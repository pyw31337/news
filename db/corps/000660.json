  "blackbox_milestones": [
    {
      "year": 1983,
      "event": "현대전자산업 설립",
      "impact": "현대그룹 정주영 회장의 반도체 도전"
    },
    {
      "year": 1999,
      "event": "정부 주도 반도체 빅딜로 LG반도체 흡수합병",
      "impact": "DRAM 시장점유율 세계 2위로 도약했으나 막대한 부채 승계"
    },
    {
      "year": 2001,
      "event": "현대그룹에서 계열 분리 및 채권단 공동관리(워크아웃)",
      "impact": "하이닉스반도체 사명 변경, 채권단 출자전환으로 독자 생존 모색"
    },
    {
      "year": 2012,
      "event": "SK그룹 최태원 회장의 결단으로 하이닉스 전격 인수",
      "impact": "SK하이닉스로 사명 변경, 매년 10조원대 공격적 R&D 및 설비투자 단행"
    },
    {
      "year": 2013,
      "event": "세계 최초 TSV 기술 적용 HBM(고대역폭메모리) 개발",
      "impact": "향후 AI 시대 엔비디아 독점 공급의 씨앗을 뿌림"
    },
    {
      "year": 2020,
      "event": "인텔(Intel) 낸드플래시 사업부 10.3조원 인수 계약",
      "impact": "솔리다임(Solidigm) 출범 및 낸드 포트폴리오 강화"
    },
    {
      "year": 2023,
      "event": "반도체 다운턴으로 7.7조원 적자 속에서도 HBM3/3E 집중 투자",
      "impact": "엔비디아 H100/H200 독점 공급 확정"
    },
    {
      "year": 2024,
      "event": "영업이익 23.4조원 사상 최대 흑자 턴어라운드",
      "impact": "HBM 세계 1위 시장 점유율 기반 글로벌 AI 반도체 황제주 등극"
    }
  ],
