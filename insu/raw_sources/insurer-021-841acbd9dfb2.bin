	<!-- S gnb -->
	
<script type="text/javascript">
/*
 * class=menu-link에 대해서 value의 값으로 url 링크처리 2026
 */
	$(document).ready(
			function() {
				$(".sub_menu_section").removeClass("active");
				$(".allmenu_section").hide();
				$(".board_cyber_more").hide();

				$(".one_depth_list > a").on(
						'mouseenter focusin click',
						function() {
							$(this).addClass("on");
							$(this).parent().siblings().children(
									'.onedepth_title').removeClass("on");
							$(this).next().slideDown(300);
							$(this).parent().siblings().find(
									".sub_menu_section").slideUp(200);
							$(this).next().find('.sub_menu_section').eq(0)
									.height(
											$(this).next().find(
													'.gnb_gorup_itme').eq(0)
													.height());
						});

				$("#gnb").on('mouseleave', function() {
					$('.onedepth_title').removeClass("on");
					$(".sub_menu_section").slideUp(100);
				});
				$(".allmenu").click(function() {
					$(this).toggleClass("active");
					$(".allmenu_section").slideToggle(200);
					$(".sub_menu_section").hide();
					var max = 0;
					$('#allmenu').find(".one_depth_list").each(function() {
						if ($(this).height() > max) {
							max = $(this).height();
						}
					});
					$('#allmenu').find(".one_depth_list").each(function() {
						$(this).height(max + 60);
					});

					// 웹접근성 문구 변경 
					if ($(this).hasClass('active')) {
						//$('#allmenu').find('.one_depth_list.menu01 > a:eq(0)').attr('tabindex', '0').focus();
						$(this).children('span').text('전체메뉴 닫기');
					} else {
						//$('#allmenu').find('.one_depth_list.menu01 > a:eq(0)').removeAttr('tabindex');
						$(this).children('span').text('전체메뉴 열기');
					}
				});

				var h = 0;
				$('.sub_menu_section').each(function() {
					h = $(this).height();
					$(this).find('.gnb_gorup_itme').each(function() {
						$(this).height(h)
					});
				});

				//탭키 포커스 아웃시 이벤트
				$('#gnb_last_depth > a').on('blur', function() {
					$('.sub_menu_section').hide();
					$('.allmenu').focus();
				});

				//탭키 포커스 아웃시 이벤트
				$('.allmenu').keydown(function(event) {
					if ($(this).hasClass('active')) {
						if (event.keyCode == 9) {
							if (event.shiftKey) {
								$('#li_last').find('a:last').focus();
								event.preventDefault();
							}
						}
					}
				});

				//탭키 포커스 아웃시 이벤트
				$('#li_last').find('a:last').keydown(function(event) {
					if (event.keyCode == 9) {
						if (!event.shiftKey) {
							$('.allmenu').focus();
							event.preventDefault();
						}
					}
				});

				// 탭+시프트 이벤트
				$('.one_depth_list.menu01 > a').keydown(function(event) {
					if (event.keyCode == 9) {
						if (event.shiftKey) {
							$('.sub_menu_section').hide();
						}
					}
				});
				/*
				* 링크처리
				*/
				$('#navigation .go-link').each(function(){
					var url = $(this).attr("value");					
					if("" != url){
						$(this).click(function(){
							document.location.href = url;
						});
					}
				});
				
				// 2026.35.25 TYLI-SRM-20260303-0045 [공시실]-4월 1일 상품공시실 변경사항 반영요청 이찬용(상품개발팀)
				// 4월1일 이후 부터 화면 보이게 처리 (개발 외에서만 시간처리) 
				var today = new Date();
				var systemMode = "prod";
				// 기준날짜 :26년 4월 1일
				if (systemMode != 'dev'){
					var targetDate = new Date(2026, 3, 1); // 월은 0부터 3 = 4월
					var element = document.getElementById('WEPAAP020300L');
					if (today >= targetDate) {
						element.style.display = "block";
					} else {
						element.style.display = "none";
					}
					console.log('어린이 : ' + targetDate + ', systemMode:' + systemMode);
				}
			});
			
	function skipNaviAct () {
			window.location.href = '#content';
			window.scrollTo({ top: 0 });
	}
</script>
<div id="dataLoadingBackground2"
	style="filter: alpha(opacity = 70); opacity: 0.7; -moz-opacity: 0.7; position: absolute; left: 0px; top: 0px; width: 1024px; height: 860px; background-color: white; font-size: 17px; color: white; text-align: center; z-index: 115; display: none"></div>
