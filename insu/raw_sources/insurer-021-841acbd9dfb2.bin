function selectAvailYn(PLYNOS, name, callback){
	var loadingBox = function(show){ isLoading(show); };
	
	var cb = function(data){
		loadingBox(false);

		data=data||{};
		if(!data.SUCCESS) {
			alert(data.MESSAGE||'계약정보 조회시 오류가 발생하였습니다.');
			return;
		}
		if(data.PLYNOS != "N") {
			alert('계약자와 수익자가 상이한 건은 온라인창구에서 처리가 불가능합니다.\n' 
					+'당사 고객센터로 문의하시기 바랍니다. ('+name+' 증권번호:'+data.PLYNOS+')');
			return;
		}

		callback(data);
	};

	loadingBox(true);
	$.ajax({
		url:'/data/selectAvailYn.jsp', 
		data:{PLYNOS:PLYNOS}, 
		dataType:"json",
		success:function(data){ cb(data); },
		error:function(){ cb(); }
	});
}

// 상품소개동의여부 확인
function selectProductAgreementYn(callback){
	var loadingBox = function(show){ isLoading(show); };

    var cb = function(data){
        loadingBox(false);

        data=data||{};
        if(!data.SUCCESS) {
            alert(data.MESSAGE||'상품소개동의 조회시 오류가 발생하였습니다.');
            return ;
        }

        setTimeout(function(){ callback(data); }, 300);
    };

    loadingBox(true);
    $.ajax({
        url:'/data/selectProductAgreementYn.jsp',
        dataType:"json",
        success:function(data){ cb(data); },
        error:function(){ cb(); }
    });
}

