<body">
<form name="downloadForm" METHOD="POST" action="/process/CO_ComDownload">
	<input type="hidden" name="_biz_op_code" value="FDL"> <input type="hidden" name="FILE_GRP_ID"><input type="hidden" name="FILE_PATH"><input type="hidden" name="FILE_NAME"><input type="hidden" name="USER_FILE_NM">
