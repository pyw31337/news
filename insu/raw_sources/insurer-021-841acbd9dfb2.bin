<script type="text/javascript">
function isLoading(bool) {
	if(!document.getElementById("dataLoadingBackground2"))
		$("body").append("<div id=\"dataLoadingBackground2\" style=\"filter:alpha(opacity=70); opacity:0.7; -moz-opacity:0.7; position:absolute; left:0px; top:0px; width:1024px; height:860px; background-color:white; font-size:17px; color:white; text-align:center; z-index:115; display:none\"></div>");

	$("#dataLoadingBackground2").html('<div id="dataLoadingBar2"><img src="/image/loading_2.gif" alt="데이터를 처리 중입니다." style=" top: 50%; left: 50%;  position: fixed; margin-left: 60px;"/></div>');

	var dataLoadingBackground2 = document.getElementById("dataLoadingBackground2");
	var dataLoadingBar2        = document.getElementById("dataLoadingBar2");

	if(bool) {
		dataLoadingBackground2.style.height = document.body.scrollHeight+"px";
		dataLoadingBackground2.style.width  = document.body.scrollWidth +"px";
		if (document.body.scrollTop == null ||document.body.scrollTop == "undefined" || document.body.scrollTop == 0) {
			dataLoadingBar2.style.top  = document.documentElement.scrollTop + document.documentElement.clientHeight/2 - 220;
			dataLoadingBar2.style.left = 250/*컨텐츠 위치*/ + 750/2 /*컨텐츠 가로폭의 반*/ - 800/2/*플래쉬 가로폭의 반*/;
		} else {
			dataLoadingBar2.style.top  = document.body.scrollTop + document.body.clientHeight/2 - 220;
			dataLoadingBar2.style.left  = 250/*컨텐츠 위치*/ + 750/2 /*컨텐츠 가로폭의 반*/ - 800/2/*플래쉬 가로폭의 반*/;
		}
		// 진행중 화면 표시 (출력)
		dataLoadingBackground2.style.display = "block";
	} else {
		dataLoadingBackground2.style.display = "none";
	}
}

function goMenu2(cat,depth2,depth3,url) {
	if ( cat == "" || cat == '#') return ;
	var frm = document.lnbform2;
	frm.target = "_self";
	frm.action = url ;
	frm.gbLNB.value = cat ;
	frm.depth2.value = depth2 ;
	frm.depth3.value = depth3 ;
	frm.submit();
}

function goMenu5(cat,depth2,depth3,depth4,url) {
	if ( cat == "" || cat == '#') return ;
	var frm = document.gnbform;
	frm.target = "_self";
	frm.action = url ;
	frm.gbLNB.value = cat ;
	frm.depth2.value = depth2 ;
	frm.depth3.value = depth3 ;
	frm.depth4.value = depth4 ;
	frm.submit();
}

function selectBabyYn(PLYNO, callback){
	var loadingBox = function(show){ isLoading(show); };
	
	var cb = function(data){
		loadingBox(false);

		

		data=data||{};
		if(!data.SUCCESS) {
			alert(data.MESSAGE||'계약정보 조회시 오류가 발생하였습니다.');
			return;
		}
		 if(data.HAS_BABY) {
			 alert('자녀가 등록되지 않은 태아보험입니다.\n자녀등록메뉴에서 자녀등록이 가능하나,\n일부 계약의 경우 온라인(모바일)창구에서 자녀등록이 제한될 수 있습니다.\n(문의 : 당사 콜센터 1577-1004)');
			return;
		}
		

		callback(data);
	};

	loadingBox(true);
	$.ajax({
		url:'/data/selectBabyYn.jsp', 
		data:{PLYNO:PLYNO}, 
		dataType:"json",
		success:function(data){ cb(data); },
		error:function(){ cb(); }
	});
}

