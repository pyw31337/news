	<button type="button" onclick="javascript:skipNaviAct()">본문내용 바로가기</button><a href="#navigation">주메뉴 바로가기</a>
</div>
<header class="header-container">
	<div class="header-inner sub">
		<h1 class="header-title">
			<a href="/notice/product/WE_PA_AP_01_00_00.jsp" class="logo"><span class="sr-only">수호천사 동양생명</span></a>
