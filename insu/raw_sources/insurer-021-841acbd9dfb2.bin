	<script type="text/javascript">
$(document).ready(function(){
	$(".foot_menu_side, .foot_menu_list").hide();
	$('.foot_menu_section').css('height','44px');

	$(".foot_menu > button").click(function(){
		if($(".foot_menu > button").hasClass('active'))
			hideFoot_menu();
		else
			showFoot_menu();
	});
	$(".foot_menu > button:first").keydown(function(event){
		if(event.keyCode==9 && event.shiftKey) hideFoot_menu();
	});
	$('button.maintop_link').keydown(function(event){
		if(event.keyCode==9) hideFoot_menu();
		
	});
	$('input[type=text]').each(function(){
		if($(this).css('height')=='1px') $(this).attr('aria-hidden',true);
	});

	function showFoot_menu(){
		$(".foot_menu > button").addClass('active').find('span.sr-only').text('상세메뉴 닫기');
		$(".foot_menu_list, .foot_menu_side").slideDown(100);
		$('.foot_menu_section').animate({height:'215px',},100);
	}
	function hideFoot_menu(){
		$(".foot_menu > button").removeClass('active').find('span.sr-only').text('상세메뉴 펼치기');;
		$(".foot_menu_list, .foot_menu_side").slideUp(100);
		$('.foot_menu_section').animate({height:'44px',},100);
	}
});

function goPageTop() {
	window.scrollTo(0,0);
	document.getElementsByTagName('body')[0].focus();
}
