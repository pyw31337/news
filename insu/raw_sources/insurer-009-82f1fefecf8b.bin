<script type="text/javascript">
$(document).ready(function () {
	//홈페이지 배너관리
	var Param = "";
	tran.sendData("HO011010_001T", $("#dataForm1"), Param, true, HO011010_001T_SUCCESS_FOOTER, HO011010_001T_FAILURE);
	
});

$(document).on("scroll",function(e){
    if($(document).scrollTop() > window.outerHeight*1.5) $("#floatGotoTopBtn").show();
    else  $("#floatGotoTopBtn").hide();
});

//홈페이지 배너관리 성공
function HO011010_001T_SUCCESS_FOOTER(resData){
	var listData = resData.list.rows;
	var tempHtml1 ='';
	var listSize1 = 0;
	
	
	if(listData.length > 0){

		$.each(listData, function(index, obj){
			
			if(obj.bannrCd == "2"){	//// 메인배너1
				 
				tempHtml1 +='<div class="swiper-slide">';
				if(obj.linkUrlValue.trim() != ""){
					tempHtml1 += '<a href="' + obj.linkUrlValue + '">';
				}
				tempHtml1 += '<img src="HO011010_002T.form?bannrWrtngIdno=' + obj.bannrWrtngIdno + '" alt="' + obj.altWrtngTitleNm + '">';
				if(obj.linkUrlValue.trim() != ""){
					tempHtml1 += '</a>';
				}
				tempHtml1 +='</div>';
				listSize1++;
			}
		});
	}
	
	if(tempHtml1 == ''){					// 메인배너1에 배너가 없을 경우
		tempHtml1 +='<li>';
		tempHtml1 +='<img src="/webdocs/resources/images/HHO/pc/main_banner01.gif" alt="핀테크지원센터">';
		tempHtml1 +='</li>';
	}else{
		
		$("#swiper-wrapper").html(tempHtml1);
	}
	
	
	fn_swiper_footer();
}
var noEnter = true;
var isFooterFocusIn = false;
var isFooterMouseOver = false;
function mainTouchSlider_footer(divClass){

	$(divClass + " .touchSlider").touchSlider({
		flexible : true,
		btn_prev : $(divClass + " .btn_prev"),
		btn_next : $(divClass + " .btn_next"),
		paging : $(divClass + " .swiper-pagination-switch"),
		initComplete : function (e) {
			$(divClass + " .swiper-pagination-switch").each(function (i, el) {
				$(this).text((i+1) + "번 배너").addClass("btn" + (i+1));
			});
		},
		counter : function (e) {
			$(divClass + " .swiper-pagination-switch").removeClass("swiper-active-switch").eq(e.current-1).addClass("swiper-active-switch");
		}
	});
	
	// 자동롤링
	main_pro_st_footer(divClass);
	
//	$(divClass + ' .swiper-pagination-switch').click(function(){
//		main_pro_stop(divClass);
//	});
	
	$(divClass + ' .play').click(function(){
		if($(divClass + ' .play').hasClass('auto')){
			main_pro_stop_footer(divClass);
		} else {
			main_pro_st_footer(divClass);
		}
	});
	
}

var isFooterStart = true;
var main_pro_tid_footer = [];

function main_pro_st_footer(divClass){
	$(divClass + ' .play').addClass('auto');
	
	var obj = {
			"tid" : setInterval('main_pro_rol_footer("' + divClass + '")',4000),
			"divClass" : divClass};
	
	main_pro_tid_footer.push(obj);
	
	isFooterStart = true;
}

// $('.main_banner').focusin(function(){
// 	main_pro_stop_footer('.main_banner');
// }).focusout(function(){
// 	main_pro_st_footer('.main_banner');
// });

function main_pro_rol_footer(divClass){
	var btn = $(divClass + ' .btn_next');
	btn.click();
}

function main_pro_stop_footer(divClass){
	$(divClass + ' .play').removeClass('auto');
	
	var idx = -1;
	for(var i=main_pro_tid_footer.length-1; i >= 0; i--){
		if(main_pro_tid_footer[i].divClass == divClass){
			idx = i;
			break;
		}
	}
	
	if(idx > -1){
		clearInterval(main_pro_tid_footer[idx].tid);
	}
	
	isFooterStart = false;
}

//홈페이지 배너관리 실패
function HO011010_001T_FAILURE(data, message){
	sAlert[0].open("홈페이지 배너 거래처리 오류 " + data.resCode + " : " + data.resMsg + "");
}

function fn_swiper_footer(){
	swiper2 = new Swiper('#swiper2', {
		autoplay: {
			delay: 2500,
			disableOnInteraction: false,
		},
		navigation: {
			nextEl: '.swiper-button-next',
			prevEl: '.swiper-button-prev',
		},
	});
}

</script>
