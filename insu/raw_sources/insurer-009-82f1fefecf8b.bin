		<script>
		$(document).ready(function() {
			$('.search_close').hide();
			$('.search_on').hide();
			
			$('.search').show();
			
			
			$("#btn_search_close").on("click",function(){
				$('.search_close').hide();
				$('.search_on').hide();
				
				$('.search').show();
				$('#btn_search').focus();
			});
			
			$("#btn_search").on("click",function(){
				$('.search').hide();
				$('.search_close').show();
				$('.search_on').show();
				$("#searchKeyword").focus();
			});
		});

		function slidEvent()
		{
			var lct_article = $('.lct_map .list > li');
			lct_article.addClass('hide');
			$('.lct_map .list > li > a').click(lctMenuToggle);
			$('.lct_map').mouseleave(lctMenuToggle2);
			$('.gnb .btn,.lct_map .btn a,.lct_map [id^=menu]>a').focus(lctMenuToggle2);
			function lctMenuToggle(event){
				var myArticle = $(this).parents('li:first');
				if(myArticle.hasClass('hide')){
					lct_article.addClass('hide').removeClass('active');
					lct_article.find('>ul').slideUp(0);
					myArticle.removeClass('hide').addClass('active');
					myArticle.find('>ul').slideDown(100);
				}
			}
			function lctMenuToggle2(event){
				$('.lct_map .list > li').addClass('hide').removeClass('active');
				$('.lct_map .list ul').slideUp(100);
			}
		}

		</script>

	
