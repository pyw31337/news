    //네비게이션 처리
    function vNavHandler(txt, url, target, targetData){
    	
        if(url !== "#") {
            var goPage = url.split(",");
            var temp = "";
            for(var i=0, loopCnt = goPage.length; i < loopCnt; i++){
                if(i == 0){
                	if(goPage[i].indexOf(".") != -1){
                        temp = temp + goPage[i];
                        temp = temp + "?";
                	} else {
                        temp = temp + goPage[i] + ".scp";
                        temp = temp + "?";
                	}
                }else{
                    temp = temp + goPage[i] + "&";
                }
            }
            goPage = temp.substring(0, temp.length-1);

            //var nPos = url.indexOf("menuId=MN");
           	//sMenuId = url.substring(nPos+7);
           	//임시로 특정 메뉴는 팝업으로 처리함.
           	var urlId = url.substring(0,10);
           	//alert("urlId=="+urlId);
           	if(urlId == "IS071090DM" || urlId == "IS081010DM"){
           		window.open(goPage);
           	}else if(temp.indexOf("popup") > -1){
            	var value = goPage.split("&");
            	var width = "100";
            	var height = "100";
            	for(var i = 1; i < value.length; i++){
            		var pair = value[i].split("=");
            		var param = pair[0];
            		var paramVal = pair[1];
            		if(param == "width"){
            			width = paramVal;
            		}
            		if(param == "height"){
            			height = paramVal;
            		}
            	}
            	var cc = "scrollbars=yes";
            	cc = cc + ",width=" + width + ",height="+height;
            	window.open(goPage,'_blank',cc);
	        }	else if(getParseUrl(location.href).getDomain().startsWith(getParseUrl(url).getDomain())) {
                goUrlScreen(goPage);
            }
            else {
                window.open(goPage);
            }
            
/*             if(targetData.link_ty == '02') {
                window.open(goPage);
            }
            else {
                goUrlScreen(goPage);
            } */
            return true;
        }
        
	};
	
	function HO011010_001T_SUCCESS(resData){
		var listData = resData.list.rows;
		var tempHtml = '';
		var listSize = 0;
		
		try {
			if(listData.length > 0){
	
				$.each(listData, function(index, obj){
					//// 좌측 배너
					var tmpOrdValue = obj.rorOrdKeyValue;
					var tmpLinkUrl = "#none";
					if (tmpOrdValue < 10) tmpOrdValue = '0' + tmpOrdValue;
					if (obj.linkUrlValue.trim() != "") tmpLinkUrl = obj.linkUrlValue;
					
					tempHtml += '<div class="cont_Banner bg' + tmpOrdValue + '" style="background: #f0f7fd url(\'HO011010_002T.form?bannrWrtngIdno=' + obj.bannrWrtngIdno + '\') 123px 63px no-repeat;" alt="' + obj.altWrtngTitleNm + '">';
					tempHtml += '	<p class="tit">' + obj.altWrtngTitleNm + '</p>';
					tempHtml += '	<p>' + obj.wrtngText + '</p>';
					tempHtml += '	<button onclick="pageLink(\'' + tmpLinkUrl + '\');" title="새창열림">내 보험료 확인하기</button>';
					tempHtml += '</div>';
				});
			}
			
			$("div[class='lnb']").append(tempHtml);
		} catch (e) {
			console.log(e);
			HO011010_001T_FAILURE(null, e)
		}
	}
	
	//좌측 배너관리 실패
	function HO011010_001T_FAILURE(data, message){
		if (!nullCheck(data)) {
			sAlert[0].open("좌측 배너 거래처리 오류 " + data.resCode + " : " + data.resMsg + "");
		}
		if (!nullCheck(message)) {
			sAlert[0].open(message);
		}
	}

