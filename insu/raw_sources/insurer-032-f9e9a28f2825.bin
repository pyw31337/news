                <div class="clauseCont nbtn scrollY" id="claus_tbl">
                </div>
            </div>
        </div>
    </div>
</div>
<!--//layerpop_특약_저축성-->


<script type="text/javascript">

/******************************************
 * 변수 & 상수 선언
 ******************************************/

 var PRODUCT_FILE_LIST = ''
 + '<tr>'
 + '<td id="product_file_date">{begindate} ~ {enddate}</td>'
 + '<td><a href="" id="{file_summary_id}" class="down" title="요약서 다운로드">요약서다운로드</a></td>'
 + '<td><a href="" id="{file_term_id}" class="down" title="약관 다운로드">약관다운로드</a></td>'
 + '<td><a href="" id="{file_biz_id}" class="down" title="사업방법서 다운로드">사업방법서다운로드</a></td>'
 + '</tr>';

 var EMPTY_PRODUCT_FILE_LIST = ''
 + '<tr>'
 + '<td colspan="4">'
 + '<div class="dataNone">'
 + '<p>등록된 자료가 존재하지 않습니다.</p>'
 + '</div>'
 + '</td>'
 + '</tr>';

 var SPC_TABLE = ''
 + '<div class="gongsi_tbl_Tit">'
 + '<div class="title" id="spcProduct_title">{agreementname}</div>'
 + '</div>'
 + '<div class="tableWrap type02 mt1">'
 + '<table cellpadding="0" cellspacing="0" border="0"  summary="" id="spc_tbl">'
 + '<caption>상품주요서류</caption>'
 + '<colgroup>'
 + '<col width="">'
 + '<col width="">'
 + '<col width="">'
 + '</colgroup>'
 + '<thead>'
 + '<tr>'
 + '<th>판매기간</th>'
 + '<th>약관</th>'
 + '<th>사업방법서</th>'
 + '</tr>'
 + '</thead>'
 + '<tbody id="spc_content{agreementid}">'
 + '</tbody>'
 + '</table>'
 + '</div>';



 var SPC_FILE_LIST = ''
 + '<tr>'
 + '<td id="spc_file_date">{begindate} ~ {enddate}</td>'
 + '<td><a href="" id="{file_term_id}" class="down" title="약관다운로드">약관다운로드</a></td>'
 + '<td><a href="" id="{file_biz_id}" class="down" title="사업방법서다운로드">사업방법서다운로드</a></td>'
 + '</tr>';

 var EMPTY_SPC_FILE_LIST = ''
 + '<tr>'
 + '<td colspan="3">'
 + '<div class="dataNone">'
 + '<p>등록된 자료가 존재하지 않습니다.</p>'
 + '</div>'
 + '</td>'
 + '</tr>';


 var papagProductList;
 var papagProductFileList;
 var papagSpcProductList;
 var papagSpcProductFileList;



 /******************************************
  * 함수 선언
  ******************************************/


  /* 상품리스트 */
 function selectProductList () {
     var ajaxPram = {};
     ajaxPram.url = '/pa/pag/rest/selectProductList101.do';
     ajaxPram.data = {
             saleYn: "1", //판매상품
             productTypeId: $(":input:radio[name=case]:checked").val()  // 저축성:1 보장성:2
     };

     ajaxPram.callback = function (result) {
         //console.log(result.data);
         papagProductList = result.data.result.productList;

         setProductDataInHtml(papagProductList);
     };
     Util.sendData(ajaxPram);
 }

 function setProductDataInHtml (productList) {
     for (var i = 0; i < productList.length; i++) {
         var rowData = productList[i];
         $('#productList').append(htmlTag.OPTION.format({optVal : rowData.productcode, label: rowData.productname}));
     }

 }


 /* 상품파일목록 */
 function selectProductFileList () {
     var ajaxPram = {};
     ajaxPram.url = '/pa/pag/rest/selectProductFileList101.do';
     ajaxPram.data = {
    		 productTypeId: $(":input:radio[name=case]:checked").val()  // 저축성:1 보장성:2
             , productCode: $('#productList').val()
             , sellable: "1"
     };
     ajaxPram.callback = function (result) {
         //console.log(result);
         papagProductFileList = result.data.productFileList;
         setProductFileDataInHtml(papagProductFileList);
     };

     // 유효성 검사
     /* if (!validateForSearch(ajaxPram.data)) {
         return false;
     } */
     Util.sendData(ajaxPram);
 }


 function setProductFileDataInHtml (productFileList) {
     $('#product_content').empty();
     $('#sectionSave').show();
     $('#spcbtn').show();


     var productname = $('#productList option:selected').text();
     //console.log(productname);
     $('#product_title').html(productname);


     var curdate = moment().format('yyyy.MM.DD');


     for (var i = 0; i < productFileList.length; i++) {
         var rowData = productFileList[i];

         var enddate = rowData.enddate;

         if(enddate > curdate) {
             rowData.enddate = "현재";
         }

         $('#product_content').append(PRODUCT_FILE_LIST.format(rowData));

     }
     if (productFileList.length == 0) {
         $('#product_content').append(EMPTY_PRODUCT_FILE_LIST.format({}));
         $('#spcbtn').hide();
     }

     //파일 다운로드 <a> html 클릭 이벤트 등록(href 속성 값 강제삽입)
     $("table tbody tr td a.down").attr("href","javascript:void(0);").off().on("click",fnFileDownload);
 }

 /* 특약리스트 */
 function selectSpcProductList () {
     var ajaxPram = {};
     ajaxPram.url = '/pa/pag/rest/selectProductList103.do';
     ajaxPram.data = {
             productCode : $('#productList').val(),
             productTypeId : $(":input:radio[name=case]:checked").val(),
             saleYn : "1"
     };
     ajaxPram.callback = function (result) {
         //console.log("특약 : " , result);
         papagSpcProductList = result.data.result.productList;
         setSpcProductDataInHtml(papagSpcProductList);
     };

     Util.sendData(ajaxPram);
 }

 function setSpcProductDataInHtml (spcProductFileList) {
     selectSpcProductFileList();

     for (var i = 0; i < spcProductFileList.length; i++) {
         var rowData = spcProductFileList[i];
         $('#claus_tbl').append(SPC_TABLE.format(rowData));
     }
     if(spcProductFileList.length == 0) {
         var agreementname = null;
         $('#claus_tbl').append(SPC_TABLE.format({}));
         $('#spcProduct_title').html(agreementname);
     }
 }


 /* 특약상품파일목록 */
 function selectSpcProductFileList () {
     var ajaxPram = {};
     ajaxPram.url = '/pa/pag/rest/selectProductFileList103.do';
     ajaxPram.data = {
             productCode: $('#productList').val(),
             productTypeId: $(":input:radio[name=case]:checked").val(),  // 저축성:1 보장성:2
             sellable : "1"
     };
     ajaxPram.callback = function (result) {
         //console.log(result);
         papagSpcProductFileList = result.data.productFileList;
         setSpcProductFileDataInHtml(papagSpcProductFileList);
     };

     Util.sendData(ajaxPram);
     }


 function setSpcProductFileDataInHtml (productFileList) {
     /* $('#spc_content').empty(); */

     var curdate = moment().format('yyyy.MM.DD');


     for (var i = 0; i < productFileList.length; i++) {
         var rowData = productFileList[i];

//          var enddate = moment(rowData.enddate).format('yyyy-MM-DD');
         var enddate = rowData.enddate;

         if(enddate > curdate) {
             rowData.enddate = "현재";
         }

         var agreementid = rowData.agreementid;
         $('#spc_content' + agreementid).append(SPC_FILE_LIST.format(rowData));
     }

     if (productFileList.length == 0) {
         $('#spc_content').append(EMPTY_SPC_FILE_LIST.format({}));

     }

     //파일 다운로드 <a> html 클릭 이벤트 등록(href 속성 값 강제삽입)
     $("table tbody tr td a.down").attr("href","javascript:void(0);").off().on("click",fnFileDownload);
 }


/**
 * 파일 다운로드 함수 >> 공통 스크립트 유틸 호출~
 */
function fnFileDownload(){
     //front서버 첨부파일 위치할 경우
    Util.fileDownloadFront( {"fileId":$(this).attr("id"), "atchFileDiv":"DIS"} );//id가 아닌 다른 속성일 경우 .attr("변경할 속성name")

     //back서버 첨부파일 위치할 경우
    //Util.fileDownload( {"fileId":$(this).attr("id"), "atchFileDiv":"DIS"} );//id가 아닌 다른 속성일 경우 .attr("변경할 속성name")
}



function init() {

    common_ui.layerpop();
    selectProductList();
}


function eventsBinding() {
    $('#select_file_btn').on('click', function () {
        selectProductFileList();
    });

    $('#case_save').click(function(){
        $('#sectionSave').hide();
        $('#productList').empty();
        $('#product_content').empty();
        selectProductList();
        //console.log($(":input:radio[name=case]:checked").val());
    });

    $('#case_cover').click(function(){
        $('#sectionSave').hide();
        $('#productList').empty();
        $('#product_title').empty();
        $('#product_content').empty();
        selectProductList();
        //console.log($(":input:radio[name=case]:checked").val());
    });

    $('#spcbtn').click(function(){
        $('#claus_tbl').empty();
        /* $('#spc_content').empty(); */
       selectSpcProductList();
        /* selectSpcProductFileList(); */
    });

}


$(document).ready(function(){

    //파일 다운로드 <a> html 클릭 이벤트 등록(href 속성 값 강제삽입)
    $("table tbody tr td a.down").attr("href","javascript:void(0);").off().on("click",fnFileDownload);

    init();

    eventsBinding();
});

</script>



