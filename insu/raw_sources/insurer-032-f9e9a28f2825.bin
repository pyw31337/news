            <!-- 공유하기 -->
            <!--<th:block th:include="/common/layout/fragments/share"/>-->
            <!-- //공유하기 -->

            <script type="text/javascript" id="location_disclosure">

                var $loc = $("div.container div.location");

                var $type01 = $loc.find("li.gongsiCate.type01");
                var $div01 = $type01.find("div.select");
                var $opList01 = $type01.find("ul.option-list");

                var $type02 = $loc.find("li.gongsiCate.type02");
                var $div02 = $type02.find("div.select");
                var $opList02 = $type02.find("ul.option-list");

                var menu_name = "";
                var meta_title = "";
                var meta_desc = "";
                var meta_bots = "";
                var loadyn = "N";

                function fnSetDisMenulevel02(_menu_no){
                	var showText = "";
                    var menu_no = $(this).attr("data-menu_no")?$(this).attr("data-menu_no"):$opList01.find("li").eq(0).attr("data-menu_no");
                    if( _menu_no && isNaN(parseInt(_menu_no)) == false ){
                        menu_no = _menu_no;
                        showText = $opList01.find("li").removeClass("selected").end().find("li[data-menu_no='"+menu_no+"']").addClass("selected").text();
                        $div01.text( showText );
                    }

                    $opList02.find("li").removeClass("selected").addClass("hidden");
                    var $showList = $opList02.find("li[data-supos_menu_no='"+menu_no+"']");
                    if( $showList.length >= 1 ){
                        $showList.removeClass("hidden");
                        if( isNaN(parseInt(_menu_no)) == true ){
                            showText = $opList02.find("li[data-supos_menu_no='"+menu_no+"']:eq(0)").addClass("selected").text();
                        }else{
                            showText = $opList02.find("li[data-supos_menu_no='"+menu_no+"']li[data-href*='"+location.pathname+"']:eq(0)").addClass("selected").text();
                        }
                    }

                    menu_name = showText;
                    meta_title = $opList02.find("li").eq($opList02.find("li.selected").index()).attr("data-meta_title");
                    meta_desc = $opList02.find("li").eq($opList02.find("li.selected").index()).attr("data-meta_desc");
                    meta_bots = $opList02.find("li").eq($opList02.find("li.selected").index()).attr("data-meta_bots");

                    $div02.removeClass("select pl20p pr20p");
                    if( showText ){
                        $div02.addClass("select");
                    }
                    $div02.text( showText );
                    if(loadyn == "N"){
	                    $("#loc_menu_name").val(menu_name);
	                    $("#loc_meta_title").val(meta_title);
	                    $("#loc_meta_desc").val(meta_desc);
	                    $("#loc_meta_bots").val(meta_bots);
	                    loadyn = "Y";
	                    fnSetHtmlMetaData();
                    }
                }

                function fnSetDisMenulevel03(){
                    menu_name = $(this).text();
                    meta_title = $(this).attr("data-meta_title");
                    meta_desc = $(this).attr("data-meta_desc");
                    meta_bots = $(this).attr("data-meta_bots");
                    Util.movePage( $(this).attr("data-href") );
                }

                function location_init(){
                	var menu_no = $opList02.find("li[data-href*='"+location.pathname+"']:eq(0)").attr("data-supos_menu_no");
                    fnSetDisMenulevel02(menu_no);
                }

                function fnSetHtmlMetaData(){
                	var menuName = $("#loc_menu_name").val();
                    var metaDesc = !$("#loc_meta_desc").val()||$("#loc_meta_desc").val()=="null"?$("#loc_menu_name").val():$("#loc_meta_desc").val();
                    var metaTitle = !$("#loc_meta_title").val()|| $("#loc_meta_title").val()=="null"?$("#loc_menu_name").val():$("#loc_meta_title").val();
                    var metaRobots = !$("#loc_meta_bots").val()|| $("#loc_meta_bots").val()=="null"?"index,follow":$("#loc_meta_bots").val();
                    menuName += " | BNP파리바 카디프생명"
                    metaTitle += " | BNP파리바 카디프생명"

                    $("title").text(menuName);
                    $("meta[name='title']").attr("content", metaTitle);
                    $("meta[name='description']").attr("content", metaDesc);
                    $("meta[name='robots']").attr("content", metaRobots);

                    $("meta[name='og_title']").attr("content", metaTitle);
                    $("meta[name='og_description']").attr("content", metaDesc);
                    $("meta[name='og_image']").attr("content", location.origin+"/img/bnppcardifkrbl.png");
                }

                $(document).ready(function(){
                    $loc = $("div.container div.location");

                    $type01 = $loc.find("li.gongsiCate.type01");
                    $div01 = $type01.find("div.select");
                    $opList01 = $type01.find("ul.option-list");

                    $type02 = $loc.find("li.gongsiCate.type02");
                    $div02 = $type02.find("div.select");
                    $opList02 = $type02.find("ul.option-list");

                    location_init();
                    $opList01.find("li").on("click",fnSetDisMenulevel02);
                    $opList02.find("li").on("click",fnSetDisMenulevel03);
                });
            </script>
                <!-- //location 영역 -->
            </div>

