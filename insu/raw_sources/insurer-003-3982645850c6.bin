<script type="text/javascript">

	function searchClick(){
		
		var keyword = '';
		var searchCheck = '0';
		
		if($(".period").is(':visible') == true){
			if($("#beginDate").val()=="" || $("#endDate").val()==""){
	   			LayerPop.alert("기간을 선택하여주십시오", function() {
					$('#beginDate').focus();
				});
				return;
			}
			
			if($("#keyword2").val()==""){
	   			LayerPop.alert("검색어를 입력하여주십시오", function() {
					$('#keyword2').focus();
				});
				return;
			} else {
				keyword = $("#keyword2").val()
			}
			
			searchCheck = '1';
	
		} else {
			if($("#keyword").val()==""){
	   			LayerPop.alert("검색어를 입력하여주십시오", function() {
					$('#keyword').focus();
				});
				return;
			} else {
				keyword = $("#keyword").val()
			}
			
			searchCheck = '0';
			
		}
		
		
		//파라미터 세팅
		var params = {};
		params.searchCheck = searchCheck;
	    params.keyword = keyword;
	    params.beginDate = deleteChar($("#beginDate").val(),'.');
	    params.endDate = deleteChar($("#endDate").val(),'.');
		
		callAjaxParams(params, "/insuPcPbanFindProductStep5_AX.do", "", FWMAIL6337_01_AX_CB, "FWMAIL6337");
	
	
	}

	function FWMAIL6337_01_AX_CB(data) {
		
		$('#liveList').empty();
		$('#sleepList').empty();
		
		if( data.result.length > 0 ) {
			var strHtml = '';
			
			//판매중상품
			for( var i=0; i < data.result.length; i++) {
				
				if(data.result[i].ARC_PDC_SL_YN == '0') continue;
				
                strHtml += '<tr>';
                strHtml += '<td class="ft">'+data.result[i].ARC_KND_LGCG_NM+'</td>';
                strHtml += '<td>'+data.result[i].PDC_NM+'</td>';
                strHtml += '<td>'+data.result[i].SALE_BEGIN_DAY+'</td>';
                if(data.result[i].INPL_FINM != undefined && data.result[i].INPL_FINM != ""){
                	strHtml += '<td><a href="javascript:" onclick="goPdf(\''+data.result[i].SQNO+'\',\''+data.result[i].INPL_FINM+'\');" class="btn_l_s" title="상품약관 PDF 새창열기"><span>상품약관</span></a></td>';
                } else {
                	strHtml += '<td></td>';
                }
                if(data.result[i].BIZ_MDDC_FINM != undefined && data.result[i].BIZ_MDDC_FINM != ""){
                	strHtml += '<td><a href="javascript:" onclick="goPdf(\''+data.result[i].SQNO+'\',\''+data.result[i].BIZ_MDDC_FINM+'\');" class="btn_l_s" title="사업방법서 PDF 새창열기"><span>사업방법서</span></a></td>';
                } else {
                	strHtml += '<td></td>';
                }
                if(data.result[i].CNSL_SMAR_FINM != undefined && data.result[i].CNSL_SMAR_FINM != ""){
                	strHtml += '<td><a href="javascript:" onclick="goPdf(\''+data.result[i].SQNO+'\',\''+data.result[i].CNSL_SMAR_FINM+'\');" class="btn_l_s" title="상품요약서 PDF 새창열기"><span>상품요약서</span></a></td>';
                } else {
                	strHtml += '<td></td>';
                }
                if(data.result[i].PDC_EXPP_FINM != undefined && data.result[i].PDC_EXPP_FINM != ""){
                	strHtml += '<td><a href="javascript:" onclick="goPdf(\''+data.result[i].SQNO+'\',\''+data.result[i].PDC_EXPP_FINM+'\');" class="btn_l_s" title="상품설명서 PDF 새창열기"><span>상품설명서</span></a></td>';
                } else {
                	strHtml += '<td></td>';
                }
                strHtml += '</tr>';
			}
			
			$('#liveList').html(strHtml);
			
			
			//판매중지상품
			strHtml = '';
			
			for( var i=0; i < data.result.length; i++) {
				
				if(data.result[i].ARC_PDC_SL_YN == '1') continue;
				
                strHtml += '<tr>';
                strHtml += '<td class="ft">'+data.result[i].ARC_KND_LGCG_NM+'</td>';
                strHtml += '<td>'+data.result[i].PDC_NM+'</td>';
                strHtml += '<td>'+data.result[i].SALE_BEGIN_DAY+'</td>';
                if(data.result[i].INPL_FINM != undefined && data.result[i].INPL_FINM != ""){
                	strHtml += '<td><a href="javascript:" onclick="goPdf(\''+data.result[i].SQNO+'\',\''+data.result[i].INPL_FINM+'\');" class="btn_l_s" title="상품약관 PDF 새창열기"><span>상품약관</span></a></td>';
                } else {
                	strHtml += '<td></td>';
                }
                if(data.result[i].BIZ_MDDC_FINM != undefined && data.result[i].BIZ_MDDC_FINM != ""){
                	strHtml += '<td><a href="javascript:" onclick="goPdf(\''+data.result[i].SQNO+'\',\''+data.result[i].BIZ_MDDC_FINM+'\');" class="btn_l_s" title="사업방법서 PDF 새창열기"><span>사업방법서</span></a></td>';
                } else {
                	strHtml += '<td></td>';
                }
                if(data.result[i].CNSL_SMAR_FINM != undefined && data.result[i].CNSL_SMAR_FINM != ""){
                	strHtml += '<td><a href="javascript:" onclick="goPdf(\''+data.result[i].SQNO+'\',\''+data.result[i].CNSL_SMAR_FINM+'\');" class="btn_l_s" title="상품요약서 PDF 새창열기"><span>상품요약서</span></a></td>';
                } else {
                	strHtml += '<td></td>';
                }
                if(data.result[i].PDC_EXPP_FINM != undefined && data.result[i].PDC_EXPP_FINM != ""){
                	strHtml += '<td><a href="javascript:" onclick="goPdf(\''+data.result[i].SQNO+'\',\''+data.result[i].PDC_EXPP_FINM+'\');" class="btn_l_s" title="상품설명서 PDF 새창열기"><span>상품설명서</span></a></td>';
                } else {
                	strHtml += '<td></td>';
                }
                strHtml += '</tr>';
			}
			
			$('#sleepList').html(strHtml);

			
		}
		
		Dialog.open("#searchResultDialog");
	}

	
	//------------------------------------------------------//
	// 해당되는 문자열 중 delchar을 제거한다.
	//------------------------------------------------------//
	function deleteChar(source, delchar)
	{
	  // source    : 작업을 수행할 대상
	  // delchar    : 제거해야 할 대상
	  var str = source;

	  str = allTrim( str );
	  var index, len;

	  do {
	    index = str.indexOf(delchar);
	    len = str.length;
	    str = str.substring(0, index) + str.substring((index+delchar.length), len);
	  } while(index > -1);

	  return str;
	}

	//------------------------------------------------------//
	// 공백을  모두제거
	//------------------------------------------------------//
	function allTrim(str)
	{
	    var index, len;

	    do {
	        index = str.indexOf(" ");
	        len = str.length;
	        str = str.substring(0, index) + str.substring((index+1), len);
	    } while(index > -1);

	    return str;
	}
</script>
