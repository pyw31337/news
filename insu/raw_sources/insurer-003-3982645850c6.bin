							<input type="checkbox" id="today_chk_01"  onclick="todayChk();"><!-- 체크박스 id 수정 -->
							<label for="today_chk_01">오늘 하루 보지 않기</label><!-- 체크박스 id 수정 -->
						</div>
					</div>
				</div>
			</div>
