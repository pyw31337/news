<script type="text/javascript">
	$(document).ready(function(){
		setInterval(function() {
			$('.mCustomScrollBox').removeAttr('tabindex');
			$('.mCustomScrollBox').find('a.active').attr('title', '현재 선택됨');
			var aTags = $('.mCustomScrollBox').find('a');
			for(var i = 0; i < aTags.length; i++) {
				if(!aTags.eq(i).hasClass('active')) {
					aTags.eq(i).removeAttr('title');
				}		
			}
		}, 200);
	});
	
	function getStep2(lnm, snm, mnm ) {
		//파라미터 세팅
		var params = {};
	    params.arc_knd_lgcg_nm = lnm;
	    params.sl_chn_nm = snm;
	    params.arc_knd_mdcg_nm = mnm;
	    params.arc_pdc_sl_yn = "1";
		
		callAjaxParams(params, "/insuPcPbanFindProductStep2_AX.do", "", FWMAIV1534_01_AX_CB, "FWMAIV1534");
	}	
	
	
	function FWMAIV1534_01_AX_CB(data) {
		
		$('#step2_list').empty();
		$('#step3_list').empty();
		reset4Step();
		
		var strHtml = '';
		
		for( var i=0; i < data.result.length; i++) {
			strHtml += '<li><a href="javascript:" onclick="step2Click(this,\''+data.result[i].PDC_NM+'\'); return false;">'+data.result[i].PDC_NM+'</a></li>';
		}
		
		$('#step2_list').html(strHtml);
	}
	
	function step2Click(obj, nm) {
		//파라미터 세팅
		var params = {};
	    params.pdc_nm = nm;
	    params.arc_pdc_sl_yn = "1";
	    $('#step2_list').find('a').removeClass('active');
	    $(obj).addClass('active');
		
		callAjaxParams(params, "/insuPcPbanFindProductStep3_AX.do", "", FWMAIV1534_02_AX_CB, "FWMAIV1534");
		
	}
	
	function FWMAIV1534_02_AX_CB(data) {
		
		$('#step3_list').empty();
		reset4Step();
		
		var strHtml = '';
		
		for( var i=0; i < data.result.length; i++) {
			
			if(data.result[i].SL_STR_DT.length<8) continue;
			
    		var begin = "";
    		var end = "현재";
    		var text = "";
    		
    		if(data.result[i].SL_STR_DT.length==8){
    			begin = data.result[i].SL_STR_DT.substr(0,4)+"."+data.result[i].SL_STR_DT.substr(4,2)+"."+data.result[i].SL_STR_DT.substr(6,2);
    		}
			if(data.result[i].SL_FIN_DT != undefined && data.result[i].SL_FIN_DT.length==8){
				end = data.result[i].SL_FIN_DT.substr(0,4)+"."+data.result[i].SL_FIN_DT.substr(4,2)+"."+data.result[i].SL_FIN_DT.substr(6,2);
    		}
			
			text = begin + " ~ " + end 

			strHtml += '<li><a href="javascript:" onclick="step3Click(this,\''+data.result[i].SQNO+'\'); return false;">'+text+'</a></li>';
		}
		
		$('#step3_list').html(strHtml);

	}
	
	function step3Click(obj, idx) {
		//파라미터 세팅
		var params = {};
	    params.sqno = idx;
	    params.arc_pdc_sl_yn = "1";
	    $('#step3_list').find('a').removeClass('active');
	    $(obj).addClass('active');
		
		callAjaxParams(params, "/insuPcPbanFindProductStep4_AX.do", "", FWMAIV1534_03_AX_CB, "FWMAIV1534");

	}
	
	
	function FWMAIV1534_03_AX_CB(data) {
		
		reset4Step();
		
		if( data.result.length > 0 ) {
	    	$("#step4_name").html(data.result[0].PDC_NM);
	    	
    		var begin = "";
    		var end = "현재";
    		var text = "";
    		
    		if(data.result[0].SL_STR_DT.length==8){
    			begin = data.result[0].SL_STR_DT.substr(0,4)+"."+data.result[0].SL_STR_DT.substr(4,2)+"."+data.result[0].SL_STR_DT.substr(6,2);
    		}
			if(data.result[0].SL_FIN_DT != undefined && data.result[0].SL_FIN_DT.length==8){
				end = data.result[0].SL_FIN_DT.substr(0,4)+"."+data.result[0].SL_FIN_DT.substr(4,2)+"."+data.result[0].SL_FIN_DT.substr(6,2);
    		}
			
			text = begin + " ~ " + end 

			$("#step4_date").html(text);
	    	
	    	if(data.result[0].BIZ_MDDC_FINM != undefined && data.result[0].BIZ_MDDC_FINM != ""){
	    		//$("#step4Btn1").attr("href","/inc/cYakgwanDown.jsp?FilePath=InsProduct/"+data.result[0].BIZ_MDDC_FINM);
	    		$("#step4Btn1").addClass('on');
	    		$("#step4Btn1").attr("onclick",'goPdf("'+data.result[0].SQNO+'","'+data.result[0].BIZ_MDDC_FINM+'")');
	    		$("#step4Btn1").show();
	    	}
	    	if(data.result[0].CNSL_SMAR_FINM != undefined && data.result[0].CNSL_SMAR_FINM != ""){
	    		//$("#step4Btn2").attr("href","/inc/cYakgwanDown.jsp?FilePath=InsProduct/"+data.result[0].CNSL_SMAR_FINM);	
	    		$("#step4Btn2").addClass('on');
	    		$("#step4Btn2").attr("onclick",'goPdf("'+data.result[0].SQNO+'","'+data.result[0].CNSL_SMAR_FINM+'")');	
	    		$("#step4Btn2").show();
	    	}
	    	if(data.result[0].INPL_FINM != undefined && data.result[0].INPL_FINM != ""){
	    		//$("#step4Btn3").attr("href","/inc/cYakgwanDown.jsp?FilePath=InsProduct/"+data.result[0].INPL_FINM);
	    		$("#step4Btn3").addClass('on');
	    		$("#step4Btn3").attr("onclick",'goPdf("'+data.result[0].SQNO+'","'+data.result[0].INPL_FINM+'")');	
	    		$("#step4Btn3").show();
	    	}
	    	/* if(data.result[0].PDC_EXPP_FINM != undefined && data.result[0].PDC_EXPP_FINM != ""){
	    		$("#step4Btn4").addClass('on');
	    		$("#step4Btn4").attr("onclick",'goPdf("'+data.result[0].SQNO+'","'+data.result[0].PDC_EXPP_FINM+'")');	
	    	} */
		}

	}
	
	function goPdf(sqno, valpdf) {
		var openwindow = window.open("about:blank");
		openwindow.location.href="/cYakgwanDown.do?FilePath=InsProduct/"+encodeURIComponent(valpdf);
		
	
 	}
	
	function FWMAIV1534_05_AX_CB(data) {
	}
	
	function reset4Step(){		
		$("#step4_name").html("");
		$("#step4_date").html("");
		$("#step4Btn1").removeAttr("onclick");
		$("#step4Btn2").removeAttr("onclick");
		$("#step4Btn3").removeAttr("onclick");
		/* $("#step4Btn4").removeAttr("onclick"); */
		$("#step4Btn1").removeClass('on');
		$("#step4Btn2").removeClass('on');
		$("#step4Btn3").removeClass('on');
		$("#step4Btn1").hide();
		$("#step4Btn2").hide();
		$("#step4Btn3").hide();
		/* $("#step4Btn4").removeClass('on'); */
    }	

	
</script>        


