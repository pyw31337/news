<script type="text/javascript">

	// 패밀리사이트 공통 플러그인

	$.fn.familysite = function() {

		return this.each(function() {

			var $obj = $(this), $tit = $obj.find(".tit"), $tgt = $tit.next();




			$tit.on("click", function() {

				$(this).addClass("on").next().removeClass("hide").attr({

					"tabindex" : "0"

				}).css("outline", 0).focus();

				return false;

			});




			$tgt.find("button").on("click", function() {

				$tit.removeClass("on").next().addClass("hide");

				$tit.attr("tabindex", 0).focus();

			});




			$(document).click(function(event) {

				if (!$(event.target).parents().is($obj)) {

					$tit.removeClass("on").next().addClass("hide");

				}

			});

		});

	}










	//페이지에 들어갈 스크립트

	$(document).ready(function() {

		//슬라이드

		$('#slides').slidesjs({

			width:178,

            height:315,

			play: {

				active: true,

	            auto: true,

	            interval: 3000,

	            swap: true

			}

		});




		//패밀리 사이트

		$(".familySite").familysite();

		// 하단 메뉴
		$(".foot-menu, .footer-laypop").off('mouseover').on('mouseover', function(e){
			$('.footer-laypop').show();
		});

		$(".foot-menu, .footer-laypop").off('mouseout').on('mouseout', function(e){
			$('.footer-laypop').hide();
		});

		// 추가
		$(".foot-menu a, .footer-laypop a").off('focus.tidx').on('focus.tidx', function(e){
			//console.log('FOCUS', $(e.currentTarget).html(), e);
			$('.footer-laypop').show();
		});
		$(".foot-menu a").off('blur.tidx').on('blur.tidx', function(e){
			setTimeout(function(){
				if($(".foot-menu, .footer-laypop").find("a:focus").length == 0){
					//console.log('BLUR', $(e.currentTarget).html(), e);
					$('.footer-laypop').hide();
				}
			}, 10);
		});
		$(".foot-menu a, .footer-laypop ol a").off('keydown.tidx').on('keydown.tidx', function(e){
			var keycode = e.which || (e.event ? window.event.keyCode : -1);
			
			var me = $(this);
			var firstA = $('.footer-laypop a:first');

			if(! keycode == 9){
				return;
			}

			if(e.shiftKey){ 
				if(me[0] == firstA[0]){
					$(".foot-menu a:first").focus();
					return false; 
				}
				return;
			}

			//console.log('KEYDOWN', keycode, String.fromCharCode(keycode), $(e.currentTarget)[0], e);

			$('.footer-laypop .p1 a').attr('midx', 0);
			$('.footer-laypop .p2 a').attr('midx', 1);
			$('.footer-laypop .p3 a,.footer-laypop .p4 a,.footer-laypop .p5 a').attr('midx', 2);

			var idx1 = $(".foot-menu a").index(me);
			var idx2 = $(".footer-laypop ol").index(me.closest('ol'));
			var idx3 = $(".footer-laypop ol:eq(" + idx2 + ") a").index(me);
			var depth = idx1 == -1 ? 1 : 0;
			idx2 = idx2 == -1 ? idx1 : idx2;
			idx3 = idx3 == -1 ? 0 : idx3;
			var o = $(".footer-laypop ol").eq(idx2).find('a').eq(idx3);
			var oMax = $(".footer-laypop ol").eq(idx2).find('a:last');
			var idx3_max = $('.footer-laypop a').index(oMax) || 0;
			var idx4 = $('.footer-laypop a').index(o) || 0;
			var idx4_max = $('.footer-laypop a').length - 1;
			var index = 0;

			//console.info(depth, 'idx1 : ' + idx1 + ', ' + 'idx2 : ' + idx2 + ', ' + 'idx3 : ' + idx3 + ', ' + 'idx4 : ' + idx4 + ', ' + 'idx3_max : ' + idx3_max + ', ' + 'idx4_max : ' + idx4_max);
			
			if(idx1 == 0){
				me.blur();
				$('.footer-laypop').show().find(".p1 a:eq(0)").focus();	
			}else if(idx1 == 1){
				me.blur();
				$('.footer-laypop').show().find(".p2 a:eq(0)").focus();	
			}else if(idx1 == 2){
				me.blur();
				$('.footer-laypop').show().find(".p3 a:eq(0)").focus();	
			}else{
				var ol = me.closest('ol');
				var lastA = $('.footer-laypop a:last');
				idx1 = idx1 == -1 ? Number(me.attr('midx')) : idx1;
				
				var foot_layLastA = $('.foot_lay .last a:first'); // 2023 웹접근성 추가
				
				if(me[0] == lastA[0]){
					$('.footer-laypop').hide();
					$('.foot_lay .last a:first').focus();
				}
				// 2023 웹접근성 추가 마지막 기타사이트에서 탭시 개인정보처리방침으로 이동
				else if(me[0] == foot_layLastA[0]){
					$('.footer-laypop').hide();
					$(".foot_link002 .frist a").focus();
					return false;
				}else if(idx2 < 2 && idx4 == idx3_max){
					$(".foot-menu a").eq(idx1 + 1).focus();
				}else{
					return;
				}
			}
			return false;
		});
		
		// 원라운딩골프보험 close시 삭제 처리
		/* $("#lay_calc_pop_golf0906").parent().find(".ui-dialog-buttonset button").click(
				function(){
					setTimeout(function() {
						commStyle.removeJsCssFile('/web/C/cm/css/popup_new.css', 'css');	
					}, 300);	
				}
		); */
		
		var toDate = new Date().format("yyyyMMdd");
		var cookieName = 'null' + toDate;
		console.log("cookieName = " + cookieName + " getCookie = " + getCookie(cookieName));
		
		// 2023.10.10 이미지시스템 고도화 홈페이지 일시 중단 팝업 노출
		var notice20231010Yn = false;
		console.log("notice20231010Yn = " + notice20231010Yn);
		
		// 이미지시스템 고도화 홈페이지 중단 팝업 호출
		if(notice20231010Yn && 'null' != null && 'null' == 'true' && getCookie(cookieName) != 'Y') {
			$("#lay_calc_pop_notice20231010").dialog('open');
		}

	});

// 쿠키 설정
function setCookie( name, value, expiredays ) { 
	var todayDate = new Date(); 
	todayDate.setDate( todayDate.getDate() + expiredays ); 
	document.cookie = name + "=" + escape( value ) + "; path=/; expires=" + todayDate.toGMTString() + ";" 
}

//쿠키 검사 함수 정의
function getCookie(name) {
	var prefix = name + "=";
	var cookieStartIndex = document.cookie.indexOf(prefix);
	if (cookieStartIndex == -1) return null;
	var cookieEndIndex = document.cookie.indexOf(";", cookieStartIndex + prefix.length);
	if (cookieEndIndex == -1) cookieEndIndex = document.cookie.length;
	return unescape(document.cookie.substring(cookieStartIndex + prefix.length, cookieEndIndex));
}	
	
/********************* 팝업관련 시작 *********************/
	
function openMainPopUp(uRL, popWidth, popHeight, title, opt, winLeft, winTop) {
	var wid;
	var winWidth = popWidth;
	var winHeight = popHeight;
	var winURL = uRL;
	var winName = title;
	var winPosLeft = ((screen.width - winWidth) / 2) - 240;
	var winPosTop = (screen.height - winHeight) / 2;

	if(winLeft){ winPosLeft = winLeft; }
	if(winTop){ winPosTop = winTop; }

	var winOpt = "width=" + winWidth + ",height=" + winHeight + ",top=100, left=150";
	if (opt == '') {
		winOpt = winOpt + ", scrollbars=yes,resizable=yes";
	} else {
		winOpt = winOpt + ", " + opt;
	}
	return window.open(winURL, winName, winOpt);
}

//팝업정보
function openPopUp(uRL, popWidth, popHeight, title, opt) {
    var wid;
    var winWidth = popWidth;
    var winHeight = popHeight;
    var winURL = uRL;
    var winName = title;
    var winPosLeft = (screen.width - winWidth) / 2;
    var winPosTop = (screen.height - winHeight) / 2;
    var winOpt = "width=" + winWidth + ",height=" + winHeight + ",top=" + winPosTop + ",left=" + winPosLeft;
    if (opt == '') {
        winOpt = winOpt + ", scrollbars=yes,resizable=yes";
    } else {
        winOpt = winOpt + ", " + opt;
    }
    return window.open(winURL, winName, winOpt);
}

function fnMovePage()
{
    openPopUp('http://www.lotteins.co.kr/web/C/D/popup/mobile_20160225.html',745, 780, '', '');
}

