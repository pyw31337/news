document.write("<script type=\"text/javascript\" src=\"" + "/anysign/anySign4PCInterface.js" + "?version=" + new Date().getTime() + "\"></scr"+"ipt>");

(function(){
	
	var platform = navigator.platform.toLowerCase();
	var macfilter ="mac|macintel";
	
	function callMac(){ //mac인경우		
		
		if(macfilter.indexOf(platform)> -1){
			var exist = false;
			var scripts = document.getElementsByTagName("script");
			
			for (var i= 0 ; i < scripts.length; i++){
				if(scripts[i].src && scripts[i].src.indexOf("nppfs-1.13.0.js") > -1){
					exist = true;
					break;
				}
			}
			if(!exist){
				var nppscript = document.createElement("script");
				nppscript.src="/inca/nppfs-1.13.0.js";		
				
				document.head.appendChild(nppscript);		
			}			
		}
	}
	if(typeof window.jQuery !=='undefined'){
		callMac();
	}else{ // jquery 없는경우
		if(macfilter.indexOf(platform)> -1){
			var script = document.createElement("script");
			script.src="/web/C/cm/js/jquery-3.5.0.min.js";
			script.load = callMac;
			script.onerror = function(){
			//	console.error("jquery 실패");
			}
			document.head.appendChild(script);
		}
	}
})();
</script>

