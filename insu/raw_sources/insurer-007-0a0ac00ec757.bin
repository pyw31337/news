<style>
.ip_check {vertical-align:-2px;border-color:#8e8f8f}
.popcheck {background:#525252;position:relative;height:32px;color:#fff;vertical-align:middle;line-height:32px;padding-left:11px}
.popcheck * {vertical-align:middle;line-height:22px}
.popcheck .bt_close {position:absolute;right:10px;top:4px;}
</style>
<div id="lay_calc_pop_notice20231010" class="ly-pop popwrap_500_ins" style="background:#525252; display:none;">
	<ul class="" id="slides_pop" style="width:0px;height: 0px;">
		<li>
			<div class="blind">
				이미지시스템 고도화 홈페이지 일시 중단 안내
			</div>
			<!-- img src="/web/C/images/event/ins_main_notice20231010.jpg" alt="이미지시스템 고도화 홈페이지 일시 중단 안내" /-->
		</li>
	</ul>	
	<p class="popcheck" style="margin:0;margin-top:0px;">
		<input type="checkbox" class="ip_check" id="chk_not_domain_ins_notice_01"> 
		<label for="chk_not_domain_ins_notice_01">오늘 다시보기 않기</label>
		<a id="popwrap_500_ins_a_04" href="#" onclick="javascript:$('#lay_calc_pop_notice20231010').dialog('close');" class="bt_close" title="닫기">
			<img src="/web/C/cm/image/hm/bt/bt_popclose001.gif" alt="close">
		</a>
	</p>
	
	<!--  javascript 영역 시작 -->
<script >

	function setCookie(cName, cValue, cDay){
	     var expire = new Date();
	     expire.setDate(expire.getDate() + cDay);
	     cookies = cName + '=' + escape(cValue) + '; path=/ '; // 한글 깨짐을 막기위해 escape(cValue)를 합니다.
	     if(typeof cDay != 'undefined') cookies += ';expires=' + expire.toGMTString() + ';';
	     document.cookie = cookies;
	}
	
	function getCookie(cName) {
	     cName = cName + '=';
	     var cookieData = document.cookie;
	//alert(cookieData);     
	     var start = cookieData.indexOf(cName);
	     var cValue = '';
	     if(start != -1){
	          start += cName.length;
	          var end = cookieData.indexOf(';', start);
	          if(end == -1)end = cookieData.length;
	          cValue = cookieData.substring(start, end);
	     }
	     return unescape(cValue);
	}
		
	function deleteCookie( cName ){
		var expireDate = new Date();
		//어제 날짜를 쿠키 소멸 날짜로 설정한다.
		expireDate.setDate( expireDate.getDate() - 1 );
		document.cookie = cName + "= " + "; expires=" + expireDate.toGMTString() + "; path=/";
	}

	$(document).ready(function () {
		try{
			$('#chk_not_domain_ins_notice_01').bind("click", function(){ 
				var chk_not_domain_ins = document.getElementById("chk_not_domain_ins_notice_01");
				var toDate = new Date().format("yyyyMMdd");
				var cookieName = 'null' + toDate;
				if(chk_not_domain_ins.checked){
					setCookie(cookieName, "Y", 1);
				}else{
					deleteCookie(cookieName);
				}
			});
			
			setTimeout(function(){
				$("#popwrap_500_ins_a_04").focus();
			}, 300);
		}catch(e){}
	});
	
</script>
