	function insuranceSearch() {
		var frm = document.myform;

		var prdNm = frm.srcPrdNm.value;

		if(prdNm == ""){
			alert ("상품을 입력해 주세요");
			frm.srcPrdNm.focus();
			return;
		}

		frm.task.value = "searchKey";
		frm.ops_tc.value = "dfi.c.d.g.cmd.Cdg079Cmd";
		frm.rtnUri.value = "/web/C/D/H/cdh190_result.jsp";
		frm.target = "common";
		frm.submit();
	}

	function procTask(issale) {
		var frm = document.myform;

		frm.issale.value = issale;
		document.getElementById("step2view").innerHTML="";
		document.getElementById("step3view").innerHTML="";
		document.getElementById("step4view").innerHTML="<dl class='pro_select'><dt>상품명</dt><dd><span><br></span></dd><dt class='pt20'>판매기간</dt><dd><span><br></span></dd></dl><ul class='pdf_btn'><li><img src='/web/C/images/com/btn/btn_cdh_pdf01.gif' alt='사업방법서'></li><li>	<img src='/web/C/images/com/btn/btn_cdh_pdf02.gif' alt='상품요약서'></li><li><img src='/web/C/images/com/btn/btn_cdh_pdf03.gif' alt='약관'></li></ul>";


		$("#cur0").removeClass("current");
		$("#cur1").removeClass("current");

		$("#addb0").removeClass("on");
		$("#addd0").removeClass("on");
		for(var i=0; i<=12; i++){
			$("#adda"+i).removeClass("on");
			$("#addc"+i).removeClass("on");
		}


		if(issale=="Y"){
			$("#cur0").addClass("current");
		}else{
			$("#cur1").addClass("current");
		}
	}


	function classchkStep2(val, size){
		for(var i=0; i<size; i++){
			if(i!=val){
				$("#adde"+i).removeClass("on");
			}
			if(i==val){
				$("#adde"+i).addClass("on");
			}
		}
	}

	function classchkStep3(val, size){
		for(var i=0; i<size; i++){
			if(i!=val){
				$("#addf"+i).removeClass("on");
			}
			if(i==val){
				$("#addf"+i).addClass("on");
			}
		}
	}

	function step2(lcode, mcode, val, gubun){
		var frm = document.myform;

		if(gubun == "1"){
			$("#addb0").removeClass("on");
