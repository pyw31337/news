		if(gubun == "3"){
			$("#addb0").removeClass("on");
			$("#addd0").removeClass("on");
			for(var i=0; i<=12; i++){
				if(i!=val){
					$("#adda"+i).removeClass("on");
					$("#addc"+i).removeClass("on");
				}
				if(i==val){
					$("#addc"+i).addClass("on");
				}
			}
		}

		if(gubun == "4"){
			$("#addb0").removeClass("on");
			$("#addd0").removeClass("on");
			for(var i=0; i<=12; i++){
				if(i!=val){
					$("#adda"+i).removeClass("on");
					$("#addc"+i).removeClass("on");
				}
				if(i==val){
					$("#addd0").addClass("on");
				}
			}

		}


		frm.lcode.value = lcode;
		frm.mcode.value = mcode;
		if(frm.issale.value=="Y"){
			frm.task.value = "gostep2issale";
		}else{
