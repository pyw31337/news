<script type="text/javascript">
//페이지에 들어갈 스크립트
var oldVal = '';
var completePos = -99;
var completeTime;
$(document).ready(function() {
	$('div[name=search_tab_new] ul.tabs').each(function(){
		// For each set of tabs, we want to keep track of
		// which tab is active and it's associated content
		var $active, $content, $links = $(this).find('a');

		// If the location.hash matches one of the links, use that as the active tab.
		// If no match is found, use the first link as the initial active tab.
		$active = $($links.filter('[href="'+location.hash+'"]')[0] || $links[0]);
		$active.addClass('active');
		$active.closest('li').addClass('current');

		$content = $($active[0].hash);

		// Hide the remaining content
		$links.not($active).each(function () {
			$(this.hash).hide();
		});

		// Bind the click event handler
		$('div[name=search_tab_new] ul.tabs a span').off('click');
		$('div[name=search_tab_new] ul.tabs a').on('click', function(e){
		//$(this).on('click', 'a', function(e){
			// Make the old tab inactive.
			$active.removeClass('active');
			$active.closest('li').removeClass('current');
			$content.hide();

			// Update the variables with the new link and content
			$active = $(this);
			$content = $(this.hash);

			// Make the tab active.
			$active.addClass('active');
			$active.closest('li').addClass('current');
			$content.show();
			
			// Prevent the anchor's default click action
			e.preventDefault();
		});
	});
		
	// onChagne event
	setOnChange();
	
	// OnMouseLeave
	setOnMouseLeave();
	
});

//자동완성 
function fn_change(){
	
	document.search_form.pageTypeCd.value = "getComplete";
	
	AjaxUtil.callAjax("/CChannelSvl","POST", $("form[name='search_form']").serialize(),"json"
   		 , function(data) {
			//console.log(data);
			
			var json = JSON.parse(data.result);
			var code = json.code;
			//console.log("code = " + code);
			
			// 1이 성공
			if(code == 1) {
				$("#complete").empty();				
				
				var jsonData = json.data;
				
				var count = jsonData.count;
				
				if(count > 0) {
					$("#div_complete").show();
				}
				
				var list = jsonData.list;
				
				for(var i = 0; i < count; i++) {
					var tmpStr = "";
					tmpStr += "<li style='cursor:pointer;' onclick=javascript:fn_search(";
					tmpStr += "'" + list[i].KEYWORDS + "'";
					tmpStr += ");>";
					tmpStr += list[i].KEYWORDS; 
					tmpStr += "</li>";
					$("#complete").append(tmpStr);
				}
			}
		}, false, false
	);
}

// 검색 시작
function fn_search(searchWord) {
	allClear();
	document.search_form.searchWord.value = searchWord;
	fn_topSearch();
}

// 검색 관련 초기화
function allClear(){
	document.search_form.menuPerPage.value = 5;
	document.search_form.faqPerPage.value = 5;
	document.search_form.contentsPerPage.value = 5;
	
	$("#search_tab1").click();
	
	$("#menu_dtl").empty();
	$("#faq_dtl").empty();
	$("#content_dtl").empty();
	
	$("#menu_dtl_tab").empty();
	$("#faq_dtl_tab").empty();
	$("#content_dtl_tab").empty();
}

// 최초 초기화
function search_init(){
	allClear();
	
	// 자동완성 초기화
	$("#complete").empty();
	$("#div_complete").hide();
	
	// 검색결과 숨김
	$("#search_result").hide();
	$("#total_srch").css("height", "")
	$("#searchWordTitle").html("");
	$("#searchWordTotlCnt").html("");
	$("p[name=menu_cnt]").html("");
	$("p[name=faq_cnt]").html("");
	$("p[name=content_cnt]").html("");
	
	// 검색어 초기화
	$("#searchTerm").val('');
	
}

// 키입력 체크
function setOnChange(){
	$("#searchTerm").on("propertychange change keyup paste input",  function(){
		
		if($(this).val().length == 0) {
			$("#complete").empty();
			$("#div_complete").hide();
			return false;
		}	
	
		var currentVal = $(this).val();
		if(currentVal == oldVal) {
			return;
		}
		if(completePos == -99) {
			oldVal = currentVal;
			fn_change();
		}
	});
}

// mouseover에 자동완성 삭제
function setOnMouseLeave(){
	$("#div_complete").on("mouseleave", function(){

		if(completeTime) {
			clearTimeout(completeTime);	
		}
		completePos = -99;
		
		$("#complete").empty();
		$("#div_complete").hide();
	});
}

//엔터 이벤트
function fn_SearchEnter(event, thisform) {
	
	//console.log("$(thisform).length = " + $(thisform).length);
	
	if($(thisform).length == 0) {
		return false;
	}
		
	var keyCode = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
	if (keyCode == 13) { // 엔터키
		fn_search(document.search_form.searchWord.value);
		event.preventDefault();
		return false;
	} else {
		return true;
	}
}

function fn_keyDown(event, thisform){

	var keyCode = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
	if(keyCode == 38){ // 키보드 UP
		
		if(completeTime) {
			clearTimeout(completeTime);	
		}
		var totLiTagCnt = $("#complete li").length;
		
		if(totLiTagCnt > 0) {
			if(completePos == -99 || completePos == -1) {
				completePos = totLiTagCnt-1;
			}
			else if(completePos > -1){
				completePos = completePos-1;	
			}
			console.log("keyup completePos = " + completePos);
			var liTag = $("#complete li:eq(" + completePos + ")");
			console.log("keyup liTag.html = " + liTag.html());
			$("#searchTerm").val(liTag.html());
			
			if(completePos == 0) {
				completePos = totLiTagCnt-1;
			}
			completeTime = setTimeout(function(){
				console.log("keyup setTimeout");
				completePos = -99;
			}, 2000);
		}
	} else if(keyCode == 40) { // DOWNKEY: 40
		
		if(completeTime) {
			clearTimeout(completeTime);	
		}
		var totLiTagCnt = $("#complete li").length;
		if(totLiTagCnt > 0) {
			if(completePos == -99) {
				completePos = 0;
			}
			else {
				completePos = completePos+1;	
			}
			
			console.log("keydown completePos = " + completePos);
			var liTag = $("#complete li:eq(" + completePos + ")");
			console.log("keydown liTag.html = " + liTag.html());
			$("#searchTerm").val(liTag.html());
			
			console.log("totLiTagCnt = " + totLiTagCnt);
			
			if(completePos == (totLiTagCnt-1)) {
				completePos = -1;
			}
			completeTime = setTimeout(function(){
				console.log("keydown setTimeout");
				completePos = -99;
			}, 2000);
		}
	} else {
		return true;
	}
}

// 검색 시작
function fn_topSearch(){

	faqCnt = 0;
	menuCnt = 0;
	contentCnt = 0;
	
	document.search_form.pageTypeCd.value = "getTotalResult";
	
	AjaxUtil.callAjax("/CChannelSvl","POST", $("form[name='search_form']").serialize(),"json"
   		 , function(data) {
		//console.log(data);
   			var json = JSON.parse(data.result);
			var code = json.code;
			
			// 1이 성공 
			if(code == 1) {

				$("#complete").empty(); // 자동완성 단어 초기화 
				$("#div_complete").hide(); // 자동완성 hide
				$("#searchTerm").blur(); // 포커스 해지
				
				// 타이틀 검색어
				$("#searchWordTitle").html(document.search_form.searchWord.value);
				
				var jsonData = json.data;
				
				var faqCnt = jsonData.count.faq;
				var menuCnt = jsonData.count.menu;
				var contentCnt = jsonData.count.contents;
				var totalCnt = Number(faqCnt)+Number(menuCnt)+Number(contentCnt);
				
				$("#searchWordTotlCnt").html("총 " + totalCnt + " 건");
				
				$("p[name=menu_cnt]").html("메뉴 (총" + menuCnt + "건)");
				$("p[name=faq_cnt]").html("자주하는 질문(FAQ) (총" + faqCnt + "건)");
				$("p[name=content_cnt]").html("본문내용 (총" + contentCnt + "건)" );
				
				var faqList = jsonData.list.faq;
				var menuList = jsonData.list.menu;
				var contentList = jsonData.list.contents;
				
				$("#menu_dtl").empty();
				if(menuCnt == 0) {
					$("#menu_dtl").html("<li>검색결과가 없습니다.</li>");
				}
				else {
					for(var i = 0; i < menuCnt; i++) {
						var tmpStr = "";
						if(typeof menuList[i] != 'undefined') {
							
							if( i == 0 ) {
								tmpStr += "<li style='cursor:pointer;' onclick=javascript:goMovePage(";	
							}
							else {
								tmpStr += "<li style='cursor:pointer;margin-top:5px' onclick=javascript:goMovePage(";
							}
							
							// 값이 비어있는 경우는 보험서비스안내 관련
							if(menuList[i].PGMURL == '') {
								menuList[i].SERVICENM = "/CChannelSvl";
								menuList[i].CMDNM = "dfi.c.cm.CFrontCmd";
								menuList[i].PGMURL = "/web/C/D/A/cda020.jsp?prdtseq=" + menuList[i].SEQ;
							}
							
							tmpStr += "'" + menuList[i].SERVICENM + "'" + ","; // /CChannelSvl
							tmpStr += "'" + menuList[i].CMDNM + "'" + ","; // dfi.c.cm.CFrontCmd
							tmpStr += "'" + menuList[i].PGMURL + "'" + ","; // /web/C/D/A/cda020.jsp
							tmpStr += "'" + menuList[i].WORKNM + "'" + ","; // ''
							tmpStr += "'" + menuList[i].SEQ + "'" + ","; // 83 (SEQ)
							tmpStr += "'" + menuList[i].PGMSEQ + "'" + ","; // '1004001'
							tmpStr += "'" + menuList[i].UPPGMSEQ + "'" + ","; // '100400'
							tmpStr += "'" + menuList[i].ATTRIBUTE1 + "'" + ","; // 'LINKTYPE02'
							tmpStr += "'" + menuList[i].ATTRIBUTE2 + "'" + ");>"; // ''
							tmpStr += menuList[i].PGMNM; // 국내여행보험
							tmpStr += "</li>";
							$("#menu_dtl").append(tmpStr);
						}
					}
				}
				
				$("#faq_dtl").empty();
				if(faqCnt == 0){
					$("#faq_dtl").html("<div>검색결과가 없습니다.</div>");
				}
				else {
					for(var i = 0; i < faqCnt; i++) {
						var tmpStr = "";
						if(typeof faqList[i] != 'undefined') {
							//console.log("faqList[i] = " + faqList[i]);
							tmpStr += "<dt style='cursor:pointer;' onclick='view_detail(this," + i + "); return false;'>";
							tmpStr += faqList[i].TTL;
							tmpStr += "<button type='button' class='srch_btn_open fr'></button>";
							tmpStr += "</dt>"
							tmpStr += "<dd name='detail_" + i + "'" + "style='display:none;'>";
							tmpStr += faqList[i].CNTNT;
							tmpStr += "</dd>"
							$("#faq_dtl").append(tmpStr);
						} 				
					}
				}
				
				$("#content_dtl").empty();
				if(contentCnt == 0){
					$("#content_dtl").html("<div>검색결과가 없습니다.</div>");
				}
				else {
					for(var i = 0; i < contentCnt; i++) {
						var tmpStr = "";
						if(typeof contentList[i] != 'undefined') {
							//console.log("faqList[i] = " + faqList[i]);
							tmpStr += "<dt style='cursor:pointer;' onclick=javascript:goMovePage(";
							tmpStr += "'" + contentList[i].SERVICENM + "'" + ","; // /CChannelSvl
							tmpStr += "'" + contentList[i].CMDNM + "'" + ","; // dfi.c.cm.CFrontCmd
							tmpStr += "'" + contentList[i].JSPPATH + "'" + ","; // /web/C/D/A/cda020.jsp
							tmpStr += "'" + contentList[i].WORKNM + "'" + ","; // ''
							tmpStr += "'" + contentList[i].SEQ + "'" + ","; // 83 (SEQ)
							tmpStr += "'" + contentList[i].PGMSEQ + "'" + ","; // '1004001'
							tmpStr += "'" + contentList[i].UPPGMSEQ + "'" + ","; // '100400'
							tmpStr += "'" + contentList[i].ATTRIBUTE1 + "'" + ","; // 'LINKTYPE02'
							tmpStr += "'" + contentList[i].ATTRIBUTE2 + "'" + ");>"; // ''
							tmpStr += contentList[i].JSPTITLE;
							tmpStr += "</dt>"
							tmpStr += "<dd>";
							tmpStr += tagReplace(contentList[i].ATTACH_JSPPATH);
							tmpStr += "</dd>"
							$("#content_dtl").append(tmpStr);
						} 				
					}
				}
				
				$("#search_result").show();
				$("#total_srch").css("height", "100%")
				$(".loadingWrap_search").removeClass("on");
			}
			else {
				$("#search_result").hide();
				$("#total_srch").css("height", "")
				$(".loadingWrap_search").addClass("on");
			}
	}
	);
}

// FAQ 상세보기
function view_detail(obj, index) {
	var tagName = $(obj).prop('tagName');
	var btnObj = $(obj);
	
	if(tagName == 'DT') {
		btnObj = $(obj).find('button');
	}
	
	if(btnObj.hasClass("srch_btn_open_on")) {
		btnObj.removeClass("srch_btn_open_on");
		btnObj.addClass("srch_btn_open");
		
		$('dd[name=detail_' + index + ']').hide();		
	}
	else if(btnObj.hasClass("srch_btn_open")) {
		btnObj.removeClass("srch_btn_open");
		btnObj.addClass("srch_btn_open_on");
		$('dd[name=detail_' + index + ']').show();
	}
}

// 탭 선택시 검색
function tabSearch(obj) {
/* 	console.log("obj.attr('id' = " + $(obj).attr('id'));
	console.log("$('#menu_dtl_tab li').length = " + $("#menu_dtl_tab li").length);
	console.log("$('#faq_dtl_tab dt').length = " + $("#faq_dtl_tab dt").length);
	console.log("$('#content_dtl_tab dt').length = " + $("#content_dtl_tab dt").length);
 */	
	var bodyHeigth = $("body").css("height");
//	console.log("$('body').css('height')" + bodyHeigth);
	$("#search_result").css("height", bodyHeigth);
	$("html").css("overflow", "hidden");

	// 2022상반기 웹접근성
	$(".customer_tab .tabmenu_lt li a").each(function(){

		var title = $(this).attr('title');
		
		if(title !== undefined && title != '') {
			$(this).attr('title', title.replace(' 선택됨', ''));
		}
		
		if($(obj).attr('id') == $(this).attr('id')) {
			$(this).attr('title', $(this).attr('title') + ' 선택됨');
		}
	});
	
	// 메뉴
	if($(obj).attr('id') == 'search_tab2' && $("#menu_dtl_tab li").length == 0) {
		
		var menuPerPage = document.search_form.menuPerPage.value;
		var menuAllCnt = fnInterger($("p[name=menu_cnt]").html());
	
		if(Number(menuAllCnt) > Number(menuPerPage)) {
			
			document.search_form.menuPerPage.value = menuAllCnt;
			document.search_form.pageTypeCd.value = "getMenuResult";
			
			AjaxUtil.callAjax("/CChannelSvl","POST", $("form[name='search_form']").serialize(),"json"
		   		 , function(data) {
				//console.log(data);
		   			var json = JSON.parse(data.result);
					var code = json.code;
					
					// 1이 성공 
					if(code == 1) {

						var jsonData = json.data;
						
						var menuCnt = jsonData.count.menu;
						var menuList = jsonData.list.menu;
						
						//$("#menu_dtl_tab").append($("#menu_dtl").html());
						$("#menu_dtl_tab").empty();
						if(menuCnt == 0) {
							tmpStr += "<li>검색결과가 없습니다.</li>";
							$("#menu_dtl_tab").html(tmpStr);
						}
						else {
							for(var i = 0; i < menuCnt; i++) {
								var tmpStr = "";
								if(typeof menuList[i] != 'undefined') {
									
									if( i == 0 ) {
										tmpStr += "<li style='cursor:pointer;' onclick=javascript:goMovePage(";	
									}
									else {
										tmpStr += "<li style='cursor:pointer;margin-top:5px' onclick=javascript:goMovePage(";
									}
									
									// 값이 비어있는 경우는 보험서비스안내 관련
									if(menuList[i].PGMURL == '') {
										menuList[i].SERVICENM = "/CChannelSvl";
										menuList[i].CMDNM = "dfi.c.cm.CFrontCmd";
										menuList[i].PGMURL = "/web/C/D/A/cda020.jsp?prdtseq=" + menuList[i].SEQ;
									}
									
									tmpStr += "'" + menuList[i].SERVICENM + "'" + ","; // /CChannelSvl
									tmpStr += "'" + menuList[i].CMDNM + "'" + ","; // dfi.c.cm.CFrontCmd
									tmpStr += "'" + menuList[i].PGMURL + "'" + ","; // /web/C/D/A/cda020.jsp
									tmpStr += "'" + menuList[i].WORKNM + "'" + ","; // ''
									tmpStr += "'" + menuList[i].SEQ + "'" + ","; // 83 (SEQ)
									tmpStr += "'" + menuList[i].PGMSEQ + "'" + ","; // '1004001'
									tmpStr += "'" + menuList[i].UPPGMSEQ + "'" + ","; // '100400'
									tmpStr += "'" + menuList[i].ATTRIBUTE1 + "'" + ","; // 'LINKTYPE02'
									tmpStr += "'" + menuList[i].ATTRIBUTE2 + "'" + ");>"; // ''
									tmpStr += menuList[i].PGMNM; // 국내여행보험
									tmpStr += "</li>";
									$("#menu_dtl_tab").append(tmpStr);
								}
							}
						}
					}
				}
			);
		}
		else {
			$("#menu_dtl_tab").html($("#menu_dtl").html());			
		}
	} 
	// Faq
	else if($(obj).attr('id') == 'search_tab3' && $("#faq_dtl_tab dt").length == 0) {
		
		if( $("#faq_dtl_tab div").length == 1 ) {
			return;
		}
		var faqPerPage = document.search_form.faqPerPage.value;
		var faqAllCnt = fnInterger($("p[name=faq_cnt]").html());
		
		if(Number(faqAllCnt) > Number(faqPerPage)) {
			
			document.search_form.faqPerPage.value = faqAllCnt;
			document.search_form.pageTypeCd.value = "getFaqResult";
			
			AjaxUtil.callAjax("/CChannelSvl","POST", $("form[name='search_form']").serialize(),"json"
		   		 , function(data) {
				//console.log(data);
		   			var json = JSON.parse(data.result);
					var code = json.code;
					
					// 1이 성공 
					if(code == 1) {

						var jsonData = json.data;
						
						var faqCnt = jsonData.count.faq;
						var faqList = jsonData.list.faq;
						
						//$("#faq_dtl_tab").append($("#faq_dtl").html());
						$("#faq_dtl_tab").empty();
						if(faqCnt == 0){
							tmpStr += "<div>검색결과가 없습니다.</div>";
							$("#faq_dtl_tab").html(tmpStr);
						}
						else {
							for(var i = 0; i < faqCnt; i++) {
								var tmpStr = "";
								if(typeof faqList[i] != 'undefined') {
									//console.log("faqList[i] = " + faqList[i]);
									tmpStr += "<dt style='cursor:pointer;' onclick='view_detail(this," + i + "); return false;'>";
									tmpStr += faqList[i].TTL;
									tmpStr += "<button type='button' class='srch_btn_open fr'></button>";
									tmpStr += "</dt>"
									tmpStr += "<dd name='detail_" + i + "'" + "style='display:none;'>";
									tmpStr += faqList[i].CNTNT;
									tmpStr += "</dd>"
									$("#faq_dtl_tab").append(tmpStr);
								} 				
							}
						}
					}
				}
			);
		}
		else {
			$("#faq_dtl_tab").html($("#faq_dtl").html());
		}
	}
	// 본문내용
	else if($(obj).attr('id') == 'search_tab4' && $("#content_dtl_tab dt").length == 0 ) {
		
		if( $("#content_dtl_tab div").length == 1 ) {
			return;
		}
		
		var contentsPerPage = document.search_form.contentsPerPage.value;
		var contentAllCnt = fnInterger($("p[name=content_cnt]").html());
		
		if(Number(contentAllCnt) > Number(contentsPerPage)) {
			
			document.search_form.contentsPerPage.value = contentAllCnt;
			document.search_form.pageTypeCd.value = "getContentsResult";
			
			AjaxUtil.callAjax("/CChannelSvl","POST", $("form[name='search_form']").serialize(),"json"
		   		 , function(data) {
				//console.log(data);
		   			var json = JSON.parse(data.result);
					var code = json.code;
					
					// 1이 성공 
					if(code == 1) {

						var jsonData = json.data;
						
						var contentCnt = jsonData.count.contents;
						var contentList = jsonData.list.contents;
						
						//$("#content_dtl_tab").append($("#content_dtl").html());
						$("#content_dtl_tab").empty();
						if(contentCnt == 0){
							$("#content_dtl_tab").html("<div>검색결과가 없습니다.</div>");
						}
						else {
							for(var i = 0; i < contentCnt; i++) {
								var tmpStr = "";
								if(typeof contentList[i] != 'undefined') {
									//console.log("faqList[i] = " + faqList[i]);
									tmpStr += "<dt style='cursor:pointer;' onclick=javascript:goMovePage(";
									tmpStr += "'" + contentList[i].SERVICENM + "'" + ","; // /CChannelSvl
									tmpStr += "'" + contentList[i].CMDNM + "'" + ","; // dfi.c.cm.CFrontCmd
									tmpStr += "'" + contentList[i].JSPPATH + "'" + ","; // /web/C/D/A/cda020.jsp
									tmpStr += "'" + contentList[i].WORKNM + "'" + ","; // ''
									tmpStr += "'" + contentList[i].SEQ + "'" + ","; // 83 (SEQ)
									tmpStr += "'" + contentList[i].PGMSEQ + "'" + ","; // '1004001'
									tmpStr += "'" + contentList[i].UPPGMSEQ + "'" + ","; // '100400'
									tmpStr += "'" + contentList[i].ATTRIBUTE1 + "'" + ","; // 'LINKTYPE02'
									tmpStr += "'" + contentList[i].ATTRIBUTE2 + "'" + ");>"; // ''
									tmpStr += contentList[i].JSPTITLE;
									tmpStr += "</dt>"
									tmpStr += "<dd>";
									tmpStr += tagReplace(contentList[i].ATTACH_JSPPATH);
									tmpStr += "</dd>"
									$("#content_dtl_tab").append(tmpStr);
								} 	
							}
						}
					}
				}
			);
		}
		else {
			$("#content_dtl_tab").html($("#content_dtl").html());
		}
	}
}

function fnInterger(str){
	var res = str.replace(/[^0-9]/g, "");
	return res;
}

// 인기검색어 가져오기
function getTrend(){
	
	// 인기검색어는 변경 사항이 없어서 최초 한번만 가져옴.
	if($("#trend li").lenght > 1) {
		return;	
	}

	loaderShow();
	
	document.search_form.pageTypeCd.value = "getTrend";
	
	AjaxUtil.callAjax("/CChannelSvl","POST", $("form[name='search_form']").serialize(),"json"
	   		 , function(data) {
		
				loaderHide();
				//console.log("data.result = " + data.result);
				var json = JSON.parse(data.result);
				var code = json.code;
				//console.log("code = " + code);
				
				$("#trend").empty();
				
				// 1이 성공
				if(code == 1) {
					
					$("#trend").append("<li class='title'>인기검색어</li>");
				
					var jsonData = json.data;
					
					var count = jsonData.count;
					
					var list = jsonData.list;
					
					//console.log("list = " + list);
					
					for(var i = 0; i < count; i++) {
						
						var keyword = list[i].KEYWORD.replace(" ", "");
						console.log("keyword = " + keyword);
					
						var tmpStr = "";
						tmpStr += "<li style='cursor:pointer;' onclick=javascript:fn_search(";
						tmpStr += "'";
						tmpStr += keyword;
						tmpStr += "'";
						tmpStr += ");>";
						tmpStr += "<button";
						if(i == (count-1)){
							tmpStr += " id='lastPopularSearch'"
						}
						tmpStr += " onclick=javascript:fn_search('";
						tmpStr += keyword;
						tmpStr += "'";
						tmpStr += ");>";
						tmpStr += keyword;
						tmpStr += "</button>";
						tmpStr += "</li>";
						$("#trend").append(tmpStr);
					}
					
					//2022 웹접근성
					$("#lastPopularSearch").focusout(function(e){
						$("#searchmain").children('a').focus();
					});
				}
			}
		);
}

function tagReplace(ATTACH_JSPPATH) {
	var replaceTag = ATTACH_JSPPATH.replace("\" target=\"_blank\">','', ''); \">", "");
	replaceTag = replaceTag.replace("selected value=''", "");
	replaceTag = replaceTag.replace(" \" > \" >", "");
	replaceTag = replaceTag.replace(" \" > ','');\" title=\"\" > \" > ','')\" title=\"\" >", "");
	replaceTag = replaceTag.replace("class=\"nb0\"  > ','', , 1);\">", "");
	 
	return replaceTag;
}

