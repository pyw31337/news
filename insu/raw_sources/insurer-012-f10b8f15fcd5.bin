					<dd class="p_name"><@=info.sPrdNm @></dd>
				</dl>
				<dl>
					<dt>판매기간</dt>
					<dd class="p_name"><@=fmt.date(info.sSaleStrDt)@> ~ <@=info.sSaleEndDt.startsWith('9999') ? '현재' : fmt.date(info.sSaleEndDt) @></dd>
				</dl>
		</div>
		
		<div class="btn_group">
				<a class="btn" href="/download/<@=info.sPolicyFileID @>" target="_blank" title="새창">약관</a>
			<@ if($.trim(info.sBizFileID) != '') { @>
				<a class="btn" href="/download/<@=info.sBizFileID @>" target="_blank" title="새창">사업방법서</a>
			<@ } @>
			<@ if($.trim(info.sSummaryFileID) != '') { @>
				<a class="btn" href="/download/<@=info.sSummaryFileID @>" target="_blank" title="새창">상품요약서</a>
			<@ } @>
