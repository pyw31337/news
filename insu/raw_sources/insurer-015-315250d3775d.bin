	//페이징
	function drawPageNevArea(data){
		var str = "";

		str += "<div class=\"nav prev\">";
		str += "<a href=\"javascript:;\" onclick=\"movePage(1)\" role=\"button\" class=\"bt prev end\"><i class=\"blind\">처음 페이지</i></a>";
		if(data.scrCurPage > 1){ //현재페이지가 1보다 크면 이전페이지 이동 버튼에 현재페이지-1 세팅
			str += "<a href=\"javascript:;\" onclick=\"movePage("+ (data.scrCurPage-1) +")\" role=\"button\" class=\"bt prev\"><i class=\"blind\">이전 페이지</i></a>";
		}else{ //현재페이지가 1이면 이전페이지 이동 버튼에 1로 세팅
			str += "<a href=\"javascript:;\" onclick=\"movePage(1)\" role=\"button\" class=\"bt prev\"><i class=\"blind\">이전 페이지</i></a>";
		}
		str += "</div>";
		str += "<div class=\"link\">";
		for(var i=data.startNumber ; i<=data.endNumber ; i++){
			if(i == data.scrCurPage){ //현재페이지 버튼 활성화
				str += "<a href=\"javascript:;\" role=\"button\" class=\"bt active\"><i class=\"n\">"+i+"</i> <i class=\"blind\">번째 페이지</i></a>";

			}else{
				str += "<a href=\"javascript:;\" onclick=\"movePage('"+i+"')\" role=\"button\" class=\"bt\"><i class=\"n\">"+i+"</i> <i class=\"blind\">번째 페이지</i></a>";
			}
		}
		str += "</div>";
		str += "<div class=\"nav next\">";
		if(data.scrCurPage == data.totPageCnt){ //현재페이지와 총페이지갯수가 같으면 총페이지갯수로 세팅
			str += "<a href=\"javascript:;\" onclick=\"movePage("+data.totPageCnt+")\" role=\"button\" class=\"bt next\"><i class=\"blind\">다음 페이지</i></a>";
		}else{
			str += "<a href=\"javascript:;\" onclick=\"movePage("+ (data.scrCurPage+1) +")\" role=\"button\" class=\"bt next\"><i class=\"blind\">다음 페이지</i></a>";
		}
		str += "<a href=\"javascript:;\" onclick=\"movePage("+data.totPageCnt+")\" role=\"button\" class=\"bt next end\"><i class=\"blind\">마지막 페이지</i></a>";
		str += "</div>";

		$("#pageNevArea").empty();
		$("#pageNevArea").append(str);
	}

	function movePage(v){
		currentPage__ = v;
		searchList();
	}

	//파일다운로드
	function fileDownload(fileName){
		$("#rDownload").empty();

		fileName = encodeURI(fileName);

		//파일 다운로드 element 생성
		let fn = fileName.substring(fileName.indexOf("_")+1);
		var url = apiUrl__+"/file/ajax/download?fName=/dtc/pdf/mm/"+fileName;
		var lnk = document.createElement('a');
		lnk.href = url;

		$("#rDownload").append(lnk);
		lnk.click();

		$("#rDownload").empty();
	}

	//상품군 목록 이동
	function movePdtDetail(isPdtCd){
		location.href="/dgt/web/dtp/insurance-detail?isPdtCd="+isPdtCd;
	}

	function donSelCheckAlert(){
		ui.alert("판매중지된 상품입니다.",{
		    ycb:function(){

		    },
		    ybt:"확인"
		});
	}

