	<script>
	var currentPage__ = 1;
	var pagePerSize__ = 10;
	var pageNumber__ = 10; //1~10, 11~20 보여주는 페이지nav 갯수
	var deviceDv__ = "pc";

	let Com = {
		OnReadyAction : function(){},
		BackBtnAction : function(){}
	}

	$(function(){
		searchList();

		//엔터키적용
		$('#input-01').keyup(function($key){
			if($key.keycode == 13 || $key.which == 13) {
				$('#searchBtn').trigger("click");
			}
		});

		//검색
		$('#searchBtn').on('click', function(){
			currentPage__ = 1;
			searchList();
		});

		//pdf뷰어버튼
		$("#pdfviewerBtn").on('click', function(){
			window.open("http://get.adobe.com/kr/reader/");
		});

	});

	//selectbox settings
	function optionCase(obj){
		let value = obj.value;
		let str = "";

		if(value == "PAMS02"){
			str += "<option value='99'>전체</option>";
			str += "<option value='01'>적격</option>";
			str += "<option value='02'>비적격</option>";
			str += "<option value='03'>계약인수</option>";
			str += "<option value='04'>기타</option>";
		} else if(value == "PAMS04"){
			str += "<option value='99'>전체</option>";
			str += "<option value='01'>재해상해</option>";
			str += "<option value='02'>암/건강</option>";
			str += "<option value='03'>종신/정기</option>";
			str += "<option value='04'>중도부가특약/기타</option>";
		} else if(value == "PAMS05"){
			str += "<option value='99'>전체</option>";
			str += "<option value='01'>보장</option>";
			str += "<option value='02'>저축</option>";
			str += "<option value='03'>연금</option>";
		} else if(value == "PAMS08"){
			str += "<option value='99'>전체</option>";
			str += "<option value='01'>운용관리계약</option>";
			str += "<option value='02'>보험자산관리계약</option>";
		} else {
			if(value == '99')
				str += "<option value='99' selected>전체</option>";
			else
				str += "<option value='99' selected>선택할 항목이 없습니다.</option>";
		}

		$('#select-13').empty();
		$('#select-13').append(str);
		ui.update();

		if(value == "PAMS02" || value == "PAMS04" || value == "PAMS05" || value == "PAMS08" || value == "99"){
			$('.btsel:eq(2)').prop("disabled", false);
		} else {
			$('.btsel:eq(2)').prop("disabled", true);
		}
	}

	function viewCount(obj){
		let value = obj.value;
		pagePerSize__ = value;
		currentPage__ = 1;
		searchList();
	}

	//상품목록조회
	function searchList(){
		let reqData = {
			"dgtPdtAtrDvCd"	: "M",
			"dgtPdtAtrLclCd" : "",
			"dgtPdtAtrMclCd" : $('#select-12').val(),
			"dgtPdtAtrSmclCd" : $('#select-13').val(),
			"saleYn" : $('#select-11').val(),
			"dgtMseAddiPsYn" : "",
			"searchTxt" : $('#input-01').val()
		};
		reqData.currentPage = currentPage__;
		reqData.pagePerSize = pagePerSize__;
		reqData.pageNumber = pageNumber__;
		reqData.deviceDv = deviceDv__;

		kyobo.ajax.json({
			url: "/dtc/product-official/find-allProductSearch",
			data: reqData
		}).then(data=>{
			requestCallBack(data);
		});
	};

	function requestCallBack(resp){
		let list = resp.list;
		let listCnt = resp.listCnt;
		let str = "";

		$('#totalCnt').text(listCnt);

		if(list.length > 0){
			for(let i=0; i<list.length; i++){

// 				if(list[i].dgtPdtAtrNm != null){
					let dgtPdtAtrMclCd = list[i].dgtPdtAtrMclCd;
					let dgtPdtAtrSmclCd = list[i].dgtPdtAtrSmclCd;
					let saleYn = list[i].saleYn;

					if(!dgtPdtAtrSmclCd) dgtPdtAtrSmclCd = "";
					if(!(dgtPdtAtrMclCd == "PAMS02" || dgtPdtAtrMclCd == "PAMS04" || dgtPdtAtrMclCd == "PAMS05" || dgtPdtAtrMclCd == "PAMS06")) dgtPdtAtrSmclCd = "";
					if(dgtPdtAtrMclCd == "PAMS01"){
						dgtPdtAtrMclCd = "교육보험";
						dgtPdtAtrSmclCd = "";
					} else if(dgtPdtAtrMclCd == "PAMS02"){
						dgtPdtAtrMclCd = "연금보험";
						if(dgtPdtAtrSmclCd == "01"){
							dgtPdtAtrSmclCd = "(적격)";
						} else if(dgtPdtAtrSmclCd == "02"){
							dgtPdtAtrSmclCd = "(비적격)";
						} else if(dgtPdtAtrSmclCd == "03"){
							dgtPdtAtrSmclCd = "(계약인수)";
						} else if(dgtPdtAtrSmclCd == "04"){
							dgtPdtAtrSmclCd = "(기타)";
						}
					} else if(dgtPdtAtrMclCd == "PAMS03"){
						dgtPdtAtrMclCd = "저축보험";
						dgtPdtAtrSmclCd = "";
					} else if(dgtPdtAtrMclCd == "PAMS04"){
						dgtPdtAtrMclCd = "보장성보험";
						if(dgtPdtAtrSmclCd == "01"){
							dgtPdtAtrSmclCd = "(재해상해)";
						} else if(dgtPdtAtrSmclCd == "02"){
							dgtPdtAtrSmclCd = "(암/건강)";
						} else if(dgtPdtAtrSmclCd == "03"){
							dgtPdtAtrSmclCd = "(종신/정기)";
						} else if(dgtPdtAtrSmclCd == "04"){
							dgtPdtAtrSmclCd = "(중도부가특약/기타)";
						}
					} else if(dgtPdtAtrMclCd == "PAMS05"){
						dgtPdtAtrMclCd = "기업보험";
						if(dgtPdtAtrSmclCd == "01"){
							dgtPdtAtrSmclCd = "(보장)";
						} else if(dgtPdtAtrSmclCd == "02"){
							dgtPdtAtrSmclCd = "(저축)";
						} else if(dgtPdtAtrSmclCd == "03"){
							dgtPdtAtrSmclCd = "(연금)";
						}
					} else if(dgtPdtAtrMclCd == "PAMS06"){
						dgtPdtAtrMclCd = "통신판매전용상품";
						dgtPdtAtrSmclCd = "";
					} else if(dgtPdtAtrMclCd == "PAMS07"){
						dgtPdtAtrMclCd = "방카슈랑스전용상품";
						dgtPdtAtrSmclCd = "";
					} else if(dgtPdtAtrMclCd == "PAMS08"){
						dgtPdtAtrMclCd = "퇴직연금";
						if(dgtPdtAtrSmclCd == "01"){
							dgtPdtAtrSmclCd = "(운용관리계약)";
						} else if(dgtPdtAtrSmclCd == "02"){
							dgtPdtAtrSmclCd = "(보험자산관리계약)";
						}
					} else if(dgtPdtAtrMclCd == "PAMS09"){
						dgtPdtAtrMclCd = "퇴직보험";
						dgtPdtAtrSmclCd = "";
					} else if(dgtPdtAtrMclCd == "PAMS10"){
						dgtPdtAtrMclCd = "온라인보험";
						dgtPdtAtrSmclCd = "";
					}  else {
						dgtPdtAtrMclCd = "";
						dgtPdtAtrSmclCd = "";
					}

					if(saleYn == 'Y') saleYn = "판매중";
					else saleYn = "판매중지";

					// 상품명 null -> 공백 처리
					var dgtPdtAtrNm = '';
					if (list[i].dgtPdtAtrNm) {
						dgtPdtAtrNm = list[i].dgtPdtAtrNm
					}

					var pdtDesc = null;
					if(list[i].dgtPdtDsc){
						pdtDesc = "\""+list[i].dgtPdtDsc+"\""; //null or "문자열"
					}
// 					if(dgtPdtAtrMclCd != ""){
						str+= "<tr>";
						str+= "<td class='txt-l'>"+ dgtPdtAtrMclCd + dgtPdtAtrSmclCd +"</td>";
						str+= "<td class='txt-l'>"+ dgtPdtAtrNm +"</td>";
						str+= "<td>"+ saleYn +"</td>";
						str+= "<td><button type='button' id='" + list[i].dgtPdtAtrSeqtId +"'class='btn sm' onclick='getProdDtlList(\""+ list[i].dgtPdtAtrSeqtId +"\",\""+ list[i].saleYn +"\",\""+ dgtPdtAtrNm + "\","+pdtDesc+",\""+ list[i].preNnnn+"\",\""+ list[i].endYymmdd +"\",\""+ list[i].dgtMseAddiPsYn +"\",\""+ list[i].dgtPdtCd +"\",\""+ list[i].maxSlsTerm +"\",\""+ dgtPdtAtrMclCd +"\",\""+ dgtPdtAtrSmclCd +"\"); return false;' title='"+dgtPdtAtrNm+"'>확인</button></td>";
						str+= "</tr>";
// 					}
// 				}
			}
		}
		$('#insuList').empty();
		$('#insuList').html(str);

		drawPageNevArea(resp.pageInfo);
	}

	//기간별다운로드 팝업
	function getProdDtlList(dgtPdtAtrSeqtId, saleYn, dgtPdtAtrNm, dgtPdtDsc, preNnnn ,endYymmdd, dgtMseAddiPsYn, dgtPdtCd, maxSlsTerm, dgtPdtAtrMclCd, dgtPdtAtrSmclCd){
		$('#pams').val(dgtPdtAtrMclCd);
		$('#saleYn').val(saleYn);
		$('#preNnnn').val(preNnnn);
		ui.popup.open('pop-period-down',{
			ccb : function(){
				setTimeout(function(){
					$("#" + dgtPdtAtrSeqtId).focus();
			  	}, 10);
			}
		});

		$('#pop-periodColgroup').empty();
		$('#pop-titlNm').text(dgtPdtAtrNm);

		//상품설명 영역 노출/미노출
		if(dgtPdtDsc){
			$("#descArea").show();
			$("#descArea #desc").html(dgtPdtDsc); //상품상세설명
		}else{
			$("#descArea").hide();
			$("#descArea #desc").html(""); //상품상세설명
		}

		let reqData = {
			"dgtPdtPdSeqtId" : dgtPdtAtrSeqtId
		};

		kyobo.ajax.json({
			url: "/dtc/product-official/find-allProductSearchDetail",
			data: reqData
		}).then(data=>{
			requestDtlCallBack(data);
		});
	}

	function requestDtlCallBack(resp){
		let list = resp.list;
		let list2 = resp.list2;
		let pams = $('#pams').val();
