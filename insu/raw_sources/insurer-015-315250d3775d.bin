			}

		} else {
			str += "<col style='width: auto'>";
			str += "<col style='width: 22.5%'>";
			str += "<col style='width: 22.5%'>";

			$('#pop-periodColgroup').html(str);

			str = "";

			str += "<tr>";
			str += "<th scope='col'>판매기간</th>";
			str += "<th scope='col'>약관</th>";
			str += "<th scope='col'>사업방법서</th>";
