<script id="productList"  type="text/template" > 
<@ _.each(list, function(data,i ) { @>
	<tr>
		<td><@=data.sSaleStatus@></td>
		<td><@=data.sInsTypeName@></td>
		<td><a href="#" title="<@=data.sPrdNm@>"><@=data.sPrdNm@></a> </td>
		<td><@=data.sSaleStrDt@></td>
		<td><a href="<@ if(!_.isEmpty(data.sPolicyFileID)) { @>/download/<@=data.sPolicyFileID @><@ } else { @>javascript:alert('파일이 등록되지 않았습니다')<@ } @>" target="_blank" class="new_download" title="다운로드"></a></td>
		<td><a href="<@ if(!_.isEmpty(data.sBizFileID)) { @>/download/<@=data.sBizFileID @><@ } else { @>javascript:alert('파일이 등록되지 않았습니다')<@ } @>" target="_blank" class="new_download" title="다운로드"></a></td>
		<td><a href="<@ if(!_.isEmpty(data.sSummaryFileID)) { @>/download/<@=data.sSummaryFileID @><@ } else { @>javascript:alert('파일이 등록되지 않았습니다')<@ } @>" target="_blank" class="new_download" title="다운로드"></a></td>
	</tr>
<@ }); @>
</script>
<script id="productListEmpty"  type="text/template" >
<tr>
	<td colspan="7">검색결과가 없습니다.</td>
</tr>
</script>

<script>
$(function(){
	
})

var searchParam = {}

$(function(){
	var pageIndex 	=	1;
	var paseSize  	=	10;
	var productArr	=	[];
	
	window.fnSearchProduct	=	function(param){
		
		searchParam.sKeyword 	=	 param.sKeyword;
		
		$('#psKeyword').val(param.sKeyword);
		console.log("@@최초 검색어 : " + param.sKeyword);
		
		srchProductList(pageIndex);
	};
	
	/** 검색 */
	var srchProductList = function(pageIndex) {
		var	sKeyword = $('#psKeyword').val();
		var sSaleYn = $('#sSaleYn').val();
		var sInsType = $('#sInsType').val();
		
		var data = {
				sKeyword 	:  	sKeyword ,
				sSaleYn		:	sSaleYn ,
				sInsType	:	sInsType ,
				page		:	pageIndex ,
				pageSize	:	paseSize
		};
		
		console.log('@@통합검색  Request'  ,data )
		
		api.call({
			data : data,
			url : '/w/disclosure/product/searchProduct.json',	//search
			success : function(data) {
				//search 성공
				var pageInfo = data.page;
				var	list = data.body;
				
				$('.pagingBox').empty();
				var page;
				if(pageInfo.totalRows > 0) {
					//tmpl.append('#targetList', '#productList', { list : list });
					tmpl.insert('#targetList', '#productList', { list : list });
					
					$('.pagingBox').show();
					loadPage(pageInfo);
				} else{
					tmpl.insert('#targetList', '#productListEmpty', {});
					$('.pagingBox').hide();
				}
				//$('#totalRowCnt').text(fmt.number(pageInfo.totalRows));	//텍스트표시
				$('#totalCnt').text(pageInfo.totalRows);
				
				_.each(list, function( o , i ){ productArr.push(o); });
				
			},failure : function(data) {
				msg.warn(data.header.message);
			}
		});
		
	};
	
	/** 검색버튼 */
	$('#pBtnSearch').on('click' , function(){
		var sKeyword = $('#psKeyword').val();
		var sSaleYn = $('#sSaleYn').val();
		var sInsType = $('#sInsType').val();
		
		if( _.isEmpty(sKeyword) ){
			msg.warn('검색어를 입력해 주세요.');
			return ;
		}
		/* if(cmm.isFalse($('[name=rdoPrivacy]:checked').val())) {
			msg.warn('개인(신용)정보 수집 · 이용에 대한 동의에 동의하여 주십시오');
			return;
		} */
		
		srchProductList(pageIndex);
	});
	
	/** 팝업 닫기 */
	$('.modalSearchClose').on('click', function() {
		pop.close('popSaleProductSearch');
		
		$('#sKeyword').val('');
		$('#psKeyword').val('');
		$('#sSaleYn').val('');
		$('#sInsType').val('');
		//$('[name=rdoPrivacy]:checked').checked(false);
	});
	
	$('#btnCounselReq').on('click', function() {
		pop.close('popSaleProductSearch');
		
		$('#sKeyword').val('');
		$('#psKeyword').val('');
		$('#sSaleYn').val('');
		$('#sInsType').val('');
	});

	/** 페이지 로딩 */
	var loadPage = function(pageInfo) {
		var page = new Page({
			pageRows : pageInfo.pageRows,
			currPage : pageInfo.currPage,
			totalRows : pageInfo.totalRows
		}, 'pagingBoxCallback', function(page) {
			srchProductList(page);
		});
		$('.pagingBox').empty().append(page.html(5));
		$('.pagingBox').show();
	}
	
});
</script>

