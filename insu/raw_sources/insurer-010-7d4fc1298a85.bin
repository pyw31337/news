/**
 * 첨부파일 다운로드
 * @param fileId, afileSeqn
 * @since 2014-01-14
 */
function fnFileDownload(fileId, afileSeqn) {
    if (afileSeqn == '') {
        alert('등록된 파일이 없습니다.');
    } else {
        jQuery('#oFileId', jQuery('#oDownloadForm')).val(fileId);
        jQuery("#oAfileSeqn").val(afileSeqn);
        jQuery("#oDownloadForm").attr("action", "/imageView/downloadFile.ajax;jsessionid=7okPF2TYpPWepJXnaVObryoYlm1kyimzFsVVAkxHYLBpovAIT9TXKbvdMJ0z6TX0.nphpws01_servlet_NHpCm01").attr("target", "_self").submit();
    }
}


 






 
/*
 * 상품구분 클릭시 background color 변경
 * @param
 * @since 2014-03-07
 */
function fnSelectedPdtDcdChange(element) {
    jQuery('#oAreaTwo ul li').each(function() {
        jQuery(this).removeClass();
        $(this).find("a").attr("title","");
    });
    jQuery(element).addClass('on');
    $(element).find("a").attr("title","선택됨");
    
}


/*
 * 상품명 클릭시 background color 변경
 * @param
 * @since 2014-03-07
 */
function fnSelectedPdtCdChange(element) {
    jQuery('#oAreaThree ul li').each(function() {
        jQuery(this).removeClass();
        $(this).find("a").attr("title","");
    });
    jQuery(element).addClass('on');
    $(element).find("a").attr("title","선택됨");
    
}


/**
 * 판매중지상품 검색기준 날짜 set
 * @param 
 * @since 2014-02-27
 */
function fnSetBasicDate(date, flag) {
    document.hiddenParameterForm.reset();
    jQuery('#oBasicDate').val(date);
    jQuery('#oFlag').val(flag);
    jQuery('#oHiddenParameterForm').attr('action', '/announce/productAnnounce/retrieveInsuranceProductsAnnounce.nhfire;jsessionid=7okPF2TYpPWepJXnaVObryoYlm1kyimzFsVVAkxHYLBpovAIT9TXKbvdMJ0z6TX0.nphpws01_servlet_NHpCm01').submit();
}


/*
 * 검색어 상품명 조회
 * @param
 * @since 2014-03-07
 */
function fnSearchPdtNm() {
    //jQuery('#oSearchWord').val(jQuery('#oSearchPdtNm').val());
    fnAntiReflectedXSS();
    jQuery('#oHiddenParameterForm').attr('action', '/announce/productAnnounce/retrieveInsuranceProductsAnnounceSearch.nhfire;jsessionid=7okPF2TYpPWepJXnaVObryoYlm1kyimzFsVVAkxHYLBpovAIT9TXKbvdMJ0z6TX0.nphpws01_servlet_NHpCm01').submit();
}


/*
 * ajax callback으로 새로 생성된 element에 click event 할당
 * @param classNm
 * @since 2014-04-03
 */
function fnAddClickEvent(classNm) {
    // ajax callback에서 생성한 element에 click 이벤트 새로 할당
    jQuery('.' + classNm).on('click', function() {
        eval(jQuery(this).attr('onclick'));
    });
}

/**
 * XSS 방지
 * @since 2014-01-27
 */
function fnAntiReflectedXSS() {
    var orgContent = jQuery('#oSearchPdtNm').val();
    var newContent = '';
    newContent = orgContent.replace(/</gi, "&lt;");
    newContent = newContent.replace(/>/gi, "&gt;");
    jQuery('#oSearchWord').val(newContent);
}


