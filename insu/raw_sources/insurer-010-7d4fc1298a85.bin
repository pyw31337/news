<script type="text/javascript">

var clickFlag = 'N';
var seletedPdtCd ='';
var selectedTab = '';
	
jQuery(document).ready(function() {
	
       selectedTab = 'Y';
    var pageCd = '';
    var accessType = '';
    var accessResult = '';
    var flag = '';    
     
    
    if (selectedTab == 'Y') {
        fnChangeTitle('보험상품공시-판매상품');
    } else {
        if (flag == 'A') {
            fnChangeTitle('보험상품공시-판매중지상품 : 2012년3월2일 이후');
        } else {
            fnChangeTitle('보험상품공시-판매중지상품 : 2012년3월1일 이전');
        }
    }
    
    if (pageCd == 'P') {
        fnCheckPage();
    }
    clickFlag ='Y';
    
    if (accessType == 'search' && accessResult == 'success') {
        jQuery('#curtain2').css('display', 'none');
        jQuery('.two').addClass('on');
    } else if (accessType == 'search' && accessResult == 'none') {
        jQuery('#curtain2').css('display', '');
    }

    // 페이지 로딩시 이전 선택한 판매/판매중지상품 탭 활성화
    jQuery('.tabMenu li a').each(function() {
        jQuery(this).parent().removeClass();
        if (jQuery(this).attr('class') == selectedTab) {
            jQuery(this).parent().addClass('on');
        }
    });

    // 판매/판매중지상품 클릭 선택시 탭 활성화
    jQuery('.tabMenu li').click(function() {
        jQuery('li[class="on"]').removeClass();
        jQuery(this).addClass('on');
    });

    // 판매/판매중지 탭 선택에 따라 기준일 show/hide
    if (selectedTab == 'Y') {
        jQuery('#noSelPdtBtn').css('display', 'none');
    } else {
        jQuery('#noSelPdtBtn').css('display', '');
    }

    // 기준일 탭 클릭시 활성/비활성
    jQuery('.tab_menu2 ul li').click(function() {
        jQuery('.tab_menu2 ul li').each(function() {
            jQuery(this).removeClass();
        });
        jQuery(this).addClass('on');
    });
    
    // 상품군 클릭시 background color 변경
    jQuery('#oAreaOne ul li').click(function() {
        jQuery('#oAreaOne ul li').each(function() {
            jQuery(this).removeClass();
            $(this).find("a").attr("title","");
        });
        jQuery(this).addClass('on');
        $(this).find("a").attr("title","선택됨");
    });
    
    // 상품명 클릭시 background color 변경
    jQuery('.pdtCd_Y li a').click(function() {
        jQuery('.pdtCd_Y li a').each(function() {
            jQuery(this).parent().removeClass();
        });
        jQuery(this).parent().addClass('on');
    });
    
    // 페이지 로딩시 직전 선택한 기준일 탭 활성화
    if (jQuery('#oBasicDate').val() == '20120302') {
        jQuery('#oAfterBtn').parent().addClass('on');
        jQuery('#oBeforeBtn').parent().removeClass();
    } else if (jQuery('#oBasicDate').val() == '20120301') {
        jQuery('#oAfterBtn').parent().removeClass();
        jQuery('#oBeforeBtn').parent().addClass('on');
    } else {
        jQuery('#oAfterBtn').parent().addClass('on');
        jQuery('#oBeforeBtn').parent().removeClass();
        jQuery('#oBasicDate').val('20120302');
        jQuery('#oFlag').val('A');
    }
    
    // 엔터키 검색
    jQuery('#oSearchPdtNm').keypress(function() {
        if (event.keyCode == 13) {
            jQuery('#oSearchPdtBtn').trigger('click');
        }
    });
    
    
    var pageEvtInfo = [
                       {"evtNm" : "home_menu_left",    "condiCd" : "thisClass",    "condiChkVal" : "lnb",  "procFunc" : "leftCyberClickEvent"},    //왼쪽메뉴
                   ];
    ampNacf.addEvent(pageEvtInfo);
    
    /* 고객여정 Amplitude 페이지 진입 */
    setTimeout(function() {
        ampNacf.setEvtNm('disclosure');
        ampNacf.setDevicePath("pc_web(homepage)", "공시정보", "상품공시", "보험상품공시");
        ampNacf.setBizNmCd("보험상품공시", "");
        ampNacf.addLogBasic(ampProp);
    }, 1000);
    
});
/**
 * 상품페이지에서 링크로 이동한 경우
 * @param pageCd, pdtGrCd, pdtDcd
 * @since 2014-01-14
 */
function fnCheckPage() {
    var selYn = "Y";
    var pdtGrCd = "";
    var pdtDcd = "";
    var pdtCd = "";
    
    // 상품구분 조회 Ajax
    fnRetrievePdtDcd(pdtGrCd);
    // 상품명 조회 Ajax
    fnRetrievePdtCd(selYn, pdtGrCd, pdtDcd);
    // 상품이력 조회 Ajax
    fnRetrievePdtInfo(pdtCd);
}


/**
 * 판매/판매중지상품 탭에 해당하는 내용 조회
 * @param selYn
 * @since 2014-01-14
 */
 function fnChangeContents(selYn) {
     if (selYn == 'Y') {
         jQuery('#announcePdtSelYn', jQuery('#oHiddenParameterForm')).val(selYn);
         jQuery('#oBasicDate').val('');
         jQuery('#oFlag').val('');
         jQuery('#oHiddenParameterForm').attr('action', '/announce/productAnnounce/retrieveInsuranceProductsAnnounce.nhfire;jsessionid=7okPF2TYpPWepJXnaVObryoYlm1kyimzFsVVAkxHYLBpovAIT9TXKbvdMJ0z6TX0.nphpws01_servlet_NHpCm01').submit();
     } else {
         jQuery('#announcePdtSelYn', jQuery('#oHiddenParameterForm')).val(selYn);
         jQuery('#oBasicDate').val('20120302');
         jQuery('#oFlag').val('A');
         jQuery('#oHiddenParameterForm').attr('action', '/announce/productAnnounce/retrieveInsuranceProductsAnnounce.nhfire;jsessionid=7okPF2TYpPWepJXnaVObryoYlm1kyimzFsVVAkxHYLBpovAIT9TXKbvdMJ0z6TX0.nphpws01_servlet_NHpCm01').submit();
     }
 }


/**
 * 상품구분 조회 2
 * @param selYn, pdtGrCd
 * @since 2014-01-14
 */
function fnRetrievePdtDcd(pdtGrCd) {
    jQuery('#oSearchPdtNm').val('');
    var selYn = '';
     
    //선택된 상푼군 
    seletedPdtCd =pdtGrCd;
    jQuery('.tabMenu ul li').each(function() {
        if (jQuery(this).attr('class') == 'on') {
            selYn = jQuery(this).children().attr('class');
        }
    });
    var aJax = new devon.xSync('/front/announce/retrievePdtDcd.ajax;jsessionid=7okPF2TYpPWepJXnaVObryoYlm1kyimzFsVVAkxHYLBpovAIT9TXKbvdMJ0z6TX0.nphpws01_servlet_NHpCm01');
    aJax.addQuery('type', 'ajax');
    aJax.addQuery('pdtSelYn', selYn);
    aJax.addQuery('pdtGrCd', pdtGrCd);
    aJax.fire();
}


/**
 * 상품구분 조회 결과 2
 * @param xmlDoc
 * @since 2014-01-14
 */
function fnSetPdtDcdList(json, instant, node, xmlDoc) {
    jQuery('.pdtDcd_Y li').detach();
    jQuery('.pdtCd_Y li').detach();
    //fnCheckResultCnt('pdtCd_Y');
    
      var oPdtDcd = "";
        
    jQuery(xmlDoc).find('pdtDcd').each(function(i) {
        var pdtGrCd = jQuery(xmlDoc).find('pdtGrCd').eq(i).text();
        var pdtDcd = jQuery(xmlDoc).find('pdtDcd').eq(i).text();
        var pdtDcdNm = jQuery(xmlDoc).find('pdtDcdNm').eq(i).text();
        var pdtSelYn = jQuery(xmlDoc).find('pdtSelYn').eq(i).text();
      
        
        if(i==0){
        	jQuery('.pdtDcd_Y').append('<li class="liClickArea" onclick="fnSelectedPdtDcdChange(this)">  		<a class="pdtDcdList" href="#noLink" onclick="fnRetrievePdtCd(\''+selectedTab+'\', \''+ pdtGrCd +'\', \'\')">    		전체</a>    		</li>');
        }
        
        if(oPdtDcd == pdtDcd ){
        	jQuery('<li>').addClass('on').addClass('liClickArea').attr('onclick', 'fnSelectedPdtDcdChange(this)')
            .append(jQuery('<a>').addClass('pdtDcdList').attr('href', '#noLink').attr('onclick', 'fnRetrievePdtCd(' + "'" + pdtSelYn + "', " + "'" + pdtGrCd + "', " + "'" + pdtDcd + "'" + ')').text(pdtDcdNm))
        .appendTo(jQuery('.pdtDcd_Y'));	
        	
        }else{
        
        jQuery('<li>').addClass('liClickArea').attr('onclick', 'fnSelectedPdtDcdChange(this)')
            .append(jQuery('<a>').addClass('pdtDcdList').attr('href', '#noLink').attr('onclick', 'fnRetrievePdtCd(' + "'" + pdtSelYn + "', " + "'" + pdtGrCd + "', " + "'" + pdtDcd + "'" + ')').text(pdtDcdNm))
        .appendTo(jQuery('.pdtDcd_Y'));
        }
    });
    fnCheckResultCnt('pdtDcd_Y');
    
    // IE7에서만 작동하도록 브라우저 버전 체크
    if (navigator.appVersion.indexOf('MSIE 7.0') > -1) {
        fnAddClickEvent('liClickArea');
        fnAddClickEvent('pdtDcdList');
    }
    if(clickFlag =='Y'){
    	
    	fnRetrievePdtCd(selectedTab, seletedPdtCd, '');
    }
    
    return '1';
}


/**
 * 상품명 조회
 * @param selYn, pdtGrCd, pdtDcd
 * @since 2014-01-14
 */
function fnRetrievePdtCd(selYn, pdtGrCd, pdtDcd) {
    var aJax = new devon.xSync('/front/announce/retrievePdtCd.ajax;jsessionid=7okPF2TYpPWepJXnaVObryoYlm1kyimzFsVVAkxHYLBpovAIT9TXKbvdMJ0z6TX0.nphpws01_servlet_NHpCm01');
    aJax.addQuery('type', 'ajax');
    aJax.addQuery('pdtSelYn', selYn);
    aJax.addQuery('pdtGrCd', pdtGrCd);
    aJax.addQuery('pdtDcd', pdtDcd);
    if (selYn == 'N') {
        aJax.addQuery('basicDate', jQuery('#oBasicDate').val());
        aJax.addQuery('flag', jQuery('#oFlag').val());
    }
    aJax.fire();
}


/**
 * 상품명 조회 결과 3
 * @param xmlDoc
 * @since 2014-01-14
 */
function fnSetPdtCdList(json, instant, node, xmlDoc) {
    jQuery('.pdtCd_Y li').detach();
    
    var oPdtCd = "";
    
    
    jQuery(xmlDoc).find('pdtDcd').each(function(i) {
        var pdtGrCd = jQuery(xmlDoc).find('pdtGrCd').eq(i).text();
        var pdtDcd = jQuery(xmlDoc).find('pdtDcd').eq(i).text();
        var pdtDcdNm = jQuery(xmlDoc).find('pdtDcdNm').eq(i).text();
        var pdtCd = jQuery(xmlDoc).find('pdtCd').eq(i).text();
        var pdtNm = jQuery(xmlDoc).find('pdtNm').eq(i).text();
        var addPdtNm = jQuery(xmlDoc).find('addPdtNm').eq(i).text();
        var ntgDivdYn = jQuery(xmlDoc).find('ntgDivdYn').eq(i).text();
        

        if (ntgDivdYn == 'Y') {
        	
        	if(oPdtCd == pdtCd){
            
        		jQuery('<li>').addClass('on').addClass('liClickArea').attr('onclick', 'fnSelectedPdtCdChange(this)')
                .append(jQuery('<a>').addClass('pdtNmList').attr('href', '#noLink').attr('onclick', 'fnRetrievePdtInfo(' + '"' + pdtCd + '"' + ',this);').text('(무)' + pdtNm + addPdtNm))
            	.appendTo(jQuery('.pdtCd_Y'));
        		
        		
        		
        		
        	}else{
        		
        		jQuery('<li>').addClass('liClickArea').attr('onclick', 'fnSelectedPdtCdChange(this)')
                .append(jQuery('<a>').addClass('pdtNmList').attr('href', '#noLink').attr('onclick', 'fnRetrievePdtInfo(' + '"' + pdtCd + '"' + ',this);').text('(무)' + pdtNm + addPdtNm))
            	.appendTo(jQuery('.pdtCd_Y'));	
        		
        	}
        } else {
        	
        	if(oPdtCd == pdtCd){
        		jQuery('<li>').addClass('on').addClass('liClickArea').attr('onclick', 'fnSelectedPdtCdChange(this)')
                .append(jQuery('<a>').addClass('pdtNmList').attr('href', '#noLink').attr('onclick', 'fnRetrievePdtInfo(' + '"' + pdtCd + '"' + ',this);').text(pdtNm + addPdtNm))
            	.appendTo(jQuery('.pdtCd_Y'));
        		
        	}else{
        		jQuery('<li>').addClass('liClickArea').attr('onclick', 'fnSelectedPdtCdChange(this)')
                .append(jQuery('<a>').addClass('pdtNmList').attr('href', '#noLink').attr('onclick', 'fnRetrievePdtInfo(' + '"' + pdtCd + '"' + ',this);').text(pdtNm + addPdtNm))
            .appendTo(jQuery('.pdtCd_Y'));
        		
        	}
            
        }
        
        $('#oAreaThree ul.pdtCd_Y li.on a').focus();

        
    });
    
    fnCheckResultCnt('pdtCd_Y');
    // IE7에서만 작동하도록 브라우저 버전 체크
    if (navigator.appVersion.indexOf('MSIE 7.0') > -1) {
        fnAddClickEvent('liClickArea');
        fnAddClickEvent('pdtNmList');
    }
    return '2';
}


/*
 * 검색결과 유/무에 따른 div 표시 선택
 * @since 2014-03-06
 */
function fnCheckResultCnt(divClass) {
    var classNm = '.' + divClass;
    if (divClass == 'pdtDcd_Y') {
        if (jQuery(classNm + ' li').length == 0) {
            // 조회결과가 없으면 div display
            jQuery('#curtain1').css('display', '');
            jQuery('.one').removeClass('on');
            jQuery('<li>').text('검색 결과가 없습니다.').appendTo(jQuery(classNm));
        } else {
            // 조회결과가 있으면 div display: none
            jQuery('#curtain1').css('display', 'none');
            jQuery('.one').addClass('on');
        }
    } else {
        if (jQuery(classNm + ' li').length == 0) {
            // 조회결과가 없으면 div display
            jQuery('#curtain2').css('display', '');
            jQuery('.two').removeClass('on');
            jQuery('<li>').text('검색 결과가 없습니다.').appendTo(jQuery(classNm));
        } else {
            // 조회결과가 있으면 div display: none
            jQuery('#curtain2').css('display', 'none');
            jQuery('.two').addClass('on');
        }
    }
}


/**
 * 상품정보(이력) 조회
 * @param pdtCd
 * @since 2014-01-14
 */
function fnRetrievePdtInfo(pdtCd,elem) {
// 	alert(elem.text);
    var selYn = "";
    var selDcdVal = "";
    jQuery('.tabMenu ul li').each(function() {
        if (jQuery(this).attr('class') == 'on') {
            selYn = jQuery(this).children().attr('class');
        }
    });
    
    if(selYn == "Y"){
    	selDcdVal = "판매상품";
    }else{
    	selDcdVal = "판매중지상품";
    	
    }
//    alert(pdtCd); 
   var pdtNm = ampNacf.getPdtNmFromProd(pdtCd);
//    alert(pdtNm);
   if(pdtNm == "" || pdtNm == undefined || pdtNm == null){
	   if(elem == undefined){
		    pdtNm = "";
	   }else{
		    pdtNm = elem.text;
	   }
	   
   }	
	   
	   
   ampNacf.setEvtNm('disclosure_product');
   ampNacf.setDevicePath("pc_web(homepage)", "공시정보", "상품공시", "보험상품공시");
   ampNacf.setBizNmCd("보험상품공시", "");
   ampProp.product_code = pdtCd;
   ampProp.product_name = pdtNm;
   ampProp.status = selDcdVal;
   ampNacf.addLogBasic(ampProp);
	   
	   
	   

	
    var aJax = new devon.xSync('/front/announce/retrievePdtInfo.ajax;jsessionid=7okPF2TYpPWepJXnaVObryoYlm1kyimzFsVVAkxHYLBpovAIT9TXKbvdMJ0z6TX0.nphpws01_servlet_NHpCm01');
    aJax.addQuery('type', 'ajax');
    aJax.addQuery('fileType', '05');
    aJax.addQuery('pdtCd', pdtCd);
    aJax.fire();
}

/**
 * 상품정보(이력) 조회 결과
 * @param xmlDoc
 * @since 2014-01-14
 */
function fnSetPdtInfoList(json, instant, node, xmlDoc) {
    jQuery('.pdtInfo_Y').detach();
    
    
   // var pdtGrCD  = '';
    //alert("상품군:::" + pdtGrCD);
    

    
    
    jQuery(xmlDoc).find('fileId').each(function(i) {
        var pdtSelStDt = jQuery(xmlDoc).find('pdtSelStDt').eq(i).text();
        var pdtSelEdDt = jQuery(xmlDoc).find('pdtSelEdDt').eq(i).text();
        
        
        var pdtCd = jQuery(xmlDoc).find('pdtCd').eq(0).text();
        if("H" == pdtCd.substring(0,1)){ //상품군이 농작물 재해보험일 경우 
            jQuery("#setPdtInfoArea1").hide();
            jQuery("#setPdtInfoArea2").show();
        }else{
            jQuery("#setPdtInfoArea2").hide();
            jQuery("#setPdtInfoArea1").show();
            
        }
        
        if(pdtSelEdDt =='29991231' || pdtSelEdDt =='99991231' || pdtSelEdDt == null || pdtSelEdDt ==''  ){
        	pdtSelEdDt ='-';
        }
        var pdtNm = jQuery(xmlDoc).find('pdtNm').eq(0).text();
        var addPdtNm = jQuery(xmlDoc).find('addPdtNm').eq(0).text();
        var ntgDivdYn = jQuery(xmlDoc).find('ntgDivdYn').eq(0).text();
        var fileId = jQuery(xmlDoc).find('fileId').eq(i).text();
        var plcndAfileSeqn = jQuery(xmlDoc).find('plcndAfileSeqn').eq(i).text();
        var smmrAfileSeqn = jQuery(xmlDoc).find('smmrAfileSeqn').eq(i).text();
        var ntcltAfileSeqn = jQuery(xmlDoc).find('ntcltAfileSeqn').eq(i).text();
        var bzMtdAfileSeqn = jQuery(xmlDoc).find('bzMtdAfileSeqn').eq(i).text();
        var fireMtdAfileSeqn = jQuery(xmlDoc).find('fireMtdAfileSeqn').eq(i).text();
        var plcndAfileNm = jQuery(xmlDoc).find('plcndAfileNm').eq(i).text();
