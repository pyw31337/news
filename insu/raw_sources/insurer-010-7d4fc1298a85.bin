        ampNacf.setBizNmCd("개인정보처리방침", "");    
    }
    
    if (_eventName == '')                       return;
    
    ampEventInfo.position = position; 
    ampNacf.addLogBasic(ampEventInfo);
}
function menuClickEvent(evt) {
	var evtClass = ampNacf.NVL(evt.target.parentNode.className, "");
	var evtHref = ampNacf.NVL(evt.target.href, "");
