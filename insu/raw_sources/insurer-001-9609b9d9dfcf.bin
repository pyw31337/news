<body>
	<div id="skip"></div>
	<div class="base-layer" id="baseLayer"></div>
	<div class="wrapper" id="IH_IF_Terms" data-page-main="false">
		<span class="pgr-tit">보험상품공시</span>
      <header class="base-header" id="baseHeader"></header>
      
      <main class="base-main" id="baseMain">
        <div class="breadcrumb-wrap">
          <ol class="breadcrumb"></ol>
        </div>
        <div class="content">

         <section class="section">
            <div class="group">
              <div class="wrap-tit-s space-reset-pb">
                <h3 class="title-lg">
                  <span class="txt">삼성화재 보험상품공시를 안내해 드려요</span>
                </h3>
              </div>
            </div>
          </section>

          <section class="section">
            <div class="group">
              <div class="module-box option-bg option-search">
                <div class="item-row option-array">
                  <div class="unit filled">
                    <div class="form-wrap">
                      <div class="ui-select option-box outlined" fui-selectbox="">
                        <select id="" title="검색 카테고리 선택" v-model="selBox">
                          <option value="0">상품명</option>
                          <option value="1" selected="">판매기간+상품명</option>
                        </select>
                      </div>
                    </div>
                  </div>
                  <div class="unit filled item-col">
                    <div class="item-row" v-if="1 == selBox">
                      <div class="unit filled">
                        <div class="form-wrap">
                          <div class="input-wrap sm option-box w-16">
                            <div class="inp-date" fui-datepicker="to:#datepickerTo1;keyControl:true;" id="datepickerFrom1">
                              <input type="text" class="inp-base" title="판매기간 시작일" maxlength="10" placeholder="날짜 선택" id="stDay"  @blur="numChangeDate(1)" @input="chkDate(1)">
                              <button type="button" class="btn-base ui-drop ui-datepicker-btn" title="판매기간 시작일">
                                <span class="sr-only">달력</span>
                              </button>
                            </div>
                          </div>
                        </div>
                      </div>
                      <div class="unit fixed unit-mark">
                        <span>~</span>
                      </div>
                      <div class="unit filled">
                        <div class="form-wrap">
                          <div class="input-wrap sm option-box w-16">
                            <div class="inp-date" fui-datepicker="from:#datepickerFrom1;keyControl:true;" id="datepickerTo1">
                              <input type="text" class="inp-base" title="판매기간 종료일" maxlength="10" placeholder="날짜 선택" id="edDay" @blur="numChangeDate(2)" @input="chkDate(2)">
                              <button type="button" class="btn-base ui-drop ui-datepicker-btn" title="판매기간 종료일">
                                <span class="sr-only">달력</span>
                              </button>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>

                    <div class="input-wrap sm option-box has-button search" fui-input="">
                      <input type="text" class="inp-base" title="상품명 검색" id="searchBox"  v-model="searchBox" @keypress.enter="sendData">
                      <div class="combine">
                        <button type="button" class="btn ico-search" @click="sendData">
                          <span class="sr-only">검색</span>
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>
         
          <section class="section" viewid="J_030_020_001">
            <div class="group">
              <div class="list-head">
                <h4 class="title-min">
                  <span class="txt">검색결과 - 판매상품(총{{onSaleList.length}}건)</span>
                </h4>
              </div>
              <div class="tbl-wrap">
                <table class="tbl-base">
                  <caption>
                    <strong>검색결과 - 판매상품(총건)</strong>
                    <span>상품종류, 상품명, 판매개시일, 사업방법서, 상품요약서, 보험약관</span>
                  </caption>
                  <colgroup>
                    <col width="80px" />
                    <col width="auto" />
                    <col width="110px" />
                    <col width="133px" />
                    <col width="133px" />
                    <col width="120px" />
                  </colgroup>
                  <thead>
                    <tr>
                      <th scope="col">상품종류</th>
                      <th scope="col">상품명</th>
                      <th scope="col">판매개시일</th>
                      <th scope="col">사업방법서</th>
                      <th scope="col">상품요약서</th>
                      <th scope="col">보험약관</th>
                    </tr>
                  </thead>
                  <tbody v-if="onSaleList.length > 0">
                    <tr v-for="(item, idx) in onSaleList" :key="idx">
                      <td>{{item.productCategory}}</td>
                      <td class="align-left">{{item.title}}</td>
                      <td>{{item.productDay}}</td>
                      <td>
                        <div class="btn-wrap">
                          <button type="button" class="btn outlined option-xsm option-round icon download" title="다운로드" v-bind:disabled ="item.method == ''" @click="fileDownload(item.method)">
                            <span>사업방법서</span>
                          </button>
                        </div>
                      </td>
                      <td>
                        <div class="btn-wrap">
                          <button type="button" class="btn outlined option-xsm option-round icon download" title="다운로드" v-bind:disabled ="item.summary == ''" @click="fileDownload(item.summary)">
                            <span>상품요약서</span>
                          </button>
                        </div>
                      </td>
                      <td>
                        <div class="btn-wrap">
                          <button type="button" class="btn outlined option-xsm option-round icon download" title="다운로드" v-bind:disabled ="item.policy == ''" @click="fileDownload(item.policy)">
                            <span>보험약관</span>
                          </button>
                        </div>
                      </td>
                    </tr>
                    
                  </tbody>
                </table>
              </div>
              <div class="list-nodata" v-if="true ==onSaleNoData">
                <p>검색 결과가 없습니다.</p>
              </div>
            </div>
          </section>

          <section class="section" viewid="J_030_020_002">
            <div class="group">
              <div class="list-head">
                <h4 class="title-min">
                  <span class="txt">검색결과 - 판매중지상품(총{{comSaleList.length}}건)</span>
                </h4>
              </div>
              <div class="tbl-wrap">
                <table class="tbl-base">
                  <caption>
                    <strong>검색결과 - 판매상품(총2건)</strong>
                    <span>상품종류, 상품명, 판매개시일, 사업방법서, 상품요약서, 보험약관</span>
                  </caption>
                  <colgroup>
                    <col width="80px" />
                    <col width="auto" />
                    <col width="110px" />
                    <col width="133px" />
                    <col width="133px" />
                    <col width="120px" />
                  </colgroup>
                  <thead>
                    <tr>
                      <th scope="col">상품종류</th>
                      <th scope="col">상품명</th>
                      <th scope="col">판매개시일</th>
                      <th scope="col">사업방법서</th>
                      <th scope="col">상품요약서</th>
                      <th scope="col">보험약관</th>
                    </tr>
                  </thead>
                  <tbody v-if="comSaleList.length > 0">
                    <tr v-for="(item, idx) in comSaleList" :key="idx">
                      <td>{{item.productCategory}}</td>
                      <td class="align-left">{{item.title}}</</td>
                      <td>{{item.productDay}}</</td>
                      <td>
                        <div class="btn-wrap">
                          <button type="button" class="btn outlined option-xsm option-round icon download" title="다운로드" v-bind:disabled ="item.method == ''"  @click="fileDownload(item.method)">
                            <span>사업방법서</span>
                          </button>
                        </div>
                      </td>
                      <td>
                        <div class="btn-wrap">
                          <button type="button" class="btn outlined option-xsm option-round icon download" title="다운로드" v-bind:disabled ="item.summary == ''" @click="fileDownload(item.summary)">
                            <span>상품요약서</span>
                          </button>
                        </div>
                      </td>
                      <td>
                        <div class="btn-wrap">
                          <button type="button" class="btn outlined option-xsm option-round icon download" title="다운로드" v-bind:disabled ="item.policy == ''" @click="fileDownload(item.policy)">
                            <span>보험약관</span>
                          </button>
                        </div>
                      </td>
                    </tr>
                    
                  </tbody>
                </table>
              </div>
              <div class="list-nodata"  v-if="true ==comSaleNoData">
                <p>검색 결과가 없습니다.</p>
              </div>
            </div>
          </section>

          <section class="section">
            <div class="group">
              <div class="ui-tab" fui-tab="">
                <div class="ui-tab-btns">
                  <div class="ui-floating">
                    <div class="ui-floating-wrap">
                      <a href="javascript:;" class="ui-tab-btn selected" aria-selected="true"  @click="tabChage(1)"><span>판매상품</span></a>
                      <a href="javascript:;" class="ui-tab-btn" aria-selected="false"  @click="tabChage(2)"><span>판매중지 상품</span></a>
                    </div>
                  </div>
                </div>

                <div class="ui-tab-pnls">
                  <section id="tab1">
                    <div class="group space-mt-10">
                      <div class="tbl-wrap option-fixed-head tbl-auto-slt type3">
                        <table id="productListTable"  class="tbl-base">
                          <caption>
                            <strong>판매상품 선택</strong>
                            <span>Step1. 상품종류, Step2. 상품명, Step3. 판매기간, 다운로드 구성</span>
                          </caption>
                          <colgroup>
                            <col style="width: 100px" />
                            <col style="width: 120px" />
                            <col style="width: auto" />
                            <col style="width: 213px" />
                            <col style="width: 170px" />
                          </colgroup>
                          <thead>
                            <tr>
                              <th scope="col" colspan="2">Step1. 상품종류</th>
                              <th scope="col">Step2. 상품명</th>
                              <th scope="col">Step3. 판매기간</th>
                              <th scope="col">다운로드</th>
                            </tr>
                          </thead>
                          <tbody>
                            <tr>
                              <td>
                                <ul id="depth1" class="list-step-auto">
                                  <li><a href="javascript:;" title="자동차" role="button"><span>자동차보험</span></a></li>
                                  <li><a href="javascript:;"  title="장기" role="button"><span>장기보험</span></a></li>
                                  <li><a href="javascript:;" title="일반보험" role="button"><span>일반보험</span></a></li>
                                  <li><a href="javascript:;" title="퇴직연금" role="button"><span>퇴직연금</span></a></li>
                                  <li><a href="javascript:;" title="퇴직보험" role="button"><span>퇴직보험</span></a></li>
                                <ul>
                              </td>
                              <td>
                                <ul id="product_gubun" class="list-step-auto">
                                </ul>
                              </td>
                              <td>
                                <ul id="product_list" class="list-step-auto">
                                </ul>
                              </td>
                              <td>
                                <ul id="date_list" class="list-step-auto">
                                </ul>
                              </td>
                              <td class="step-download">
                                <dl id="pdfDiv" style="display:none">
                                  <dt><strong>상품명</strong></dt>
                                  <dd>{{strPrdName}}</dd>
                                  <dt><strong>판매기간</strong></dt>
                                  <dd>{{strPeriod}}</dd>
                                </dl>
                                <div class="step-btn-wrap" id="pdfDiv2" style="display:none" >
                                  <button id="pdfCnt_0" type="button" class="btn outlined option-xsm option-round icon download" disabled="disabled" title="새창열림_사업방법서 PDF보기" >
                                    <span>사업방법서</span>
                                  </button>
                                  <button id="pdfCnt_1" type="button" class="btn outlined option-xsm option-round icon download" disabled="disabled" title="새창열림_상품요약서 PDF보기" >
                                    <span>상품요약서</span>
                                  </button>
                                  <button id="pdfCnt_2" type="button" class="btn outlined option-xsm option-round icon download" disabled="disabled" title="새창열림_약관 PDF보기" >
                                    <span>보험약관</span>
                                  </button>
                                  <button id="pdfCnt_3" type="button" class="btn outlined option-xsm option-round icon download" disabled="disabled" title="새창열림_상품설명서 PDF보기" >
                                    <span>상품설명서</span>
                                  </button>
                                </div>
                              </td>
                            </tr>
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </section>

                 
        </div>
      </main>
	 
	 <footer class="base-footer" id="baseFooter"></footer>
	</div>
	<script type="text/javascript" src="/sfmi/v2/ui/info/IH_IF_Terms.js?_v=202611181908"></script>
</body>
</html>