function announceOpenWindow(code) { //v2.0
    // HouseFire,
    var openUrl = "/announce/retrieveAnnouncePopup.nhfire?sUrl=/jsp/front/announce/retrieveAnnounce" + code + ".jsp";
    window.open(openUrl,'nhfire_pop','width=984,height=728,scrollbars=no');
}


function announceNewOpen(pdtCd) { //v2.0

    ampNacf.setEvtNm('disclosure_price');
    ampNacf.setDevicePath("pc_web(homepage)", "공시정보", "가격공시", "가격공시");
    ampNacf.setBizNmCd(pdtCd , "");
    //만약체 추가인자가 있을경우
    ampProp.button = "보험료계산";
    ampNacf.addLogBasic(ampProp);
    
    var urlAddress = "/announce/retrieveAnnounceNewPopup.nhfire";

    var urlParam = "";
    var planCd = "301";

    // 테스트 기간동안 임시로 사용 코드. 로컬/개발에서만 전체 상품 보험료 계산 가능하고 검증/운영에서는 보험료계산 불가능하도록 수정


    if("D11031L|D31241A".indexOf(pdtCd) > -1) {
        urlParam = "url=/jsp/front/announce/retrieveAnnounceA.jsp";

        if("D31241A".indexOf(pdtCd) > -1){ // 리치팜생활안심보험인경우 초기플랜셋팅 NDP -농업든든플랜(자유설계형이 없음)
            planCd = "SDP";
        }

    } else if("D21041A".indexOf(pdtCd) > -1  || "D110511".indexOf(pdtCd) > -1) {
        urlParam = "url=/jsp/front/announce/retrieveAnnounceB.jsp";
    } else if("D71021N|D313817|D314613".indexOf(pdtCd) > -1) {
        urlParam = "url=/jsp/front/announce/retrieveAnnounceF.jsp";
    } else {
        urlParam = "url=/jsp/front/announce/retrieveAnnounceD.jsp";

        // 예외!! 일부 상품의 경우 시작하는 플랜코드가 다름
//         if("D411018".indexOf(pdtCd) > -1 ){    // NH3대진단비, NH다이렉트운전자
//         	planCd = "IDP";
//         }else 
		if("D312326".indexOf(pdtCd) > -1 || "D314513".indexOf(pdtCd) > -1 || "D314523".indexOf(pdtCd) > -1){
            planCd = "SSP";
        }else if( "D710919".indexOf(pdtCd) > -1){    // NH올바른지구굿데이운전자, NH80튼튼치아
        	planCd = "201";
        }else if( "D31271G".indexOf(pdtCd) > -1 || "D312721".indexOf(pdtCd) > -1){
        	planCd = "FC1";
        }else if("D411312".indexOf(pdtCd) > -1){    // NH건강할수록스마트암보험 (자유설계3)
        	planCd = "FP3";
        }
    }

    urlParam = urlParam + "&planCd="+ planCd +"&pdtCd=" + pdtCd;

    window.open(urlAddress + "?" + urlParam,'nhfire_pop','width=984,height=728,scrollbars=no');
}

function openCrops(code) { //농작물보험(일반보험)

    // 농작물재해보험-과수작물 : 01
    // 농작물재해보험-밭작물 : 03
    // 농작물재해보험-원예시설 : 07
    // 농작물재해보험-벼 : 02
    // 농작물재해보험-버섯 : 04
    // 수입안정보험 : 31
    var openUrl = "/announce/retrieveCrops" + code + ".nhfire";
    window.open(openUrl,'nhfire_pop','width=984,height=728,scrollbars=no');
}

function announceOpenWindowNormal(code) {
    //주택, 농기계, 풍수해(일반보험)
    // HouseFire, HouseGeneral, FarmingMachines, DamageStormAndFlood, LeisureHorseAnnounce
//  if(code=='HouseGeneral'||code=='HouseFire'){ //19.1가격공시 게시 전 보험료계산 막기(주택화재, 주택화재종합보험)
//      alert('서비스 준비중입니다.');
//  }
//  else{

        // 2020년 개정으로 인한 임시 막기(주택화재, 정책보험 제외)
//      if("HouseFire" == code || "FarmingMachines" == code || "DamageStormAndFlood" == code || "LeisureHorseAnnounce" == code || "HouseGeneral" == code) {

//      } else {
//          alert("2020년 요율개정으로 인하여 서비스 준비중입니다.");
//          return;
//      }

        var openUrl = "/announce/retrieve" + code + ".nhfire";
        
        if(code == "OneDayLeisureAnnounce"){
        	openUrl = openUrl+"?pdtCd=E790211"; //하루보장레저보험
        	
        }else if(code == "LeisureHorseAnnounce"){
        	openUrl = openUrl+"?pdtCd=E710211"; //레저상해보험
        }else if(code == "DriverInjuryAnnounce"){
        	openUrl = openUrl+"?pdtCd=E710311"; //NH운전자상해보험
        }else if(code == "HouseFire"){
        	
        	openUrl = openUrl+"?pdtCd=E110111"; //주택화재보험
        }else if(code == "HouseGeneral"){
        	
        	openUrl = openUrl+"?pdtCd=E810111"; //주택종합보험
        }else if(code == "FarmingMachines"){
        	openUrl = openUrl+"?pdtCd=G610110"; //농기계종합보험
        }else if(code == "DamageStormAndFlood"){
        	openUrl = openUrl+"?pdtCd=E990111"; //농기계종합보험
        }else if(code == "MbtiAnnounce"){
        	openUrl = openUrl+"?pdtCd=E710411"; //NH헤아림MBTI보험
        }
        
        
        window.open(openUrl,'nhfire_pop','width=984,height=728,scrollbars=no');
//  }
}

function openTravel(value) { //여행자보험(일반보험)

    // 2020년 개정으로 인한 임시 막기
    //alert("2020년 요율개정으로 인하여 서비스 준비중입니다.");
    //return;

    var openUrl = "";

    if(value == "E720111"){
//         openUrl = "/announce/retrieveDomesticTravelAnnounce.nhfire";//국내여행보험
        openUrl = "/announce/retrieveDomesticTravelAnnounce.nhfire?pdtCd=E720111"; //국내여행보험
        //urlParam = "url=/jsp/front/announce/retrieveDomesticTravelAnnounce.jsp"
        //urlParam = urlParam +"&pdtCd=E720111";
        //window.open(openUrl + "?" + urlParam,'nhfire_pop','width=984,height=728,scrollbars=no');
        //return;
        
    }else if(value == "E720121"){
//         openUrl = "/announce/retrieveOverseasTravelAnnounce.nhfire";//해외여행보험
        openUrl = "/announce/retrieveOverseasTravelAnnounce.nhfire?pdtCd=E720121"; //해외여행보험
    }else if(value == "E720181"){
        openUrl = "/announce/retrieveOverseasTravelAnnounce.nhfire?pdtCd=E720181"; //해외여행보험
    }else if(value == "E790121"){
        openUrl = "/announce/retrieveDomesticTravelRealLossAnnounce.nhfire?pdtCd=E790121";//국내여행 실손의료보험
//         openUrl = "/announce/retrieveDomesticTravelRealLossAnnounce.nhfire";//국내여행 실손의료보험
    }else if(value == "E790131"){
        openUrl = "/announce/retrieveOverseasTravelRealLossAnnounce.nhfire?pdtCd=E790131";//해외여행 실손의료보험
//         openUrl = "/announce/retrieveOverseasTravelRealLossAnnounce.nhfire";//해외여행 실손의료보험
    }else if(value == "E720131"){
        openUrl = "/announce/retrieveOverseasLongtimeTravelAnnounce.nhfire?pdtCd=E720131";//해외장기체류보험
//         openUrl = "/announce/retrieveOverseasLongtimeTravelAnnounce.nhfire";//해외장기체류보험
    }else if(value == "E790141"){
        openUrl = "/announce/retrieveOverseasLongtimeTravelRealLossAnnounce.nhfire?pdtCd=E790141";//해외장기체류실손의료보험
//         openUrl = "/announce/retrieveOverseasLongtimeTravelRealLossAnnounce.nhfire";//해외장기체류실손의료보험
    }else if(value == "E720141"){
        openUrl = "/announce/retrieveOnOffTravelAnnounce.nhfire?pdtCd=E720141";//해외장기체류실손의료보험
//         openUrl = "/announce/retrieveOnOffTravelAnnounce.nhfire";//해외장기체류실손의료보험
    }else if(value == "E720211"){
        openUrl = "/announce/retrieveTravelLeisureAnnounce.nhfire?pdtCd=E720211";//올인원여행레저보험    
//         openUrl = "/announce/retrieveTravelLeisureAnnounce.nhfire";//올인원여행레저보험    
    }else {

    }
  //19.1가격공시 게시 전 보험료계산 막기
    window.open(openUrl,'nhfire_pop','width=984,height=728,scrollbars=no');
}

function openLivestock(num) {//가축재해보험(일반보험)
    if(num == '1'){
        var openUrl = "/announce/retrieveLivestockDisasterInsurance.nhfire?pdtCd=E930111"; // 가축재해보험(일반)
    }else{
        var openUrl = "/announce/retrieveLivestockDiseaseInsurance.nhfire?pdtCd=E930421";// 가축재해보험(일반)
    }
    window.open(openUrl,'nhfire_pop','width=984,height=728,scrollbars=no');
}

function openImage(value) { //여행자보험(일반보험)

