	var hpg_mnu_id = "0101050002";
	var hpg_prcd_mnu_id = "0101050000";

	$(document).ready(function(){
		$("#cms_title_memo").text("신규 계약 체결시 상품설명서 및 청약서 내용을 확인하고 전자서명으로 자필서명을 대신하는 서비스입니다.");
		
		// 전자금융거래회원 로그인 클릭
		$('#auth_01').click(function(){
			move("/FWLGNV0002.do?rUrl=/FWMYCV0433.do");
		});	
	
		// 비회원 본인인증 로그인
		$('#auth_02').click(function(){
			//move("/FWMYCV0435.do");
			realNamePopOpen();
		});		
	});
	
	
	/**
	 * 페이지 이동
	 **/	
	function move(pURL) {
		$('#frm').attr('action', pURL);
		$('#frm').submit();
	}
</script>










