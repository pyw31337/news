					</select>
				</div>
				<input type="search" id="find" name="find" title="검색어 입력" placeholder="검색어를 입력하세요" style="width:400px;" class="placeholder inpDisplay" />
				<div class="selectbox selDisplay" style="display:none;">
					<!-- 170915: 접근성 관련 삭제  <label for="find2"></label> -->
					<select title="검색년도선택" class="selectLine" name="find2" id="find2" style="width:230px;">
            
            
            
            
            
