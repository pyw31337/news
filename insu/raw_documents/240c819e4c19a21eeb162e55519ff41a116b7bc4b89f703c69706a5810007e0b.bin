<script type="text/javascript">
var pathUrl = "/main/disclosure/management/occasionalmanagement/";

require(['hwlife', 'grid'], function(hwlife, grid) {
  
  var boardListForm   = document.getElementById('frm');
  var $boardListForm = $(boardListForm);
  var boardListGrid    = $('#LIST_GRID').initGrid();
  var pageSize         = $("#pageSize").val();
  /********************
   * 목록조회
   ********************/
  function getList(currentPage) {
    currentPage = currentPage ? currentPage : boardListForm.currentPage.value || 1;
    boardListForm.currentPage.value = currentPage;
    
    hwlife.secure.ajax($boardListForm, {
      url: pathUrl+'getList.do',
      dataType: 'json',
      data: $('#frm').serialize(),
      success: function(data) {
    	  
        //console.log(JSON.stringify(data));
        
        $("#total").text(data.tot_cnt);//총건수
        
        boardListGrid.databind(data, 'list', {
          getNumber: function(rowIndex) {
            return data.tot_cnt - (rowIndex + (currentPage - 1) * pageSize);
          },
          getFile: function(attachfile) {
              return getFileExt(attachfile);
          }
        }).setNumberPaging(currentPage, data.tot_cnt, pageSize, 10, getList);
          boardListForm.currentPage.value = '';
      },
      error: function(request, status, error){
        console.log("code:"+request.status+"\n"+"message:"+request.responseText+"\n"+"error:"+error);
      }
    });
  }

  /********************
   * 검색버튼 실행
   ********************/
  $("#btnSearch").click(function(){
    getList();
    return false;          
  });
  
  // enter 처리
  $('#find').on('keypress', function(e){
      e = (e) ? e : window.event;
  if (e.keyCode) code = e.keyCode;
  else if (e.which) code = e.which;
  if (code == 13) {
      getList();
      return false;
  }
  });
  
  /********************
   * 파일 유형별 버튼
   ********************/
  function getFileExt(fileNm){
    if(fileNm == undefined){
      fileNm = "";
    }
    var name = fileNm.toLowerCase();
    var rtnStr = "";
    if (name.length > 0) {    
      rtnStr += '<a href="#none" target="blank" class="btn_small_gray ck-fileDownload" data-file="'+fileNm+'"><img src="/resources/main/img/button/btn_pdf.png" alt="PDF 다운로드"></a>';
    }else {
      rtnStr = "-";
    }
    return rtnStr
  }
  /********************
   * 파일다운로드
   ********************/
   $('#List').on('click', '.ck-fileDownload', function(e){
	    var option = {
              gubun: '1',
              file_name: $(this).attr('data-file')
        };
	    hwlife.util.fileDownload("/www/announce/goods/download_chk2.asp", option);	    
   });
    
  /********************
   * 파일다운로드(한화생명 공시업무규정)
   ********************/
  $(".ck-btnDown").click(function(){
	    var option = {
	            file_url: '/announce/susigongsi/',
	            file_name: 'gongsi_guide.pdf'
	    };
	    hwlife.util.fileDownload("/kinc/download_chk.asp", option);   	  
  });
  
  /********************
   * 폼 첫조회
   ********************/
  getList();
});
</script>
</section>
