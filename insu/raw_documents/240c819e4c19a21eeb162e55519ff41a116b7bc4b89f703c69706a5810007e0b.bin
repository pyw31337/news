						window.open("/main/insurance/counsel/IN_IR00000_W10000.do", "counsel", "Scrollbars=yes,width=860,height=820");
					}); */

					//신규 상담사매칭 보험상담신청
					$('#popup_counsel2').on('click', function (e) {
						e.preventDefault();
						//구글태깅관련 소스추가
						var $this = $(this);
						var categoryName = $("#container").find('h1').text();	//카테고리값
						var labelName = $this.data('title');					//라벨값
						var actionName = e.type;	  							//액션값
						if (temp_profile === "qa" || temp_profile === "real") {
							GA_Event(categoryName, actionName, labelName);
						}
						//utm 값들이 있는지 체크
						var utm_source = "";
						var utm_medium = "";
						var utm_campaign = "";
						var utm_content = "";
						var utm_term = "";
						//기본호출Url
						var baseUrl = "";
						var params = {
							utm_source : utm_source
							, utm_medium : utm_medium
							, utm_campaign : utm_campaign
							, utm_content : utm_content
							, utm_term : utm_term
						};
						//최종호출Url
						var finalUrl = "";
						var popupY = (window.screen.height / 3) - (220);
