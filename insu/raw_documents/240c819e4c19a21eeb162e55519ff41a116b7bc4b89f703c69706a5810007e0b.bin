            <script type="text/javascript">
                require(['hwlife'], function (hwlife) {
                	
                	var realHideMenus = "MY_RBII000NMY_RCII000N";
                    var splitUrl = location.href.split("/");
                    var nSplitUrlLength = splitUrl.length;
                    var splitPageName = splitUrl[nSplitUrlLength-1].split("_");
                    

                    if(realHideMenus.indexOf(splitPageName[0] + "_" + splitPageName[1]) >= 0){
                        alert("시스템 점검중입니다. 홈으로 이동합니다.");
