                    $('.use-tooltip').mouseover(function(){
                        $(this).closest('.partners').find('.partners-tooltip').show();
                    });
                    $('.use-tooltip').focus(function(){
                        $(this).closest('.partners').find('.partners-tooltip').show();
                    });
                    $('.use-tooltip').mouseleave(function(){
                        $('.partners-tooltip').hide();
                    });
                    $('.use-tooltip').blur(function(){
                        $('.partners-tooltip').hide();
                    });

					// 상품 상담
