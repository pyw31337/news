		ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메뉴", "보상서비스", "보상처리현황조회");
		ampNacf.setBizNmCd("보상처리현황조회", "");
	} else if (evtHref.indexOf("customer/guide/accidentInvetigationStandards.nhfire") >= 0) {
		ampNacf.setEvtNm('home_menu_claimcriteria');
		ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메뉴", "보상서비스", "사고조사기준안내");
		ampNacf.setBizNmCd("사고조사기준안내", "");
	} else if (evtHref.indexOf("cyber/cropAcd/cropAcd01.nhfire") >= 0) {
		ampNacf.setEvtNm('home_menu_claim_crop');
		ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메뉴", "보상서비스", "농작물재해보험사고접수");
