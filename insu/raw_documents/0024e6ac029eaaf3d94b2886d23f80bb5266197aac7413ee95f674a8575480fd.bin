<script>

jQuery(document).ready( function() {
    
	//초기화면 최종버젼보여주기
	jQuery("#selVerion").val("3");
	fnSelViContent();
	

});



function fnSelViContent(){
	var num = jQuery("#selVerion").val();
	if(jQuery("#selVerion").val() == "3"){
		jQuery("#contentTable4").html(jQuery("#changeVisArea3").html());
	}else{
		jQuery("#contentTable4").html(jQuery("#changeVisArea"+num).html());
	}
	
	
	
	
}

</script>


