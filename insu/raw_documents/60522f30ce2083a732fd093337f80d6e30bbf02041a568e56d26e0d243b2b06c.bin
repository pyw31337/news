          $('#gnb .panel').hide();
          $('#gnb a.depth-1').removeClass('active');
        }
      });
*/
    });

    // gnb
    $('#gnb a.depth-1 , .btn-sch').focus(function(){
      $('#gnb a.depth-1').removeClass('active');
      $('#gnb .panel').hide();
      $('.gnb-close').hide();
      $(this).addClass('active');
      $(this).siblings('.panel').show();

       $('#gnb').mouseleave(function(){
         $('#gnb a.depth-1').removeClass('active');
         $('#gnb').find('.panel').hide();
       });
    });

    $('#gnb .gnb-close').click(function(){
      $('#gnb .panel').hide();
      $('#gnb a.depth-1').removeClass('active');
    });

    $('.smart-alarm').click(function(){
      window.location.href = "/smart-advice/smartNotice.do";
    });
	});

    // 엔터키 눌렀을시 검색
    function press() {
      var num = 0;
      if (event.keyCode==13) {
        if($("#selectPop").val() != ''){
          $("#menuTab").hide();
          $(".menuList").hide();
          $("#selectResult").show();
          $("#selectList").show();
          $('#selectList').empty();
          $('#selectResult').empty();

          for(i=0; i<$(".result-tbl").find(".depth-2").length; i++){
            if($(".result-tbl").find(".depth-2").eq(i).text().toUpperCase().indexOf($("#selectPop").val().toUpperCase()) != -1){
              num += 1;

              var menu1 = "";
              var menu2 = "";
              var menuHref = "";

              menu1 += $("#"+$(".result-tbl").find(".depth-2").eq(i).parent().parent().parent().attr("id")).attr("value");
              menu2 += $(".result-tbl").find(".depth-2").eq(i).text();
              menuHref +=  $(".result-tbl").find(".depth-2").eq(i).attr('href');
              $("#selectList").append('<li>' + menu1 + ' > <a href="' + menuHref + '">' + menu2 + '</a> > ' + $("#selectPop").val() + '</li>');
            }
          }

          for(i=0; i<$(".result-tbl").find(".depth-3").length; i++){
            if($(".result-tbl").find(".depth-3").eq(i).text().toUpperCase().indexOf($("#selectPop").val().toUpperCase()) != -1){
              num += 1;

              var menu1 = "";
              var menu2 = "";
              var menu3 = "";
              var menuHref = "";

              menu1 += $("#"+$(".result-tbl").find(".depth-3").eq(i).parent().parent().parent().attr("id")).attr("value");
              menu2 += $(".result-tbl").find(".depth-3").eq(i).parent('div').find('p').text();
              menu3 += $(".result-tbl").find(".depth-3").eq(i).text();
              menuHref +=  $(".result-tbl").find(".depth-3").eq(i).attr('href');
              $("#selectList").append('<li>' + menu1 + ' > ' + menu2 + ' > <a href="' + menuHref + '">' + menu3 + '</a> > ' + $("#selectPop").val() + '</li>');
            }
          }
          $("#selectResult").append('<h2>‘'+ $("#selectPop").val() +'’ 검색결과 (' + num + ')</h2>');
        } else{
          $('#selectResult').hide();
          $('#selectList').hide();
          $('#menuTab').show();
          $('.menuList').show();
          $('#selectList').empty();
          $('#selectResult').empty();
        }
      }
    }

    function goKbGoldenLife() {
        if(accessServer == "LOCAL" || accessServer == "DEV"){
            window.open('https://www-dev1.kbgoldenlife.co.kr', '_blank');
        }else if(accessServer == "UAT"){
            window.open('https://www-uat.kbgoldenlife.co.kr', '_blank');
        }else if(accessServer == "PROD"){
           window.open('https://www.kbgoldenlife.co.kr', '_blank');
        }
    }
</script>


		<!-- header include ed -->
	
		<!-- main content 영역 st --> 
		<main id="content">
			<section class="inside">
			
				<h1>이용약관</h1>
			
				<div class="terms">

				<h2 class="subtit02">제 1 조 목적</h2>
				<p class="desc-txt">이 약관은 주식회사 KB라이프생명보험(이하 "회사"라 합니다.)이 운영하는 인터넷 홈페이지와 사이버센터에서 제공하는 서비스의 이용과 관련한 제반 사항의 규정을 목적으로 합니다.</p>

				<h2 class="subtit02">제 2 조 정의</h2>
				<ul class="list01">
					<li>1) "홈페이지"란 회사가 컴퓨터 등 정보통신설비를 이용하여 이용자(고객)에게 상품 및 서비스를 제공하고 거래할 수 있도록 설정한 가상의 영업장을 말합니다.</li>
					<li>2) "서비스"라 함은 홈페이지 및 사이버센터를 통해 회사가 제공하는 모든 서비스를 말합니다.</li>
					<li>3) "이용자(고객)"란 회사 홈페이지에 접속하여 이 약관에 따라 회사 홈페이지에서 제공하는 서비스를 받는 고객을 말합니다.</li>
				</ul>

				<h2 class="subtit02">제 3 조 약관의 효력 및 개정</h2>
				<ul class="list01">
					<li>1) 회사는 이 약관의 내용과 상호, 영업소 소재지, 대표자의 성명, 사업자등록번호, 연락처(전화, 팩스, 전자우편 주소 등) 등을 이용자(고객)가 알 수 있도록 회사 홈페이지에 게시합니다.</li>
					<li>2) 회사는 약관의 규제 등에 관한 법률, 전자문서 및 전자거래기본법, 전자서명법, 정보통신망 이용 촉진 및 정보보호 등에 관한 법률, 금융소비자 보호에 관한 법률 등 관련법령을 위배하지 않는 범위에서 이 약관을 개정할 수 있습니다.</li>
					<li>3) 회사가 약관을 개정할 경우에는 적용일자 및 개정사유를 명시하여 현행약관과 함께 회사 홈페이지의 초기화면에 그 적용일자 7일 이전부터 적용일자 전일(약관변경이 소비자에게 불리한 경우 적용일자 30일 이전부터 적용일자 전일)까지 게시합니다.</li>
					<li>4) 이 약관에서 정하지 아니한 사항과 이 약관의 해석에 관하여는 정부가 제정한 전자상거래 등에서의 소비자 보호지침 및 관계법령 또는 상관례에 따릅니다.</li>
				</ul>

				<h2 class="subtit02">제 4 조 서비스의 제공 및 변경</h2>
				<ul class="list01">
					<li>
						1) "홈페이지"는 다음과 같은 서비스를 제공합니다.
						<ul class="depth01">
							<li>① 회사의 전반적인 소개와 안내</li>
							<li>② 회사의 보험, 대출, 펀드 등 상품의 설명 및 안내(SMS, E-mail 발송 등), 가상 설계 서비스, 가입상담 신청</li>
							<li>③ 회사와 거래가 있는 이용자(고객)를 위한 사이버센터를 통한 금융거래내역의 조회, 입출금, 대출 서비스 등의 운영</li>
							<li>④ 회사가 정하는 기타 업무 및 서비스</li>
						</ul>
					</li>
					<li>2) 회사는 필요한 경우 언제든지 제1항에서 정한 서비스의 내용을 변경하거나 일부 제한할 수 있으며, 이로 인하여 발생하는 문제에 대해서는 관련 법령에 특별한 규정이 없는 한 어떠한 책임도 부담하지 않습니다.</li>
				</ul>

				<h2 class="subtit02">제 5 조 서비스의 중단</h2>
				<ul class="list01">
					<li>1) 회사는 정보통신설비의 보수ㆍ점검ㆍ교체 및 고장, 통신의 두절 등의 사유가 발생한 경우에는 서비스의 제공을 일시적으로 중단할 수 있습니다.</li>
					<li>2) 제1항에 의한 서비스 중단의 경우에는 홈페이지 공지 등을 통해 이용자(고객)에게 안내합니다.</li>
					<li>3) 회사는 제1항의 사유로 인한 서비스의 제공 중단으로 이용자(고객)에게 발생한 문제에 대해서는 책임을 부담하지 않습니다.</li>
				</ul>

				<h2 class="subtit02">제 6 조 사이버센터 서비스</h2>
				<p class="desc-txt">이용자(고객)가 아래의 요건을 충족하는 경우 이 약관에 따라 제4조 제1항 제3호에 관한 사이버센터의 서비스가 개시됩니다.</p>
				<ul class="list01">
					<li>① 회사가 정한 방법에 따라 공동인증서 등을 통해 이용자(고객)인증 후 서비스 이용</li>
					<li>② 인증서 유효기간 만료 및 폐기 등의 사유 발생시에는 공동인증서 등의 재발급을 통해 이용자(고객)인증 후 이용</li>
				</ul>

				<h2 class="subtit02">제 7 조 개인정보보호</h2>
				<ul class="list01">
					<li>1) 회사는 개인정보처리방침에 따라 이용자(고객)의 정보수집 시 필요한 최소한의 정보만을 수집합니다.</li>
					<li>2) 회사는 이용자(고객)의 개인식별이 가능한 개인정보를 수집하는 때에는 이용자(고객)의 동의를 받습니다.</li>
					<li>3) 이용자(고객)는 언제든지 본인의 개인정보 열람 및 수정/삭제를 요청할 수 있으며, 회사는 이에 대해 지체 없이 필요한 조치를 취할 의무를 가집니다.</li>
					<li>4) 회사는 이용자(고객)의 개인정보 분실·도난·누출 사실을 알았을 경우, 이를 지체 없이 이용자(고객)에게 알리고 관련 법령에 따른 관계기관에 신고할 의무를 가집니다.</li>
					<li>5) 기타 개인정보 관련 사항은 홈페이지 개인정보 처리방침에 의거합니다.</li>
				</ul>

				<h2 class="subtit02">제 8 조 회사의 의무</h2>
				<ul class="list01">
					<li>1) 회사는 이 약관이 정하는 바에 따라 안정적인 서비스를 제공할 의무가 있습니다.</li>
					<li>2) 회사는 이용자(고객)가 안전하게 인터넷 서비스를 이용할 수 있도록 이용자(고객)의 개인정보 및 신용정보 보호를 위한 보안 시스템을 갖추어야 하며 관리에 만전을 기함으로써 이용자(고객)의 개인정보 보호에 최선을 다 합니다.</li>
					<li>3) 회사는 상품이나 서비스에 대하여 「표시·광고의 공정화에 관한 법률」 제3조 소정의 부당한 표시·광고행위를 하지 않습니다.</li>
					<li>4) 회사는 이용자(고객)가 동의하지 않은 영리목적의 광고성 전자우편을 발송하지 않습니다.</li>
				</ul>

				<h2 class="subtit02">제 9 조 이용자(고객)에 대한 통지</h2>
				<ul class="list01">
					<li>1) 회사가 이용에 대한 통지를 하는 경우, 이용자(고객)가 회사에 제출한 이메일, 주소 또는 휴대폰메시지(SMS, LMS) 중 1가지 이상의 방법으로 할 수 있습니다.</li>
					<li>2) 회사가 불특정 다수의 이용자(고객)에 대하여 통지하여야 하는 경우, 1주일 이상 홈페이지 게시판에 게시함으로써 개별 통지에 갈음할 수 있습니다.</li>
				</ul>

				<h2 class="subtit02">제 10 조 이용자(고객)의 의무</h2>
				<ul class="list01">
					<li>
						1) 이용자(고객)는 다음의 행위를 하여서는 안 됩니다.
						<ul class="depth01">
							<li>① 신청 또는 변경 시 허위내용의 등록</li>
							<li>② 회사에 게시된 정보의 변경</li>
							<li>③ 회사가 정한 정보 이외의 정보(컴퓨터프로그램 등)의 송신 또는 게시</li>
							<li>④ 회사 기타 제3자의 저작권 등 지식재산권에 대한 침해</li>
							<li>⑤ 회사 기타 제3자의 명예를 손상시키거나 업무를 방해하는 행위</li>
							<li>⑥ 회사의 직원이나 서비스의 관리자를 가장하거나 사칭하여 또는 타인의 명의를 도용하여 글을 게시하는 행위</li>
							<li>⑦ 전기통신 장비의 정상적인 가동을 방해, 파괴할 목적으로 고안된 소프트웨어, 바이러스, 기타 다른 컴퓨터 코드, 파일, 프로그램을 포함하고 있는 자료를 입력, 전송 또는 게시하는 행위</li>
							<li>⑧ 스토킹(stalking) 등 다른 이용자(고객)을 괴롭히는 행위</li>
							<li>⑨ 외설 또는 폭력적인 메시지ㆍ화상ㆍ음성 기타 사회질서에 반하는 정보를 회사 홈페이지에 공개 또는 게시하는 행위</li>
							<li>⑩ 다른 이용자(고객)의 개인정보를 수집 또는 저장 및 공개하는 행위</li>
							<li>⑪ 불특정 다수의 자를 대상으로 하여 광고 또는 선전을 게시하는 등의 방법으로 회사의 웹서비스를 이용하여 영리목적의 활동을 하는 행위</li>
							<li>⑫ 공동인증서와 비밀번호를 제3자에게 제공하거나 관리 소홀로 유출하는 행위</li>
							<li>⑬ 회사가 제공하는 서비스에 대한 약관 또는 그 밖에 서비스 이용에 관한 법령, 규정을 위반하는 행위</li>
						</ul>
					</li>
					<li>2) 이용자(고객)는 위 제1항에서 정한 행위로 인하여 회사나 다른 사람이 입은 손해를 배상할 책임이 있습니다.</li>
					<li>3) 공동인증서와 비밀번호 관리책임은 이용자(고객)에게 있으며, 위 제1항 제12호의 위반 및 공동인증서, 비밀번호와 관련하여 발생하는 모든 문제에 대해서는 이용자(고객)가 책임을 부담합니다.</li>
				</ul>

				<h2 class="subtit02">제 11 조 저작권의 귀속 및 이용제한</h2>
				<ul class="list01">
					<li>1) 회사가 작성한 저작물에 대한 저작권 및 기타 지적재산권은 회사에 귀속합니다.</li>
					<li>2) 이용자(고객)는 회사 홈페이지 및 사이버센터를 이용함으로써 얻은 정보를 회사의 사전 승낙 없이 복제, 송신, 출판, 배포, 방송 기타 방법에 의하여 영리목적으로 이용하거나 제3자에게 이용하게 하여서는 안됩니다.</li>
					<li>3) 이용자(고객)의 게시물이 정보통신망법 및 저작권법 등 관련법에 위반되는 내용을 포함하는 경우, 권리자는 관련법이 정한 절차에 따라 해당 게시물의 게시중단 및 삭제 등을 요청할 수 있으며, 회사는 관련 법에 따라 조치를 취하여야 합니다.</li>
					<li>4) 회사는 전항에 따른 권리자의 요청이 없는 경우라도 권리침해가 인정될 만한 사유가 있거나 기타 회사 정책 및 관련 법에 위반되는 경우에는 관련 법에 따라 해당 게시물에 대해 임시조치 등을 취할 수 있습니다.</li>
				</ul>

				<h2 class="subtit02">제 12 조 분쟁해결</h2>
					<p class="desc-txt">이용자(고객)가 회사의 전자거래의 처리에 관하여 이의가 있을 때에는 회사에 이의를 제기하거나 금융감독원의 금융분쟁조정위원회, 한국소비자보호원의 소비자분쟁조정 위원회 등을 통하여 분쟁조정을 신청할 수 있습니다.</p>


				<h2 class="subtit02">제 13 조 준거법</h2>
				<p class="desc-txt">이 약관에서 정하지 아니한 사항은 대한민국 법령을 적용합니다.</p>

				<h2 class="subtit02">부칙</h2>
				<p class="desc-txt">이 약관은 2023년 1월 1일 부터 적용합니다.</p>
				<p class="desc-txt">이 약관은 2024년 5월 9일부터 개정하여 시행합니다.</p>
				</div>
			
			</section>
		</main>
