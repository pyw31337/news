<script type="text/javascript">

// 세션 연장 팝업 관련 로직
var iSecond;
var timerchecker = null;
var accessServer = 'PROD';

var timecheckPopOpen = false; // 화면이 이미 열려있는지 확인
// Test용으로 추후 삭제필요
var imsiTest = false;
//var imsiTest = true;

// 08시 ~ 22시 이외 업무 불가능 화면 리스트 - 2026.10
// 보험계약대출신청, 중도인출신청, 배당금신청, 중도보험금신청, 만기보험금신청,휴면보험금신청,보험료납입,보험료추가납입,보험계약대출상환,해지특별입금(실효계약), 자동이체관리
// 목록 화면 이후 2단계~ 화면등록
const timeCheckblockUrlList = [
    {
        name : '보험계약대출 신청',
        url : 'requestLoanSelectDepositAccount.do',
    },{
        name : '보험계약대출 신청',
        url : 'requestLoanCheckRequest.do',
    },{
        name : '중도인출 신청',
        url : 'withdrawalSelectDepositAccount.do',
    },{
        name : '중도인출 신청',
        url : 'withdrawalCheckAndAgreePayment.do',
    },{
        name : '배당금 신청',
        url : 'dividendSelectDepositAccount.do',
    },{
        name : '배당금 신청',
        url : 'dividendCheckAndAgreeOnPayment.do',
    },{
        name : '중도보험금 신청',
        url : 'dividedBenefitSelectDepositAccount.do',
    },{
        name : '중도보험금 신청',
        url : 'dividedBenefitCheckAndAgreePayment.do',
    },{
        name : '중도보험금 신청',
        url : 'dividedBenefitCheckAndAgreePaymentForward.do',
    },{
        name : '만기보험금 신청',
        url : 'expirationBenefitSelectDepositAccount.do',
    },{
        name : '만기보험금 신청',
        url : 'expirationBenefitCheckAndAgreePayment.do',
    },{
        name : '휴면보험금 신청',
        url : 'dormantBenefitSelectDepositAccount.do',
    },{
        name : '휴면보험금 신청',
        url : 'dormantBenefitCheckAndAgreePayment.do',
    },{
        name : '휴면보험금 신청',
        url : 'dormantBenefitCheckAndAgreePaymentForward.do',
    },{
        name : '보험료납입',
        url : 'payPremiumSelectAccount.do',
    },{
        name : '보험료납입',
        url : 'payAddPremiumSelectContract.do',
    },{
        name : '보험료납입',
        url : 'payAddPremiumSelectAccount.do',
    },{
        name : '보험계약대출 상환',
        url : 'repayLoanSelectAccount.do',
    },{
        name : '보험계약대출 상환',
        url : 'repayLoanCheckRepay.do',
    },{
        name : '해지특별입금(실효계약)',
        url : 'rescissionSpecialDepositRequest.do',
    },{
        name : '보험료 자동이체 관리',
        url : 'updatePremiumEtransferSelectAccount.do',
    },{
        name : '보험료 자동이체 관리',
        url : 'updateAddPremiumEtransferSelectAccount.do',
    },{
        name : '보험계약대출 자동이체 관리',
        url : 'updateLoanEtransferSelectEtransferAccount.do',
    }
];

initTimer = function() {

	// 10시 마감 체크 로직
    iHour = Number(new Intl.DateTimeFormat('ko-KR', {timeZone : 'Asia/Seoul', hour12 : false, hour : 'numeric'}).formatToParts(new Date())[0]?.value||'0');

    // TODO - Test용으로 추후 삭제필요
    if(imsiTest) iHour = 22;

    if(timecheckPopOpen == false){
        if( 7 >= iHour || 22 <= iHour ){
            // 08시 ~ 22시 이외 업무 불가능 화면 여부 체크
            timeCheckblockUrlList.forEach(function(item){
                if((window.url||'').includes(item.url)){
                    timecheckPopOpen = true;
                    // chkBusiHour 세션에 화면 명 셋팅 (홈에서 체크 후, 업무시간 종료 팝업 호출을 위함)
                    dialog.alert('지금은 '+item.name+'<br/>시간이 아니에요<br/><br/>영업시간 : 08:00~22:00<br/>이용시간에 다시 방문해주세요').then(function(){
                        // 홈으로 이동
                        move.go("/customer-common/home.do");

                        // 이동 중에 팝업 열리는 현상 제거
                        setTimeout( function(){
                            timecheckPopOpen = false;
                        }, 1200 );
                    });
                }
            });
        }
    }

	if (iSecond > 0) {
		iSecond--;
		$('.tttt').text(iSecond);
		if(iSecond == 60) {
			dialog.openPop('systemNotice')
			.then(function(rst){
				if(rst.result) {	// 로그인 연장
				    http.ajax('/log/loginExtension.do', {}).then(function(result){
				        clearTimeout(timerchecker);
                        fncClearTime();
                        initTimer();
				    });
				}
			});
			timerchecker = setTimeout(initTimer, 1000);
		} else {
			timerchecker = setTimeout(initTimer, 1000);
		}
	} else {
		http.ajax('/log/logout.do', {})
		.then(function(result){
			if(result.success) {
				userInfo = {};	// 초기화
			}
			move.go('/customer-common/autoLogout.do');

			setTimeout(function(){
				clearTimeout(timerchecker);
			},1000);

		});

		return;
	}
}

