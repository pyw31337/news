<script type="text/javascript">
// ============================================================
// [동시 로그아웃 감지 - 클라이언트사이드]
// ============================================================
// <목적>
//   페이지 진입 시 SSO 토큰 쿠키(_sc_a)가 없고 로그인 세션이 있으면,
//   타 시스템(CNX 또는 cnx-web-cmo)에서 로그아웃한 것으로 판단하여
//   자동 로그아웃 처리한다.
//
// <동작>
//   1. _sc_a 쿠키 존재 여부 확인
//   2. dp.Biz.isLogin()으로 클라이언트 로그인 상태 확인
//   3. 둘 다 만족(쿠키 없음 + 로그인 상태) 시:
//      a. dp.Biz.logout(true) 호출 → co/lgn/dpLogOut
//
// <배치 위치>
//   hp_head.jsp (<head> 내부, dp.biz.js 로드 직후)
//   - <body> 렌더링 전에 실행되어 UI 깜빡임 방지
//   - 모든 hp/**/*.do 화면에 공통 적용 (Tiles 설정)
//
// <제약>
//   - 서버사이드 preHandle에서 이미 세션 무효화 처리됨
//   - 클라이언트는 sessionStorage 정리만 수행
//   - CNX/CDP 간 직접 호출 없음 (쿠키 기반 감지만 수행)
// ============================================================
(function() {
	function getCookie(name) {
		var value = document.cookie.match('(^|;)\\s*' + name + '\\s*=\\s*([^;]+)');
		return value ? value.pop() : '';
	}
	function setCookie(name, value, maxAgeSec) {
		var d = new Date();
		d.setTime(d.getTime() + (maxAgeSec * 1000));
		document.cookie = name + '=' + encodeURIComponent(value) + ';expires=' + d.toUTCString() + ';path=/;secure';
	}
	if (!getCookie('_sc_a') && typeof dp !== 'undefined' && dp.Biz && dp.Biz.isLogin && dp.Biz.isLogin()) {
		dp.Biz.logout(true, false);
	}
})();
</script>
