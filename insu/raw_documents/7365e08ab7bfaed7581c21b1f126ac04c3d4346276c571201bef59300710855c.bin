              //패밀리사이트
              require(['hwlife'], function(hwlife) {
            	$('.contents .family > .sitObj').on('click', function(e){
            		e.preventDefault();
            		$('.contents .family').toggleClass('on');
            	})
            	
            	//개정중인 보험상품 메뉴명 처리용
            	$('.mainProPop').on('click', function(e){
            		e.preventDefault();
            		//alert($(this).data("file"));
            		var param = {
						scrnId: "SC_CBCP000_P20000",
						fileName: $(this).data("file"),
						productName: $(this).data("name"),
						fileYn: $(this).data("fileyn")
					};		
				
					var option = {
							callback : function(result) {
								//정상리턴의 경우
								console.log(result);
								
							}, param : param							
					}
            		hwlife.layer.showProductGuideLayer(option);
            		
            	})
              });	
            </script>            
