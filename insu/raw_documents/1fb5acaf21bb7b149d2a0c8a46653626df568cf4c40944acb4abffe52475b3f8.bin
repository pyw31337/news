<script type="text/javascript">
// ============================================================
// [동시 로그아웃 감지 - 클라이언트사이드]
// ============================================================
// <목적>
//   페이지 진입 시 SSO 토큰 쿠키(_sc_a)가 없고 로그인 세션이 있으면,
//   타 시스템(CNX 또는 cnx-web-cmo)에서 로그아웃한 것으로 판단하여
//   자동 로그아웃 처리한다.
//
// <동작>
//   1. _sc_a 쿠키 존재 여부 확인
//   2. dp.Biz.isLogin()으로 클라이언트 로그인 상태 확인
//   3. 둘 다 만족(쿠키 없음 + 로그인 상태) 시:
//      a. dp.Biz.logout(true) 호출 → co/lgn/dpLogOut
//
// <배치 위치>
//   hp_head.jsp (<head> 내부, dp.biz.js 로드 직후)
//   - <body> 렌더링 전에 실행되어 UI 깜빡임 방지
//   - 모든 hp/**/*.do 화면에 공통 적용 (Tiles 설정)
//
// <제약>
//   - 서버사이드 preHandle에서 이미 세션 무효화 처리됨
//   - 클라이언트는 sessionStorage 정리만 수행
//   - CNX/CDP 간 직접 호출 없음 (쿠키 기반 감지만 수행)
// ============================================================
(function() {
	function getCookie(name) {
		var value = document.cookie.match('(^|;)\\s*' + name + '\\s*=\\s*([^;]+)');
		return value ? value.pop() : '';
	}
	function setCookie(name, value, maxAgeSec) {
		var d = new Date();
		d.setTime(d.getTime() + (maxAgeSec * 1000));
		document.cookie = name + '=' + encodeURIComponent(value) + ';expires=' + d.toUTCString() + ';path=/;secure';
	}
	if (!getCookie('_sc_a') && typeof dp !== 'undefined' && dp.Biz && dp.Biz.isLogin && dp.Biz.isLogin()) {
		dp.Biz.logout(true, false);
	}
})();
</script>
<script>dp.Message.putAll({CDP00005:"잘못된 요청입니다.",CDP00007:"첨부 가능한 확장자가 아닙니다.",CDP00016:"{0}(을)를 선택해주세요.",CDP00020:"조회 결과가 없습니다.",CDP00022:"{0}의 형식이 잘못되었습니다.",CDP00023:"{0}(을)를 입력해주세요.",CDP00030:"{0}에 동의하여 주십시오.",CDP00031:"인증번호를 발송하였습니다.",CDP00032:"본인인증이 확인되었습니다.",CDP00035:"{0}(은)는 {1}자리 이상 입력해야 합니다.",CDP00045:"인증코드 입력제한시간이 만료되었습니다.\n인증코드 발송버튼을 누르고 재발급받은 인증코드를 입력 해 주세요.",CDP00046:"입력하신 인증번호가 올바르지 않습니다. 다시 한번 확인해주세요.",CDP00047:"계약자 본인이 아닙니다. 계약자 본인의 전화번호로 다시 시도해주세요.",CDP00057:"권한이 없는 화면입니다.",CDP00136:"다른 웹브라우저 및 모바일에서 로그인 되었습니다.",CDP00178:"로그아웃 하시겠습니까?",CDP00179:"세션이 종료되었습니다.",CDP00245:"{0} 설치프로그램이 설치되어있지 않습니다. 설치페이지로 이동하시겠습니까?",CDP00271:"로그인이 필요한 메뉴입니다.",CDP00595:"휴대폰로그인 이용제한서비스 화면입니다. 공동인증서 또는 금융인증서 로그인하시면 정상이용 가능합니다.",CDP00474:"기업고객만 이용 가능한 메뉴입니다.",CDP00475:"개인고객만 이용 가능한 메뉴입니다."});</script>
