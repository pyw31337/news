<script>

function ga4EventClose(popId , Title){
	ga4Event('닫기',Title);
	lp.close(popId);
}
function ga4Event(btnNm , title){
  	//Google Analytics
	let pageEventObj = {
			ep_click_label: btnNm,
			ep_click_area : title
	};
	dp.GA4.clickEtcEvent(pageEventObj,'0005','8');
}

document.addEventListener("DOMContentLoaded", function() {
	const chatbotButton = document.getElementById('btnChatbot');

	if(chatbotButton){
		// 첫 진입시 3초 동안 노출 후 사라지게 하기
		chatbotButton.classList.add('on');
		setTimeout(() => {
			chatbotButton.classList.remove('on');
		}, 3000);
	}
	
	// popuVoList 콘솔 로그
	const popuVoList = [
		
	];
	
	console.log('=== popuVoList ===');
	console.log(popuVoList);
});

// 업무분류값으로 챗봇 제어
(async () => {
    try {
    	var chatbotType = ""; 
        const data = await dp.hpCom.selectDutjAsrtGrouDetList('hp.chatbotType');
        if(dp.Utils.isNotEmpty(data) && dp.Utils.isNotEmpty(data.dutjAsrtGrouDetVoList)){
            for(var i=0; i<data.dutjAsrtGrouDetVoList.length; i++){
                chatbotType = data.dutjAsrtGrouDetVoList[i].dpDutjAsrtDsN01;
            }
        }

        if(chatbotType == "OFF"){
            $('#btnChatbot').hide();
        }
    } catch (error) {
        console.error("데이터 로딩 중 오류 발생:", error);
    }
})();

</script>	
