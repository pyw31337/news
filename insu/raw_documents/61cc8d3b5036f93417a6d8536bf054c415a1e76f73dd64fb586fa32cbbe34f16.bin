    var sUrl = window.location.href;
    var arrUrl = sUrl.split("https");

    if(arrUrl.length > 1){
        url =  "https" + arrUrl[1] ;

    }else{

        var arrData = sUrl.split("undefined");

        if(arrData.length > 1){
            url =  "https:/" + arrData[1] ;
        }else{
            url = sUrl ;
        }
    }

