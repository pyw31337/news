<script language="JavaScript">
/**
 * Ready
 */
$(document).ready(function(){
	// subTitle
	$("#cms_title_memo").text("고객님께서 보유하고 계신 보험계약공시지침에 대한 안내입니다.");
	
});

/**
 * 로그인페이지로 이동
 */
 function goView() {
	Loading.open();
	$("#frm").submit();
} 

