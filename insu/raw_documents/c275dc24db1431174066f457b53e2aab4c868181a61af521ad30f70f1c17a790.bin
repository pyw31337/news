	<!--// CONTENTS -->
  
<script type="text/javascript">
var selUrl = "";
require(['hwlife', 'grid'], function(hwlife, grid) {
	
    var menufrm = document.getElementById('menufrm');
    var $menufrm = $(menufrm);
	  /********************
	   * 메뉴조회
	   ********************/
    function getMenuList() {
        hwlife.secure.ajax($menufrm, {
          url: '/main/disclosure/goods/disclosurenotice/getMenuList.do',
          success: function(data) {
            //console.log(JSON.stringify(data));
            if($("#MENU_ID1").val() == ""){
            	$("#MENU_ID1").val("DF_GDDN000_P10000");
            }
            
            var list;
            var depth1 = ""; var depth2 = ""; var depth3 = ""; var depth4 = "";
            var depth1cnt = 0; var depth2cnt = 0; var depth3cnt = 0; var depth4cnt = 0;
            var autoPage = false;
            var autoPageUrl = "";
            
            for ( var i = 0; i < data.list.length ; i++ ) {
              list = data.list[i];
              
              if(list.STEP == "1"){
            	  if($("#MENU_ID1").val() == ""){
            		   var flag = (depth1cnt == 0)?"on":"off"; 
            		   setButtonUrl($("#sel1"), list.MENU_NM, list.MENU_URL, flag);
                   depth1 += setButton(list.MENU_URL, list.MEMU_ID, list.MENU_NM , flag);
                   if(flag == "on"){
                	   $("#MENU_ID1").val(list.MEMU_ID);
                	   autoPage = true;
                	   autoPageUrl = list.MENU_URL;
                   }
            	  }else{
            		   var flag = ($("#MENU_ID1").val() == list.MEMU_ID)?"on":"off";
                   setButtonUrl($("#sel1"), list.MENU_NM, list.MENU_URL, flag);
                   depth1 += setButton(list.MENU_URL, list.MEMU_ID, list.MENU_NM , flag);
            	  }
            	  depth1cnt++;
              }
              
              if(list.STEP == "2"){
                  if($("#MENU_ID2").val() == ""){
                      var flag = (depth2cnt == 0)?"on":"off"; 
                      setButtonUrl($("#sel2"), list.MENU_NM, list.MENU_URL, flag);
                      depth2 += setButton(list.MENU_URL, list.MEMU_ID, list.MENU_NM , flag);
                      if(flag == "on"){
                          $("#MENU_ID2").val(list.MEMU_ID);
                          autoPage = true;
                          autoPageUrl = list.MENU_URL;
                      }
                   }else{
                      var flag = ($("#MENU_ID2").val() == list.MEMU_ID)?"on":"off";
                      setButtonUrl($("#sel2"), list.MENU_NM, list.MENU_URL, flag);
                      depth2 += setButton(list.MENU_URL, list.MEMU_ID, list.MENU_NM , flag);
                      
                      if(flag == "on" && list.MENU_URL.length > 0){
                          autoPage = true;
                          autoPageUrl = list.MENU_URL;
                      }
                   }
                   depth2cnt++;
              }
              if(list.STEP == "3"){
                  if($("#MENU_ID3").val() == ""){
                      var flag = (depth3cnt == 0)?"on":"off"; 
                      setButtonUrl($("#sel3"), list.MENU_NM, list.MENU_URL, flag);
                      depth3 += setButton(list.MENU_URL, list.MEMU_ID, list.MENU_NM , flag);
                      if(flag == "on"){
                          $("#MENU_ID3").val(list.MEMU_ID);
                          autoPage = true;
                          autoPageUrl = list.MENU_URL;
                      }
                   }else{
                      var flag = ($("#MENU_ID3").val() == list.MEMU_ID)?"on":"off";
                      setButtonUrl($("#sel3"), list.MENU_NM, list.MENU_URL, flag);
                      depth3 += setButton(list.MENU_URL, list.MEMU_ID, list.MENU_NM , flag);
                      
                      if(flag == "on" && list.MENU_URL.length > 0){
                          autoPage = true;
                          autoPageUrl = list.MENU_URL;
                      }
                   }
                   depth3cnt++;
              }
              if(list.STEP == "4"){
                  if($("#MENU_ID4").val() == ""){
                      var flag = (depth4cnt == 0)?"on":"off"; 
                      setButtonUrl($("#sel4"), list.MENU_NM, list.MENU_URL, flag);
                      depth4 += setButton(list.MENU_URL, list.MEMU_ID, list.MENU_NM , flag);
                      if(flag == "on"){
                          $("#MENU_ID4").val(list.MEMU_ID);
                          autoPage = true;
                          autoPageUrl = list.MENU_URL;
                      }
                   }else{
                      var flag = ($("#MENU_ID4").val() == list.MEMU_ID)?"on":"off";
                      setButtonUrl($("#sel4"), list.MENU_NM, list.MENU_URL, flag);
                      depth4 += setButton(list.MENU_URL, list.MEMU_ID, list.MENU_NM , flag);
                      
                      if(flag == "on" && list.MENU_URL.length > 0){
                          autoPage = true;
                          autoPageUrl = list.MENU_URL;
                      }
                   }
                   depth4cnt++;
              }
            }
            $("#menu1").html(depth1); $("#menu_L1").html(depth1);
            $("#menu2").html(depth2); $("#menu_L2").html(depth2);
            $("#menu3").html(depth3); $("#menu_L3").html(depth3);
            $("#menu4").html(depth4); $("#menu_L4").html(depth4);
            
            //console.log("autoPage : "+autoPage);
            //console.log("autoPageUrl : "+autoPageUrl);
            
            if(autoPage){
            	goFrm(autoPageUrl);
            	return;
            }
          },
          error: function(request, status, error){
            console.log("code:"+request.status+"\n"+"message:"+request.responseText+"\n"+"error:"+error);
          }      
        });
      }
     
    /********************
     * 링크구성
     ********************/
     function setButton(MENU_URL, MEMU_ID, MENU_NM, flag){
    	 var rtnHtml = "";
    	 if(flag == "on"){
    		 rtnHtml = "<li><button type=\"button\" class=\"on ck-button\" title=\"선택됨\" data-url=\""+MENU_URL+"\" data-id=\""+MEMU_ID+"\"><span>"+MENU_NM+"</span></button></li>";
    	 }else{
    		 rtnHtml = "<li><button type=\"button\" class=\"ck-button\" data-url=\""+MENU_URL+"\" data-id=\""+MEMU_ID+"\"><span>"+MENU_NM+"</span></button></li>";
    	 }
    	  return rtnHtml;
     }
     
     /********************
      * 선택여부 확인
      ********************/
     function setButtonUrl(obj, MENU_NM, MENU_URL, flag){
    	 if(flag == "on"){
    		 obj.text(MENU_NM);
    		 if(MENU_URL != ""){
    			 obj.parent().attr("class","on");
    		 }
    	 }
     }

     /********************
      * 조회및 화면이동전 DataSetting
      ********************/
      function setFrmData(idno, dataId, dataurl){
    	  $("#MENU_ID"+idno).val(dataId);
    	  if(dataurl == ""){
    		  $("#menu"+idno).parent().attr("class","");
    	  }
    	  for(var i = idno+1; i <= 4 ; i++ ){
    		  $("#MENU_ID"+i).val("");
    		  $("#menu"+i).empty();
    		  $("#menu_L"+i).empty();
    		  $("#menu"+i).parent().attr("class","");
    		  $("#sel"+i).text("");
    	  }
      }
     
      /********************
       * 조회및 화면이동전 DataSetting (펼침메뉴)
       ********************/
      function setFrmDataL(idno, tmp){
    	  //펼침셋팅
    	  $("#menu_L"+idno+" button").attr("class","ck-button");
		  $("#menu_L"+idno+" button").removeAttr("title");
    	  tmp.attr("class","on ck-button");
		  tmp.attr("title","선택됨");
    	  //콤보셋팅
    	  var id = tmp.attr("data-id");
    	  $("#sel"+idno).text("");
        $.each($("#menu"+idno+" li > button"), function(idx, obj){
            if($(obj).attr("data-id") == id){
              $(obj).attr("class","on ck-button");
			  $(obj).attr("title","선택됨");
              $("#sel"+idno).text(tmp.text());
            }else{
              $(obj).attr("class","ck-button");
			  $(obj).removeAttr("title");
            }
        });
     }
      
      /********************
       * 조회및 화면이동전 DataSetting (콤보박스)
       ********************/
      function setFrmDataC(idno, tmp){    	  
    	  var id = tmp.attr("data-id");
    	  //펼침셋팅
        $.each($("#menu_L"+idno+" li > button"), function(idx, obj){
          if($(obj).attr("data-id") == id){
        	  $(obj).attr("class","on ck-button");
			  $(obj).attr("title","선택됨");
          }else{
        	  $(obj).attr("class","ck-button");
			  $(obj).removeAttr("title");
          }
        });
     }
      
     /********************
      * 조회및 화면이동
      ********************/
      function goFrm(url){
    	  $('.tab_ty1 > li > a').css('cursor', 'pointer').removeClass('js-default').removeAttr('tabindex');
    	  for(var i=1;i<5;i++){
        	  if($('#menu'+i).find('li').length == 0){
      		  	$('#sel'+i).css('cursor', 'default').addClass('js-default').attr('tabindex', '-1');
          	  }    		  
    	  }
          if(url == ""){
              getMenuList();
          }else{
        	  selUrl = url;
        	  if($("#MENU_ID1").val() == "DF_GDDN000_P10000"){
               hwlife.secure.submit($menufrm, { 
                 url : url
               });
        	  }else if($("#MENU_ID2").val() == "DF_GDPF000_P30000" || $("#MENU_ID2").val() == "DF_GDPF000_P40000" || $("#MENU_ID2").val() == "DF_GDPF000_P50000"){
        		   window.open(url);
        		   return;
             }else if($("#MENU_ID3").val() == "DF_GDVD000_P5P600"){
               hwlife.util.openLayer({
                  id: 'ajaxLayer4',
                  title: '변액보험펀드 용어설명',
                  url: "/main/disclosure/goods/variableinsurance/DF_GDVD000_P5P600.do",
                  width:900, //레이어팝업 넓이 px 단위 입력
                  height:776, //레이어팝업 높이 px 단위 입력
                  closebutton : true,
                  //dom: $('.layer1') // 레이어 팝업 id/class 지정
                });
            }else{
               $("#inn_wrap").empty();
               var elseParam = {};
               
               if(url.indexOf('DF_GDGL000_P10000.do')>-1){//판매중인상품
            	   //<!-- 검색엔진을 통해 들어온 경우 param.schText등이 전달될수 있음 -->
            	   elseParam['schText'] =  '';
               }
               
               hwlife.secure.ajax($menufrm, {
                 url: url,
                 data:$.param(elseParam),
                 success: function(data) {
                 //console.log(JSON.stringify(data));
                   $("#inn_wrap").html(data);
                 },
                 error: function(request, status, error){
                   console.log("code:"+request.status+"\n"+"message:"+request.responseText+"\n"+"error:"+error);
                 }
               });
        	  }
        	  //공시실 브라우저 타이틀
        	  hwlifeUI.setTabTitle($('.tab_ty1 > li'));
          }
      }
      
    	$('.btn_ds').on('click', function(e){ goFrm(selUrl);});
    	
    	$('.btn_dm_on').on('click', function(e){ 
    		$(".tab_sub_ty1").hide();
			$('.tab_depth1 li').removeClass('on')
    	});
    	$('.btn_dm_off').on('click', function(e){
    	});
     
      $('#menu1').on('click', '.ck-button'  , function(e){ setFrmDataC(1, $(this)); setFrmData(1, $(this).attr("data-id"),$(this).attr('data-url')); goFrm($(this).attr('data-url')); });
      $('#menu_L1').on('click', '.ck-button'  , function(e){ setFrmDataL(1, $(this)); setFrmData(1, $(this).attr("data-id"),$(this).attr('data-url')); goFrm($(this).attr('data-url')); });
      $('#menu2').on('click', '.ck-button'  , function(e){ setFrmDataC(2, $(this)); setFrmData(2, $(this).attr("data-id"),$(this).attr('data-url')); goFrm($(this).attr('data-url')); });
      $('#menu_L2').on('click', '.ck-button'  , function(e){ setFrmDataL(2, $(this));setFrmData(2, $(this).attr("data-id"),$(this).attr('data-url')); goFrm($(this).attr('data-url')); });
      $('#menu3').on('click', '.ck-button'  , function(e){ setFrmDataC(3, $(this));setFrmData(3, $(this).attr("data-id"),$(this).attr('data-url')); goFrm($(this).attr('data-url')); });
      $('#menu_L3').on('click', '.ck-button'  , function(e){ setFrmDataL(3, $(this));setFrmData(3, $(this).attr("data-id"),$(this).attr('data-url')); goFrm($(this).attr('data-url'));});
      $('#menu4').on('click', '.ck-button'  , function(e){ setFrmDataC(4, $(this));setFrmData(4, $(this).attr("data-id"),$(this).attr('data-url')); goFrm($(this).attr('data-url')); });
      $('#menu_L4').on('click', '.ck-button'  , function(e){ setFrmDataL(4, $(this));setFrmData(4, $(this).attr("data-id"),$(this).attr('data-url')); goFrm($(this).attr('data-url')); });
      
      getMenuList();
      
      /********************
       * tab_ty1 하위 리스트가 없을 때, default 시키기
       ********************/
      $('#sel2').css('cursor', 'default').addClass('js-default').attr('tabindex', '-1');
      $('#sel3').css('cursor', 'default').addClass('js-default').attr('tabindex', '-1');
      $('#sel4').css('cursor', 'default').addClass('js-default').attr('tabindex', '-1');
      
      /********************
       * 파일다운로드(한화생명 공시업무규정)
       ********************/
      $(".DF_GDDN000_P10000_ck-btnPdf").click(function(){
        var option = {
        	    file_url:"/announce/goods/notice/",
        	    file_name: "보험상품공시제도웹용.pdf"
        };
        hwlife.util.fileDownload("/kinc/download_chk.asp", option);
        
      });
      
      $('#btnPrint').on('click', function() {
          hwlife.util.printArea();
      });

});
</script>

</section>
