<script>
//스크롤막기, GNB 클래스 변경
function scrollDisable(){
	$('body').addClass('scrollDisable');
	$('#headerGnb').addClass('headerfixed');
}
function scrollAble(){
	$('body').removeClass('scrollDisable');
	$('#headerGnb').removeClass('headerfixed');
}

// 슬라이드 검색 모달
var btn = document.getElementById("gnbShBtn");
var shclose = document.getElementById("gnbShBtnHide");
var modal = document.getElementById("gnbShModal");

// 모달 오픈
btn.onclick = function() {
	modal.style.display = "block";
	shclose.style.display = "block";
	// 검색어 삭제
	$("#srchMenuNm").val("");
	$(".shresultText p, .shresultBox li").remove();
	$(".shresultText, .shresultBox").addClass("hide");
	//body fixed
	scrollDisable();
}

// 닫기
shclose.onclick = function() {
	modal.style.display = "none";
	shclose.style.display = "none";
	//body 원래대로
	scrollAble();
}

// 배경여백 클릭시 닫기
window.onclick = function(event) {
	if (event.target == modal) {
		modal.style.display = "none";
		shclose.style.display = "none";
		//body 원래대로
		scrollAble();
		
	}
}

function qrInfoPopOpen1(){
	$('#qrInfoPop1').css('display', 'block');
}
function qrInfoPopOpen2(){
	$('#qrInfoPop2').css('display', 'block');
}
function qrInfoPopOpen3(){
	$('#qrInfoPop3').css('display', 'block');
}
function qrInfoPopOpen4(){
	$('#qrInfoPop4').css('display', 'block');
}
function qrInfoPopClose(){
	$('.qrInfoPop').css('display', 'none');
}
</script>
