		ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메뉴", "보상서비스", "보험금청구하기");
		ampNacf.setBizNmCd("보험금청구하기", "");
	} else if (evtHref.indexOf("cyber/acd/AcdUserStep2.nhfire") >= 0) {
		ampNacf.setEvtNm('home_menu_claimlist');
		ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메뉴", "보상서비스", "보상처리현황조회");
