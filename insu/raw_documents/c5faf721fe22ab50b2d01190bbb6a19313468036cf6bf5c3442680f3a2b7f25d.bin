<script type="text/javascript">
<!--
	$("#calTabMenu li, #calSubTabMenu li a, #calSubTabMenu2 li a").each(function(){
		if($(this).hasClass('on')){
		   $(this).attr('title', '선택됨');
		} else {
		   $(this).removeAttr('title');
		}
	});
    // 메뉴탭 클릭 //
    $("#calTabMenu li").bind("click",function() {
    	$("#calTabMenu li").removeClass("on").removeAttr('title');
        $(this).addClass("on").attr('title', '선택됨').siblings().removeClass("on").removeAttr('title');
        var tabCnt = $("#calTabMenu li").index(this);
       // alert(tabCnt);
        $(".calTab").hide();
        $(".calTab").eq(tabCnt).show();
    });

    // 예적금 서브탭 클릭 //
    $("#calSubTabMenu li").bind("click",function() {
        $("#calSubTabMenu li a").removeClass("on").removeAttr('title');
        $(this).children().addClass("on").attr('title', '선택됨').siblings().removeClass("on").removeAttr('title');
        var tabCnt = $("#calSubTabMenu li").index(this);
       // alert(tabCnt);
        $(".calSubTab").hide();
        $(".calSubTab").eq(tabCnt).show();
    });

    // 가치 서브탭 클릭 //
    $("#calSubTabMenu2 li").bind("click",function() {
        $("#calSubTabMenu2 li a").removeClass("on").removeAttr('title');
        $(this).children().addClass("on").attr('title', '선택됨').siblings().removeClass("on").removeAttr('title');
        var tabCnt = $("#calSubTabMenu2 li").index(this);
       // alert(tabCnt);
        $(".calSubTab2").hide();
        $(".calSubTab2").eq(tabCnt).show();
    });

//-->
function footerPdfView(val) {
	if(val == "1") {
        fileName = "붙임2. 정보보호 관리체계 인증서2.pdf";
        var url = '/file/cert/'+fileName;
    }
	var winWidth = document.body.clientWidth; // 현재창의 너비
	var winHeight = document.body.clientHeight; // 현재창의 높이
	var popupX = (winWidth - 670) / 2;
	var popupY = (screen.height - 550) / 2;
	var option = 'width=1000px, height=700px, resizable=no, scrollbars=no, status=no, top=' + popupY + ', left=' + popupX;
	window.open(url, 'uPopup', option);
}
</script>
 
  
    <!-- Footer 끝 -->
    <!-- quick menu 시작 -->
    
    <div class="quick_menu">
        <ul>
            <li class="qm01"><a href="/customer/custconsult/createEmailConsultForm.nhfire">고객상담</a></li>
            <li class="qm02"><a href="/faq/retrieveFaqList.nhfire">자주묻는질문</a></li>
            <li class="qm03"><a href="/location/CustomerCenterLocationListAll.nhfire">지점찾기</a></li>
            <li class="qm04"><a href="/event/event/retrieveProgressEventList.nhfire">이벤트</a></li>
            <li class="qm05"><a href="/customer/guide/mobileCertification.nhfire">인증센터</a></li>
        </ul>
        <a href="#wrap" class="btn_top">TOP</a>
    </div>
    
    <!-- //quick menu 종료 -->
</div>




