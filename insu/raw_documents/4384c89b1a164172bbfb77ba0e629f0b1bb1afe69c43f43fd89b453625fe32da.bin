			}
			// [common] end
			if($('#smartNotice').val() >= 1){
				$('#lastLoginDate').prepend('<a href="/smart-advice/smartNotice.do" title="알람이 도착했습니다." class="smart-alarm"></a>');
			};

      if(session.getUserInfo()){
        $('#lastLoginDate').append(session.getUserInfo().lastLoginDt);
      }
