						//window.open("/main/insurance/counsel/IN_IRN0000_W10000.do?DI_GUBUN=HSPQUICK&CONTENT=홈페이지퀵메뉴", "counsel", "Scrollbars=yes, width=552, height=800, top=" + popupY);
					});

                    // 이메일 상담
                    $('#go_email').on('click', function (e) {
                        if (!hwlife.util.checkLogin()) {
                            if (confirm('이메일 상담은 로그인 후 이용하실 수 있습니다.\n로그인으로 이동하시겠습니까?')) {
                                location.href = "/main/customerCenter/petition/CU_CR00000_P20000.do?type=1";
                            }
                        } else {
                            location.href = "/main/customerCenter/petition/CU_CR00000_P20000.do?type=1";
                        }
                    });

                    $('body').on('click', '#btnARS', function () {
                        hwlife.layer.arsLayer();
                    });
                    
                    // $('body').on('click', '#E_ServiceBtn', function () {
