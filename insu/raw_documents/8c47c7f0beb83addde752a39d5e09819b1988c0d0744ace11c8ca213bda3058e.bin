        <script type="text/javascript">
            
            
            //javascript에서 device 정보 필요한 경우 사용
            function getDevice() {
                return 'pc';
            }
            //공인인증서 사용을 위한 서버 공개키값
            function getSvrCert() {
                //MainAuthorizer 에서 isSecure or 로그인 되어 있을 경우
                //var svrCert 변수에 공개키값을 생성해 준다.
                
                try {

                    if (typeof svrCert != 'undefined') {
                        return svrCert;
                    } else {
                        return '';
                    }
                } catch (e) {
                    return '';
                }
            }

            //http -> https 로 변경
            if (location.protocol == 'http:') {
                location.href = location.href.replace(/^http:/, 'https:');
            }

        </script>
        
