        jQuery(document).ready(function() {
            jQuery('ul.h4Menu li').click(function() {
                var menuId = jQuery(this).attr('id');
                var url = jQuery(this).find('a').attr('id');
                jQuery('#oFaqSearchParam').val(menuId);
                jQuery('#oMenuIdForm').attr('action', url).submit();
            })
        });
        function handleError(err, url, line) {
            alert('Error : ' + err + '\nURL: ' + url + '\nLine:' + line);
            return true;
        }
        document.oncontextmenu=new Function("return false") /* 마우스 오른쪽 클릭 막기 */
        //window.onerror = handleError;
        </script>
        

