	0% {background-position:50% 0}
	100% {background-position:50% -1720px} 
} 
.chatbot_bann > button.btn_chatbot:hover{width:263px}
.chatbot_bann > button.btn_chatbot:hover:before{display:block;position:absolute;bottom:12px;right:43px;width:200px;height:62px;padding:11px 50px 11px 25px;border-radius:31px 0 0 31px;border: 0;background:#0065b3;font-size:14px;line-height:20px;color:#fff;letter-spacing:-1px;overflow:hidden;box-sizing:border-box;content:"무엇이든 궁금한 점을 \A 왕구에게 물어보세요"}
