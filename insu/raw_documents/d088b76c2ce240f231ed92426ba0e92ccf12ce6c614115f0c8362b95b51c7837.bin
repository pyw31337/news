		}
		if('04' == ampVal) {
			ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메뉴", "보호금융상품등록부", "보호금융상품등록부");
			ampNacf.setBizNmCd("보호금융상품등록부", "");
			ampNacf.setEvtNm('home_menu_bottom_privateinfo');
			ampNacf.addLogBasic(ampEventInfo);
			location.href = "/announce/financialProtectionRegister/retrieveFinancialProtectionRegister.nhfire";	
		}
		if("05" == ampVal) {
			ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메뉴", "상품공시", "상품공시");
			ampNacf.setBizNmCd("상품공시", "");
			ampNacf.setEvtNm('home_menu_bottom_privateinfo');
			ampNacf.addLogBasic(ampEventInfo);
			location.href = "/announce/productAnnounce/announceServiceGuide.nhfire";	
		}
		if("06" == ampVal) {
			ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메뉴", "가격공시", "가격공시");
			ampNacf.setBizNmCd("가격공시", "");
			ampNacf.setEvtNm('home_menu_bottom_privateinfo');
			ampNacf.addLogBasic(ampEventInfo);
			location.href = "/announce/retrieveAnnounceList.nhfire";	
		}

	}
</script>


