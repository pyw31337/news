                    </div>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-4x btn-yellow" id="ok-action">확인</button>
        </div>
        <button type="button" class="modal-close"><span>레이어 닫기</span></button>
    </div>
</section><!-- 개인정보수집 및 이용동의(KB국민인증서 인증서) -->
	
  
<!-- s: modal KB국민인증서 이용 동의 -->
