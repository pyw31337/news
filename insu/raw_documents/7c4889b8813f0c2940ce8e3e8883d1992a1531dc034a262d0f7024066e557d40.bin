                            <tr>
                                <th scope="row">일반개인정보</th>
                                <td class="left-align">CI값, 성명, 생년월일, 휴대전화번호</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="panel type-2">
                    <div class="agreeArea mb-0">
                        <p class="txt1"><strong>위 <span class="agree_name">개인(신용)정보 수집&#183;이용</span>에 동의하십니까?</strong></p>
                        <div class="form-row mt-3">
                            <label class="input-radio" for="personalRadioAgreementFalse">
                                <input name="personalRadioAgreement" type="radio" id="personalRadioAgreementFalse" title="동의하지 않음">
                                <span>동의하지 않음</span>
                            </label>
                            <label class="input-radio" for="personalRadioAgreementTrue">
                                <input name="personalRadioAgreement" type="radio" id="personalRadioAgreementTrue" title="동의함">
