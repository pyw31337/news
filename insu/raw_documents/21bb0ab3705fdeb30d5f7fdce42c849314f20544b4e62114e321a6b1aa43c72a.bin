        if(tNumber == "T60000") {
          $('.jumbotron h1 > span').html("금융소비자권리");
          $(".jumbotron .leadText").html("알아두면 좋은 금융소비자 권리를 안내드립니다.");
        }

        // 금융소비자보호 내부통제기준
