	<script type="text/javascript">
	
	function setGtagByProp(eventname, eventProperties){
		eventProperties.device_type = 'pc_web(homepage)';
		console.log('setGtagByProp:' + eventname);
		console.log('eventProperties:' + eventProperties);
		
		
		
			gtag('event', eventname , eventProperties);
		
		
		
	}
