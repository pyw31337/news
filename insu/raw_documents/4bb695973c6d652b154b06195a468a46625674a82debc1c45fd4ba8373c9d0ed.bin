		<script id="tmplRegularList" type="text/template">
<@ _.each(years , function(year) { @>
<@ var item = data[year]; console.log(year); console.log(item); @>
<@	item = _.groupBy(item , function(o , i){ return o.sQuarter; });  @>
<@	item = Object.keys(item).map(function(i){return item[i];}); console.log(item); @>
<tr>
	<th class="bg_dffbf9"><@=year@></th>
	<@ _.each(item , function(o , i) { @>
		<td>
			<@ o = _.sortBy(o, 'sTitle'); @>
			<@ _.each(o , function(oo , ii) { @>
			<a href="/download/<@= oo.sFileID @>" target="_blank"  class="td_btn acrobat_btnB">
				<@ if(!(oo.sFileID||'').match(/^\s*$/)) { @>
					<@= oo.sTitle @>
				<@ }@>
			</a>
			<@ }) @>
		</td>
	<@ }) @>
	<@ var len = item.length;  if(len < 4){ @>
		<@ _.each(new Array(4-len) , function(o , i) { @>
			<td></td>
		<@ }) @>
	<@}@>
</tr>
<@ }) @>

</script>
<script>
$(function(){
	api
	.call({
		url : '/w/disclosure/manage/getRegularMngDisclosure.json',
		success : function(data) {
			var result = data.body;
			var _target = $('#targetRegularList');
			var arr = new Array();
			var index = 0;
		
			_target.empty();

			_.each(result , function( o , i ){
				var bfYear = o.sYear;
				var afYear = _.isUndefined(result[i+1]) ? '' : result[i+1].sYear;
				
				if(bfYear != afYear){ index++; }
// 				if(index > 3) {return false};
					arr.push(o);
			});
			
			var list = _.groupBy(arr , function(o , i){ return o.sYear; });
			var years = _.chain(list).keys().sortBy(function(y) { return y * -1 }).value();
			
			tmpl.insert(_target, '#tmplRegularList', { years: years, data:list });
			
		}
	});
	
 
});
</script>
	
	
			
