}
div {
    display: block;
}
.titArea.typeAqua {
    background: #01c1d6;
}
.titArea {
    padding: 57px 56px 50px;
}
.titArea {
    width: auto;
    padding: 40px 20px 44px;
    line-height: 1em;
    color: #fff;
    background: #f1352b;
}
.titArea .heading {
    padding-bottom: 28px;
    line-height: 1.56em;
    font-size: 18px;
}
h1, h2, h3, h4, h5, h6 {
    font-weight: normal;
}
body, div, dl, dt, dd, ul, ol, li, h1, h2, h3, h4, h5, h6, pre, code, form, fieldset, legend, select, input, textarea, p, blockquote, th, td {
    margin: 0;
    padding: 0;
}
h2 {
    display: block;
    font-size: 1.5em;
    -webkit-margin-before: 0.83em;
    -webkit-margin-after: 0.83em;
    -webkit-margin-start: 0px;
    -webkit-margin-end: 0px;
    font-weight: bold;
}
h3 {
    display: block;
    font-size: 2.37em;
    -webkit-margin-before: 1em;
    -webkit-margin-after: 1em;
    -webkit-margin-start: 0px;
    -webkit-margin-end: 0px;
    font-weight: bold;
}

.titArea {
    width: auto;
    padding: 40px 20px 44px;
    line-height: 1em;
    color: #fff;
    background: #f1352b;
}
