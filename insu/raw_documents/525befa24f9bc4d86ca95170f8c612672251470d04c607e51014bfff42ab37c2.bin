var position = "";
//메뉴 클릭이벤트 공통처리
function menuBottomClickEvent(evt){
	
	var evtClass = ampNacf.NVL(evt.target.parentNode.className, "");
    var evtHref = ampNacf.NVL(evt.target.href, "");
    console.log("menuBottomClickEvent(홈페이지 바닥 bottom 메뉴 클릭) className:" + evtClass + ",   target.href:" + evtHref);
	
    if (ampNacf.isNull(evtHref))           return;

    var ampEventInfo = {};
    ampNacf.setEvtNm('');
    position = "bottom";
    
    if (evtHref.indexOf("announce/managementAnnounce/retrievePeriodicManagementAnnounce.nhfire") >= 0) {
        ampNacf.setEvtNm('home_menu_bottom_disclosure');
        ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메뉴", "공시정보", "경영공시");
        ampNacf.setBizNmCd("정기경영공시", "");
    } else if (evtHref.indexOf("announce/managementAnnounce/retrieveAnytimeManagementAnnounce.nhfire") >= 0) {
        ampNacf.setEvtNm('home_menu_bottom_disclosure');
        ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메뉴", "공시정보", "경영공시");
        ampNacf.setBizNmCd("수시경영공시", "");
    } else if (evtHref.indexOf("announce/managementAnnounce/retrieveControlStructureAnnounce.nhfire") >= 0) {
        ampNacf.setEvtNm('home_menu_bottom_disclosure');
