						addStr += "<td class='gryetext_13px bottomline'>"+ list226[j] +"</td>";
					}else{
						addStr += "<td class='gryetext_13px bottomline'></td>";
					}
				}
				// 저축성 공시이율
				else if(titleCdList[i] == '212' && typeof(list212[j]) != 'undefined') {
					
					if(j < list212.length){
						addStr += "<td class='gryetext_13px bottomline'>"+ list212[j] +"</td>";
					}else{
						addStr += "<td class='gryetext_13px bottomline'></td>";
					}
					
				}
				// 저축성 공시이율(2)
				else if(titleCdList[i] == '218' && typeof(list218[j]) != 'undefined') {
					if(j < list218.length){
						addStr += "<td class='gryetext_13px bottomline'>"+ list218[j] +"</td>";
					}else{
						addStr += "<td class='gryetext_13px bottomline'></td>";
					}
				}
				// 저축성 공시이율(3)
				else if(titleCdList[i] == '223' && typeof(list223[j]) != 'undefined') {
					if(j < list223.length){
						addStr += "<td class='gryetext_13px bottomline'>"+ list223[j] +"</td>";
					}else{
						addStr += "<td class='gryetext_13px bottomline'></td>";
					}
				}
				// 저축성 공시이율(4)
				else if(titleCdList[i] == '225' && typeof(list225[j]) != 'undefined') {
					if(j < list225.length){
						addStr += "<td class='gryetext_13px bottomline'>"+ list225[j] +"</td>";
					}else{
						addStr += "<td class='gryetext_13px bottomline'></td>";
					}
				}
				// 저축성 공시이율(5)
				else if(titleCdList[i] == '227' && typeof(list227[j]) != 'undefined') {
					if(j < list227.length){
						addStr += "<td class='gryetext_13px bottomline'>"+ list227[j] +"</td>";
					}else{
						addStr += "<td class='gryetext_13px bottomline'></td>";
					}
				}
				// 손해공시이율(2)(구 공시이율(8))
				else if(titleCdList[i] == '215' && typeof(list215[j]) != 'undefined') {
					if(j < list215.length){
						addStr += "<td class='gryetext_13px bottomline'>"+ list215[j] +"</td>";
					}else{
						addStr += "<td class='gryetext_13px bottomline'></td>";
					}
				}
				// undefined 처리
				else{
					addStr += "<td class='gryetext_13px bottomline'></td>";
				}
			}
		}
		addStr += "    </tr>" ;
	}
	$("#draw").append(addStr);
}

