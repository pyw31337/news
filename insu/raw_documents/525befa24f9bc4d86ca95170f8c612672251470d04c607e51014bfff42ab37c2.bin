/*
 * 상품상세 안내 각 탭에 해당하는 내용 보이기
 */
function fnChangeContents(oId, tabTitle) {
    jQuery('#test1').css('display', 'none');
    jQuery('#test2').css('display', 'none');
    jQuery('#test3').css('display', 'none');
    jQuery('#test4').css('display', 'none');
    jQuery('#' + oId).css('display', '');
    fnChangeTitle(tabTitle);
}

/*
 * 첨부파일 다운로드
 */
function fnFileDownload(fileId, afileSeqn) {
    jQuery('#oDownloadFileId').val(fileId);
    jQuery("#oDownloadAfileSeqn").val(afileSeqn);
    jQuery("#oDownloadForm").attr("action", "/imageView/downloadFile.ajax;jsessionid=hE1YZvaBZzlDttFqBO18ZDQC4ErZZ6XWFYIXEOB17hUcZZ7FTaWfTA0yLiwHXjvO.nphpws01_servlet_NHpCm01").attr("target", "_self").submit();
}

/*
 * 조회
 */
function goSeachList(year, inttrNm){
	//jQuery("#oForm").attr('action', '/announce/productAnnounce/applicableInterestRateAnnounce.nhfire;jsessionid=hE1YZvaBZzlDttFqBO18ZDQC4ErZZ6XWFYIXEOB17hUcZZ7FTaWfTA0yLiwHXjvO.nphpws01_servlet_NHpCm01').submit();
	
	var url = '/announce/productAnnounce/applicableInterestRateAnnounce.ajax';
    var aJax = new devon.xSync(url);
    aJax.addQuery('type', 'ajax');
    aJax.addQuery('year', year);
    aJax.addQuery('inttrNm', inttrNm);
    aJax.fire();
}

/*
 * 조회가능 연도셋팅
 */
function fnSetYear() {
	
	var nowDate = "20261118";
	var setDate = nowDate.substring(0, 4);
	
	var addStr = "";
	
	for(var i = setDate; i > 2004; i--) {
		addStr += "<option value=" + i + ">" + i + "</option>";
	}
	$("#year").append(addStr);
}

/*
 * 공시기준이율 조회 연월 세팅
 */
function fnSetNtfyBasYM() {

	var nowDate = "20261118";
	var year = nowDate.substring(0,4);
	var month = nowDate.substring(4,6);

	var addStr = "";


	
	
	for (var i = year; i > 2011; i--) {  // 2012년 3월까지

		if(i == year){
			for (var j = month; j > 0; j--) {
	
				if (i == 2012 && j == 2) break;
	
				if (j.toString().length == 1) {
					j = '0' + j; 
				}
				addStr += "<option value=" + i + j + '01' + ">" + i + '년' + j + '월' + "</option>";
	        }
		}else{
			for (var j = 12; j > 0; j--) {
				
				if (i == 2012 && j == 2) break;
	
				if (j.toString().length == 1) {
					j = '0' + j; 
				}
				addStr += "<option value=" + i + j + '01' + ">" + i + '년' + j + '월' + "</option>";
	        }		
			
			
		}
	}

	$("#selNtfyBasYM").append(addStr);
}

