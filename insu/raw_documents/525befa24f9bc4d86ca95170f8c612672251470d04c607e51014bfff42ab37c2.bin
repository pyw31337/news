<!-- subFrontAmplitude.jsp -->
<script type="text/javaScript">

$(document).ready(function() {
	//고객여정 페이지이벤트 등록
	//setTimeout(function(){
		var pageAmpEvtInfo = [
			{"evtNm" : "home_menu",	"condiCd" : "thisId",	"condiChkVal" : "headerGnb",	"procFunc" : "menuClickEvent"},	//메뉴
			{"evtNm" : "home_menu", "condiCd" : "thisId",   "condiChkVal" : "bottomArea",    "procFunc" : "menuBottomClickEvent"}, //메뉴
		];
		
