                                <th class="Titext1 bgg">현재가치</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="contant lineb hpx40 inp"><input type="text" id="oCurrentValueArea" name="currentValueArea" class="wp95" readonly="readonly" style="text-align:center;" title="현재가치 보기" /></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- 현재가치 끝 //-->

            <!-- 미래가치 시작 //-->
            <div class="calSubTab2" style="display:none;">
                <p class="popupSubTitle ml15">가치 계산</p>
                <div class="ProTable ml15 mr15 mb20 wpx500">
                    <table width="100%" cellspacing="0" cellpadding="0" border="0" summary="현재가치,기간(년후),적용이율(%),가치계산방법을 입력하는 가치 계산(미래가치) 입력 테이블입니다.">
                        <caption>가치 계산</caption>
                        <colgroup>
                            <col width="25%" />
                            <col width="25%" />
                            <col width="25%" />
                            <col width="25%" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th class="Titext1 bgg">현재가치</th>
                                <th class="Titext1 bgg">기간(년후)</th>
                                <th class="Titext1 bgg">적용이율(%)</th>
                                <th class="Titext1 bgg">가치계산방법</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="contant lineb hpx40 inp"><input type="text" id="oFutureValCurrentValue" name="futureValCurrentValue" class="wpx100" maxlength="13" onkeydown="onlyNumber(event, this);" onkeyup="AddCommaValue(this);" style="text-align:right; padding-right:1px" value="" title="현재가치 입력" /></td>
                                <td class="contant lineb inp"><input type="text" id="oFutureValPeriod" name="futureValPeriod" class="wpx100" maxlength="3" onkeydown="onlyNumber(event, this);" style="text-align:right; padding-right:1px" value="1" title="기간 입력" /></td>
                                <td class="contant lineb inp"><input type="text" id="oFutureValApplyIntRate" name="futureValApplyIntRate" class="wpx100" maxlength="5" onkeydown="onlyNumberIncludeDot(event, this);" style="text-align:right; padding-right:1px" value="" title="적용이율" /></td>
                                <td class="contant lineb sel">
                                    <select id="oFutureValCalculateMethod" name="futureValCalculateMethod" title="가치계산방법 선택" class="wpx80">
                                        <option value="0">월복리</option>
                                        <option value="1">연복리</option>
                                    </select>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div>
                    <span class="btn_pack wseabtn"><a href="#nolink" onclick="fnResetFutureValue();">재입력</a></span>
                    <span class="btn_pack seabtn"><a href="#nolink" onclick="fnCalculateFutureValue();">계산하기</a></span>
                </div>

                <p class="popupSubTitle ml15 mt30">계산결과</p>
                <div class="ProTable ml15 mr15 mb30 wpx500">
