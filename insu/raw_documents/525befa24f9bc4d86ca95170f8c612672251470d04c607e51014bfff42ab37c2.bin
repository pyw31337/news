/*
 * 적용이율표 데이터 셋팅
 */
function makeGridValue(inttrList, detlHstDt) {
	
	var cnt = 0;
	var lengthChk = "";
	
	var rtnList = new Array();

	
	for(var j = 0; j < inttrList.length; j++) {
		
		lengthChk = inttrList[j] + "";
		var detlDt = (detlHstDt[j]+"").substring(4,6);
		
		
		
		for(var i =0; i < 12; i++){
			if(i == Number(detlDt)-1){
			
				if(lengthChk.length == 3 || (lengthChk.length == 4 && lengthChk.indexOf("-") != -1)) {
					rtnList[i] = inttrList[j] + "0";
				}
				else if(lengthChk.length == 1 || lengthChk.length == 2) {
					rtnList[i] = inttrList[j] + ".00";
				}
				else{
					rtnList[i] = inttrList[j] + "";
				}
			}else{
				if(rtnList[i] == "" || typeof rtnList[i] == undefined ){
					rtnList[i] = "";
				}
			}
		}
		
		cnt++;
	}
	
	return rtnList;
}

