    	ampEventInfo.position = changeAllMenuPosition(evt);    
    }

	ampNacf.addLogBasic(ampEventInfo);
}

//이벤트명 및 position정보 셋팅
function changeAllMenuPosition(evt) {
	var isAll = ampNacf.hasBubbleCheck("allnavArea", "id", ampNacf.getEventPath(evt));
	var topHeader = ampNacf.hasBubbleCheck("topHeader", "id", ampNacf.getEventPath(evt));
	var isEtc = ampNacf.hasBubbleCheck("etcMenu", "id", ampNacf.getEventPath(evt));
//     alert("isCompany" + isCompany);
	var evtHref = ampNacf.NVL(evt.target.href, "");
    
    
    if (isAll == false) {
    	//최상단메뉴 
        if(topHeader){
            position = "top";
            if(evtHref.indexOf("login.nhfire") >=0 ){ampNacf.setEvtNm('home_top_direct');ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메인", "상단메뉴", "다이렉트");ampNacf.setBizNmCd("다이렉트메인", "");}
            if(evtHref.indexOf("direct/service/cmHybrid.nhfire") >=0 ){ampNacf.setEvtNm('home_top_cmHybrid');ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메인", "상단메뉴", "보험상담");ampNacf.setBizNmCd("하이브리드", "");}
            if(evtHref.indexOf("register.nhfire") >=0 ){ampNacf.setEvtNm('home_top_join');ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메인", "상단메뉴", "회원가입");ampNacf.setBizNmCd("회원가입", "");}
            if(evtHref.indexOf("announce/productAnnounce/retrieveInsuranceProductsAnnounce.nhfire") >=0 ){ampNacf.setEvtNm('home_top_join');ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메인", "상단메뉴", "공시정보");ampNacf.setBizNmCd("공시정보", "");}
            if(evtHref.indexOf("company.nhfire") >=0 ){ampNacf.setEvtNm('home_top_company_info');ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메인", "상단메뉴", "회사소개");ampNacf.setBizNmCd("회사소개", "");}
            if(evtHref.indexOf("company/info/socialServiceIntro.nhfire") >=0 ){ampNacf.setEvtNm('home_top_social_contribution');ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메인", "상단메뉴", "사회공헌");ampNacf.setBizNmCd("사회공헌", "");}
            if(evtHref.indexOf("introductionEng.nhfire") >=0 ){ampNacf.setEvtNm('home_top_foreign');ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메인", "상단메뉴", "FOREIGN");ampNacf.setBizNmCd("FOREIGN", "");}
            if(evtHref.indexOf("nhc/nhcMain.nhfire") >=0 ){ampNacf.setEvtNm('home_top_NHFC');ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메인", "상단메뉴", "농협FC");ampNacf.setBizNmCd("농협FC", "");}
            if(evtHref.indexOf("fpsProtection.nhfire") >=0 ){ampNacf.setEvtNm('home_top_finconsumer');ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메인", "상단메뉴", "소비자보호센터");ampNacf.setBizNmCd("소비자보호센터", "");}
            return position;
        }
		if (position == "")		return "menu";
		else					return position;
	} 
    
    if(isEtc){ //상단메뉴url 과  전체메뉴내 기타메뉴 분리를 위해  분기처리
        
        if(evtHref.indexOf("login.nhfire") >=0 ){ampNacf.setEvtNm('home_menu_etc');ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메뉴", "기타메뉴", "로그인");ampNacf.setBizNmCd("로그인", "");}
        if(evtHref.indexOf("register.nhfire") >=0 ){ampNacf.setEvtNm('home_menu_etc');ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메뉴", "기타메뉴", "회원가입");ampNacf.setBizNmCd("회원가입", "");}
        if(evtHref.indexOf("mypage/emailconsult/retrieveEmailConsultList.nhfire") >=0 ){ampNacf.setEvtNm('home_menu_etc');ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메뉴", "기타메뉴", "상담현황");ampNacf.setBizNmCd("상담현황", "");}
        if(evtHref.indexOf("voc/retrieveVocList.nhfire") >=0 ){ampNacf.setEvtNm('home_menu_etc');ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메뉴", "기타메뉴", "전자민원현황");ampNacf.setBizNmCd("전자민원현황", "");}
        if(evtHref.indexOf("mypage/membership/MembershipUpdate.nhfire") >=0 ){ampNacf.setEvtNm('home_menu_etc');ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메뉴", "기타메뉴", "개인정보조회/변경");ampNacf.setBizNmCd("개인정보조회/변경", "");}
        if(evtHref.indexOf("mypage/membership/changePasswordForm.nhfire") >=0 ){ampNacf.setEvtNm('home_menu_etc');ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메뉴", "기타메뉴", "비밀번호변경");ampNacf.setBizNmCd("비밀번호변경", "");}
        if(evtHref.indexOf("mypage/membership/membershipWithdrawStep1.nhfire") >=0 ){ampNacf.setEvtNm('home_menu_etc');ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메뉴", "기타메뉴", "회원탈퇴");ampNacf.setBizNmCd("회원탈퇴", "");}
        if(evtHref.indexOf("mypage/event/retrieveMyEventList.nhfire") >=0 ){ampNacf.setEvtNm('home_menu_etc');ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메뉴", "기타메뉴", "이벤트현황");ampNacf.setBizNmCd("이벤트현황", "");}
        if(evtHref.indexOf("multiconsult/createMultiConsultForm.nhfire") >=0 ){ampNacf.setEvtNm('home_menu_etc');ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메뉴", "기타메뉴", "가입상담");ampNacf.setBizNmCd("가입상담", "");}
     
    }
 
    
    
    
	//이벤트명 및 position정보 변경
	_eventName = _eventName.replace("_menu_", "_allmenu_");
	ampNacf.setPathMain("홈페이지_전체메뉴");
	return "allmenu";
}

//메뉴에서 상품클릭시 이동정보 이벤트등록
function ampNacf_menuProdClick(pdtCd, evtPath) {
	var isAll = ampNacf.hasBubbleCheck("allnavArea", "id", evtPath);
	
	if (isAll) {
		ampNacf.setEvtNm('home_allmenu_product');
		ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_전체메뉴", "보험상품", "상품명");
		_position = "allmenu";
	
	} else {
		ampNacf.setEvtNm('home_menu_product');
		ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메뉴", "보험상품", "상품명");
		_position = "menu";
	}
	ampNacf.setBizNmCd("상품안내장이동", "");
	ampNacf.setPathSub(ampNacf.getPdtNmFromProd(pdtCd));
	ampNacf.setPdtCd(pdtCd);

	var ampEventInfo = {};
	ampEventInfo.position = _position;
	ampNacf.addLogMoveProd(ampEventInfo);
}
</script>

<script type="text/javaScript">

function setGtagByProp(eventname, eventProperties){
