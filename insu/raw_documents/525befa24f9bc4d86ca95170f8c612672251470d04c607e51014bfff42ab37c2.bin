/*챗봇상담아이콘*/
.quick_fixed{position:fixed;bottom:20px;right:20px;z-index:1}
.chatbot_bann{display:block;position:relative}
.chatbot_bann > button.btn_chatbot{display:block;position:relative;width:86px;height:86px;overflow:hidden;transition:width .3s ease;-webkit-transition:width .3s ease; background-color: transparent;border: 0;}
.chatbot_bann > button.btn_chatbot:after{position:absolute;top:0;right:0;width:86px;height:100%;background:url(/images/ani_wanggu.png) 50% 0 no-repeat;background-size:86px auto;animation:aniFani 1.5s steps(20) infinite;-webkit-animation:aniFani 1.5s steps(20) infinite;overflow:hidden;content:""}
@keyframes aniFani{
	0% {background-position:50% 0}
	100% {background-position:50% -1720px} 
}
@-webkit-keyframes aniFani{ 
	0% {background-position:50% 0}
	100% {background-position:50% -1720px} 
} 
.chatbot_bann > button.btn_chatbot:hover{width:263px}
.chatbot_bann > button.btn_chatbot:hover:before{display:block;position:absolute;bottom:12px;right:43px;width:200px;height:62px;padding:11px 50px 11px 25px;border-radius:31px 0 0 31px;border: 0;background:#0065b3;font-size:14px;line-height:20px;color:#fff;letter-spacing:-1px;overflow:hidden;box-sizing:border-box;content:"무엇이든 궁금한 점을 \A 왕구에게 물어보세요"}
</style> 

