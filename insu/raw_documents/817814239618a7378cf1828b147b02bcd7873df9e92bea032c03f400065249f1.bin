<script type="text/javascript">
var totalMenu;
var pMenuId = 'MN0800000';
var pMenuId2 = 'MN0803000';
var pMenuId3 = '';
var cMenuId = 'MN0803001';
(function($){
	loadCommonTabATagFoucsStyle();
	
})(jQuery);
function loadCommonTabATagFoucsStyle(){
	setTimeout(function(){
		
		var keyDownEventS = $._data(document,"events").keydown;
		var isTabKeySet = false;
		for(var i = 0 ; i < keyDownEventS.length ; i++){
			var temprowevent = keyDownEventS[i];
			if(temprowevent != null && typeof temprowevent.handler == "function" && temprowevent.handler.toString().indexOf("fn_commonTabATagFoucsStyle") != -1){
				isTabKeySet = true;
				break;
			}
		}
		if(isTabKeySet == false){
			fn_commonOnReadyOnLoad();
			loadCommonTabATagFoucsStyle();
		}
	},(1000*1));
}
function getLvlByMenu(obj, lvl)
{
	var objects = [];
	
	$.each(obj, function(key, val){
		if(val.menu_level == 3 && lvl == 3){
			objects.push(val);
		 }
		else if(lvl == 4)
		{
			if(typeof val == 'object')
			{
		 		$.each(val, function(key2, val2){
					objects.push(val2);
				});
			}
		}
	});

	objects.sort(function(a, b){
		return (a.menu_ord<b.menu_ord) ? -1 : (a.menu_ord>b.menu_ord) ? 1 : 0; 
	});
	
	return objects;
}

// 상단 3단 메뉴 구성
function genMenu(obj, lvl, id)
{
	var menu;
	
	if(lvl == 5)
	{
		menu = getMenus(obj, id);
	}
	else if(lvl == 6)
	{
		menu = getMenus(obj, id, lvl);
	}
	else	
	{
		menu = getLvlByMenu(obj, lvl);
	}

	if($.isEmptyObject(menu)) {
		return;
	}
	if(lvl == 3)
	{	
		$('#menu1').show();
		$('#menu1').append("<ul>");
		
		$.each(menu, function(key, val){
			if(val.menu_id == pMenuId || val.menu_id == cMenuId)
			{
				$('#menu1 > a').text(val.menu_nm);
				if(val.menu_id == cMenuId && val.link_url != ''){
					menuLink(val, "menu1");
				}else{
					genMenu(val, 4);
				}
			}
			else
			{
				if(val.link_url != '')
				{
					menuLink(val, "menu1");
				}
				else
				{
					$('#menu1 > ul').append('<li><a href="javascript:goMenu(\''+val.menu_id+'\', 4)">'+val.menu_nm+'</a></li>');
				}
			}
		});
	}	
	else if(lvl == 4)
	{
		$('#menu2').show();
		$('#menu2').append("<ul>");
		
		$.each(menu, function(key, val){
			
			if(val.menu_id == cMenuId || val.menu_id == pMenuId || val.menu_id == pMenuId2)
			{
				$('#menu2 > a').text(val.menu_nm);
				genMenu(totalMenu, "5", val.menu_id);	
			}
			else
			{
				$('#menu2 > ul').append('<li id=\''+val.menu_id+'\'><a href="javascript:goMenu(\''+val.menu_id+'\', 5)">'+val.menu_nm+'</a></li>');
			}
			
			if(val.link_url != '')
			{
				if(val.param != null && val.param.indexOf('popup') != -1)
				{
					$('#'+val.menu_id+' > a').attr("title", '새창');
				}
				$('#'+val.menu_id+' > a').attr("href", 'javascript:pageLink(\''+val.link_url+'\')');
			}
		});
	}
	else if(lvl == 5)
	{
		$('#menu3').show();
		$('#menu3').append("<ul>");
		
		var i=0;
		var tmpVal = [];
		 $.each(menu, function(key, val){
			if(i == 0)
			{
				$('#menu3 >a').text(val.menu_nm);
				tmpVal = val
			}
			else
			{
				if((val.low_menu_yn == 'Y' && val.menu_id == pMenuId3) || (val.menu_id == cMenuId))
				{
					if(val.upper_menu_id == 'MN0301000'){
						if(val.param.indexOf("220AS") != -1){
							val.menu_nm = "(무)원더풀플러스 종합보험(연만기갱신형)";
						}
					}
					$('#menu3 > a').text(val.menu_nm);
					$('#menu3 > a').attr(val.menu_nm);
					menuLink(tmpVal, "menu3");
					tmpVal = val;
				}
				else
				{
					menuLink(val, "menu3");
				}
			}
			i++;
		});

		if(tmpVal.low_menu_yn == 'Y')
		{
			genMenu(totalMenu, "6", tmpVal.menu_id);	
		}
	}
	else if(lvl == 6)
	{
		$('#menu3').parent().append("<li id='menu4'><a href='javascript:'></a><ul>");	
		
		var i=0;
		var tmpVal = [];
		 $.each(menu, function(key, val){
			if(i == 0)
			{
				$('#menu4 >a').text(val.menu_nm);
				tmpVal = val
			}
			else
			{
				if(val.menu_id == cMenuId)
				{
					$('#menu4 > a').text(val.menu_nm);
					$('#menu4 > a').attr(val.menu_nm);
					menuLink(tmpVal, "menu4");
				}
				else
				{
					menuLink(val, "menu4");
				}
			}
			i++;
		});
	}
	
	slidEvent();
}

function menuLink(val, id)
{
	 if(val.link_ty =='02' && val.link_url != '')
	 {
		if(val.menu_level == '3')
		{
			$('#'+id+' > ul').append('<li><a href="javascript:goMenu(\''+val.menu_id+'\', 3)"">'+val.menu_nm+'</a></li>');
		}
		else
		{
			if(val.param != null && val.param.indexOf('popup') != -1)
			{
				$('#'+id+' > ul').append('<li><a href="javascript:pageLink(\''+val.link_url+'\')"" title="새창">'+val.menu_nm+'</a></li>');
			}
			else
			{
				$('#'+id+' > ul').append('<li><a href="javascript:pageLink(\''+val.link_url+'\')"">'+val.menu_nm+'</a></li>');
			}
		}
	 }
	 else if(val.link_ty =='01' && val.link_url != '')
	 {
		$('#'+id+' > ul').append('<li><a href="javascript:location.href=\''+val.link_url+'\'">'+val.menu_nm+'</a></li>');
	 }
	 else if(val.link_url == '' && val.low_menu_yn == 'Y')
	 {
		$('#'+id+' > ul').append('<li><a href="javascript:goMenu(\''+val.menu_id+'\', 6)"">'+val.menu_nm+'</a></li>');
	 }
	 else
	 {
		$('#'+id+' > ul').append('<li><a href="javascript:">'+val.menu_nm+'</a></li>');
	 }
}

// 상단 3단메뉴
function getMenus(obj, id, lvl)
{
	var objects = new Object();
	
	$.each(obj, function(key, val){
 		$.each(val.low_menus, function(key, val){
 			if(lvl == 6)
 			{
				if(val.menu_id ==pMenuId2 && val.low_menu_yn == 'Y')
				{
	 		 		$.each(val.low_menus, function(key, val){
						if(val.menu_id ==id && val.low_menu_yn == 'Y')
						{
							objects = val.low_menus;
							return false;
						}
	 		 		});
				}
 			}
 			else
 			{
				if(val.menu_id ==id && val.low_menu_yn == 'Y')
				{
					objects = val.low_menus;
					return false;
				}
 			}
		});
	});
	
	return objects;
}

function goMenu(menuId, lvl)
{

	if(lvl == 3)
	{
//		if(totalMenu[menuId].low_menus == 'N' && totalMenu[menuId].link_url != '')
		if(totalMenu[menuId].link_url != '')
		{
			pageLink(totalMenu[menuId].link_url);
			return false;	
		}
		else
		{
			goMenu(menuId, 4);	
		}
	}
	else if(lvl == 4)
	{
		var obj = getLvlByMenu(totalMenu[menuId], lvl);
		
		if(obj[0].link_url !='' )
		{
			pageLink(obj[0].link_url);
			return false;
		}

		$.each(obj[0].low_menus, function(key, val){
			if(val.link_url != ''){
				pageLink(val.link_url);
				return false;
			}
		});
		
		$.each(obj, function(key, val){

			if(val.link_url != '')
			{
				 if(val.link_ty =='02')
				 {
					pageLink(val.link_url);
					return false;
				 }
			}else if(val.low_menu_yn == 'Y'){
				var arrMenu = [];
				arrMenu.push(val);
				arrMenu.sort(function(a, b){
					return (a.menu_ord<b.menu_ord) ? -1 : (a.menu_ord>b.menu_ord) ? 1 : 0; 
				});
				
				for(var i=0; i<arrMenu.length; i++){
					if(arrMenu[i].link_url != '')
					{
						pageLink(arrMenu[i].link_url);
						return false;
					}
					else if(arrMenu[i].low_menus == 'Y')
					{
						$.each(arrMenu[i].low_menus, function(key, val){
							pageLink(val.link_url);
							return false;
						});
					}
				}
			}
		});
	}
	else if(lvl == 5 || lvl == 6)
	{
		var bPageLinkStatus = false;
		var obj = getMenus(totalMenu, menuId, lvl);
		$.each(obj, function(key, val){
			
			// lvl6까지 있는경우
			if(val.low_menu_yn == 'Y')
			{
				$.each(val.low_menus, function(key, val){
					if(val.link_url != '' && (val.param == null || (val.param != null && val.param.indexOf('popup') == -1))){
						pageLink(val.link_url);
						bPageLinkStatus = true;
						return false;
					}
				});
			}
			else
			{
				if(val.link_url != '' && (val.param == null || (val.param != null && val.param.indexOf('popup') == -1))){
					pageLink(val.link_url);
					bPageLinkStatus = true;
					return false;
				}
			}
			
			if(bPageLinkStatus)	return false;
		});
	}
}


// 페이지 링크
function pageLink(url){
    if(url !== "#") {
        var goPage = url.split(",");
        var temp = "";
        for(var i=0, loopCnt = goPage.length; i < loopCnt; i++){
            if(i == 0){
            	if(goPage[i].indexOf(".") != -1){
                    temp = temp + goPage[i];
                    temp = temp + "?";
            	} else {
                    temp = temp + goPage[i] + ".scp";
                    temp = temp + "?";
            	}
            }else{
                temp = temp + goPage[i] + "&";
            }
        }
        goPage = temp.substring(0, temp.length-1);

    	if(temp.indexOf("popup") > -1){
        	var value = goPage.split("&");
        	var width = "100";
        	var height = "100";
        	for(var i = 1; i < value.length; i++){
        		var pair = value[i].split("=");
        		var param = pair[0];
        		var paramVal = pair[1];
        		if(param == "width"){
        			width = paramVal;
        		}
        		if(param == "height"){
        			height = paramVal;
        		}
        	}
        	var cc = "scrollbars=yes";
        	cc = cc + ",width=" + width + ",height="+height;
        	window.open(goPage,'_blank',cc);
    	}else if(getParseUrl(location.href).getDomain().startsWith(getParseUrl(url).getDomain())) {
            goUrlScreen(goPage);
    	}else{
			window.open(goPage);
        } 
    }
};


// 상단펼침메뉴 생성
function makeMenu(menu, id)
{
	var MN0503000Count = 0;
	var obj = getMenus(menu, id);
	 $.each(obj, function(key, val){
		 var tempUlJquer = $('#'+id+' > ul');
		 if(id=="MN0503000"){
			 var tempUlJquerLength = tempUlJquer.length;
			 if(tempUlJquerLength > 1){
				 if(MN0503000Count == 0){
					 tempUlJquer = $($('#'+id+' > ul')[0]);
				 }else{
					 var tempIndex = Math.floor(MN0503000Count/8);
					 if(tempIndex < tempUlJquerLength){
						 tempUlJquer = $($('#'+id+' > ul')[tempIndex]);					 
					 }else{
						 tempUlJquer = $($('#'+id+' > ul')[tempUlJquerLength-1]);
					 }				 
				 }
				 MN0503000Count++;
			 }
		 }
		 if(val.link_ty =='02' && val.link_url != ''){
			if(val.param != null && val.param.indexOf('popup') != -1){
				tempUlJquer.append('<li><a href="javascript:pageLink(\''+val.link_url+'\')" target="_blank" title="새창">'+val.menu_nm+'</a></li>');
			}else{
				if(val.param != null && (val.param.indexOf("2211Z") != -1 || val.param.indexOf("2216G") != -1 || val.link_url.indexOf("PD090010") != -1)){
					tempUlJquer.append('<li><a href="javascript:pageLink(\''+val.link_url+'\')">'+val.menu_nm+'</a><span class="best">BEST</span></li>');
				}else if(val.param != null && (val.param.indexOf("2201A") != -1 || val.param.indexOf("2211L") != -1)){
					tempUlJquer.append('<li><a href="javascript:pageLink(\''+val.link_url+'\')">'+val.menu_nm+'</a><span class="hot">HOT</span></li>');
				}else if(val.param != null && (val.param.indexOf("2221P") != -1)){
					tempUlJquer.append('<li><a href="javascript:pageLink(\''+val.link_url+'\')">'+val.menu_nm+'</a><span class="new">NEW</span></li>');
				}else{
					if(val.param != null && val.param.indexOf("220AS") != -1){
						val.menu_nm = "(무)원더풀플러스 종합보험<br>&nbsp; &nbsp; &nbsp;(연만기갱신형)";
					}
					tempUlJquer.append('<li><a href="javascript:pageLink(\''+val.link_url+'\')">'+val.menu_nm+'</a></li>');
				}
			}
		 }else if(val.link_ty =='01' && val.link_url != ''){
			 if(val.link_url.indexOf("PD090020") != -1){
			 	tempUlJquer.append('<li><a href=\"'+val.link_url+'\" target="_blank" title="새창">'+val.menu_nm+'</a><span class="best">BEST</span></li>');
			}else if(val.link_url.indexOf("PD110010") != -1){
				if(val.link_url.indexOf("planCd") != -1){
					tempUlJquer.append('<li><a href=\"'+val.link_url+'\" target="_blank" title="새창">'+val.menu_nm+'</a><span class="new">NEW</span></li>');
				}else{
					tempUlJquer.append('<li><a href=\"'+val.link_url+'\" target="_blank" title="새창">'+val.menu_nm+'</a><span class="best">BEST</span></li>');
				}
			}else{
				tempUlJquer.append('<li><a href=\"'+val.link_url+'\" target="_blank" title="새창">'+val.menu_nm+'</a></li>');
			}
		 }else{
			 tempUlJquer.append('<li><a href="javascript:">'+val.menu_nm+'</a></li>');
		 }
	});
}
 
