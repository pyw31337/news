var _gAnySignInstChkTimer = null;
function BockInstallDisp(){
	if($.blockUI){
		$.blockUI({message:"<div class=\"processing\"><p><img src=\"" + sui.env.getImageDir("loading.gif") + "\" /><strong>보안프로그램 설치 확인 중 입니다.</strong><br />잠시만 기다려 주시기 바랍니다.</p></div>"});
	}
}

function installCheck_callback (result) {
	
	if(_gAnySignInstChkTimer != null ) {
		clearTimeout(_gAnySignInstChkTimer);
		if($.unblockUI)	$.unblockUI();
	}

	switch (result)
	{
		case "ANYSIGN4PC_NORMAL":
			npPfsCtrlinstallCheck();
			break;
		case "ANYSIGN4PC_INTEGRITY_FAIL":
		case "ANYSIGN4PC_NEED_INSTALL":
		case "ANYSIGN4PC_NEED_UPDATE":
			location.href=contextPath+"/LG051030DM.scp?menuId=MN0105000&redirect=" + encodeURIComponent(location.href);
			break;
	}
}

function chkNosLoad(){
	if( npPfsCtrl == false || npPfsCtrl == "undefind" || npPfsCtrl.isStartup != true){
		alert("키보드 보안프로그램이이 정상적으로 실행되지 않아\n화면을 새로고침 합니다.\n자동으로 새로고침 되지않을 경우 F5키를 눌러\n화면을 새로고침 해주시기 바랍니다.\n\n문제가 지속될경우 잉카인터넷 고객센터(1566-0771)로 문의 주시기 바랍니다.");
		linkpage(dataForm1,location.href);
		return false;
	}
	return true;
}

function npPfsCtrlinstallCheck(){
	$("#userAgent").text(navigator.userAgent);
	
	npPfsCtrl.isInstall({
		success : function(){
			npPfsStartup(document.form1, true, true, false, true, "npkencrypt", "on");
			setTimeout("chkNosLoad();",3000);
		},
		fail : function(){
			if(location.href.indexOf("LG051030DM") == -1){
				location.href=contextPath+"/LG051030DM.scp?menuId=MN0105000&redirect=" + encodeURIComponent(location.href);
			}
		}
	});
}

$(document).ready(function(){
	
	if(location.href.indexOf("LG051030DM") == -1){
		_gAnySignInstChkTimer = setTimeout("BockInstallDisp()", 500);	
		PrintObjectTag();
		AnySign4PC_installCheck (installCheck_callback);
	}
	
});
</script>

		

    

