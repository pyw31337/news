<!-- container -->
<section id="container">
	<div id="DF_IPCR000_P10000">
		<!-- jumbotron -->
		<div class="jumbotron">
			<h1><span>보험가격공시실</span></h1>
			<p class="leadText">한화생명은 보험상품의 보험료 계산, 상품별 비교가 가능하도록 보험상품 가격을 공시합니다</p>
		</div>
		<!-- //jumbotron -->

		<!-- CONTENTS -->
		<div class="contents">
			<form id="frm" name="frm"  class="form-inline" method="POST"></form>
			<table class="dataTable" id="LIST_GRID"
						 data-grid="{scroll: false, databind: true, resultMsg: false, paging: 'number', emptyData: true}">
				<caption>보험가격공시실 상세 항목</caption>
				<colgroup>
					<col style="width:20%;">
					<col style="width:65%;">
					<col style="width:15%;">
					<col class="ck-colspan" style="width:0;" />
					<col class="ck-colspan" style="width:0;" />
				</colgroup>
				<thead>
				<tr>
					<th scope="col">구분</th>
					<th scope="col">보험</th>
					<th scope="col">보험료계산</th>
					<th class="ck-colspan"></th>
					<th class="ck-colspan"></th>
				</tr>
				</thead>
				<tbody id="List">
				<tr class="ck-rowspan">
					<td data-bind="PARENTCATEGORYNAME"></td>
					<td class="alignL" data-bind="CategoryName"></td>
					<td data-bind="getLink(CategoryCode, pageurl, bojongCode, sealCode)"></td>
					<td class="ck-colspan" data-bind="rownum"></td>
					<td class="ck-colspan" data-bind="ChildCount"></td>
				</tr>
				</tbody>
			</table>
		</div>
		<!--// CONTENTS -->
		
        <!-- <script type="text/javascript" src="/resources/main/js/goods_hmp_new.js"></script> -->
        <!-- 넥스트랩 가입설계 대응 20250529 -->
        <script type="text/javascript" src="/resources/main/js/goods_hmp_new2.js"></script>
        
		<script type="text/javascript">
      var pathUrl = '/main/disclosure/insuranceprice/';

      require(['hwlife', 'grid'], function(hwlife, grid) {
        var boardListForm   = document.getElementById('frm');
        var $boardListForm = $(boardListForm);
        var boardListGrid    = $('#LIST_GRID').initGrid();

        function getList() {
          hwlife.secure.ajax($boardListForm, {
            url: pathUrl+'getList.do',
            dataType: 'json',
            data: $('#frm').serialize(),
            success: function(data) {
              //console.log(JSON.stringify(data));
              boardListGrid.databind(data, 'list', {
                getLink: function(CategoryCode, pageurl, bojongCode, sealCode) {
                  if (CategoryCode == undefined || CategoryCode == '') {
                    return '<a href="#none" class="btnDefault xs borderGray ck-linkPopup" data-info="'+pageurl+'" data-gubun="URL"><span>보험료계산</span></a>';
                  } else {
                    return '<a href="#none" class="btnDefault xs borderGray ck-linkPopup" data-info="'+CategoryCode+'" data-bojongcode="'+bojongCode+'" ' +
											'data-sealcode="'+sealCode+'" data-gubun="CODE"><span>보험료계산</span></a>';
                  }
                }
              });

              //병합 시작
              $.each($('.ck-rowspan'), function(idx, obj) {
                var rownum = $(obj).children('td:eq(3)').html();
                var idxCnt = $(obj).children('td:eq(4)').html();
                if (rownum == 1) {
                  if (idxCnt > 1) {
                    $(obj).children('td:eq(0)').attr('rowspan',idxCnt);
                  }
                } else {
                  $(obj).children('td:eq(0)').empty();
                  $(obj).children('td:eq(0)').hide();
                }
              });
              $.each($('.ck-colspan'), function(idx, obj) {
                $(obj).remove();
              });
              //병합 종료
            },
            error: function(request, status, error) {
              console.log('code:'+request.status+'\n'+'message:'+request.responseText+'\n'+'error:'+error);
            }
          });
        }

        /********************
         * 링크정보 팝업
         ********************/
        $('#List').on('click', '.ck-linkPopup', function(e) {
          var url = '';
          var strCode = '';
          var $this = $(this);
          if ($this.data('gubun') == 'CODE') {
            strCode = $this.data('info');
            if (strCode == 'IS070900' ) {
              url = 'http://www.insvalley.com/goods/comm/goods_400.jsp?group_product_cd=L01732&market_cd=G06&market_point_cd=G06_G';
              window.open(url);
            } else if (strCode.substring(0,4) == 'IS07') {
              if (strCode == 'IS070700' ) {strCode = 'CM011801'}
              if (strCode == 'IS071801' ) {strCode = 'CM012201'}
              if (strCode == 'IS072200' ) {strCode = 'CM010803'}
              url = 'http://www.directgood.com/redirectSub.asp?http://help.directgood.com:9112/shopping/sendQuote.asp?menu1=1&menu2=2&menu='+strCode+'&sGubun=';
              window.open(url,'pop_quote_win','scrollbars=yes,status=yes,top=20,left=1,width=817,height=653').focus;
            } else {
              var bojongCode = $this.data('bojongcode');
              var sealCode = $this.data('sealcode');
              var profile = global.getProfile();
              homepage('5',bojongCode,sealCode,'99900308',profile);
            }
          } else {
            url = $this.data('info');
            window.open(url,'_blank').focus;
          }
        });

