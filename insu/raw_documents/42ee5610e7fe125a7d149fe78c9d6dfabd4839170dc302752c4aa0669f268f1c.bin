			$('#tm_mktView2').hide();
			setCookie( "mkt_no", "done" , 1); // 1=하룻동안 공지창 열지 않음
		});
		
		$('#popClose').click(function(){
			
			var param = {'agree1':'3'};//skip
			//ajaxRun("/MAW/updateMktAgrInfo.do", param, function(data){});
			
