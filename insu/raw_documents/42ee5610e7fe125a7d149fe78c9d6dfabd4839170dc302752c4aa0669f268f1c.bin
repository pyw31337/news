<script type="text/javascript">
//창닫기 시 로그아웃 처리
// $(window).bind('beforeunload',function(){
//   if((event.clientY < 0) || (event.altKey) || (event.ctrlKey) || ((event.clientY < 129) && (event.clientY > 107))){
