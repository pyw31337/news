            <!-- 데스크탑용 header -->
			






<!-- Google Tag Manager (noscript)(body공통)-->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MNHJRR"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript)(body공통) -->



<script type="text/javascript">
	$(document).ready(function(){
		// 로그인타이머
		window.loginTimer = new Timer({
			  time : 20 * 60
			, viewObj : ["txt_loginTimer"]
			, viewObj2 : ["txt_autoLogoutPopupTimer"]
			, timeoutFunc : function(){$("div[id*='_autoLogoutPopup_']").find(".dialog_close.ui_dialog_close").click();goLogout({view:"login/afterAutoLogout"});}
			, intermediateExecutionFunc : {time:5 * 60,func:function(){openAutoLogoutPopup();}}
			, format : "hh:mm:ss"
			, format2 : "hh시 mm분 ss초"
			, initStartYn : SessionData.get("loginYn")
			, id : "login"
		});
		
		// 2021.08.26 GNB메뉴 네비게이션 영역 이벤트 추가 (퍼블소스)
		$.fn.GnbNav();
		
		// 2021.09.06 퍼블 소스 변경 적용
		if( window.mbHeader ){
			if( getBoolean(mbHeader.main) ){
				$("#spn_mbHeaderMain").show();
			}else if( getBoolean(mbHeader.big) ){
				$("#lnk_mbHeaderBig").show();
				
				$("#btn_mbHeaderBigWriting").show();	// 큰글씨서비스
				
			}else{
				var title = getStr(mbHeader.title);
				// 2021.09.06 메뉴정보에서 불러온 메뉴명 우선으로 처리할 경우 주석해제
				var menuInfo = HDMF_MENU.getMenuInfo();
				/* 2021.12.14 기획에서 menuIdcNm 제거
				if( isNull(title) && !isNull(menuInfo.menuIdcNm) ){
					title = menuInfo.menuIdcNm;
				}
				*/
				if( isNull(title) && !isNull(menuInfo.menuNm) ){
					title = menuInfo.menuNm;
					
					// 2021.12.14 개발 후 제거 필요 -  모바일에서도 메뉴아이디 출력
					// SM 요청으로 운영계에서만 숨김처리
					if( !isNull(getMenuId()) && !isProd() ){
						title += " ["+getUiId()+"]";
					}
				}
				
				var _bTitle = !isNull(getParentMenuId()) ? getStr(HDMF_MENU.getAllMenuInfo()[getParentMenuId()].menuNm) : ""; 
				
				if( menuInfo.menuNm == _bTitle ){
					_bTitle = "";
				}
				
				//화면에 기본값으로 설정된 타이틀이 있을 경우 해당 값을 사용
				if (!isNull(window["DOCUMENT_TITLE"])) {
					document.title = window["DOCUMENT_TITLE"];
				} else {
					document.title = (!isNull(_bTitle) ? _bTitle + " " : "" ) + title;
				}
				
				if( $(".header_mb").hasClass("big") ){
					title = "<span class='b'>" + title + "</span>";
				}
				
				$("#spn_mbHeaderTitle").html(title);	// 페이지 타이틀
			}
			
			if( getBoolean(mbHeader.tooltip) ){
				$("#spn_mbHeaderTooltip").show();
			}
			
			if( getBoolean(mbHeader.menu) ){
				$("#btn_mbHeaderOpenAllMenu").show();	// 전체메뉴 열기버튼
			}
		}
		
		// 2021.10.20 퍼블 소스 변경 적용
		if( window.mbHeader) {
			if( getBoolean(mbHeader.prev) ){
				$("#btn_mobile_prev").show();	// 이전화면버튼 보임
			}
			
			if( $(".header_mb").hasClass("monitoring") ){
				$(".logo_monitoring").show();
			}
			
			if( getBoolean(mbHeader.mainH) ){
				//$("#btn_mobile_hiplanner").show();	// 하이플래너홈버튼 보임  2022.01.14 불필요 최미경
			}
			
			if( getBoolean(mbHeader.home) ){
				$("#btn_mobile_home").show();	// 홈버튼 보임
			}
			
			if( getBoolean(mbHeader.main) ){
				$("#btn_mobile_big").show();	// 큰글씨 버튼 보임 2021.11.29 퍼블 적용
				$("#btn_mobile_main_login").show();	// 메인화면 로그인 보임
			}
		}
		
		$(".greeting_msg").html(SessionData.get("custNm") +"님, 안녕하세요!");
		
		if( window.mbHeader && window.mbHeader.main){
			$("#btn_mobile_prev").hide();	// 이전화면버튼 숨김
			$("#btn_mobile_login").show();	// 로그인버튼 보임
		}else if (window.mbHeader && window.mbHeader.mainH){ //회사소개메인 
			$("#btn_mobile_prev").hide();	// 이전화면버튼 숨김
			$("#btn_mobile_login").hide();	// 로그인버튼 숨김
		}else{
			$("#btn_mobile_prev").show();	// 이전화면버튼 보임
			$("#btn_mobile_login").hide();	// 로그인버튼 숨김
		}
		
		// draw menu
		fn_drawMenu();
		
		// 공지팝업 정보 확인
		fn_checkCommonPopupInfo();
		
		// 버튼셋팅
		setTimeout(function(){fn_setCommonBtns();},500);
		
		// 2022.02.28 모바일 메뉴
		if( ENV_INFO.isMobile ){
			window._stop_goMenu_ = true;
			var _tObj = $((window._pageHeaderInfo && window._pageHeaderInfo.type ? getStr(window._pageHeaderInfo.type) : "") == "DP" ? ".header_dm" : ".header_mb").find("[data-menuid='"+getMenuId()+"']").css("font-weight","bold");
			if( _tObj.length > 0 ){
				_tObj.parents(".sub_layer").prev("a").click();
				_tObj.parents(".sub_layer2").prev("a").click();
				_tObj.parents(".sub_layer3").prev("a").click();
			}else{
				$((window._pageHeaderInfo && window._pageHeaderInfo.type ? getStr(window._pageHeaderInfo.type) : "") == "DP" ? ".header_dm" : ".header_mb").find("li[id='n"+(window._pageHeaderInfo.type=="HI"?1:0)+"']").children("a").click();
			}

			delete window._stop_goMenu_;
		}
		
		// 2022.02.10 개인/법인 로그인사용자에 따른 메뉴제어
		if( SessionData.get("loginYn") == "Y" ){
			if( SessionData.get("custFlag") == "C" ){
				$("a[href='#mBiz1']").click();
				$(".headerSwitch .switchPoint").css("left", "55px");
				$(".headerSwitch .switchButton a").eq(1).addClass("on").attr("title","선택됨").siblings().removeClass("on").removeAttr("title");
				$(".perPanel").removeClass('active').removeAttr("title");
				$(".bizPanel").addClass('active').attr('title','현재선택');
				$("#headMyPage").hide();					
			}else {
				$(".headerSwitch .switchPoint").css("left", "0");                                                                                                                                                                                              
				$(".headerSwitch .switchButton a").eq(0).addClass("on").attr("title","선택됨").siblings().removeClass("on").removeAttr("title");
				$(".perPanel").addClass('active').attr('title','현재선택');
				$(".bizPanel").removeClass('active').removeAttr("title");
			}
			$("#div_menuTabPcSection1").hide();
			$("#div_menuTabPcSection3").hide();
			$("#div_menuTabPcSection4").hide();
			$("#div_menuTabPcSection6").hide();
			

		}
		
		// goole 태깅(로그인 완료를 위한 체크) 202310
		if('' == 'login') {
			try{
				var tagInfo = getTaggingInfo();
				
		      	window.dataLayer.push({
					event:"login",
					login_type:tagInfo.loginType
		      	});
		    }
		    catch(e) {
		      	console.log(e);
		    }

		}
	});
	
	// 개인/법인 선택 /2211
	$(function() {
		var swPoint = $(".headerSwitch .switchPoint");
		var swButton = $(".headerSwitch .switchButton a");
		var balCorp = $('.bal_corp'); // 법인 안내 말풍선
		
		swButton.on("click", function() {
			var swIndex = $(this).index();
			
			if (SessionData.get("custFlag") =="F" && swIndex == 1){
        		confirmInfo("법인 고객 전용 서비스입니다.<br/><br/>로그아웃 후 이용해 주세요.<br/>[확인] 버튼을 누르시면, 로그아웃됩니다.", function(rtnVal){
					if (rtnVal=="Y"){
						goLogout();	
					}
        		});
				return;
			}else if (SessionData.get("custFlag") =="C" && swIndex == 0){
        		confirmInfo("개인 고객 전용 서비스입니다.<br/><br/>[확인] 버튼을 누르시면,<br/>로그아웃 후 개인 홈페이지로 이동합니다.", function(rtnVal){
					if (rtnVal=="Y"){
						goLogout();	
					}
        		});
				return;
			}
			
			switch(swIndex) {
				case 0 :
						swPoint.css("left", "0");                                                                                                                                                                                              
						swButtonOn(swIndex);
						if (SessionData.get("custFlag") =="") {
							balCorp.removeClass('on').attr('aria-hidden','true'); // 법인 안내 말풍선
						}
						$(".perPanel").addClass('active').attr('title','현재선택');
						$(".bizPanel").removeClass('active').removeAttr("title");
					
				break;
				default :
					swPoint.css("left", "55px");
					swButtonOn(swIndex);
					if (SessionData.get("custFlag") =="") {
						balCorp.addClass('on').attr('aria-hidden','false'); // 법인 안내 말풍선
					}
					$(".perPanel").removeClass('active').removeAttr("title");
					$(".bizPanel").addClass('active').attr('title','현재선택');
				break;
			}
		});
		function swButtonOn(i){
			swButton.eq(i).addClass("on").attr("title","선택됨").siblings().removeClass("on").removeAttr("title");
		}
	});
	
	// 서비스시간안내 및 공지팝업 정보 확인
	function fn_checkCommonPopupInfo(){
		// 우선순위 : 공지팝업 > 서비스시간안내
		var list = window.POPUP_INFO || [];
		
		var menuId = getMenuId();
		var promise = Promise.resolve();
		
		// 공지팝업 체크
		if( list && list.length > 0 && !getBoolean(window.NOT_USE_NOTICE_POPUP) ){
			// noMore 체크여부 확인
			var openYn = false;
			var targetList = [];
			for( var i = 0 ; i < list.length ; i++ ){
				// chkCat가 P인 케이스만
				if( list[i].chkCat != "P" ){
					continue;
				}
				
				if( CookieManager.get("hhcoco201popup_noMoreView_" + menuId + "_" + list[i].bltSeq) != "Y" ){
					openYn = true;
				}
				targetList.push(list[i]);
			}

			if( openYn ){
				promise = promise.then(function(){
					// 공지팝업 호출
					return openLayerPopup("bin/CO/CO/HHCOCO201P", "noticePopup", {data:{list:targetList},isModal:true});
				});
			
				promise = promise.then(function(rtnVal){
					if( rtnVal != "X" ){
						return Promise.reject();
					}
				});
			}
		}
		
		// 서비스시간안내 체크
		if( !isNull(menuId) ){
			promise = promise.then(function(){
				return getPossibleServiceTimeInfo().then(function(svcInfo){
					// 서비스시간안내팝업 필요
					if( svcInfo && svcInfo.isOpenPopup ){
						openLayerPopup("bin/CO/CO/HHCOCO202P", "possibleServiceTimeInfoPopup", {data:{svcInfo:svcInfo}});
					}
				});
			});
		}
		
		promise = promise["catch"](function(err){
			return Promise.resolve(err);
		});
		
		return promise;
	}
	
	// 2021.09.30 메뉴캐쉬 삭제
	function fn_clearMenuCache(){
		clearMenuCache();
	}

	// 2021.09.28 홈페이지/모바일 메뉴 하드코딩 (국문)
	function fn_drawMenu(){
		// draw page navigation
		fn_drawPageNav();
		
		// draw local navigation
		fn_drawLocalNav();
		
		// draw all menu
		fn_drawAllMenu();
		
		// bind gnb menu click event
		fn_bindGnbMenuClick();
		
		// addMenuParam
		fn_addMenuParam();
	}
	
	// draw page navigation (흰색바탕)
	function fn_drawPageNav(){
		var navInfoAry = HDMF_MENU.getMenuPageNavList();	// 화면ID에 대한 page navigation 목록 추출
		// 개발종료되면 메뉴아이디 출력은 삭제할 것
		if( navInfoAry && navInfoAry.length > 0 ){
			/* 2021.12.14 기획에서 menuIdcNm 제거
			navInfoAry[navInfoAry.length-1].menuIdcNm = navInfoAry[navInfoAry.length-1].menuIdcNm +  "&nbsp;&nbsp;<b style=\"font-weight: bold;\">["+getUiId()+"]</b></li>";
			*/
			if( !isProd() ){
				navInfoAry[navInfoAry.length-1].menuNm = navInfoAry[navInfoAry.length-1].menuNm +  "&nbsp;&nbsp;<b style=\"font-weight: bold;\">["+getUiId()+"]</b></li>";
			}
		}
		
		// 2021.10.05 page navigation 없으면 navigation영역 숨김처리
		if( navInfoAry.length == 0 ){
			$(".breadcrumbs_cont").hide();
		}
		
		// 2021.10.07 GNB 노출메뉴에 해당하는 메뉴가 아니면 출력하지 않는다.
		if( navInfoAry.length > 0 ){
			//var visibleAry = ["900000", "100100", "100200", "100300", "100400", "100500", "100600", "100700"];
			var visibleAry = HDMF_MENU.getGnbIdAry();
			if( visibleAry.indexOf(navInfoAry[0].menuId) < 0 ){
				navInfoAry = [];
			}
		}
		
		// 2021.10.09 GNB 노출메뉴 처리 이후 navInfoAry가 없으면 breadcrumbs_simple 영역 숨김처리
		if( navInfoAry.length == 0 ){
			$(".breadcrumbs_simple").hide();
		}
		
		var navObj = $("#pageNavInfo");
		for( var i = 0 ; i < navInfoAry.length ; i++ ){
			//navObj.append($("<li>"+navInfoAry[i].menuNm+"</li>"));
			/* 2021.12.14 기획에서 menuIdcNm 제거
			navObj.append($("<li>"+navInfoAry[i].menuIdcNm+"</li>"));
			*/
			//소비자포털 메뉴인경우 메뉴안내바 클릭시 소비자포털 메인으로 이동처리 추가함 2024.11. 
			if (navInfoAry[0].menuId == '101400') { 
				navObj.append($("<li><a href=\"#none\" onclick=\"fn_goMenu('101401')\">"+navInfoAry[i].menuNm+"</a></li>"));
			}else {
				navObj.append($("<li>"+navInfoAry[i].menuNm+"</li>"));
			}
		}
	}
	
	// draw local navigation (주황색)
	function fn_drawLocalNav(){
		var localNavInfoAry = HDMF_MENU.getMenuLocalNavList();
		if( localNavInfoAry && localNavInfoAry.length > 0 ){
			// 2021.10.07 GNB 노출메뉴에 해당하는 메뉴가 아니면 출력하지 않는다.
			//var visibleAry = ["900000", "100100", "100200", "100300", "100400", "100500", "100600", "100700"];
			var visibleAry = HDMF_MENU.getGnbIdAry();
			if( visibleAry.indexOf(localNavInfoAry[0].menuId) < 0 ){
				localNavInfoAry = [];
			}
		}
		
		Handlebars.setData("localNavInfo", "template_localNavInfo", {localNavList : localNavInfoAry});
		$.fn.dropMenu();
	}
	
	// draw all menu
	function fn_drawAllMenu(){
		// 2021.11.09 임시로 전체 출력 가능
		if( !window.mbHeader ){
			window.mbHeader = {};
		}
		window.mbHeader.allMenuYn = true;
		
		if( window.mbHeader && !getBoolean(window.mbHeader.allMenuYn) ){
			$("#btn_allMenu").hide();
			$("#btn_allMenu2").hide();
			return;
		}
		
		var thisMenuId = getMenuId() || getParentMenuId();	// 현재메뉴아이디
		if( !isNull(thisMenuId) ){
			var menuInfo = HDMF_MENU.getMenuInfo(thisMenuId);
			var navInfoAry = HDMF_MENU.getNav(thisMenuId);
			var gnbMenuId = navInfoAry[0].menuId || "";
			var gnbMenuInfo = HDMF_MENU.getGnbSubTreeInfo(gnbMenuId);
			
			if( menuInfo.navAry && menuInfo.navAry.length > 1 ){
				$(".header_gnb").find("a[data-menuId="+menuInfo.navAry[1]+"]").addClass("current");
			}
			
			// 2021.10.07 GNB 노출메뉴에 해당하는 메뉴가 아니면 출력하지 않는다.
			var visibleAry = HDMF_MENU.getGnbIdAry();
			if( visibleAry.indexOf(navInfoAry[0].menuId) < 0 ){
				
				// 전체메뉴 햄버거 버튼 숨김
				$("#btn_allMenu").hide();
				$("#btn_allMenu2").hide();
				return;
			}
			
			var _allMenuNm = gnbMenuInfo.data.menuNm + " 전체 메뉴";
			$("#allMenuTitle").text(_allMenuNm);
			$("#btn_allMenu").find("span").text(_allMenuNm);
			$("#btn_allMenu2").find("span").text(_allMenuNm);
			
			// 2022.02.09 마이페이지(my), 공시실(pa), 소비자포털(cc) class추가
			$("#allMenu").removeClass("my pa cc");
			
			var _menuId = getMenuId() || getParentMenuId();
			if( isNull(_menuId) ){
				return;
			}
			
			if( HDMF_MENU.getNav(_menuId)[0].menuId == "100900" ){
				$("#allMenu").addClass("pa");
			}else if( HDMF_MENU.getNav(_menuId)[0].menuId == "101400" ){
				$("#allMenu").addClass("cc");
			}else if( HDMF_MENU.getNav(_menuId)[0].menuId == "100800" ){
				$("#allMenu").addClass("my");
			}else{
				// 2022.02.09 위3개가 아니면 전체메뉴 숨김
				$("#btn_allMenu").hide();
				$("#btn_allMenu2").hide();
				return;
			}
			
			$("#btn_allMenu").show();
			$("#btn_allMenu2").show();
			
			/*퇴직연금공시 메뉴 위치 변경 AS-IS : 가격공시 다음 단독 메뉴로 구성. TO-BE : 상품공시 하위로 자산연계형상품공시 아래에 위치. 시작.*/
			
			if( HDMF_MENU.getNav(_menuId)[0].menuId == "100900" ){
				
				var rePen_i=0;				//퇴직연금공시 index
				var rePen_length = 0;		//퇴직연금공시 배열 길이
				var r = 0;
				
				
				for(var i=0; i<gnbMenuInfo.children.length; i++){
					if(gnbMenuInfo.children[i].data.menuId == "100960"){	//퇴직연금공시 메뉴 위치 찾기.
						rePen_i = i;
						rePen_length=gnbMenuInfo.children[i].children.length;
					}
				}
				
				//상품공시>자산연계형상품공시 하위에 퇴직연금공시 위치
				for(var i=0; i<gnbMenuInfo.children.length; i++){
					if(gnbMenuInfo.children[i].data.menuId == "100930"){	//상품공시
						for(var j=0; j<gnbMenuInfo.children[i].children.length; j++){
							if(gnbMenuInfo.children[i].children[j].data.menuId =="100935"){	//자산연계형상품공시 아래 
								
								gnbMenuInfo.children[i].children.splice(j+1, 0 ,gnbMenuInfo.children[rePen_i]);	//상품공시>자산연계형상품공시 다음으로 퇴직연금공시 메뉴 위치==> j번째:자산연계형상품공시 j+1번째부터 위치
							
								r=j+1;//퇴직연금공시 하위메뉴 위치 ==>j+2부터 퇴직연금사업자공시~퇴직연금공시 위치 : 아래 r에 1을 더하여 j+2부터 위치시키게 함.
								for(var k=0; k<rePen_length; k++){
									gnbMenuInfo.children[i].children.splice(r+1, 0 ,gnbMenuInfo.children[rePen_i].children[k]);	//퇴직연금공시 하위메뉴 
									gnbMenuInfo.children[i].children[r+1].data.menuNm="- "+gnbMenuInfo.children[i].children[r+1].data.menuNm;//퇴직연금공시 하위 메뉴명앞에 하이픈('-')
									r=r+1;
								}	
								
								break;
							}
						}
					
						break;
					}
				}
				
			
				//기존 위치의 퇴직연금공시 메뉴 제거
				gnbMenuInfo.children.splice(rePen_i,1);
			
			
			}
			
			/*퇴직연금공시 메뉴 위치 변경 AS-IS : 가격공시 다음 depth2 메뉴로 구성. TO-BE : 상품공시 하위로 자산연계형상품공시 하위 위치. 끝.*/
			
			Handlebars.setData("allMenuInfo", "template_allMenuInfo", {allMenuList : gnbMenuInfo.children});
			//$("#allMenuTitle").text(gnbMenuInfo.data.menuNm + " 전체 메뉴");
			/* 2021.12.14 기획에서 menuIdcNm 제거
			$("#allMenuTitle").text(gnbMenuInfo.data.menuIdcNm + " 전체 메뉴");
			*/
		}
	}
	
	// bind gnb menu click event
	function fn_bindGnbMenuClick(){
		//gmenu_main
		var gnbMenuObj = $(".header_gnb").find("a[data-menuId],h3[data-menuId]");
		var allMenu = HDMF_MENU.getAllMenuInfo();
		
		var _setMenu = function(thisObj){
			var menuId = thisObj.dataset.menuid;
			if( !isNull(menuId) && allMenu[menuId] ){
				/* 2021.12.14 기획에서 menuIdcNm 제거
				// 메뉴명 처리
				if( !isNull(allMenu[menuId].menuIdcNm) ){
					$(this).text(allMenu[menuId].menuIdcNm);
				}
				*/
				if( !isNull(allMenu[menuId].menuNm) ){
					$(thisObj).text(allMenu[menuId].menuNm);
				}
				
				// 2022.01.25 비노출메뉴일 경우 하드코딩된 메뉴 숨김처리
				if( ENV_INFO.isMobile ){
					if( allMenu[menuId].menuEpsCat == "P" ){
						$(thisObj).parent().hide();
					}else{
						if( ENV_INFO.isApp ){
							if( allMenu[menuId].appBltYn != "Y" ){
								$(thisObj).parent().hide();
							}
						}else{
							if( allMenu[menuId].mblBltYn != "Y" ){
								$(thisObj).parent().hide();
							}
						}
					}
				}else{
					if( allMenu[menuId].menuEpsCat == "M" ){
						$(thisObj).parent().hide();
					}else{
						if( allMenu[menuId].webBltYn != "Y" ){
							$(thisObj).parent().hide();
						}
					}
				}
				if( $(thisObj)[0].tagName.toLocaleLowerCase() == "a" ){
					$(thisObj).click(function(){
						fn_goMenu(thisObj.dataset.menuid);
					});
				}
			}else{
				$(thisObj).click(function(){
					if( !isNull(thisObj.dataset.menuid) ){
						alertInfo("메뉴아이디 ["+thisObj.dataset.menuid+"]에 해당하는 메뉴정보가 없습니다.");
					}
				});
			}
		};
		
		// 메뉴정보에 따라 메뉴 처리
		gnbMenuObj.each(function(){
			_setMenu(this);
		});
		
		// 2021.10.09 모바일 메뉴 바인딩 추가 (일단 PC WEB과 동일하게 처리)
		gnbMenuObj = $(".gnb_menu").find("a[data-menuId]");
		// 메뉴정보에 따라 메뉴 처리
		gnbMenuObj.each(function(){
			_setMenu(this);
		});
	}
	
	// click local nav menu
	function goLocalNavMenu(menuId){
		
		try {
			// 태깅에 필요한 정보 조회(bizCommon.js 함수)
			var tagInfo = getTaggingInfo(menuId);

			if(tagInfo != null) {
				window.dataLayer.push({
		       		event:"click_navigation"
		       		,click_location:"main"
		       		,click_label:tagInfo.menuNm
		       		,menu_category : tagInfo.category1
		       		,menu_category2: tagInfo.category2
		      	});
			}
		}catch(e) {
	      	console.log(e);
	    }
		
		var menuInfo = HDMF_MENU.getLastNode(menuId).data;
		fn_goMenu(menuInfo.menuId);
	}
	
	// addMenuParam
	function fn_addMenuParam(){
		var menuParam = {};
		var allMenuInfo = HDMF_MENU.getAllMenuInfo();
		var gMenuList = $(".header_gnb,.gmenu_main").find("a[data-menuId]");
		gMenuList.each(function(){
			var menuId = this.dataset.menuid;
			if( !isNull(menuId) && allMenuInfo[menuId] && !isNull(this.dataset.menuparam) ){
				menuParam[menuId] = this.dataset.menuparam;
			}
		});
		HDMF_MENU.addMenuParam(menuParam);
	}
	
	// check and move menu
	function fn_goMenu(menuId, paramData){
		paramData = paramData || {};
		if( getBoolean(window._stop_goMenu_) ){
			return;
		}
		
		var menuInfo = HDMF_MENU.getMenuInfo(menuId);
		Object.assign(paramData,menuInfo.menuParam);
		// 2021.09.30 GNB 메뉴가 보험상품(100200)에 속한 메뉴를 클릭한 경우 경우 menuPapam에서 prodCd를 가져와서 화면요청이력을 먼저 쌓는다.
		if( menuInfo.navAry && menuInfo.navAry.length > 0 && menuInfo.navAry.indexOf("100200") > -1 ){
			var popupPosCat = menuInfo.popupPosCat;	// 내부(M), 외부(N), 팝업(P)
			var prodCd = "";
			
			var paramAry = getStr(menuInfo.menuParam).split("&");
			for( var i = 0 ; i < paramAry.length ; i++ ){
				if( paramAry[i].split("=")[0] == "prodCd" ){
					prodCd = getStr(paramAry[i].split("=")[1]);
				}
			}
			
			if( popupPosCat == "M" || popupPosCat == "N" ){
				doRequest("COCO0011M02I", {
					  incCat : popupPosCat == "M" ? "1" : "5"		// 유입구분값 : 내부상품 1, 상품몰+상담 2, 상품몰+하이플래너(명장) 3, 상품몰+콜센터 4, 인터넷가입상품 클릭 5
					, svcMenuId : prodCd							// 상품코드(보종코드4자리) 
				}
				,{
					  isIndicator : false
					, isShowMessage : false
				}).then(function(){
					goMenu(menuInfo.menuId,paramData);
				});
			}else{
				goMenu(menuInfo.menuId,paramData);
			}
		}else{
			// 보험상품 메뉴를 제외하고 [data-menuparam]을 사용하지 않아 기타 메뉴에서도 ParamData 세팅하도록 로직 추가 
			// 빠른 로그인 메뉴(202252)의 경우, menuParam(svcInfoYn)을 사용하기 때문에 해당 기능 추가함.
			// 기타 메뉴에서 [data-menuparam]을 사용할 경우, 아래 메뉴 제거 또는 추가하여 사용 (단, 제거 시, 검증 기간은 길게 가져가기를 권장함.)
			if(menuInfo.menuParam && menuInfo.menuId == "202252") {
			//if(menuInfo.menuParam) {
				paramData = {};
				var menuParamAry = getStr(menuInfo.menuParam).split("&");
				var paramKey = "";
				var paramValue = "";
				
				for( var i = 0 ; i < menuParamAry.length ; i++ ){
					paramKey = getStr(menuParamAry[i].split("=")[0]);
					paramValue = getStr(menuParamAry[i].split("=")[1]);
					
					paramData[paramKey] = paramValue;
				}
				
				goMenu(menuInfo.menuId,paramData);
			} else {
				goMenu(menuInfo.menuId,paramData);
			}
		}
	}
	
	// 메인이동
	function fn_goMain(){
		if( window._pageHeaderInfo && window._pageHeaderInfo.type ){
			goMain(window._pageHeaderInfo.type);
		}else{
			goMain();
		}
	}
	
	// 통합검색 이동
	function fn_goTotalSearch(type){
		var searchKeyword = "";
		if(type=='P') searchKeyword = $("#ipt_pcSearchKeyword").val();
		else if(type=='C') searchKeyword = $("#ipt_menuSearchKeyword").val();
		else searchKeyword = $("#ipt_mobileSearchKeyword").val();
		
		searchKeyword = getStr(searchKeyword);
		searchKeyword = trim(searchKeyword);
		if( isNull(searchKeyword) ){
			alertInfo("검색어를 입력해 주세요.");
			return;
		}
		
		var ret;
		//한글은 2Byte , 영문은 1Byte
		for( var i = 0 ; i < searchKeyword.length ; i++ ){
			ret = searchKeyword.charCodeAt(i);
			if( (ret > 64 && ret < 91) || (ret > 96 && ret < 123) || (ret > 47 && ret < 58) ){
				//영문값,숫자값 체크
			}else{
				if( ret < 0xAC00 || ret > 0xD7A3 ){
					if( ret == 37 || ret == 34 || ret == 60 || ret == 62 || ret == 38 || ret == 39  || ret == 43 ){ // %, ", < , >, &, ', +
						alertInfo("특수문자는 입력하실수 없습니다.");
						return;
					}
				}
			}
		}
		
		goView("bin/CM/09/HHCM09010M",{query:searchKeyword});
	}
	
	// fn_setCommonBtns
	function fn_setCommonBtns(){
		var _getTxt = function(t){
			return getStr(t.text()).toLocaleLowerCase().trim().replaceAll(" ","").replaceAll("<br/>","").replaceAll("<br>","");
		};
		
		$(".m_bridge,.quick_link,.gmenu_shotcut,.gmenu_shotcut,.floating_menu,.added_menu").find("a").each(function(){
			var thisObj = $(this);
	        switch (_getTxt(thisObj)){
	            case "대표"						: thisObj[0].onclick=null;thisObj.off("click").on("click",function(){openHdmfDomain("HH");});break;
	            //case "대표홈페이지"				: thisObj[0].onclick=null;thisObj.off("click").on("click",function(){openHdmfDomain("HH");});break;
	            case "대표홈페이지"				: thisObj[0].onclick=null;thisObj.off("click").on("click",function(){goMain();});break;
	            case "기업"						: thisObj[0].onclick=null;thisObj.off("click").on("click",function(){openHdmfDomain("CH");});break;
	            case "적하"						: thisObj[0].onclick=null;thisObj.off("click").on("click",function(){openHdmfDomain("GE");});break;
	            case "퇴직연금"					: thisObj[0].onclick=null;thisObj.off("click").on("click",function(){openHdmfDomain("RM");});break;
	            case "다이렉트"					: thisObj[0].onclick=null;thisObj.off("click").on("click",function(){openHdmfDomain("DP");});break;
	            
	            case "하이플래너"				: thisObj[0].onclick=null;thisObj.off("click").on("click",function(){goView("bin/HP/00/HHHP00000M");});break;
	            case "채용정보"					: thisObj[0].onclick=null;thisObj.off("click").on("click",function(){openNewBrowser("https://hi.recruiter.co.kr/");});break;
	            
	            case "회사소개"					: thisObj[0].onclick=null;thisObj.off("click").on("click",function(){goView("bin/KC/00/HHKC00000M");});break;
	            case "소비자포털"				: thisObj[0].onclick=null;thisObj.off("click").on("click",function(){fn_goMenu("101401");});break;
	            case "공시실"					: thisObj[0].onclick=null;thisObj.off("click").on("click",function(){fn_goMenu('100931');});break;  //20220208 공시실링크 변경 fn_goMenu("100911")
	            case "파트너제안센터"			: thisObj[0].onclick=null;thisObj.off("click").on("click",function(){fn_goMenu("204355");});break;
	            case "english"					: thisObj[0].onclick=null;thisObj.off("click").on("click",function(){goMain("GC");});break;
	            case "korean"					: thisObj[0].onclick=null;thisObj.off("click").on("click",function(){goMain();});break;
	            
	            case "마이페이지"				: thisObj[0].onclick=null;thisObj.off("click").on("click",function(){goMenu("100810");});break;
	            case "지점찾기"					: thisObj[0].onclick=null;thisObj.off("click").on("click",function(){goView("bin/CM/00/HHCM00020M");});break;
	            case "인증센터"					: thisObj[0].onclick=null;thisObj.off("click").on("click",function(){goView("bin/ZA/05/HHZA05010M");});break; //20220214 인증센터 목록 화면으로 이동 goMenu("102064")
	            case "신고센터"					: thisObj[0].onclick=null;thisObj.off("click").on("click",function(){goMenu("101461");});break;
	            
	            case "최근본메뉴"				: thisObj[0].onclick=null;thisObj.off("click").on("click",function(){goMenu("100810",{'selTabCat':'ltVistMenu'});});break;
	            case "간편인증서발급/관리"		: thisObj[0].onclick=null;thisObj.off("click").on("click",function(){goCertification('pin');});break;
	            case "공동인증서복사"			: thisObj[0].onclick=null;thisObj.off("click").on("click",function(){goMenu("102067");});break;
	            
	            default: return;
	        }
		});
		
		/* Google Tag Manager(click_top) (지점찾기, 인증센터, 소비자포털)*/
		$(".gmenu_shotcut a").click(function(){
			try{
				var thisObj = $(this);
		        var menuNm = _getTxt(thisObj);
//		        alert("=gmenu_shotcut=menuNm=="+menuNm);
		      	window.dataLayer.push({
		      		event:"click_navigation"
		   			,click_location:"top"
		  			,click_label:menuNm
		      	});
		    }
		    catch(e) {
		      	console.log(e);
		    }

		});
		/* END Google Tag Manager(click_top) */

		/* Google Tag Manager(click_floating") (최근본메뉴, 인증센터, 공동인증복사, 소바지포털, 지점찾기)*/
		$(".floating_menu a").click(function(){
			
			try {
				var thisObj = $(this);
		        var menuNm = _getTxt(thisObj);
		      	window.dataLayer.push({
		      		event:"click_floating"
		   			,click_location:"right"
		  			,click_label:menuNm
		      	});
		    }
		    catch(e) {
		      	console.log(e);
		    }

		});
		
		/* Google Tag Manager(click_navigation") (왼쪽메뉴 다이렉트)*/
		$(".added_menu a").click(function(){
			try{
				var thisObj = $(this);
		        var menuNm = _getTxt(thisObj);
//		        alert("=added_menu=menuNm=="+menuNm);
		      	window.dataLayer.push({
		      		event:"click_navigation"
		   			,click_location:"sub"
		  			,click_label:"다이렉트"
		      	});
		    }
		    catch(e) {
		      	console.log(e);
		    }

		});

		/* Google Tag Manager(click_navigation") (대리운전계약조회, 다이렉트 해외여행보험 기간연장 및 취소)*/
		$(".added_smenu a").click(function(){
			try {
				var thisObj = $(this);
		        var menuNm = _getTxt(thisObj);
//		        alert("=added_smenu=menuNm=="+menuNm);
		      	window.dataLayer.push({
		      		event:"click_navigation"
		   			,click_location:"sub"
		  			,click_label:menuNm
		      	});
		    }
		    catch(e) {
		      	console.log(e);
		    }

		});
		/* END Google Tag Manager(click_floating") */
		
		
		$(".sub_link_menu").find("a").each(function(){
			var thisObj = $(this);
	        switch (_getTxt(thisObj)){
	            case "기업여신거래기본약관"		: thisObj[0].onclick=null;thisObj.off("click").on("click",function(){goPdfFileView('/data/PM/LOAN/agmt_cp.pdf');});break;
	            case "개인여신거래기본약관"		: thisObj[0].onclick=null;thisObj.off("click").on("click",function(){goPdfFileView('/data/PM/LOAN/agmt_credit.pdf');});break;
	            case "자본시장법시행안내"		: thisObj[0].onclick=null;thisObj.off("click").on("click",function(){goPdfFileView('/data/PM/FND/3.market.pdf');});break;
	            case "표준투자권유준칙안내"		: thisObj[0].onclick=null;thisObj.off("click").on("click",function(){goPdfFileView('/data/PM/FND/3.집합투자증권_업무규정(현대해상표준투자권유준칙)_개정본.pdf');});break;
	            case "예탁금이용료지급기준"		: thisObj[0].onclick=null;thisObj.off("click").on("click",function(){goPdfFileView('/data/PM/FND/1.investordepositmoney.pdf');});break;
	            
	            default: return;
	        } 
		});
	}

</script>

<script id="template_localNavInfo" type="text">
