			        clickTitle = clickTitle + "_검색";
			    }
	
			    if(selectorId  == "clauApn") {
			        clickTitle = clickTitle + "_약관_다운";
			    } else if(selectorId == "userMthd") {
			        clickTitle = clickTitle + "_사업방법서_다운";
			    } else if(selectorId == "prodSmry") {
			        clickTitle = clickTitle + "_상품요약서_다운";
			    } else if(selectorId == "prodNote") {
			        clickTitle = clickTitle + "_상품설명서_다운";
			    } else if(selectorId == "btnRecoProd") {
			        clickTitle = clickTitle + "_연관상품";
