<script type="text/javascript">

	if (!window["rpSessionData"]) {
		window["rpSessionData"] = new UserSessionManager("eyJsb2dpblluIjoiTiJ9");
	}

	$(document).ready(function(){
		
		function rpPrintLog(...param) {
			if( isLocal() || isDev() || isQa() ){
				console.log("%c[" + new Date().format("HH:mm:ss") + "]" + param.join(""), 'color: blue;');
			}
		}
		
		function _rpChangeMenuByDvsn () {
			
			if (!rpSessionData) {
				return;
			}
			
			var authCheck = rpSessionData.get("authCheck");
						
			if ($("#rpMoMenuPanelBas").length > 0 && $("#rpMoMenuPanelPer").length > 0) {
				if (authCheck == "1" || authCheck == "2" || authCheck == "3") {
					if (!isProd()) {
						rpPrintLog("[MO] [퇴직연금] [개인계약선택] ==> <개인> 메뉴를 show 처리, authCheck: " + authCheck);
					}
					
					$("#rpMoMenuPanelBas").hide();
					$("#rpMoMenuPanelPer").show();
				} else {
					if (!isProd()) {
						rpPrintLog("[MO] [퇴직연금] [선택계약없음/법인계약선택] ==> <기본> 메뉴를 show 처리, authCheck: " + authCheck);
					}
					
					$("#rpMoMenuPanelBas").show();
					$("#rpMoMenuPanelPer").hide();
				}
			}
			
			return true;
		}
		
		if (isMobile) {
			_rpChangeMenuByDvsn();
		}
		
	});
	
	if (!window["rpResetDoActiveLastTab"]) {
		window["rpResetDoActiveLastTab"] = function () {
			var RP_PAGE_STORE_KEY = "RP_PAGE_RESTOR";
			BizSessionStorage.remove(RP_PAGE_STORE_KEY);
		}
	}
	
</script>
