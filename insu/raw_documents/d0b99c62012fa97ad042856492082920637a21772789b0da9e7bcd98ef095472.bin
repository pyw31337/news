				});
			}
			catch(e) {
			  	console.log(e);
			}
		});
		
		// 공시실_보험상품공시_가입일 선택
		$(document).on("change", "#inp_datepicker", function(){
		    console.log("공시실_보험상품공시_가입일 선택");
		    
		    try {				
				window.dataLayer.push({
					event:"click_button"
					,click_label:"공시실_보험상품공시_가입일 선택"
					// ,click_location:""
					// ,click_type: ""
					,event_name_for_report:"click_button"
				});
			}
			catch(e) {
			  	console.log(e);
			}
		});
		
		// 공시실_보험상품공시_[판매형태, 보험종류, 보험유형, 상품명]
		$(document).on("click", "[class^='lv']", function(){
		    try {
		    	if($(this).attr("class").indexOf("lv4") > -1) {
		    		return ;
		    	}
			    console.log("공시실_보험상품공시_" + $(this).text() + $(this).attr("class"));
		    	
				window.dataLayer.push({
					event:"click_button"
