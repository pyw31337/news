				});
			}
			catch(e) {
			  	console.log(e);
			}
		});
		
		// PDF 다운로드, 연관상품 클릭
		$(document).on("click", "#clauApn, #userMthd, #prodSmry, #prodNote, #btnRecoProd", function(){
			try {			
			    var selectorId = this.id;
			    var clickTitle = "공시실_보험상품공시";
			    if( $(this).parents("#tbd_prodList").length > 0 ) {
			        clickTitle = clickTitle + "_트리";
			    } else if( $(this).parents("#tbd_recoProdList").length > 0 ) {
