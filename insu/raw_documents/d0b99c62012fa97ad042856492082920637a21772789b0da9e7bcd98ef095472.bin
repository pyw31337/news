		// 2021.10.09 nos 공통 처리
		setTimeout(function(){setNosSecurity();},1);
		
		getCertification().getDeviceInfo();
		
		// 2021.12.03 native에서 로그인/로그아웃시 1회 처리
		setTimeout(function(){
			var pId = "";
			if( !isNull(pId) && pId != "null" ){
				BizLocalStorage.set("lastId",pId, true);
				if( ENV_INFO.isApp ){
					doRequest("COCE0000M54S",{ptyId:pId},{isShowMessage:false,isIndicator:false}).then(function(res){
						callNative("setUserInfo", {ptyId:pId,isNotification:getStr(res.data.usePushYn)});
					});
						
					// logout clear
					if( "" == "Y" ){
						callNative("clearUserInfo");
					}
				}
				
				// 2022.03.31 마지막 로그인시 사용된 인증수단 확인
				BizLocalStorage.set("lastLoginType", SessionData.get("loginType"), true);
			}
		},1);
		
		// 2021.12.28 중복로그인 알림 팝업
		var isDup = "";	// 중복로그인체크
		if( !isNull(isDup) ){
			if( isDup == "Y" ){
				alertInfo("");
			}
		}
		
		if( !isNull(getUrlParams().rid) ){
			if( !isNull(HDMF_MENU.getMenuInfo(getUrlParams().rid).menuId) ){
				fn_goMenu(HDMF_MENU.getMenuInfo(getUrlParams().rid).menuId);
			}
		}
		
		// 2021.01.03 test 세션체커
		startSessionChecker();
	
		// 2021.11.29 에러가 있을 경우 에러 출력
		var resCd = "";
		if( !isNull(resCd) ){
			setTimeout(function() {
				var showList = [{
					  code		: resCd
					, gId		: ""
					, message	: setBr("")
					, show		: "1"									// 메세지출력여부 : 1(보임), 2(안보임)
					, tranId	: ""
					, type		: "ERROR" 								// 메세지유형 : INFO, WARN, ERROR, "" (자동자 에러전문은 type이 "")
				}];
				
				openLayerPopup("/error/iferrorPopup", "iferrorPopup", {data : {list : showList}}).then(function(rtnVal){
					window._goBack(resCd);
				});
			}, 100);
		}
	});
	
