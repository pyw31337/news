<script type="text/javascript">
!(function(){
	$(document).ready(function(){
		try{
			window["SessionData"] = new UserSessionManager("eyJpbnBhdGgiOiIiLCJsb2dpblluIjoiTiJ9");
		}catch(e){}
		
		<!-- Google Tag Manager(page_view)-->
		try{
			
			var menuId = getBizMenuId();
			var menuInfo = HDMF_MENU.getMenuInfo(menuId);
			var menuNm = getStr(menuInfo.menuNm);
			var curView = _HDMF_VIEW_INFO_.curView;
			var login_YN; //로그인여부
			var device_gubun; //디바이스 구분 값.
			var service_name; //서비스명
			
			// 로그인여부 체크 로직
			if(SessionData.get("loginYn") == "Y"){
				login_YN = "Y";
			}else{
				login_YN = "N";
			}

			
			//모바일여부 체크로직
			var epsCat = (ENV_INFO.isMobile ? "M" : "P");
			if(epsCat == "M"){ //모바일
				device_gubun = "mobile_web";
				if( ENV_INFO.isApp ){
					device_gubun = "mobile_app";
				}
			}else{
				device_gubun = "pc_web";
			}
			
			if (menuId =="100291" || menuId =="100292" || menuId =="100293" || menuId =="100294" || menuId =="100295" || menuId =="100296" || menuId =="201752"
				  || menuId =="929000" || menuId =="929010" || menuId =="100217" || menuId =="929020" || menuId =="929030" || menuId =="929040" || menuId =="929050" || menuId =="201754")
			{
				service_name = "장기보험_TM";
			}else {
				service_name = "현대해상_대표";
			}
			
//			alert("==접속주소 : "+curView+"\n\n타이틀 : "+menuNm+"\n\n사이트명 : "+service_name+"\n\n로그인여부 : "+login_YN+"\n\n접속기기 : "+device_gubun);
			window.dataLayer.push({
				event:"custom_page_view",
				page_info: {
					page_url: curView,
					page_title: menuNm
				},
				platform_info: {
					service_type: service_name,
					device_type: device_gubun
				},
				user_info: {
					login_status: login_YN,
//					previous_view_item:""
				}
			});
				
		}catch(e){
			console.warn(e);
		}
		<!-- End Google Tag Manager(page_view)-->
		
		
		<!-- Google Tag Manager(click_navigation) 메인메뉴클릭시-->
//		$(".gnb .sub_menu a").on("click", function() { 
		$(".taging_mainMenu").on("click", 'a', function() { 
			try {
				
				if ($(this).attr("data-menuid") != undefined && $(this).attr("data-menuid") != null && $(this).attr("data-menuid") !="") {
			        var menu_category;
			        var menu_category2;
			        if(HDMF_MENU.getMenuLocalNavList($(this).attr("data-menuid")).length > 0) {
			        	menu_category=HDMF_MENU.getMenuLocalNavList($(this).attr("data-menuid"))[0].menuNm; //카테고리1
			        }
			        if(HDMF_MENU.getMenuLocalNavList($(this).attr("data-menuid")).length > 1) {
			        	menu_category2=HDMF_MENU.getMenuLocalNavList($(this).attr("data-menuid"))[1].menuNm; //카테고리2
			        }
			        
			        if(HDMF_MENU.getMenuLocalNavList($(this).attr("data-menuid")).length == 4) {
			        	menu_category2=HDMF_MENU.getMenuLocalNavList($(this).attr("data-menuid"))[1].menuNm; //카테고리3
			        }
			        /* menu_category2 값이 다이렉트전용상품으로 조회되어 하드코딩 처리함 */
                    var menuId = $(this).attr("data-menuid");
					if (menuId =="100291" || menuId =="100292" || menuId =="100293" || menuId =="100294" || menuId =="100295" || menuId =="100296" || menuId =="201752"){
						menu_category2 = "전화가입상품";
					}
					
					//네비게이션 최근방문메뉴 클릭시 카테고리 설정
					if($(this).hasClass('navigation_visit')) {
						menu_category = '최근방문';
						menu_category2 = '최근방문서비스';
					}
			        
			        var menuNm = HDMF_MENU.getMenuInfo($(this).attr("data-menuid")).menuNm; //메뉴명
//			 		alert("==메뉴명1 : "+menu_category+"\n\n메뉴명2 : "+menu_category2+"\n\n메뉴명3 : "+menuNm);
			      	window.dataLayer.push({
			       		event:"click_navigation"
			       		,click_location:"main"
			       		,click_label:menuNm
			       		,menu_category: menu_category
			       		,menu_category2:menu_category2
	//		       		,index:undefined
			      	});
				}
		    }
		    catch(e) {
		      	console.log(e);
		    }
		});
		<!-- End Google Tag Manager(click_navigation) 메인메뉴클릭시-->

		
		<!-- Google Tag Manager(click_navigation) 메인헤더 클릭시(큰글씨, 로그인, 회원가입등)-->
		$(".tagging_header").on("click", function() { 
			try {
//			 		alert("==메뉴명header : "+$(this).text());
			      	window.dataLayer.push({
			      		event:"click_navigation"
			      			,click_location:"header"
			      			,click_label:$(this).text()
			      	});
		    }
		    catch(e) {
		      	console.log(e);
		    }
		});
		
		
		<!-- Google Tag Manager(click_navigation) 하단 전화번호영역 클릭시(대표콜센터, 하이카다이렉트, 보험가입신규문의)-->
		$(".tagging_mainCall").on("click", function() { 
			try {
			 		//alert("==메뉴명header : "+$(this).text());			
			 		var label = $(this).text().replace(/[^가-힣]/gi,'');
					//alert("메뉴명 : "+label);		
			      	window.dataLayer.push({
			      		event:"click_call"
			      			,click_location:"home"
			      			,click_label:label
			      	});
		    }
		    catch(e) {
		      	console.log(e);
		    }
		});
		
		
		<!-- Google Tag Manager(click_navigation) 하단공통 클릭시(상품, 인증센터, 홈, 지점찾기, 고장출동)-->
		$(".bottomFixedMenu a").on("click", function() { 
