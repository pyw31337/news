<script type="text/javascript">
	window._pageHeaderInfo = {type:"HI"};
	
	function goPathGuidePopup(){
		openLayerPopup("/bin/CS/06/HHCS06012P", "hhcs06012Pop", {isCurtainYn:true});
	}
 
	/**
	 * @alias 일반회원(인터넷회원) 탈퇴페이지 이동
	 */
	function withdrawalGeneralMbr() {
		goView("/bin/MY/02/HHMY02112M");
	}
	
	$(document).ready(function(){
		if('' == "big" || BizLocalStorage.get("bigFlag") == "big"){
			$("#mobGnb").remove();			// (모바일) 메뉴
			$("#bigMobGnb").show();			// (모바일)큰글씨 메뉴
			BizLocalStorage.set("bigFlag", "big");
			$("#mobGnbHeader").addClass("big");
			
		} else {
			$("#bigMobGnb").remove();		// (모바일) 메뉴
			$("#mobGnb").show();			// (모바일)큰글씨 메뉴
			BizLocalStorage.set("bigFlag", "");	
		}
		

		$(".btn_main").click(function(){
			goMain();
		});


		/***********************************************
		* 최근방문 메뉴 (모바일)
		***********************************************/
		if(ENV_INFO.isMobile) {
			$('#li_ltVistMenuList .ltVistMenuList').empty();
			if(SessionData.get("loginYn") == "Y") {
				var _html = '';
				var ltVistMenuList = BizLocalStorage.get("recentMenuList_" + BizLocalStorage.get("lastId"), true) || [];
				if(ltVistMenuList.length > 0) {
					$.each(ltVistMenuList, function(index, item) {
						if(index < 10) { //10개 컷
							_html += '<li>'
								_html += '<a href="#" data-menuid="'+item.menuId+'" onclick="fn_goMenu(\''+item.menuId+'\')" class="sub navigation_visit">'+item.menuNm+'</a>'
							_html += '</li>';
						}
					});
				}
				$('#li_ltVistMenuList .ltVistMenuList').html(_html);
				$('#li_ltVistMenuList').show();
				
				// R20240904-0048 모바일_로그인 후 햄버거 메뉴(전체 메뉴) 진입 시 노출 로직 변경
				var CHK_MENU = ["n2", "n3", "n4", "n6", "n8", "n9"]; //보험상품(n2), 대출(n3), 보상서비스(n4), 스마트발급센터(n6), 소비자포탈(n8), 하이플래너(n9)
				var mMenu = $('.main_menu > ul > li');
				mMenu.each(function(){
					var thisObj = $(this);
					var thisParent = thisObj.closest('li');
					var thisId = thisParent.attr("id");
										
					//보험상품(n2), 대출(n3), 보상서비스(n4), 스마트발급센터(n6), 소비자포탈(n8), 하이플래너(n9)이외 메뉴는 최근방문 tab 열기
					if (!!thisParent.hasClass('active')) {
						if(!CHK_MENU.includes(thisId)) { 
							//이력이 있을때만 메뉴 활성화
							if(ltVistMenuList.length > 0) {
								$('.ltVistMenuList').parents(".sub_layer").prev("a").click();
							}
						}
					}				
					
				});
				
				//이력이 있을때만 메뉴 활성화
				//if(ltVistMenuList.length > 0) {
				//	$('.ltVistMenuList').parents(".sub_layer").prev("a").click();
				//}
			}
		}
	});

	function allMenuView(){
    	confirmInfo("일반모드에서 확인 가능합니다. <br/>일반모드로 전환할까요?", null, {
            confirmBtnNm: "네",
            cancleBtnNm: "아니오",
            buttonNmModYN: "Y"
        }).then(function(rtn) {
            if (rtn == "Y") {
				BizLocalStorage.set("bigFlag", "");	
				BizLocalStorage.set("bigSendMain", "Y");	
				goMain();
            }
        });
	}
	
</script>
