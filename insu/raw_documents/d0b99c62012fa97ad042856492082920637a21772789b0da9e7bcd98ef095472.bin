					<!-- ■■■■■■■■■■■■■■■■■■■■ 퇴직추가 PC메뉴 (li 시작) ■■■■■■■■■■■■■■■■■■■■ -->
					






<script type="text/javascript">

	if (!window["rpSessionData"]) {
		window["rpSessionData"] = new UserSessionManager("eyJsb2dpblluIjoiTiJ9");
	}

	$(document).ready(function(){
		
		function rpPrintLog(...param) {
			if( isLocal() || isDev() || isQa() ){
				console.log("%c[" + new Date().format("HH:mm:ss") + "]" + param.join(""), 'color: red;');
			}
		}
		
		var loginYn = "N" || "N";
		var rpLoginYn = "N" || "N";
		
		if (!isProd()) {
			rpPrintLog("[홈] loginYn = ", loginYn, ", [퇴] rpLoginYn = ", rpLoginYn)
		}
		
		function _rpChangeMenuByDvsn () {
			
			if (loginYn == "Y") {
				if (rpLoginYn == "Y") {
					// 홈페이지 로그인 후 > 퇴직연금 로그인 후
					
					var authCheck = rpSessionData.get("authCheck");
			
					if (authCheck == "4" || authCheck == "5" || authCheck == "7" || authCheck == "8") {
						// 법인계약 선택 시 ==> "④ 법인 메뉴" 표출
						if (!isProd()) {
							rpPrintLog("[PC] [퇴직연금] [법인계약선택] ==> <법인> 메뉴를 show 처리, authCheck: " + authCheck );
						}
						
						$("#rpMenuPanelBas").hide();
						$("#rpMenuPanelEnp").show();
						$("#rpMenuPanelPer").hide();
					} else if (authCheck == "1" || authCheck == "2" || authCheck == "3") {
						// 개인계약 선택 시 ==> "③ 개인 메뉴" 표출
						if (!isProd()) {
							rpPrintLog("[PC] [퇴직연금] [개인계약선택] ==> <개인> 메뉴를 show 처리, authCheck: " + authCheck);
						}
						
						$("#rpMenuPanelBas").hide();
						$("#rpMenuPanelEnp").hide();
						$("#rpMenuPanelPer").show();
					} else {
						// 특정 계약선택 전 (계약다건으로 특정 계약을 선택상태로 만들 수 없는 경우 포함) ==> "② 기본 메뉴" 표출
						if (!isProd()) {
							rpPrintLog("[PC] [퇴직연금] [선택계약없음] ==> <기본> 메뉴를 show 처리, authCheck: " + authCheck);
						}
						
						$("#rpMenuPanelBas").show();
						$("#rpMenuPanelEnp").hide();
						$("#rpMenuPanelPer").hide();
					}
					
				} else {
					// 홈페이지 로그인 후 > 퇴직연금 로그인 전 ==> "② 기본 메뉴" 표출
					if (!isProd()) {
						rpPrintLog("[PC] [홈페이지 로그인상태][퇴직연금 비로그인상태] ==> <기본> 메뉴를 show 처리");
					}
					
					$("#rpMenuPanelTap_beforeRpLogin").hide();
					$("#rpMenuPanelBas_beforeRpLogin").show();
				}
			} else {
				// 홈페이지 로그인 전 (== 퇴직연금 로그인 전) ==> "① [개인/법인] 탭 메뉴" 표출
				if (!isProd()) {
					rpPrintLog("[PC] [홈페이지 비로그인상태][퇴직연금 비로그인상태] ==> <탭> 메뉴를 show 처리");
				}
				
				$("#rpMenuPanelTap_beforeRpLogin").show();
				$("#rpMenuPanelBas_beforeRpLogin").hide();
			}
			
			return true;
		}
		
		if (!isMobile) {
			_rpChangeMenuByDvsn();
		}
		
	});
	
	// 메뉴 클릭 시 화면 내에서 기 선택된 탭 정보를 삭제하여 디폴트 탭이 표출되게 함 
	function rpResetDoActiveLastTab() {
		var RP_PAGE_STORE_KEY = "RP_PAGE_RESTOR";
		BizSessionStorage.remove(RP_PAGE_STORE_KEY);
	}

</script>

