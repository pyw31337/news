/**
 * @alias 홈페이지내 모든 뒤로가기 클릭시 호출 처리됨 2024.01(마이페이지, 새소식등)
 * @param returnPageView
 */
function goBack(){
	var returnPageView = "";
	if (!isNull(returnPageView)){
		goView(returnPageView);
	}else {
		goView("/main/main");
	}
}

function getEmoniLang(key) {
	if(key == null || key == "") {
		alertInfo("완전판매e모니터링 다국어 코드가 없습니다.");
		return;
	}

	var reqParam = {'key':key};
	doRequest("HHIL0200M05S", reqParam, {responseFunction : function(tranId, res) {
		if (exceptionCheck()) {
			return;
		}
		console.log(res.data.koLang);
		console.log(res.data.zhLang);
		console.log(res.data.viLang);
		console.log(res.data.enLang);
	}});
}
</script>

<title>현대해상</title>

<script type="text/javascript">
		
	var mbHeader = { title: '보험상품공시', tooltip: false, prev: true, menu: true };
	var g_insMap = {};	// 상품 map
	var g_isMtMenuShow = true;	// 자동차보험 서브메뉴 show 여부
	var g_isLtMenuShow = false;	// 장기보험 서브메뉴 show 여부
	var g_upperCategory = "00";	// 상품 상위 카테고리
	var g_isSale = "Y";	// 판매여부
	var g_subCat = ""; // 자동차 하위 선택
	var g_initLoad = true; // 최초로드 구분
	var g_searchMode = false; // 검색여부
	var g_fileClickGb = ""; //파일 미리보기 다운받기 구분
	var g_recomProdNm = "";			// 연관상품명
	var g_recomProdCatCd = "";		// 연관상품유형코드
	var g_recomRepInsCd= "";		// 연관상품대표코드
	
	var INIT_FLAG = true;
	
	/**
	 * @alias 화면 로딩 시 초기 실행 함수
	 */
	$(function() {
		doRequest("HHCA0310M38S", {}, {isIndicator:false, responseFunction: fn_initCallBack } );	// INIT_FLAG
		/**
		* 검색창 애니메이션
		*/
		// 상품명 or 가입일 + 상품명 선택 /2508
		const selectSearchItem = document.getElementById('search_item'); // select
		const searchItemDate = document.querySelector('.search__date'); // date
		const searchItemText = document.querySelector('.search__text'); // text
		
		const onToday = new Date(); // 오늘 날짜
		// 년, 월, 일 추출
		const todayYear = onToday.getFullYear();
		const todayMonth = String(onToday.getMonth() + 1).padStart(2, '0');
		const todayDate = String(onToday.getDate()).padStart(2, '0');
		const todayString = dateFormat(todayYear+todayMonth+todayDate, "yyyy.MM.dd"); // 날짜 형식
		
		// event
		selectSearchItem.addEventListener('change', (event) => {
			// 오늘 날짜 설정
			$('.inp_date').val(todayString);
			
			const selectItemValue = event.target.value;

			switch(selectItemValue) {
				case '0': // 선택 : 상품명
					searchItemDate.classList.remove('active'); // 가입일
					setTimeout(() => {
						searchItemDate.style.display = 'none'; // 가입일 (애니메이션 종료 후 display:none)
					}, 300);
					searchItemText.classList.remove('w-small'); // 상품명 넓이 조정
					break;

				case '1':	// 선택 : 가입일+상품명
					searchItemDate.style.display = 'block'; // 가입일
					setTimeout(() => {
						searchItemDate.classList.add('active'); // 가입일 (display:block 후 애니메이션 시작)
					}, 10);
					searchItemText.classList.add('w-small'); // 상품명 넓이 조정
					break;

				default :
					break;
			}
		});
		
		$("#inp_datepicker").on("change", function(){
			var selDate = $("#inp_datepicker").val();
	
			if(!isDate(selDate)) {
				alertInfo("가입일을 정확하게 입력해주세요.", function(){
					$("#inp_datepicker").val(todayString);
				});
				return;
			}
			
			// 입력일 비교
			if( parseInt(replaceAll(selDate, ".", ""), 10) > parseInt(replaceAll(todayString, ".", ""), 10)){
				alertInfo("미래일자는 입력할 수 없어요.", function(){
					$("#inp_datepicker").val(todayString);
				});
				return;
			}
		});
		
		
		
		$(document).on("click", "button[class^=lv]", function() {
		    const MAX_STEP = 4;
		    var _thisClass = $(this).attr("class");
		    var selectLv = _thisClass.substr('2','1');

		    // 상위 STEP active 제거(this 포함)
		    for(var i = selectLv; i <= MAX_STEP; i++) {
		    	$(".lv" + i).removeClass("active");
		    }
		    $(this).addClass("active");
		    $(this).attr("title", "현재 선택중");
		    
		    
		    switch(selectLv) {
		        // 판매형태
				case "1" :
		            $("#div_insCat").show();
		            $("#ul_mtInsCat").hide();
		            $("#ul_ltInsCat").hide();
					$("#div_goodsList").html("");
					
					$("#searcTbl").hide();
		            break;
		        
				// 보험종류
		        case "2" :
		            if($(this).val() == "0200") {  			// 자동차보험
		                $("#ul_ltInsCat").hide();
		                $("#ul_mtInsCat").show();
						$("#div_goodsList").html("");
		            } else if ($(this).val() == "03") {  	// 장기보험
		                $("#ul_ltInsCat").show();
		                $("#ul_mtInsCat").hide();
						$("#div_goodsList").html("");
		            } else {
		                $("#ul_ltInsCat").hide();
		                $("#ul_mtInsCat").hide();
					 
						/* 상품명 보여주기 기능 필요 */
		                if(INIT_FLAG) {
							showLoading();
		                } else {
		                	drawProdNmList();
		                }
		            }
		            
		            $("#searcTbl").hide();
		            break;

				// 보험유형
		        case "3" :
					/* 상품명 보여주기 기능 필요 */
					if(INIT_FLAG) {
						showLoading();
		            } else {
		            	drawProdNmList();
		            }
					
					$("#searcTbl").hide();
		            break;
		        
		    }
		});
		
		
		
		<!-- Google Tag Manager START-->
		/* 함수 내 호출 : 
			searchProductListByKeyword (공시실_보험상품공시_검색)	- ga_searchProduct
		*/
		
		// 공시실_보험상품공시_조건선택
		$(document).on("change", "#search_item", function(){
			console.log("공시실_보험상품공시_조건선택");
			
			try {				
				window.dataLayer.push({
