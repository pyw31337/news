					,event_name_for_report:"click_button"
				});
			}
			catch(e) {
			  	console.log(e);
			}
		    
		    console.log( clickTitle );
		});
		
		<!-- Google Tag Manager END-->
		
		
	});
	
	
	// 공시실_보험상품공시_검색, 공시실_보험상품공시_[검색어]
	function ga_searchProduct(_searchWord) {
		console.log("공시실_보험상품공시_{" + _searchWord + "}");
		try {				
			window.dataLayer.push({
				event:"click_button"
				,click_label:"공시실_보험상품공시_검색"
				// ,click_location:""
				// ,click_type: ""
				,event_name_for_report:"click_button"
			});
			
			window.dataLayer.push({
				event:"click_button"
				,click_label:"공시실_보험상품공시_" + _searchWord
				// ,click_location:""
				// ,click_type: ""
				,event_name_for_report:"click_button"
			});
		}
		catch(e) {
		  	console.log(e);
		}
	}
	
	
	/**
	* [상품명] 리스트 조회
	* 판매형태 + 보험종류 + 보험유형 선택 시 상품명 노출 함수
    *   - 장기상품의 경우 보험종류 + 보험유형이 PROD_CAT_CD가
    *   - 기타 상품의 경우 보험유형이 나눠져있지 않음.
    *   - 단, 자동차의 경우 PROD_TY으로 구분지어 사용
	*/
	function drawProdNmList(){
		var slYn = "";
		var prodCatCd = "";
		var prodTy = "";
        var selectedLv = "";
        var appendHTML = "";
		
		$("button[class^=lv]").each(function(i,_this) {
		    if( $(_this).hasClass("active") ) {
		    	selectedLv = $(_this).attr('class');
		    	
		    	// 판매형태
		        if(selectedLv.indexOf("lv1") > -1) {
		        	slYn = $(_this).val();
		        } 
		    	// 보험종류
		        else if(selectedLv.indexOf("lv2") > -1) {
		        	prodCatCd = $(_this).val();
		        } 
		    	// 보험유형
		        else if(selectedLv.indexOf("lv3") > -1) {
		        	prodTy = $(_this).val();
		        }
		        
		    }
		});
		
		
		if(isNull(slYn) && isNull(prodCatCd) && isNull(prodTy)) {
			$("#div_goodsList").html("");
		} else {
			// 장기상품(PROD_CAT_CD) : 보험종류 + 보험유형
			if(prodCatCd == "03") {
				prodCatCd = prodCatCd + prodTy;
			}
			
			// DEEP COPY
			if(g_insMap[slYn][prodCatCd]) {
				$.each(g_insMap[slYn][prodCatCd], function(i, obj){
					var repInsCd = nvl(obj[0].repInsCd,"");
					
					if(prodCatCd == "0200") { // 자동차보험 유형(개인용, 업무용...)을 선택했을 경우에는 일치하는 것만 표시
						if(obj[0].prodTy == prodTy) {
							appendHTML += "<button type='button' class='lv4' onclick=\"onClickProdNm("+"'"+prodCatCd+"', '"+obj[0].prodNm+"', '"+repInsCd+"', '"+prodTy+ "', '"+slYn+"');\"><span>"+ obj[0].prodNm +"</span></button>";
						}
					} else {
						appendHTML += "<button type='button' class='lv4' onclick=\"onClickProdNm('"+prodCatCd+"', '"+obj[0].prodNm+"', '"+repInsCd+"', '"+prodTy+ "', '"+slYn+"');\"><span>"+ obj[0].prodNm +"</span></button>";
					}
					
				});				
				$("#div_goodsList").html(appendHTML);
			}
		}
		
	}
	
	function onClickProdNm(prodCatCd, prodNm, repInsCd, prodTy, slYn) {
		$("#tbd_prodList").html( makeProdListHtml(prodCatCd, prodNm, prodTy, slYn) );
		$("#searcTbl").show();
	}
	
	
	/**
	 * @alias 상품명 검색(키워드) 버튼
	 */
	function searchProductListByKeyword(){
		clearInputMessage();
		
		var _searchWord = $('input[name=ipt_searchProd]').val();
		var _searchType = $("#search_item").val();
		var _searchDate = "";
// 		g_searchMode = true;
		
		// 검색유형 [0:가입일, 1:가입일+상품명]
		if(_searchType == "1") {
			_searchDate = $(".inp_date").val().replaceAll(".", "");
		} else {
			_searchDate = "";
		}
		
		if( isNull(_searchWord) || _searchWord.length < 1){
			alertInfo("검색어를 한글자 이상 입력해 주세요");
			return;
		}
		
		if(_searchWord.replaceAll(" ","") == "" ) {
			alertInfo("공백은 입력할 수 없습니다.<br>다시 검색어를 입력해 주세요");
			return;
		}
		
		doRequest("HHCA0310M38S", {searchData : _searchWord, searchDate : _searchDate, searchType : _searchType, searchKeyword : 1 });
		
		<!-- Google Tag Manager CALL -->
		ga_searchProduct(_searchWord);
	}
	
	/**
	 * @alias doRequest에 대한 응답함수
	 * @param tranId : doRequest에서 요청한 전문번호
	 */
	function doResponse(tranId, res){  
		
		if (exceptionCheck()) {
			return;
		}
		if(tranId == "HHCA0310M26S"){
			showLoading();
			//var filePath = model.getValue("/root/response/downloadFilesInfo/downloadFilesInfo_row[1]/path");
			var savPath   = res.data.savPath;
			var savFileNm = res.data.savFileNm;
			var flExts    = res.data.flExts;
			
			var fullPath  = savPath + "/" + encodeURIComponent(savFileNm) + "." + flExts;
			
			//fnCFileDownload(fullPath);
			if( g_fileClickGb == "view"){				
				goPdfFileView(fullPath);
			}else {				
				doBizFileDownload(fullPath);
			}

			/* 다운로드 파일이 없는경우 풀리지 않아서 강제로 풀어줌 */
			setTimeout(function() {
		    	hideLoading();
        	}, 4000);

		}else if (tranId == "HHCA0310M38S"){
			// fn_initCallBack 에서도 호출함( 최초 조회를 위함 )
			$("#tbd_searchSlYList").html("");
			$("#tbd_searchSlNList").html("");
			var slYProdList  = res.data.slYProdList;
			var slNProdList  = res.data.slNProdList;
			
			slYProdList = generateValidJson(slYProdList);
			slNProdList = generateValidJson(slNProdList);
			
			$("#initSearchBox").hide();						// [검색 결과 없음] 박스
			drawSearchHTML(slYProdList, "searchSlYTbl");	// 판매 중인 상품
			drawSearchHTML(slNProdList, "searchSlNTbl");	// 판매 중지 상품
			
		} else if (tranId == "HHCA0310M39S"){
			var recommendCnt = res.data.recommendCnt;
			// if(recommendCnt > 1) {
				var recommendDataObj = {};
				recommendDataObj.recommendCnt = recommendCnt;
				recommendDataObj.prodNm = g_recomProdNm; 
				recommendDataObj.prodCatCd = g_recomProdCatCd;
				recommendDataObj.repInsCd = g_recomRepInsCd;
				
				openLayerPopup('/bin/PA/03/HHPA03022P','hhpa03022Pop', {data : recommendDataObj})
			/*
			} else {
				alertInfo("현재 상품은 연관 상품이 없습니다.");
			}
			*/
		}
	}

	function drawSearchHTML(srcList, selector) {
		var searchHTML = "";
		var prodCatNm = "";
		var prodCatCd = "";
		var prodNm = "";
		var tblTitle = "";
		var tblSelector = "";
		var srcListCnt = srcList.length;
		
		// TABLE TITLE
		if(selector == "searchSlYTbl") {
			tblTitle = "판매 중인 상품 (총 "+ srcListCnt +"건)";		// 검색결과 - 판매 중인 상품 TITLE
			tblSelector = "tbd_searchSlYList";
		} else if (selector == "searchSlNTbl") {
			tblTitle = "판매 중지 상품 (총 "+ srcListCnt +"건)";		// 검색결과 - 판매 중지 상품 TITLE
			tblSelector = "tbd_searchSlNList";
		}
		$("#"+selector).find(".h3").text(tblTitle);
		
		// TBODY CONTENT
		if(srcListCnt < 1) {
			searchHTML += "<tr>";
			searchHTML += "<td colspan='9'>검색결과가 존재하지 않습니다.</td>";
			searchHTML += "</tr>";
		} else {
			$.each(srcList, function(i, obj){
				prodNm = obj.prodNm;
				prodCatCd = obj.prodCatCd.substr(0, 2);				
				if( prodCatCd == "01") {
					prodCatNm = "일반보험";
				} else if( prodCatCd == "02") {
					prodCatNm = "자동차보험";
				} else if( prodCatCd == "03") {
					prodCatNm = "장기보험";
				} else if( prodCatCd == "04") {
					prodCatNm = "퇴직보험";
				} else if( prodCatCd == "05") {
					prodCatNm = "퇴직연금";
				} else {
					prodCatNm = "기타";
				}
				
				searchHTML += "<tr>";
//				searchHTML += "<td>" + prodCatNm + "</td>";
				searchHTML += "<td class='l'>" + prodNm + "</td>";

				var slStDt = obj.slStDt ? setFormatDate(trim(obj.slStDt), ".") : obj.slStDt;
				var slEdDt = obj.slEdDt ? setFormatDate(trim(obj.slEdDt), ".") : obj.slEdDt;
				slEdDt = nvl(slEdDt,"");
				searchHTML += "<td>" +  nvl(slStDt,"") + "</td>";
				searchHTML += "<td>" +  nvl(slEdDt,"") + "</td>";

				/* 종료일 : 현재 처리
					if(isNull(slEdDt)) {
						searchHTML += "<td>" + nvl(slStDt,"") + "</td>";
						searchHTML += "<td> 현재</td>";
					}
				*/

				// 금리연동
				if(prodCatCd == "03") {
					var intRtPlctYn = obj.intRtPlctYn == "Y" ? "O" : "X";
					searchHTML += "<td>" + intRtPlctYn + "</td>";
				}else{
					searchHTML += "<td> X </td>";
				}

				var popupTag1 = !isNull(obj.clauApnflId) ? "id='clauApn' class='file pdf' title='약관 새창 띄움' onclick=\"linkPdf('" + obj.clauApnflId + "')\"" : "class='disabled'";
				var popupTag2 = !isNull(obj.userMthdApnflId) ? "id='userMthd' class='file pdf' title='PDF뷰어 새창 띄움' onclick=\"openPdf('" + obj.userMthdApnflId + "')\"" : "class='disabled'";
				var popupTag3 = !isNull(obj.prodSmryApnflId) ? "id='prodSmry' class='file pdf' title='PDF뷰어 새창 띄움' onclick=\"openPdf('" + obj.prodSmryApnflId + "')\"" : "class='disabled'";
				var popupTag4 = !isNull(obj.prodNoteApnflId) ? "id='prodNote' class='file pdf' title='PDF뷰어 새창 띄움' onclick=\"openPdf('" + obj.prodNoteApnflId + "')\"" : "class='disabled'";

				searchHTML += "<td><a href=\"javascript:void(0)\" " + popupTag1 + "></a></td>";
				searchHTML += "<td><a href=\"javascript:void(0)\" " + popupTag2 + "></a></td>";
				searchHTML += "<td><a href=\"javascript:void(0)\" " + popupTag3 + "></a></td>";
				searchHTML += "<td><a href=\"javascript:void(0)\" " + popupTag4 + "></a></td>";
				
				
				// if(srcList.filter(item => item.prodCatCd === obj.prodCatCd).length > 1 ){}
				if(obj.repInsYn == "Y") {
					searchHTML += "<td><button type='button' id='btnRecoProd' onclick=\"fn_recomProd('" + prodNm+ "', '" + obj.prodCatCd + "', '" + obj.repInsCd  + "')\" class='btn line' title='연관상품 열림'>연관상품</button></td>";
				} else {
					searchHTML += "<td></td>";
				}
				
				
				searchHTML += "</tr>";
			});
		}
		
		// $("#"+selector).html(searchHTML);
		$("#"+tblSelector).html(searchHTML);
		$("#"+selector).show();
	}
	
	/**
	 *	@alias 연관상품 조회
	 */
	function fn_recomProd(prodNm, prodCatCd, repInsCd ) {
		g_recomProdNm = prodNm;
		g_recomRepInsCd = nvl(repInsCd, "");
		g_recomProdCatCd = nvl(prodCatCd, "");
		doRequest("HHCA0310M39S", {repInsCd : g_recomRepInsCd, prodCatCd : g_recomProdCatCd}, {isIndicator:false});
	}
	
	function fn_initCallBack(tranId, res){
		if (exceptionCheck()) {
			return;
		}
		if (tranId == "HHCA0310M38S") {
			var slYProdList  = res.data.slYProdList;
			var slNProdList  = res.data.slNProdList;
			
			slYProdList = generateValidJson(slYProdList);
			slNProdList = generateValidJson(slNProdList);
			
			/** 최초 (상품명) 세팅을 위한 조회 **/
			g_insMap = {};
			
			$.each(slYProdList, function(i, obj){
				if(!g_insMap['Y']){
					g_insMap['Y'] = {};
				}
				
				if(!g_insMap['Y'][obj.prodCatCd]){						
					g_insMap['Y'][obj.prodCatCd] = {};
				}
				
				if(!g_insMap['Y'][obj.prodCatCd][obj.prodNm]){						
					g_insMap['Y'][obj.prodCatCd][obj.prodNm] = [];
				}
			
				g_insMap['Y'][obj.prodCatCd][obj.prodNm].push(obj);
			});
			
			$.each(slNProdList, function(i, obj){
				if(!g_insMap['N']){
					g_insMap['N'] = {};
				}
				
				if(!g_insMap['N'][obj.prodCatCd]){						
					g_insMap['N'][obj.prodCatCd] = {};
				}
				
				if(!g_insMap['N'][obj.prodCatCd][obj.prodNm]){						
					g_insMap['N'][obj.prodCatCd][obj.prodNm] = [];
				}
				
				g_insMap['N'][obj.prodCatCd][obj.prodNm].push(obj);
			});
			
			INIT_FLAG = false;
			hideLoading();
			drawProdNmList();
		}
		
	}
	

	
	/**
	 *	@alias 판매상품의 보험종류에 맞는 상품 HTML 생성
	 *  @param cat : 상품 카테고리
	 */
	function makeProdListHtml(cat,prodNm,prodTy,slYn) {
		var appendHTML = "";
		var upperCat = cat.substr(0,2);
		if(g_insMap[slYn][cat]) {
			$.each(g_insMap[slYn][cat], function(key, prodArr) {	
				
				// key : 상품명
				$.each(prodArr, function(i, obj) {
					if(obj.prodNm == prodNm) {
						
						if(cat == "0200") {
							if(obj.prodTy != prodTy) {
								return true;	// continue
							}
						}
						
						var makedHTML = "";
						var popupTag1 = "";
						var popupTag2 = "";
						var popupTag3 = "";
						var popupTag4 = "";
						var popupTag5 = "";
						
						var slStDt = obj.slStDt ? setFormatDate(trim(obj.slStDt), ".") : obj.slStDt;	// 시작일
						var slEdDt = obj.slEdDt ? setFormatDate(trim(obj.slEdDt), ".") : obj.slEdDt;	// 종료일
						// var opnDt = obj.opnDt ? setFormatDate(trim(obj.opnDt), ".") : obj.opnDt;	// 개시일
						
						/* if(upperCat == "02" && g_subCat != "") { // 자동차 하위 분류일 경우
							if(obj.prodTy == g_subCat) {
								subCatFlag = true;
							} else {
								subCatFlag = false;
							}
						} else {
							subCatFlag = true;
						} */
						
						makedHTML += "<tr>";
						// 상품명
						makedHTML += "<td class='l'>" + obj.prodNm + "</td>";
						
						// 판매개시일, 판매중지일
						/*
						if(upperCat == "02"){
							if(obj.prodTy == prodTy) {
								if(isNull(slEdDt)) {
									makedHTML += "<td>" + nvl(slStDt,"") + "</td>";
									makedHTML += "<td> 현재</td>";
								} else {
									makedHTML += "<td>" +  nvl(slStDt,"")  + "</td>";	//자동차보험 상품개시일(변경일) 추가
									makedHTML += "<td>" + nvl(slEdDt,"") + "</td>";		//자동차보험 상품개시일(변경일) 추가
								}
							} else {
								makedHTML += "<td>" +  nvl(slStDt,"")  + "</td>";	//자동차보험 상품개시일(변경일) 추가
								makedHTML += "<td>" + nvl(slEdDt,"") + "</td>";		//자동차보험 상품개시일(변경일) 추가
							}
						} else {
							makedHTML += "<td>" + nvl(slStDt,"") + "</td>";	
							makedHTML += "<td>" + nvl(slEdDt,"") + "</td>";				//장기상품일경우도 판매중지일자 조회되도록 수정
						}
						*/
						makedHTML += "<td>" + nvl(slStDt,"") + "</td>";	
						makedHTML += "<td>" + nvl(slEdDt,"") + "</td>";	
						
						//금리연동
						if(upperCat == "03") {
							var intRtPlctYn = obj.intRtPlctYn == "Y" ? "O" : "X";
							makedHTML += "<td>" + intRtPlctYn + "</td>";
						}else{
							makedHTML += "<td> X </td>";
						}
	
						popupTag1 = !isNull(obj.clauApnflId ) ? "id='clauApn' class='file pdf' title='약관 새창 띄움' onclick=\"linkPdf('" + obj.clauApnflId + "')\"" : "class='disabled'";
						popupTag2 = !isNull(obj.userMthdApnflId ) ? "id='userMthd' class='file pdf' title='PDF뷰어 새창 띄움' onclick=\"openPdf('" + obj.userMthdApnflId + "')\"" : "class='disabled'";
						popupTag3 = !isNull(obj.prodSmryApnflId ) ? "id='prodSmry' class='file pdf' title='PDF뷰어 새창 띄움' onclick=\"openPdf('" + obj.prodSmryApnflId + "')\"" : "class='disabled'";
						popupTag4 = !isNull(obj.prodNoteApnflId ) ? "id='prodNote' class='file pdf' title='PDF뷰어 새창 띄움' onclick=\"openPdf('" + obj.prodNoteApnflId + "')\"" : "class='disabled'";
						makedHTML += "<td><a href=\"javascript:void(0)\" " + popupTag1 + "></a></td>";	// 약관
						makedHTML += "<td><a href=\"javascript:void(0)\" " + popupTag2 + "></a></td>";	// 사업방법서
						makedHTML += "<td><a href=\"javascript:void(0)\" " + popupTag3 + "></a></td>";	// 상품요약서
						makedHTML += "<td><a href=\"javascript:void(0)\" " + popupTag4 + "></a></td>";	// 상품설명서
						
						if(obj.repInsYn == "Y") {
							makedHTML += "<td><button type='button' id='btnRecoProd' onclick=\"fn_recomProd('" + prodNm+ "', '" + obj.prodCatCd + "', '" + obj.repInsCd  + "')\" class='btn line' title='연관상품 열림'>연관상품</button></td>";
						} else {
							makedHTML += "<td></td>";
						}
	
						makedHTML += "</tr>";
	
						obj.html = makedHTML;
						appendHTML += makedHTML;
					}
				});
			});
		}
		return appendHTML;
	}
	
	/**
	 * @alias download기능 실행
	 * @param tranId : doRequest에서 호출한 tranId
	 */
	function openPdf(uuid) {  
		if(!uuid || uuid == "") {
			return false;
		}
		g_fileClickGb = "view";
		doRequest("HHCA0310M26S", {apnflId:uuid }, {isIndicator:false});
		

	}
	
	/**
	 * @alias PDF LINK 기능 실행
	 * @param tranId : doRequest에서 호출한 tranId
	 */
	function linkPdf(uuid) {  
		if(!uuid || uuid == "") {
			return false;
		}
		//model.setValue("/root/request/apnflIds/apnflIds_row[1]", uuid);
		//doRequestBy("/HH.xhi", "HHCO4503M01S", {responseFunction: pdfLinkResponse});
		g_fileClickGb = "down";
		doRequest("HHCA0310M26S", {apnflId:uuid }, {isIndicator:false});

	}
</script>
</head>
<body>
    <div id="skipNavi"> 
		<a href="#content">본문내용 바로가기</a> 
	</div>
    <div id="wrap" class="exclude">  <!-- PC 전용 class -->
