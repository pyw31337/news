		<script type="text/javascript">
		$(window).on('load',function() {
			
			// /IDB/webapp/p1scwb1/webponent-press/press2.0/webponent.press.js
			// 2291 line. setTimeout 1000 로, 이보다 늦어야 함.
			
			setTimeout(function () {
				if ($('.biz_attachfile_download').length > 0) {
					
					$('.biz_attachfile_download').each(function (i) {
						
						var $bizFileDownObj = $(this).find('a');
						var clkEvt = $bizFileDownObj.attr('onclick');
						if ($.trim(clkEvt) != '' && clkEvt.toLowerCase().includes('.pdf')) {
							$bizFileDownObj.attr('title', '새창열림');
						} else if ($.trim(clkEvt) != '' && clkEvt.toLowerCase().includes('.exe')) {
							$bizFileDownObj.attr('title', '실행파일 다운로드');
						}
					});
				}
			}, 1500);
		});
		</script>
	
