    <div class="nr_search_form spr1">
        <fieldset>
            <legend>게시물 검색 양식</legend>
            <div class="search_item">
                <select id="searchType" class="wd180" name="" title="검색 조건 선택">
                    <option value="제목" selected="">제목</option>
                    <option value="날짜">날짜</option>
                </select>
            </div>
            <div class="search_item search">
                <div class="search_form">
                    <input id="searchText" class="i_txt" type="text" name="" placeholder="검색어를 입력해주세요." title="검색어 입력">
                    <button type="button" class="btn_delete"><span class="offscreen">삭제</span></button>
                    <button class="btn_search"><span class="offscreen">검색</span></button>
                </div>
            </div>
        </fieldset>
    </div>
                    

</form>


<script>
    	(function($){
    		var page = 0;
			var rows = 9999;
			var totalCount = 28;
			var rowCount = 10;
			var totalPage = Math.ceil(totalCount / rowCount);
			var ct = 'null';
			var re_ct = 0;
			
			$(".tbp > table > tbody > tr").hide();

			if(ct == "null"){
				ct = 1;
				for(var re_ct=0 ; re_ct < ct/10 ; re_ct++){
					page++;
					for(i=rowCount*(page-1) ; i<rowCount*page ; i++){
						$(".tbp > table > tbody > tr").eq(i).show();
					}
				}
			}else{
				for(var re_ct=0 ; re_ct < ct/10 ; re_ct++){
					page++;
					for(i=rowCount*(page-1) ; i<rowCount*page ; i++){
						$(".tbp > table > tbody > tr").eq(i).show();
					}
				}
				$(".tbp > table > tbody > tr a").eq(ct-1).focus();
			}

			if(totalPage > page){
				var div_btn_more = '<div class="btn_more">'+
											'<a href="#none"><span>더보기<span class="num">(' + page + '/' + totalPage + ')</span></span></a>'+
										'</div>';
				$(".tbp").append($(div_btn_more));
			}
			
    		
    		$(document).on("click", ".btn_more", function(){
    			page++;
    			$(".btn_more").remove();
    			for(i=rowCount*(page-1) ; i<rowCount*page ; i++){
    				$(".tbp > table > tbody > tr").eq(i).show();
    			}
    			setTimeout(function(){
    				$(".tbp > table > tbody > tr a").eq((page-1)*rowCount).focus();
    			}, 100);
				if(totalPage > page){
					div_btn_more = '<div class="btn_more">'+
											 '<a href="#none"><span>더보기<span class="num">(' + page + '/' + totalPage + ')</span></span></a>'+
										'</div>';
					$(".tbp").append($(div_btn_more));
				}
    		});
    		
    		$(document).on("click", ".btn_search", function(e){
				e.preventDefault();
				var f = document.getElementById('listForm');
	            var $f = $(f);
	            var tp = $("#searchType").val()=='제목'?"T":"D";
	            var searchTxt = $("#searchText").val();
	            if("D" == tp ){
	            	var dayReg = /^(19|20)\d{2}(\.|)(0[1-9]|1[012])(\.|)(0[1-9]|[12][0-9]|3[0-1])$/;
	            	if(!dayReg.test(searchTxt)){
	            		alert("날짜는 yyyy.mm.dd 형식으로 검색해 주시기 바랍니다.");
	            		return;
	            	}
	            	dayReg = /^(19|20)\d{2}(0[1-9]|1[012])(0[1-9]|[12][0-9]|3[0-1])$/;
		            if(dayReg.test(searchTxt)){
		            	searchTxt = searchTxt.substring(0,4) + "." + searchTxt.substring(4,6) + "." + searchTxt.substring(6,8);
		            }
	            }
	            $f.find('[name="tp"]').val(tp);
                $f.find('[name="tx"]').val(searchTxt);
                $f.attr('action','/pc/bizxpress/contentTemplet/pb/mp/fg/list.jsp');
                $f.submit();
			});
			if(''){
				$("#searchText").val('');
				if("D" == ""){
					$("#searchType").val("날짜");
				}
				$(document.getElementById('listForm')).find('[name="tx"]').val('');
				setTimeout(function(){$("#searchText").trigger('keypress');},100);
			}
     		var enterKey = function(){
     			if(window.event.keyCode == 13){
     				$(".btn_search").trigger("click");
     			}
     		}
     		$.fn.enterKey = enterKey;
    	})(jQuery);
    </script>

