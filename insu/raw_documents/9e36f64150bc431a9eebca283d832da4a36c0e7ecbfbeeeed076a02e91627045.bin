<script>

$(function() {
	
	$('a[name=btnDiv]').on('click', function() {
		
		var _this = $(this);
		var type = _this.data('type');
		
		$('.privateBtn').removeClass('on');
		$('.priceDiv').hide();
		switch(type) {
			case '01':
				$('a[name=btnDiv][data-type=01]').addClass('on');
				$('#hTitle').text('자동차');
				$('#div01').show();
				break;
			case '02':
				$('a[name=btnDiv][data-type=02]').addClass('on');
				$('#hTitle').text('장기보험');
				$('#div02').show();
				break;
			case '03':
				$('a[name=btnDiv][data-type=03]').addClass('on');
				$('#hTitle').text('일반보험(소멸성)');
				$('#div03').show();
				break;
		}
	});
	
	$('a[name=btnCal]').on('click', function() {
		
		var $this = $(this);
		
		var targetUrl = $this.data('url');
		var targetNm = targetUrl;
		
		var prdKey = $this.data('prd-key');
		var calcType = $this.data('calc-type'); //간편심사형, 일반심사형일때 구분 
		
		if (! _.isUndefined(prdKey)) {
			
			if (targetUrl.indexOf("?") < 0) {
				targetUrl = targetUrl + '?prdKey='+prdKey;
			} else {
				targetUrl = targetUrl + '&prdKey='+prdKey;
			}			
		}
		if (! _.isUndefined(calcType)) {
			targetUrl = targetUrl + '&calcType='+calcType;
		}
		
		var type = $("a[name=btnDiv].on").data("type");
		
		if(_.isEqual("02", type)){
			
			api.call({
				url : '/w/common/getLongTermPrdMciProgress.json',
				data : {sPrdKeyID : prdKey},
				loading: false,
				success : function(data) {
					openWindowPop(targetUrl, targetNm, prdKey);
				}, failure : function(data){
					msg.warn(data.header.message);
				}
			});
		}else{
			openWindowPop(targetUrl, targetNm, prdKey);
		}
		
		
	});
	
	var openWindowPop = function(targetUrl, targetNm, prdKey) {
		var hSize = 700;
		var type = $("a[name=btnDiv].on").data("type");

		// 자동차 탭
		if(_.isEqual("01", type)){
			if(!_.isUndefined(prdKey)){
				var pdGpCd = String(prdKey).substr(0,2);

				// 개인용, 업무용, 영업용
				if(pdGpCd.match('71|72|73') != null){
					hSize = 850;
				}
			}			
		}

		pop.openWindowPopup(targetNm, cmm.url('/w/disclosure/price/'+targetUrl), { width: 1100, height: hSize });
	};
	
	var doInit = function() {
		console.log("@@@@@@@@ doIt @@@");
		api.call({
			url : '/w/disclosure/price/getLongTermList.json',
			success : function(data) {
				
				console.log("getLongTermList.json success");
				_.each(data.body, function(b){
					// 장기요청으로 레이디 플러스, 하나 가득담은 암보험, 하나 가득담은 암보험 다이렉트 , 하나 Grade 건강보험  하드코딩함
					if (! _.contains(['60644','60607', '60655','60652', '60697', '60703'], b.untpdcd)) { 
						$('a[name=btnCal][data-prd-key='+b.untpdcd+']').parent().parent().find('td > span').text(b.sPrdNm);
					}					
				});
			}
		});
		
		$('a[name=btnDiv][data-type=01]').trigger('click');
	};
	
	doInit();
	
	//2023-12-31 임시 Alert
	$('.alretNoService').on('click', function() {
		msg.warn('서비스 개선작업중입니다.\n 나중에 이용해주세요.');
	}); 
	
	
});

</script>

	
	
			
	<div class="popup_box dimmed" id="popTerms">
	<div class="popup_container w600">
		<div class="popup_header">
			<h1 class="popTermsTitle"></h1>
