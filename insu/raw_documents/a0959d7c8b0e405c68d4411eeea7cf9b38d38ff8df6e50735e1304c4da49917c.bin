/*
 * 수시경영공시 검색
 * @param
 * @since
 */
function fnSearchAnnounce() {
    jQuery("#devonTargetRow").val("");
    fnAntiReflectedXSS();
    jQuery('#oAnytimeManagementAnnounceSearchForm').attr('action', '/announce/managementAnnounce/retrieveAnytimeManagementAnnounce.nhfire;jsessionid=aN6mn4Mok9Ik5zh7BpNMUnjWBtlIH1ywF70X1kXzmVjHbY20TO96pj8birmz2qj1.nphpws01_servlet_NHpCm01').submit();
}

/**
 * 첨부파일 다운로드
 * @param
 * @since
 */
function fnFileDownload(fileId, afileSeqn) {
    jQuery('#oDownloadFileId').val(fileId);
    jQuery("#oDownloadAfileSeqn").val(afileSeqn);
    jQuery("#oDownloadForm").attr("action", "/imageView/downloadFile.ajax;jsessionid=aN6mn4Mok9Ik5zh7BpNMUnjWBtlIH1ywF70X1kXzmVjHbY20TO96pj8birmz2qj1.nphpws01_servlet_NHpCm01").attr("target", "_self").submit();
}

/**
 * XSS 방지
 * @since 2014-01-27
 */
function fnAntiReflectedXSS() {
    var orgContent = jQuery('#oTempSearchWord').val();
    var newContent = '';
    newContent = orgContent.replace(/</gi, "&lt;");
    newContent = newContent.replace(/>/gi, "&gt;");
    jQuery('#oSearchWord').val(newContent);
}

