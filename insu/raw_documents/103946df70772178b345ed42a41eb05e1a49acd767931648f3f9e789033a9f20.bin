<script type="text/javascript" language="javascript">


jQuery(document).ready( function() {
    
    var flag = "";
    if ("search"==flag) {   
        $("#search_notice").val();
        $("#search_dcd").val(6);
    }  
});

function goSeachList() {
	fnAntiReflectedXSS();
    $("#flag").val("search");
    $("#search_subject").val($("#search_notice").val());
    jQuery("#oboardForm").attr("action", "/company/bbs/socialServiceList.nhfire;jsessionid=1rFGhy3H3EclrM1oA9Yt3rb24ahfxd4UFVbL3ykxldnn7mCBTBGHHqDM2VkOPgnC.nphpws02_servlet_NHpCm01").submit();
}

//상세 화면으로 이동
function fnMoveDtail(value) {
    
    jQuery("#searchNum").val(value);
    jQuery("#oboardForm").attr("action", "/company/bbs/boardDetail.nhfire;jsessionid=1rFGhy3H3EclrM1oA9Yt3rb24ahfxd4UFVbL3ykxldnn7mCBTBGHHqDM2VkOPgnC.nphpws02_servlet_NHpCm01").submit();
}


//엔터클릭시 조회
function handleKeydown(n){
  if (event.keyCode==13) {
      goSeachList();
  }
}
/**
 * XSS 방지
 * @since 2014-01-27
 */
function fnAntiReflectedXSS() {
    var orgContent = jQuery('#search_value').val();
    var newContent = '';
    newContent = orgContent.replace(/</gi, "&lt;");
    newContent = newContent.replace(/>/gi, "&gt;");
    jQuery('#search_value').val(newContent);
}

</script>

