// <![CDATA[
  function goPage(row) {
    var pageForm = document.getElementById("devonTargetRow").form;
    pageForm.devonTargetRow.value = row;
    pageForm.submit();
  }
  function goOrderByPage(row, orderBy) {
    var pageForm = document.getElementById("devonTargetRow").form;
    pageForm.devonTargetRow.value = row;
    pageForm.devonOrderBy.value = orderBy;
    pageForm.submit();
  }
  function changePage(sel) {
    var pageForm = sel.form;
    pageForm.devonTargetRow.value = sel.value;
    pageForm.submit();
  }
// ]]>
</script>
