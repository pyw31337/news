    aJax.addQuery('BRDT', $("#passBirth").val());
    aJax.addQuery('AUTH_REQ_NOTI_TITL', "농협손해보험 로그인" );
    aJax.addQuery('callbackFunctionName', "passPrivLoginBtnResult");
    aJax.addQuery('loginYn', 'Y');
    aJax.fire();
    return false;

}




