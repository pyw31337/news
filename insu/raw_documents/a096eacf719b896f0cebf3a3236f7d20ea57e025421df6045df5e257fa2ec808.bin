};

// 인증수단 변경시 기존 입력값 초기화
function authTypeReset(){
    authHpInit();//금융거래회원 sms 로그인
    if(document.getElementById('emonitoring')){authHpInit1();}//완전판매모니터링 sms 인증
    $("input:radio, input:checkbox").attr("checked", false);
    $("input:text, input:password").val("");
    $(".resetBtn").addClass("gray");
    $("#smsCom, #kkoSmsCom, #passCom, #tossCom, #telecom, #smsCom1").val(""); 
    //  #smsCom : 금융거래회원 sms통신사, #kkoSmsCom 제휴회원 sms통신사, #passCom 금융거래회원 패스통신사, #telecom 피보험자 패스통신사, #smsCom1 완전판매 sms통신사
    
}

// 로그인 정상처리후 페이지 이동 처리
function returnTran(){

    var returnUrl = "";
    var sTitle = "";
    
    if(document.getElementById('cmLoginNew')){ // 다이렉트 홈페이지
        cusHstLoginEvt("direct");

        returnUrl = ($("#returnUrl").val()=="") ? "/direct/index.nhfire" : $("#returnUrl").val();
    }else if(document.getElementById('emonitoring')){   //완전판매 모니터링
        cusHstLoginEvt("emonitoring");

        returnUrl = "/mypage/membership/eMonitoringList.nhfire";
    }else if(sTitle == "보험금청구"){    //보험금청구 로그인
        cusHstLoginEvt("agreeAcd");

        returnUrl = "/cyber/acd/agreeAcdForm.nhfire";
    
    }else if(sTitle == "보상처리현황조회"){ //보상처리현황조회 로그인 
        cusHstLoginEvt("acdlist");

        returnUrl = "/cyber/acd/retrieveAcdList.nhfire";
    
    }else {
        cusHstLoginEvt("home");

        returnUrl = ($("#returnUrl").val()=="") ? "/index.nhfire" : $("#returnUrl").val();
    }
    
    return returnUrl;
}

/* 고객여정 Amplitude 함수 */
function cusHstLoginEvt(evtType) {
    if (evtType == "home") {
        ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메인", "로그인", "개인고객");
        if (position == "22") {
            ampNacf.setEvtNm("home_login_company");
            ampNacf.setPathSub("기업고객");
            position = "2";
        } else {
            ampNacf.setEvtNm("home_login_person");
        }
    } else if (evtType == "direct") {
        ampNacf.setDevicePath("pc_web(direct)", "다이렉트_메인", "로그인", "개인고객");
        if (position == "22") {
            ampNacf.setEvtNm("direct_login_company");
            ampNacf.setPathSub("기업고객");
            position = "2";
        } else {
            ampNacf.setEvtNm("direct_login_person");
        }
    } else if (evtType == "emonitoring") {
        ampNacf.setDevicePath("pc_web(homepage)", "완전판매 모니터링", "로그인", "개인고객");
        if (position == "22") {
            ampNacf.setEvtNm("emonitoring_login_company");
            ampNacf.setPathSub("기업고객");
            position = "2";
        } else {
            ampNacf.setEvtNm("emonitoring_login_person");
        }
    } else if (evtType == "agreeAcd") {
        ampNacf.setDevicePath("pc_web(homepage)", "보험금청구", "로그인", "개인고객");
        if (position == "22") {
            ampNacf.setEvtNm("requestacd_login_company");
            ampNacf.setPathSub("기업고객");
            position = "2";
        } else {
            ampNacf.setEvtNm("requestacd_login_person");
        }
    } else if (evtType == "acdlist") {
        ampNacf.setDevicePath("pc_web(homepage)", "보상처리현황조회", "로그인", "개인고객");
        if (position == "22") {
            ampNacf.setEvtNm("viewacd_login_company");
            ampNacf.setPathSub("기업고객");
            position = "2";
        } else {
            ampNacf.setEvtNm("viewacd_login_person");
        }
    }
    ampNacf.setBizNmCd("로그인", "");
    ampNacf.setAuthCode(position);

    var ampEventInfo = {
        "method" : _authCode,
    };
    if (_pathSubCategory == "개인고객") {
        ampEventInfo.age = _userAge;
        ampEventInfo.gender = _gender;
    }
    ampNacf.addLogBasic(ampEventInfo);
}

/* 휴대폰인증 Start*/

/* sms 인증 시작(s) */
function fnPhoneAgree(num) {
    var smsComCd = "";
    if($("#divKkoPopupArea").hasClass("on")){
        smsComCd ="#kkoSmsCom"; 
    }else{
        smsComCd = "#smsCom";
    }
    // num : 1- 개인정보 이용및 제공동의 2-통신사별 이용약관동의 3-본인확인 서비스 대행사별 이용약관동의  4- 고유식별정보처리동의 
    if(num == "1"){ 
        var popOpen = window.open("/external/html/agreePop/privateAgre.html","agreePop1","width=550,height=500,menubar=false");
        popOpen.focus();
    }else if(num == "2"){
        if ( jQuery(smsComCd).val() == ""  ) {
            alert("통신사를 선택하세요");
            jQuery(smsComCd).focus();
            return;
        }   
        if(jQuery(smsComCd).val() == "01" || jQuery(smsComCd).val() == "04"){
            //sk
            var popOpen = window.open("/external/html/agreePop/skTeleUserAgre.html","agreePop2","width=550,height=500,menubar=false");
            popOpen.focus();
        }else if(jQuery(smsComCd).val() == "02" || jQuery(smsComCd).val() == "05"){
            //kt
            var popOpen = window.open("/external/html/agreePop/ktTeleUserAgre.html","agreePop2","width=550,height=500,menubar=false");
            popOpen.focus();
        }else if(jQuery(smsComCd).val() == "03" || jQuery(smsComCd).val() == "06"){
            //lgU+
            var popOpen = window.open("/external/html/agreePop/lgTeleUserAgre.html","agreePop2","width=550,height=500,menubar=false");
            popOpen.focus();
        }
    }else if(num == "3"){
        
        var popOpen = window.open("/external/html/agreePop/ownerServiceAgre.html","agreePop3","width=550,height=500,menubar=false");
        popOpen.focus();
        
    }else if(num == "4"){
        var popOpen = window.open("/external/html/agreePop/identityInfoAgre.html","agreePop4","width=550,height=500,menubar=false");
        popOpen.focus();
    }
    else if(num == "5"){
        var popOpen = window.open("/external/html/agreePop/saveAuthStep2_1.html","agreePop5","width=550,height=500,menubar=false");
        popOpen.focus();
    }
    else if(num == "6"){
        var popOpen = window.open("/external/html/agreePop/saveAuthStep2_2.html","agreePop6","width=550,height=500,menubar=false");
        popOpen.focus();
    }

}

function hpAuthValidationChk(check) {
    
    if($("#cusNm").val() == ""){
        if(!check){         
            alert("성명을 입력하세요");
            $("#cusNm").focus();
        }
        return false;
    }

    if($("#fRlno").val() == "" || $("#fRlno").val().length < 6){
        if(!check){         
            alert("주민번호 앞자리를 입력하세요.");
            $("#fRlno").focus();
        }
        return false;
        
    }
    
    if($("#bRlno").val() == "" || $("#bRlno").val().length < 7){
        if(!check){         
            alert("주민번호 뒷자리를 입력하세요.");
            $("#bRlno").focus();
        }
        return false;
    }
    
    if ( $("#smsCom").val() == "" ) {
        if(!check){
            alert("통신사를 선택하세요");
            $("#smsCom").focus();
        }
        return false;
    }
    
    if ( $("#mpnoNo1").val() == "" ) {
        if(!check){
            alert("휴대전화 국번을 선택하세요");
            $("#mpnoNo1").focus();
        }
        return false; 
    }
    
    if ( $("#mpnoNo2").val() == "" || $("#mpnoNo2").val().length < 3 ) {
        if(!check){
            alert("휴대전화 가운데 자리를 입력하세요");
            $("#mpnoNo2").focus();
        }
        return false;
    }
    
    if ( $("#mpnoNo3").val() == "" || $("#mpnoNo3").val().length < 4 ) {
        if(!check){
            alert("휴대전화 끝자리를 입력하세요");
            $("#mpnoNo3").focus();
        }
        return false;
    }
    
    if ( !$("#chkAgree1").is(":checked") ) {
        if(!check){
            alert("개인정보이용 및 제공동의에 동의 하셔야 합니다.");
            $("#chkAgree1").focus();
        }
        return false;
    }
    
    return true;
}

