    }
}


//공인인증 로그인 CHECK 결과
function fnSetCheckResult2(json, instant, node, xmlDoc){
  var result = jQuery(xmlDoc);
  var checkResult = result.find("LoginResult").text();
  
  //E 모니터 상품 셋팅
  var ECntYn = result.find("ECntYn").text();
  $("#ECntYn").val(ECntYn);
  
  (checkResult != "1" || checkResult == "") ? hideLoading() : showLoading();
  
  if(checkResult != "" && checkResult != null){
      
      loginCheck ="Y";
      if(checkResult == "1"){//홈페이지 가입 통합회원
        
        var sexType = result.find("sexType").text();
        var ageGroupCd = result.find("ageGroupCd").text();
        //_trk_flashEnvView("'_TRK_SX="+sexType+"','_TRK_AG="+ageGroupCd+"','_TRK_ISLOGIN=Y','_TRK_MBR=Y','_TRK_PI=LIR'");
        _trk_flashEnvView("_TRK_SX="+sexType,"_TRK_AG="+ageGroupCd,"_TRK_ISLOGIN=Y","_TRK_MBR=Y","_TRK_PI=LIR");
        
        $("#f").attr("action", returnTran()).submit();
      }else if(checkResult == "2"){//홈페이지 미가입 통합회원(홈페이지 회원가입 페이지로 이동)
          alert("홈페이지 회원가입을 하시기 바랍니다.");
          jQuery("#f").attr("action", "/mypage/membership/hpMembershipStep1.nhfire;jsessionid=feA6CUll5CkBZtFyBY5ah4H9lbk49pp5Fqsp034wsHH3g4KNTl6FTxTtf3193p3V.nphpws01_servlet_NHpCm01").submit();
      }else if(checkResult == "3"){
          //통합 웹 회원이 아닌경우(회원가입메인 페이지로 이동)
 
          alert("등록된 공동인증서가 없습니다. \n공동인증서를 등록 하신 후 사용해주시기 바랍니다.");
          //jQuery("#f").attr("action", "/saveAuth.nhfire;jsessionid=feA6CUll5CkBZtFyBY5ah4H9lbk49pp5Fqsp034wsHH3g4KNTl6FTxTtf3193p3V.nphpws01_servlet_NHpCm01").submit();
      }else if(checkResult == "4"){
          //공동인증서 오류
          alert("공동인증서 오류입니다.\n다시 로그인해 주시기 바랍니다.");
      }else if(checkResult == "12"){
          //공동인증서 오류
          alert("공동인증서 기간이 만료되었습니다. \n공동인증서를 발급받은 기관에서 갱신 후 이용해 주세요.");
      }else if(checkResult == "13"){
          //공동인증서 오류
          alert("폐기된 공동인증서 입니다. \n공동인증서를 발급받은 기관에서 새로 발급 받은 후 이용해 주세요.");
      }else if(checkResult == "14"){
          //공동인증서 오류
          alert("사용할수 없는 공동인증서입니다. \n정상적인 공동인증서를 선택 후 이용해 주세요.");
      }else if( checkResult=="DEATH_E"){
          alert("신용정보원에서 말소자로 확인된 주민번호입니다.\n금융사고예방을 위한 조치로 양해부탁드립니다.\n자세한 문의사항은 대표번호 1644-9000로 연락주세요.");   
      }else{
          return false;
          
      }
      
  } 
}



//통합회원
function handleKeydown2(n){
    if (event.keyCode==13) {
        OcspLogin2();
    }
}

//공동인증서 로그인(기업)
function OcspLogin2()
{

  var num1 = $("#oSaupjaNO1").val();
  var num2 = $("#oSaupjaNO2").val();
  var num3 = $("#oSaupjaNO3").val();
  var saupja = num1+num2+num3 ;
  
  if(check_busino(saupja)){//사업자번호 체크
      var logon2 = document.logon2;
      var sendForm = document.sendForm;
      CheckSendForm3(logon2, sendForm);
  }else{
      return false;  
  }
    position = "22";    //공동인증서-기업
}

//공인인증 로그인(기업고객)
function CheckSendForm3(readForm, sendForm)
{
    InitCache();
  
    EncFormVerify2(readForm, sendForm,"CheckEncFormCallback");
return false; //반드시 false를 return;
}


//공인인증 로그인(기업고객) callback
function CheckEncFormCallback(result)
{
    if(result){
        if(loginCheck =="Y"){
         loginCheck ="N";
            var aJax = new devon.xSync("/login/check/authLoginCheck3.ajax;jsessionid=feA6CUll5CkBZtFyBY5ah4H9lbk49pp5Fqsp034wsHH3g4KNTl6FTxTtf3193p3V.nphpws01_servlet_NHpCm01"); // fnSetCheckResult2
            aJax.addQuery("type", "ajax");
            aJax.addQuery("INIpluginData", $("#INIpluginData").val());
            aJax.addQuery("serializeFormData", escape(encodeURIComponent(jQuery("#oLogon2").serialize()))); 
            aJax.addQuery('loginYn', 'Y');
            aJax.fire();
           return false;
         }
    } else {
        //alert("보안상 문제가 생겨 전송이 취소 되었습니다.");
    }
}



