//공인인증 로그인(개인고객)
function CheckSendForm2(readForm, sendForm)
{
    InitCache();
    
  
    EncFormVerify2(readForm, sendForm,"CheckSendForm2Callback");
  
 
return false; //반드시 false를 return;
}

//공인인증 로그인(개인고객 callback)
function CheckSendForm2Callback(result)
{
    if(result){
        if(loginCheck =="Y"){
         loginCheck ="N";
           var nVal   = $("#nVal").val();
           var aJax = new devon.xSync("/login/check/authLogin.ajax;jsessionid=feA6CUll5CkBZtFyBY5ah4H9lbk49pp5Fqsp034wsHH3g4KNTl6FTxTtf3193p3V.nphpws01_servlet_NHpCm01"); // fnSetCheckResult2
           aJax.addQuery("type", "ajax");
