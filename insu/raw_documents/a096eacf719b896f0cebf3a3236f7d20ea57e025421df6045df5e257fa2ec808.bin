        var ajaxUrl = '/auth/auth/certPCToss.ajax';
        var aJax = new devon.xSync(ajaxUrl);
        var pre = "";
        //tossCusNm
        var name = jQuery("#tossCusNm").val().trim();
        var birthday = $("#tossBirth").val();
        var pre =  $("#tossRRNO_N7").val();
        if( "1" ==(pre) || "2"==(pre) || "5"==(pre) || "6"==(pre)) {
            pre = "19";
        } else { 
            pre = "20"; 
        };
        

        var hp = $("#numLoginTossHp1").val()+$("#numLoginTossHp2").val()+$("#numLoginTossHp3").val();
        aJax.addQuery('loginYn', 'Y');
        aJax.addQuery('txCode', 'SU001_LGIN');
        aJax.addQuery('kindCode', '0200');
        aJax.addQuery('identifier', 'com.nonghyup.nhfire');
        aJax.addQuery('triggerType', 'PUSH');
        aJax.addQuery('requestType', 'USER_PERSONAL');
        aJax.addQuery('expireSeconds', '3600');
        aJax.addQuery('phone_no', hp);
        
        aJax.addQuery('name', name);
        aJax.addQuery('phone_no', hp);
        aJax.addQuery('birthday', pre+""+birthday);
        aJax.addQuery("serviceName", "농협손해보험 로그인");
        //aJax.addQuery("doc", "");
        aJax.addQuery('callbackFunctionName', 'tossLoginBtnResult');

        aJax.fire();

    }

    function tossLoginBtnResult(json, instant, node, xmlDoc){
        var result = jQuery(xmlDoc);
        var txId = result.find("txId").text();
        console.log("JSON.result :" + JSON.stringify(result));
        
        if( txId != null){
            // 토스 팝업창 열기
            $("#popToss").show();
        }
        // 로딩화면 숨기기
        hideLoading();
    }
    
    
    function tossLogin(){
        var ajaxUrl = '/auth/auth/certPCToss.ajax';
        var aJax = new devon.xSync(ajaxUrl);
        
        aJax.addQuery('txCode', 'SU002_LGIN'); 
        aJax.addQuery('callbackFunctionName', 'tossPrivLoginStsResult');
        aJax.addQuery('loginYn', 'Y');
        aJax.fire();
        
        showLoading();
    }
    
    function tossPrivLoginStsResult(json, instant, node, xmlDoc){
        var result = jQuery(xmlDoc);
        var status = result.find("status").text();
        console.log("status :" + status);
        
            if(status == "COMPLETED") {
                tossLoginVerify("SU003_LGIN"); 
                
            } else if(status == "EXPIRED") {
                alert("처리 마감시간이 종료되었습니다.");
                hideLoading();
                
            } else if(status == "REQUESTED") {
                alert("요청중입니다.");
                hideLoading();
                
            } else if(status == "IN_PROGRESS") {
                alert("인증 대기중입니다.");
                hideLoading();
                
            }else{  // 그 외
                alert("알 수 없는 에러입니다.");
                hideLoading();
            }
    }
    
    function tossLoginVerify(txcode) {
        console.log("Toss_Retrieve_authDataVerify: "+txcode);
        
        var ajaxUrl = '/auth/auth/certPCToss.ajax';
        var aJax = new devon.xSync(ajaxUrl);
        
        aJax.addQuery('txCode', txcode);
        aJax.addQuery('callbackFunctionName', 'getTossPrivLoginVerifyResult');
        aJax.addQuery('loginYn', 'Y');
        aJax.fire();
       
    }

    function getTossPrivLoginVerifyResult(json, instant, node, xmlDoc){
        var result = jQuery(xmlDoc);
        //var signedDoc = result.find("signedDoc").text();
        var txId = result.find("txId").text();
        var RZT_CI = result.find("RZT_CI").text();
        var nVal   = $("#nVal").val();
        //onsole.log("signed_data=====================>" + signedDoc);
        console.log("txid=====================>" + txId);
        console.log("RZT_CI=====================>" + RZT_CI);
        //인증후 로그인처리.
        if(txId != undefined) {
            $("#popToss").hide();
            //$("#tossBtnChk").addClass("disabled");
            
            var ajaxUrl = '/login/check/authTossLogin.ajax';  // AuthTossLoginCmd
            var aJax = new devon.xSync(ajaxUrl);
            aJax.addQuery("type", "ajax");
            aJax.addQuery("RZT_CI", RZT_CI);
            aJax.addQuery('loginYn', 'Y');
            aJax.addQuery("nVal" , nVal);
            aJax.addQuery("wdata", $("#wdata").val());
            aJax.addQuery("ndata", $("#ndata").val());
            aJax.fire();
            return false;
        } else {
            hideLoading();
        }
        
    }

