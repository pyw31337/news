<!-- 팝업스크립트 -->
<script type="text/javascript">  
 
//bind() 지원되지 않을 경우 대비  
if(typeof Function.prototype.bind === "undefined"){
    Function.prototype.bind = function(){
        var fn = this, 
            args = arraySlice.call(arguments),
            object = args.shift();
        return function(context){
            var local_args = args.concat(arraySlice.call(arguments));
            if(this !== window){
                local_args.push(this);
            }
            return fn.apply(object, local_args); 
        }
    } 
}
 
var NJTUI = NJTUI || {};
NJTUI.module = (function(){
	// (sta) NJTUI return module
	return {
		modalUi: function(){
			var moBtn = $("[aria-controls]"),
				moClose = $(".popOff_btn"),	
				moId,
				moObj,				
				moTabable,
				moTabableFirst,
				moTabableLast,
				tabDisable,
				nowScrollPos,
				$this;

			var modalOpen = function(moId){
				nowScrollPos = $(window).scrollTop(),
				moObj = $("#" + moId).find(".dirPop_box"),
				moTabable = moObj.find("button, [href], input:not([type='hidden']), select, textarea, iframe, [tabindex]:not([tabindex='-1'])"), //포커스 받을 수 있는 요소 찾기
				moTabableFirst = moTabable && moTabable.first(),
				moTabableLast = moTabable && moTabable.last();
				
				$("#" + moId).addClass("on");
				$("body").css("overflow", "hidden");

				moTabable.length ? moTabableFirst.focus().on("keydown", function(e){
					//레이어 열리자 마자 포커스 받을 수 있는 첫번째 요소로 포커스 이동
					if (e.shiftKey && (e.keyCode || e.which) === 9) {
						//Shift + Tab키 : 포커스 받을 수 있는 첫번쨰 요소에서 마지막 요소로 초점 이동
						e.preventDefault();
						moTabableLast.focus();
					}
				}) : moObj.attr("tabindex", "0").focus().on("keydown", function(e){
					tabDisable = true;
					if ((e.keyCode || e.which) === 9) e.preventDefault();
					//Tab키 / Shift + Tab키 : 포커스 받을 수 있는 요소가 없을 경우 레이어 밖으로 초점 이동 안되게
				});
		
				moTabableLast.on("keydown", function(e){
					if (!e.shiftKey && (e.keyCode || e.which) === 9) {
						//Tab키 : 포커스 받을 수 있는 마지막 요소 첫번쨰 요소로 초점 이동
						e.preventDefault();
						moTabableFirst.focus();
					}
				});				
			}

			var modalClose = function(moId){
				$(window).scrollTop(nowScrollPos); //레이어 닫은 후 화면 이동 방지
				if (tabDisable === true) moObj.attr("tabindex", "-1");
				$("#" + moId).removeClass("on");
				$("body").css("overflow", "visible");
			}

			//모달버튼
			moBtn.on("click", function(e){
				e.preventDefault();
				moId = $(this).attr("aria-controls");
				modalOpen(moId);
				$this = $(this);
				$this.blur();
			});

			moClose.on("click", function(e){
				e.preventDefault();
				if(!moId){
					moId = $(this).closest("dirPop_wrap").attr("id");
					modalClose(moId);
					$("[data-modal=" + moId + "]").focus().removeAttr("data-modal");//레이어 닫은 후 원래 있던 곳으로 포커스 이동
				} else {
					modalClose(moId);
					$this.focus();//레이어 닫은 후 원래 있던 곳으로 포커스 이동
				}
				moId = null;
			});

			//외부 제어용 플러그인 형식
			$.fn.modalUi = function(evt, moId, t){
				
				if(evt === "open"){
					$this = t;
					modalOpen(moId);
					$this.attr("data-modal", moId);
				} else if(evt === "close"){
					$this = t;
					modalClose(moId);
				}
				return this;
			}

		}
	}
	// (end) NJTUI return module
})();

$(function(){
    NJTUI.module.modalUi();
	// 개발 적용 후 삭제 필요
	$('.popOn_btn').on("click", function() {
		$('.dirPop_wrap').addClass('on');
		$('body').css('overflow','hidden');
	});
	$('.popOff_btn').on("click", function() {
		$('.dirPop_wrap').removeClass('on');
		$('body').css('overflow','visible');
	});
});

/* 
1. NJTUI.ui.js 참조 후 
NJTUI.module.modalUi();

2-1. 클릭 aria-controls
<a href="javascript:void(0)" class="btn" aria-controls="팝업레이어 id와 맵핑" name="insuconOpen" data-gubun="SSP" data-chk=""><span>보장내역</span></a>
<a href="javascript:void(0)" class="btn" aria-controls="pop_02" name="refundAmt" data-gubun="SSP" data-chk=""><span>해약환급금</span></a>

2-2. 플러그인
$({선택자}).modalUi("open|close", "{팝업레이어 id와 맵핑}", "{원래 포커스로 보낼 선택자}");
$.fn.modalUi("open", "pop_02", $(this));

※ 닫기는 .popOff_btn 클래스 선택자----이전과 동일 
*/


