<!-- 바이오인증팝업 -->

<script src="/js/qrcode.js"></script>
<script type="text/javascript">

	$(document).ready(function() {
	
		// 인증완료버튼 클릭
		$("#btnBioCertResult").click(function(){
			 
			 var biokey=$("#bioForm input[name=biokey]").val();			// FORM -> hidden(biokey)
			 var authSvcCd=$("#bioForm input[name=authSvcCd]").val();	// FORM -> hidden(authSvcCd)
			 if(authSvcCd=="reg"){
				 
				 $.fn.modalUi("close", "pop_qr01", $(this));
				 // #nProd TODO
				 $('#nProd').find('a:visible').each(function(){ 
						//											$('#pop_qr01 div.head h2')
					 	if($(this).text().replace(/ /gi,'').indexOf($('#pop_qr01 div.head h2').text().replace(/ /gi,'')) >= 0){ 
						 	// 						공백제거
					 		$(this).focus(); 
						} 
				});
				 
			 }else{
				 if(authSvcCd=="familyauth"){
					 // /homepage_prj/web/jsp/front
					 //	/direct/product/onoff/travelFamilyAuth.jsp
					 familyAuth();	
				 }else{
				 	showLoading();	// $("#loadingPopupArea01").show();
				 	
				 	var aJax = new devon.xSync("/bio/fido/retrieveBioResult.ajax;jsessionid=feA6CUll5CkBZtFyBY5ah4H9lbk49pp5Fqsp034wsHH3g4KNTl6FTxTtf3193p3V.nphpws01_servlet_NHpCm01"); ///direct/product/retrieveCmHouseNfireStep6.ajax
					aJax.addQuery("type", "ajax");
					aJax.addQuery("biokey",biokey);
					aJax.addQuery("authSvcCd",authSvcCd); //등록/인증/서명구분
					aJax.fire();

				 }
			 }
		});
 	});
	
	//바이오등록
	function fnCreateBio(){
		$("#pop_qr01_h1").text("생체정보 등록");
		alert("신규등록이 불가능합니다.\n다른 인증수단으로 진행해 주세요");
		return false;
		$("#qrDesc").html("<li>PC 바이오인증을 위해서는 NH농협손해보험 모바일앱에 있는 QR코드 스캐너를 이용하셔야 합니다.</li><li>NH농협손해보험 모바일앱에 있는 QR코드 촬영 버튼(메인 우측 하단 + 버튼)를 실행하고 QR코드를 인식하시면 등록페이지로 자동이동됩니다.</li>");
		getQrInfo("reg","101");
		alert("PC 바이오인증을 위해서는 NH농협손해보험 모바일앱에 있는 QR코드 스캐너를 이용하셔야 합니다.\n NH농협손해보험 모바일앱에 있는 QR코드 촬영 버튼(메인 우측 하단 + 버튼)를 실행하고 QR코드를 인식하시면 등록페이지로 자동이동됩니다.");
	}

	// 간편빌밀번호 등록 
	function fnCreateSimplePwd(){
		$("#pop_qr01_h1").text("간편비밀번호 등록");
		alert("신규등록이 불가능합니다.\n다른 인증수단으로 진행해 주세요");
		return false;

		$("#qrDesc").html("<li>PC 간편비밀번호 인증을 위해서는 NH농협손해보험 모바일앱에 있는 QR코드 스캐너를 이용하셔야 합니다.</li><li>NH농협손해보험 모바일앱에 있는 QR코드 촬영 버튼(메인 우측 하단 + 버튼)를 실행하고 QR코드를 인식하시면 등록페이지로 자동이동됩니다.</li>");
		getQrInfo("reg","116");
		alert("PC 간편비밀번호 등록을 위해서는 NH농협손해보험 모바일앱에 있는 QR코드 스캐너를 이용하셔야 합니다.\n NH농협손해보험 모바일앱에 있는 QR코드 촬영 버튼(메인 우측 하단 + 버튼)를 실행하고 QR코드를 인식하시면 등록페이지로 자동이동됩니다.");
	}
	
	/**
		화면에서 버튼클릭이벤트	
		(100 : 지문 인증)
		(119 : 홍채 인증)
	*/
	function getQrInfo(authSvcCd, authTechCd, signData){
		//authSvcCd : reg,=101(생체),   authTechCd 119(홍체), 
		if((authSvcCd=="reg" &&  authTechCd=="101") || authTechCd=="119"){
			$("#notPin").show();
		} else{
			$("#notPin").hide();
		}
			
		 $("#bioForm input[name=biokey]").val(authSvcCd);
		 $("#bioForm input[name=authSvcCd]").val(authTechCd);
		 $("#loadingPopupArea01").show();
		 if(authSvcCd=="reg"){
			 $("#btnBioCertResult").text("닫기");
		 }else{
			 $("#btnBioCertResult").text("인증완료");
		 }
		 $("#bioForm input[name=authSvcCd]").val(authSvcCd); //등록/인증/서명 구분
			
		 	var aJax = new devon.xSync("/bio/fido/retrieveQrInfo.ajax;jsessionid=feA6CUll5CkBZtFyBY5ah4H9lbk49pp5Fqsp034wsHH3g4KNTl6FTxTtf3193p3V.nphpws01_servlet_NHpCm01"); 
		 	// <--------------------- setQrInfo
		 
			aJax.addQuery("type", "ajax");
			aJax.addQuery("authSvcCd",authSvcCd);
			aJax.addQuery("authTechCd",authTechCd);
			if(signData!=undefined && signData!="undefined"){
				aJax.addQuery("signData",signData);
			}
			aJax.fire();			
			// fnAlertGoHome 		ERR00
			// fnAlertGoLogin		ER001
			// fnAlertCallBack		HPR003
			
			// setQrInfo			call-back

	 }

	/**
		getQrInfo 의 콜백함수
	*/
	 function setQrInfo(json, instant, node, xmlDoc){
		 hideLoading();						// $("#loadingPopupArea01").hide();
		 var result = jQuery(xmlDoc);
		 var biokey = result.find("biokey").text();
		 $("#bioForm input[name=biokey]").val(biokey);

		 $.fn.modalUi("open", "pop_qr01", $(this));
		 
		 makeQR(result.find("qrInfo").text());
	 }
	 
	function fncBioResultRgt(json, instant, node, xmlDoc){
		hideLoading();						// $("#loadingPopupArea01").hide();
		alert("등록에 성공하였습니다. 인증을 수행해 주세요");
		$.fn.modalUi("close", "pop_qr01", $(this));
		
		$('#nProd').find('a:visible').each(function(){ 
			//											$('#pop_qr01 div.head h1')
			if($(this).text().replace(/ /gi,'').indexOf($('#pop_qr01 div.dirPop_head h1').text().replace(/ /gi,'')) >= 0){ 
				$(this).focus(); 
			} 
		});
	}
	
	// 인증완료버튼 클릭 이후 콜백버튼 (인증)
	function fncBioResultAuth(json, instant, node, xmlDoc){
		hideLoading();	//	$("#loadingPopupArea01").hide();
		 
		$.fn.modalUi("close", "pop_qr01", $(this));
		/*
		 nprod.toggleLayer($("#btnBioEye"), $('#pop_qr01'), 'off');
		 nprod.toggleLayer($("#btnPay"), $('#pop_dSign'), 'off');
		*/
		
		
		 	$('#nProd').find('a:visible').each(function(){ 
				//											$('#pop_qr01 div.head h1')
		 		if($(this).text().replace(/ /gi,'').indexOf($('#pop_qr01 div.dirPop_head h1').text().replace(/ /gi,'')) >= 0){ 
				 	$(this).focus(); 
				} 
			});
		 fncBioAuthSuccess(); 	// 화면단에서 구현.
	}
	
	// 인증완료버튼 클릭 이후 콜백버튼 (서명)
	function fncBioResultCert(json, instant, node, xmlDoc){
		
		hideLoading();			// $("#loadingPopupArea01").hide();
		 alert("서명이 완료되었습니다.");
		 nprod.toggleLayer($("#btnBioEye"), $('#pop_qr01'), 'off');
		 nprod.toggleLayer($("#btnPay"), $('#pop_dSign'), 'off');
			$('#nProd').find('a:visible').each(function(){ 
			 	//											$('#pop_qr01 div.head h1')
				if($(this).text().replace(/ /gi,'').indexOf($('#pop_qr01 div.dirPop_head h1').text().replace(/ /gi,'')) >= 0){ 
			 		$(this).focus(); 
			 	} 
			});
		 fncBioCertSuccess(); 	// TODO - 화면단에서 구현 
	 }
	
	
	// QR 코드 이미지 세팅
	function makeQR(value) {

           // console.log('Current version:', version)
           qrcode.qrcode.stringToBytes = qrcode.qrcode.stringToBytesFuncs['UTF-8'];
           var qr = qrcode.qrcode(8, 'L'); // version, errorCorrectionLevel 'L','M','Q','H'
           qr.addData(value);
           try {
             qr.make();
             document.getElementById('imgQr').innerHTML = qr.createImgTag(2,0);
             $('#imgQr img').css("width","160");
             $('#imgQr img').css("height","160");
             // pop_qr01 .head
             $('#imgQr img').prop("alt", $('#pop_qr01 .dirPop_head').text().trim() +' QR코드 이미지 ' + "https://m.nhfire.co.kr/mhwr/web/html/bio/qr.html?token=DC0B394E447961BBC040C03F3CA03910CC55A7BC58FC0D765F026A259B1AA3D5");	
           } catch (err) {
             //console.log('Version is low:', version);
             $('#imgQr img').css("width","160");
             $('#imgQr img').css("height","160");
             // pop_qr01 .head
             $('#imgQr img').prop("alt", $('#pop_qr01 .dirPop_head').text().trim()+' QR코드 이미지 ' + "https://m.nhfire.co.kr/mhwr/web/html/bio/qr.html?token=DC0B394E447961BBC040C03F3CA03910CC55A7BC58FC0D765F026A259B1AA3D5");	

           }
	}
	   
</script>
