function moveFromSearchProduct(jsonObj, actionUrl){
	/**
	var oForm = document.createElement('form');
	var paramStr = '';
	for(key in jsonObj){
		var input = document.createElement('input');
		input.type = 'hidden';
		input.name = key;
		input.value = jsonObj[key];
		oForm.appendChild(input);
	}

	oForm.name = 'recommendProductFormNewVer';
	oForm.method = 'post';
	oForm.action = actionUrl;
	if(navigator.userAgent.toLowerCase().indexOf('msie') != -1 && parseInt(navigator.userAgent.toLowerCase().split('msie')[1]) == 8){
		document.appendChild(oForm);
	}
	oForm.submit();
	**/
	/**
	var oForm = document.getElementById('recommendProductFormNewVer');
	for(key in jsonObj){
		var input = document.createElement('input');
		input.type = 'hidden';
		input.name = key;
		input.value = jsonObj[key];
		oForm.appendChild(input);
	}
	oForm.method = 'post';
	oForm.action = actionUrl;
	oForm.submit();
	**/
	for(key in jsonObj){
		paramStr += (key + '=' + jsonObj[key]);
		paramStr += '&';
	}
	location.href = actionUrl + '?' + paramStr.substring(0, paramStr.length-1);
};

function FrontMoveUrl(url){

	divLoadingPopup();
	location.href = url;
}

function TrainCenter(){
	$("#divCenterStopArea , #balanceCouponPop2").show();
}

// 2025.02.19 메뉴 검색
function fnSrchHPMenu() {

	if($("#srchMenuNm").val() == "") {
		alert("검색하실 메뉴명을 입력하세요.");
		return false;
	}
	
    //var targetForm = $("#oMenuSearchForm");
    //targetForm.attr("action", "/testSrchMenuResult.nhfire").submit();
    fnAntiReflectedHeadXSS();
    var aJax = new devon.xSync("/nhfire/menu/srchHPMenuResult.ajax;jsessionid=feA6CUll5CkBZtFyBY5ah4H9lbk49pp5Fqsp034wsHH3g4KNTl6FTxTtf3193p3V.nphpws01_servlet_NHpCm01");
        aJax.addQuery("menuNm", $("#srchMenuNm").val());
        aJax.fire();
}

/**
 * XSS 방지
 * @since 2014-01-27
 */
function fnAntiReflectedHeadXSS() {
    var orgContent = jQuery('#srchMenuNm').val();
    var newContent = '';
    newContent = orgContent.replace(/</gi, "&lt;");
    newContent = newContent.replace(/>/gi, "&gt;");
    jQuery('#srchMenuNm').val(newContent);
}


// 검색 후 결과 세팅
function fnSetSrchMenuResult() {
	
	try {
    	    
		var xmlDoc = this.request.responseXML.documentElement;
		
		$(".shresultBox li, .shresultText p").remove();
		var rsltHtml = "", rsltTxt = "", cnt = 0;
		
		$(".shresultText, .shresultBox").addClass("hide");
		$(".shresultText").removeClass("hide");
		if($(xmlDoc).find("menuNmPath").size() > 0) {
			rsltTxt += '<p>' + $("#srchMenuNm").val() + '(으)로 <br/>총 <strong class="num">' + $(xmlDoc).find("menuNmPath").size() + '</strong>개의 메뉴가 검색되었습니다.</p>';
			
			$(xmlDoc).find("menuNmPath").each(function(i) { 
				cnt = i + 1;
				
				var srchNm = $("#srchMenuNm").val();
				var menuNmPath = $(xmlDoc).find("menuNmPath").eq(i).text().replace(/<br>/gi, "");
				var strMenuNmPath = "";
				if(menuNmPath.indexOf(srchNm) > -1) {
					strMenuNmPath = menuNmPath.substring(0, menuNmPath.lastIndexOf(srchNm)) + "<strong>" + srchNm + "</strong>" + menuNmPath.substring(menuNmPath.lastIndexOf(srchNm) + srchNm.length);
				} else {
					strMenuNmPath = menuNmPath;
				}
				
				rsltHtml += '<li>';
				rsltHtml += 	'<button type="button" onclick="location.href=\'' + $(xmlDoc).find("mngpMenuUrlNm").eq(i).text() + '\'">';
				rsltHtml += 	'<p>' + (i < 9 ? ("0" + cnt) : cnt) + '</p>';
				rsltHtml += 	'<p>' + strMenuNmPath + '</p>';
				rsltHtml += '</li>';
            });

			$(".shresultBox").append(rsltHtml).removeClass("hide");
		} else {
			rsltTxt += '<p><strong class="word">' + $("#srchMenuNm").val() + '</strong>(으)로<br/>검색된 메뉴가 없습니다.</p>';
		}
		        
		$(".shresultText").append(rsltTxt);
	} catch(e) {
		console.log("fnSetSrchMenuResult ====================== ", e);
	} 
	
}

//엔터 클릭시 조회
function handleKeydown(n){
    if (event.keyCode==13) {
    	fnSrchHPMenu();
    }
}

</script>


