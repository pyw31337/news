 */
function smsAuthResult(json, instance, node, xmlDoc) {
    
    var result = jQuery(xmlDoc);
    var checkResult = result.find("LoginResult").text();
    
    var ECntYn = result.find("ECntYn").text();
    $("#ECntYn").val(ECntYn);
    
    (checkResult != "1" || checkResult == "") ? hideLoading() : showLoading();
    
    if(checkResult != null && checkResult != ""){
        
        loginCheck ="Y";
        if(checkResult == "0") {
            alert("회원정보조회중 오류가 발생하였습니다.\n 잠시 후 다시 시도해 주시기 바랍니다.");

        } else if(checkResult == "1") {
            
            var sexType = result.find("sexType").text();
            var ageGroupCd = result.find("ageGroupCd").text();
            _trk_flashEnvView("'_TRK_SX="+sexType+"','_TRK_AG="+ageGroupCd+"','_TRK_ISLOGIN=Y','_TRK_MBR=Y','_TRK_PI=LIR'");
            

            _gender = (sexType=="M" ? "남자" : "여자");
            var cusBrdt = result.find("cusBrdt").text();
            if (cusBrdt != "")
                _userAge = getKoreanAge(cusBrdt);
            //amplitude.setUserId(result.find("cusNo").text());
            amplitude.setUserId('');

            $("#f").attr("action", returnTran()).submit();
           
        } else if(checkResult == "2") {
            alert('해당 서비스는 계약자만 이용하실 수 있습니다.');

        } else if(checkResult == "3") {
            alert('통합회원 정보 조회 중 오류가 발생하였습니다.\n잠시 후 다시 이용해주세요.');

        }else if(checkResult=="E"){
            alert("올바른 주민번호를 입력하세요");   
        }else if( checkResult=="DEATH_E"){
        	alert("신용정보원에서 말소자로 확인된 주민번호입니다.\n금융사고예방을 위한 조치로 양해부탁드립니다.\n자세한 문의사항은 대표번호 1644-9000로 연락주세요.");
        } else {
        
            alert("휴대폰 인증 중 오류가 발생하였습니다.\n잠시 후 다시 이용해주세요.");
        }
        
    } else {
        alert("휴대폰 인증 중 오류가 발생하였습니다.\n잠시 후 다시 이용해주세요.");
    }    
}

function checkNumber() {
    var objEv = event.srcElement;
    var numPattern = /([^0-9|.])/;
    numPattern = objEv.value.match(numPattern);
    if(numPattern != null){
        objEv.value = "";
        objEv.focus();
        return false;
    } else {
        return true;
    }
}

function onlyKor(thisId,obj) {
    if (obj == "") return true;
    var re = /[a-z0-9]|[\[\]{}()<>?|`~!@#$%^&*-_=+,.:;\"'\\]/gi;
        if (re.test(obj)) {
    
           obj = obj.replace(re, "");
           thisId.val(obj);
           return ;
        }
};


function authHpInit(){
    
    $('#oInputSmsAuthCfmtNo').val("");
    $('#oInputSmsAuthCfmtNo').prop("disabled", true);
    $("#oSmsAuthCfmtNoBtn").text("인증번호받기");
    smsValidationChk();
}


function smsValidationChk(){
    
    var authNbr = $("#oInputSmsAuthCfmtNo").val().length;
    
    if(!(authNbr<6)){

        if(hpAuthValidationChk("check")){
            $("#fnConfirmSmsAutNo").removeClass("gray");
            return true;
        }else{
            $("#fnConfirmSmsAutNo").addClass("gray");
            return false;
        }
    }else{
        $("#fnConfirmSmsAutNo").addClass("gray");
        return false;       
    }
    
    return false;
}

