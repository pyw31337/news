 //카카오페이 팝업창 인증완료 버튼 클릭시
 function kakaoLogin(){
     console.log("금융거래회원 카카오 로그인 실행");
     showLoading();
     
    var ajaxUrl = '/auth/auth/certKakao.ajax'; // ni.hp.cert.cmd.AuthKakaoCmd  kakaoLoginSts
     var aJax = new devon.xSync(ajaxUrl);
     aJax.addQuery('type', 'ajax');
     aJax.addQuery('kindCode', '0300');
     aJax.addQuery('txCode', 'STATUS'); 
     aJax.addQuery('reqTxId', 'S610');
     aJax.addQuery('loginYn', 'Y');
     aJax.addQuery('callbackFunctionName', "kakaoAuthResultSTATUS");
     aJax.vestFire();
     return false;
     
 } 
  
 // 카카오페이 인증대기 중
 function kakaoAuthResultSTATUS(json, instance, node, xmlDoc){
     var result = jQuery(xmlDoc);
     var status = result.find("status").text();
     
     (status != 'COMPLETE') ? hideLoading() : showLoading();

     if(status == 'COMPLETE'){
         
        kakaoAuthVerify("S610V");
            
     } else if (status == 'EXPIRED'){
         
        alert("처리 마감시간이 종료되었습니다.");
        
     } else if (status == 'PREPARE'){
         
        alert("인증 대기중입니다.");
        
     } else if (status != undefined) {
         
        alert("알수없는 에러입니다.");
        
     };
     
 }

 //결과 확인
 function kakaoAuthVerify(txcode) {
    
    var ajaxUrl = '/auth/auth/certKakao.ajax'; // ni.hp.cert.cmd.AuthKakaoCmd
    var aJax = new devon.xSync(ajaxUrl);
    aJax.addQuery('type', 'ajax');
    aJax.addQuery('txCode', txcode);
    aJax.addQuery('callbackFunctionName', "kakaoAuthResultS610V");
    aJax.addQuery('loginYn', 'Y');
    aJax.vestFire();
    return false;

 }


 function kakaoAuthResultS610V(json, instance, node, xmlDoc){
    
    var result = jQuery(xmlDoc);

     var txId = result.find("tx_id").text();
     var errCode = result.find("errcode").text();
     var serviceUserId = result.find("service_user_id").text();
     
     (!serviceUserId) ? hideLoading() : showLoading();
     
     (serviceUserId) ? goNextKakaoAfterAuth(txId,serviceUserId) : alert("요청에 실패하였습니다.");
     
 }


 function goNextKakaoAfterAuth(txId, serviceUserId){
    
        var ajaxUrl = '/login/check/authKakaoLogin.ajax'; // ni.hp.login.cmd.AuthKakaoLoginCmd
        var aJax = new devon.xSync(ajaxUrl);
        aJax.addQuery('type', 'ajax');
        aJax.addQuery('txId', txId);
        aJax.addQuery('serviceUserId', serviceUserId);
        aJax.addQuery('loginYn', 'Y');
        aJax.vestFire();
        return false;
 
 } 


 function kakaoAuthLoginResult(json, instant, node, xmlDoc){

     var result = jQuery(xmlDoc);
     var checkResult = result.find("LoginResult").text();
     
     (checkResult != "1" || checkResult == "") ? hideLoading() : showLoading();

     if(checkResult != "" && checkResult != null){
        //loginCheck ="Y";

        if(checkResult == "1"){
            
            
            var sexType = result.find("sexType").text();
            var ageGroupCd = result.find("ageGroupCd").text();
            _trk_flashEnvView("'_TRK_SX="+sexType+"','_TRK_AG="+ageGroupCd+"','_TRK_ISLOGIN=Y','_TRK_MBR=Y','_TRK_PI=LIR'");
            
            
            $("#f").attr("action", returnTran()).submit();   
            
        }else if(checkResult == "2"){
            jQuery("#f").attr("action", "/savePrivAuthStepComplete.nhfire").submit();
            //민간인증서 등록완료화면으로 이동
        }else if(checkResult == "3"){
            jQuery("#f").attr("action", "/savePrivAuthStep1.nhfire;jsessionid=feA6CUll5CkBZtFyBY5ah4H9lbk49pp5Fqsp034wsHH3g4KNTl6FTxTtf3193p3V.nphpws01_servlet_NHpCm01").submit();
        }else if(checkResult == "4"){
            alert("통합회원 정보 조회 중 오류가 발생하였습니다.\n잠시 후 다시 이용해주세요.");
        }else if(checkResult == "5"){
            alert("해당 서비스는 계약자만 이용하실 수 있습니다.");
        }else if(checkResult == "15"){
            alert("잘못된 요청입니다. 다시 시도해주세요");
        }
     }else{
         alert("로그인 요청이 완료되지 않았습니다. 잠시후 다시 이용해 주세요");
     }
 };
     
