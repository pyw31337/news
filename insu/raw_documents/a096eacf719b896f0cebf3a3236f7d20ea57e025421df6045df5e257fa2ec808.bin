//바이오 주민 체크
function bioAuthValidationChk(gubun) {
    
    
    if(gubun == "100" || gubun == "119" ){
        if($("#fRlno2").val()==""){
            alert("주민번호 앞자리를 입력하세요.");
            $("#fRlno2").focus();
            return false;
        }
        
        if($("#bRlno2").val()==""){
            alert("주민번호 뒷자리를 입력하세요.");
            $("#bRlno2").focus();
            return false;
        }
    }else if(gubun == "116"){
        if($("#fRlno3").val()==""){
            alert("주민번호 앞자리를 입력하세요.");
            $("#fRlno3").focus();
            return false;
        }
        
        if($("#bRlno3").val()==""){
            alert("주민번호 뒷자리를 입력하세요.");
            $("#bRlno3").focus();
            return false;
        }
    }
    return true;
}
