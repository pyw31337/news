            element.removeClass('open');
            element.find('li').removeClass('open');
            element.find('.openBox').slideUp(200);
        }
        else {
            element.addClass('open');
            element.children('.openBox').slideDown(200);
            element.siblings('li').children('.openBox').slideUp(200);
            element.siblings('li').removeClass('open');
            element.siblings('li').find('li').removeClass('open');
            element.siblings('li').find('.openBox').slideUp(200);
