    aJax.addQuery('kindCode', '0700601');
    aJax.addQuery('txCode', 'S300100');
    aJax.addQuery('TLCM_DCD', $("#passCom").val());
    aJax.addQuery('ENC_MPNO', hp);
    aJax.addQuery("RRNO_N7", $("#passRRNO_N7").val());
