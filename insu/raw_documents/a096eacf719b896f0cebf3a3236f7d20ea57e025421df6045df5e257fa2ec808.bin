 //패스 값체크
 function passLoginValidation(check){
     /* 이름, 생년월일, 주민번호뒷자리 첫번째, 휴대폰 가운데, 휴대폰 끝자리, 약관체크여부  */
    var cusNm = $("#passCusNm"); 
    var birth =$("#passBirth");
    var n7 = $("#passRRNO_N7");
    var telCode = $("#passCom");
    var hpNo2 = $("#passmpnoNo2");
    var hpNo3 = $("#passmpnoNo3");
    var chk = $("#passChk");
        
    if(!cusNm.val())                            {if(!check){alert("이름을 입력 해주세요.");          cusNm.focus();  }return false;}
    if(!birth.val() || birth.val().length < 6 ) {if(!check){alert("주민번호 앞자리를 입력해주세요");      birth.focus();  }return false;}
    if(!n7.val())                               {if(!check){alert("주민번호 뒷자리를 입력해주세요");      n7.focus();     }return false;}
    if(!telCode.val())                          {if(!check){alert("통신사를 선택해주세요.");          telCode.focus();}return false;}
    if(!hpNo2.val() || hpNo2.val().length <3)   {if(!check){alert("휴대전화 가운데 자리를 입력하세요");    hpNo2.focus();  }return false;}
    if(!hpNo3.val() || hpNo3.val().length <4)   {if(!check){alert("휴대전화  끝자리를 입력하세요.");     hpNo3.focus();  }return false;} 
    if(!chk.is(":checked"))                     {if(!check){alert("약관 동의 후 인증해주세요.");       chk.focus();    }return false;}

    return true;
 }
 
 
 function passLoginChk(){
     
     passLoginValidation("check") ? $("#passLoginChk").removeClass("gray") : $("#passLoginChk").addClass("gray");

 }
 
 
 
 function passLoginBtn(){
     
    if(!passLoginValidation()) {
        return false;
    }

    position = "9"; //패스인증

    $.fn.modalUi("open", "popPass", $(this));
    showLoading();

    var ajaxUrl = '/auth/auth/certPCPass.ajax';
    var hp = $("#passmpnoNo1").val()+$("#passmpnoNo2").val()+$("#passmpnoNo3").val();
