 /**
  * 카카오페이 인증번호를 입력하여 본인인증 확인
  */
  

  function kakaoLoginChk(){
    
    kkoAuthValidationChk("check") ? $("#kakaoLoginChk").removeClass("gray") : $("#kakaoLoginChk").addClass("gray");

  }
  
  function kkoAuthValidationChk(check){
    
    /* 이름, 생년월일, 휴대폰 가운데, 휴대폰 끝자리, 약관체크여부  */
    var cusNm = $("#kakaoCusNm");
    var birth = $("#kakaoBirth");
    var hpNo2 = $("#kakaoMpnoNo2");
    var hpNo3 = $("#kakaoMpnoNo3");
    var chk = $("#kakaoChk");
    
    if(!cusNm.val() )                           {if(!check){alert("이름을 입력하세요");         cusNm.focus();} return false;}
     
    if(!birth.val() || birth.val().length<8 )   {if(!check){alert("생년월일 8자리를 입력하세요");       birth.focus();} return false;}
    
    if(!hpNo2.val() || hpNo2.val().length<3 )   {if(!check){alert("휴대전화 가운데 자리를 입력하세요");    hpNo2.focus();} return false;}
     
    if(!hpNo3.val() || hpNo3.val().length<4 )   {if(!check){alert("휴대전화 끝자리를 입력하세요");       hpNo3.focus();} return false;}
    
    if(!chk.is(":checked") )                    {if(!check){alert("약관 동의 후 인증해주세요.");       chk.focus();}   return false;}

    return true;
  };
  
 function kakaoAuthBtn(){ //카카오페이_KDH  frm_kakaoReq
    if (!kkoAuthValidationChk()){       
        return false;   
    }

    position = "7"; //pay인증

    $.fn.modalUi("open", "popKakao", $(this));
    showLoading();
    
    var ajaxUrl = '/auth/auth/certKakao.ajax'; // ni.hp.cert.cmd.AuthKakaoCmd
     var aJax = new devon.xSync(ajaxUrl);
     aJax.addQuery('type', 'ajax');
     aJax.addQuery('kindCode', '0200');
     aJax.addQuery('txCode', 'S610');
     aJax.addQuery('phone_no', $("#kakaoMpnoNo1").val()+$("#kakaoMpnoNo2").val()+$("#kakaoMpnoNo3").val());
     aJax.addQuery('name', $("#kakaoCusNm").val());
     aJax.addQuery('birthday', $("#kakaoBirth").val());
     aJax.addQuery('expire', '0120');
     aJax.addQuery('call_center', '1644-6000');
     aJax.addQuery('title', '카카오페이로그인');
     aJax.addQuery('message', '로그인 인증요청');
     aJax.addQuery('allow', 'Y');
     aJax.addQuery('verify', 'Y');
     aJax.addQuery('payload', '');
     aJax.addQuery('call_center_label', '고객콜센터');
     aJax.addQuery('callbackFunctionName', "kakaoAuthResultS610");
     aJax.addQuery('loginYn', 'Y');
     aJax.vestFire();
     return false;

 };
 
 
