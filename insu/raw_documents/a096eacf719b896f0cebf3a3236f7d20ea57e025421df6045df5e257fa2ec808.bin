    });
/*  //한글입력방지  IE에서 기능동작이 육안으로 식별이 안되는경우가 있어 주석처리
    $('#cusNm, #kakaoCusNm, #passCusNm').keyup(function(event){
            onlyKor($(this),$(this).val());
