 function doPrivLogin(json, instant, node, xmlDoc){

     var result = jQuery(xmlDoc);
     
     
    var sexType = result.find("sexType").text();
    var ageGroupCd = result.find("ageGroupCd").text();
    
    _trk_flashEnvView("_TRK_SX="+sexType,"_TRK_AG="+ageGroupCd,"_TRK_ISLOGIN=Y","_TRK_MBR=Y","_TRK_PI=LIR");
    
    
    $("#f").attr("action", returnTran()).submit();

 }
 
