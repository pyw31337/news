 function finCertCallBack(result){
     // 금융인증서 인증 완료했을때 동작
     console.log("Step2. 로그인, 사용자 금융인증 완료 ");
     $('#signature').val( result.signedValStr);
     console.log("인증이 완료 되었습니다." ); 
     //+ JSON.stringify(result) );
     if(stat == ""){
    	 finCertAuthSign(result);      // privAuthCommon.js의 finCertAuthSign() function 을 호출
     }else{
    	 finCertIdVerifyDone(result);
     }
 }
 
 
 /**
  * Step3. 금융인증서 검증 실행
  * @param result
  */
 function finCertAuthSign(result) {
     console.log("Step3. 로그인, 서명검증(실명번호와 서명값 검증:금결원) ");
     showLoading();
     
     var ajaxUrl = '/auth/auth/certPCfineCert.ajax'; 
     var aJax = new devon.xSync(ajaxUrl);

     aJax.addQuery('cusNm', "");
     aJax.addQuery('signature', result.signedValStr);
     aJax.addQuery('is_content_required', "true");
     aJax.addQuery('selfAuthDcd', 'C');
     aJax.addQuery('hmpgChnDcd', '02');
     aJax.addQuery('loginYn', 'Y');
     
     aJax.addQuery('title', "");
//      aJax.addQuery('isSignature', "true");
     aJax.addQuery('callbackFunctionName', "finCertAuthSignSuccess");


//          aJax.fire();    // fnSetAuthResult

         aJax.vestFire();

     
     
//      var tr = new FinCert_Retrieve_authSignSD001();
     //tr.inData.txCode = "SD001"; //FinCert_Retrieve_authDataTest 를 사용하기 때문에 txCode를 지정해 주어야 하기 때문에 설정, FinCert_Retrieve_authSignSD001 를 사용하게 되면 설정할 필요 없음
//      tr.inData.signature = $('#signature').val();                        // 싸인값
//      tr.inData.is_content_required = "true"; // 서명원문을 응답받을 지 여부
//      tr.inData.selfAuthDcd = prevData.selfAuthDcd;   // 
//      tr.inData.hmpgChnDcd    = '02'        ;  // 홈페이지채널구분코드 01:공통 02:홈페이지 03:모바일
//      tr.inData.inpPgmId      = SCREEN_CODE;
     
     

 }
 //금융인증서 서명 callback
 function finCertAuthSignSuccess(json, instance, peer, xmlDoc){
     hideLoading();
     console.log("Step4. 로그인, 금융인증서 서명검증 완료");
     var result = jQuery(xmlDoc);
     var errcode = result.find("errcode").text();
     var err_code = result.find("err_code").text();
     var isValid = result.find("isValid").text();
     console.log("errcode::::"+errcode);
     console.log("errcode::::"+typeof errcode);
     console.log("err_code::::"+err_code);
     console.log("err_code::::"+typeof err_code);
     console.log("isValid::::"+isValid);
//      if(errcode == ""  && isValid == 'true'){
         //alert("금융인증서 전자서명이 완료 되었습니다.");
   
//      }
     //return;
     if(errcode == "" ){
         
         showLoading();
         //간편로그인(민간인증) 회원정보조회 및 로그인 처리(금융인증 정보로 조회)
         var ajaxUrl = '/login/check/authFinCertLogin.ajax'; 
         var aJax = new devon.xSync(ajaxUrl);
         var nVal = $("#nVal").val();
         var valid_from = trimValidTimeStr(result.find("valid_from").text());
         var valid_to = trimValidTimeStr(result.find("valid_to").text());
         var virtual_id = result.find("virtual_id").text();
         var ci = valid_from + "|" + valid_to + "|" + virtual_id;
         var selfAuthDcd = "C";
         
         aJax.addQuery('valid_from', valid_from);
         aJax.addQuery('valid_to', valid_to);
         aJax.addQuery('virtualId', virtual_id);
         aJax.addQuery('virtual_id', virtual_id);
         aJax.addQuery('selfAuthDcd', selfAuthDcd);
         aJax.addQuery("nVal", nVal);
         aJax.addQuery("ci", ci);
         aJax.addQuery("loginYn", "Y");
         aJax.addQuery("wdata", $("#wdata").val());
         aJax.addQuery("ndata", $("#ndata").val());
         
         
         aJax.vestFire();
     }
}
 
 
 //금융인증서 로그인 결과(간편로그인(민간인증) 회원정보조회 및 로그인 처리(금융인증 정보로 조회))
 function finCertLoginCallBack(json, instance, peer, xmlDoc){
     
     hideLoading();
     var result = jQuery(xmlDoc);
     var loginResult =  result.find("KakaoBizResult").text();
     var KakaoBizResultMsg = result.find("KakaoBizResultMsg").text();
     //결과값
     if(loginResult == "2"){
         if (confirm('금융인증서 등록이 필요합니다. 금융인증서 등록을 하시겠습니까?')){
             jQuery("#f").attr("action", "/saveFinCertAuthStep1.nhfire;jsessionid=feA6CUll5CkBZtFyBY5ah4H9lbk49pp5Fqsp034wsHH3g4KNTl6FTxTtf3193p3V.nphpws01_servlet_NHpCm01").submit();
         }
     }else if(loginResult == "E"){ 
        // 가입고객 아님
         console.log(" 가입고객 아님 :" + KakaoBizResultMsg);
         alert("해당 서비스는 계약자만 이용하실 수 있습니다.");
     }else if(loginResult == "1"){ 
         
         alert("해당 서비스는 계약자만 이용하실 수 있습니다.");
     }else if( loginResult=="DEATH_E"){
     	alert("신용정보원에서 말소자로 확인된 주민번호입니다.\n금융사고예방을 위한 조치로 양해부탁드립니다.\n자세한 문의사항은 대표번호 1644-9000로 연락주세요.");
     }else{
         showLoading();
         //정상로그인일경우
         $("#f").attr("action", returnTran()).submit();
     }
     
     
 }
 
 
 
