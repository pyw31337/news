console.log("홈페이지 로그인");
//통합고객 로그인 결과 처리
var gCheckResult = "";  

var loginCheck = "Y";

function fnTabInit(){

	var loginMenuVal  = document.cookie.match('(^|;)?loginmenu=([^;]*)(;|$)');

	if((loginMenuVal == null)||(loginMenuVal[2] == "")||(loginMenuVal[2] == "1")){
		$("#menu01").addClass("active").find('a').attr('title','선택됨');
		$("#menu01Tab").addClass("active");
		setAuthTypeCookie("loginmenu",1,60);
		
		var loginTabVal  = document.cookie.match('(^|;)?logintab=([^;]*)(;|$)');
		if((loginTabVal == null)||(loginTabVal[2] == "")||(loginTabVal[2] == "1")){		
			$("#rdo1").addClass("active").find('a').attr('title','선택됨');
			$("#rdo1Tab").addClass("active");
			setAuthTypeCookie("logintab",1,60);
			
			var loginTypeVal  = document.cookie.match('(^|;)?logintype=([^;]*)(;|$)');
			
			if((loginTypeVal == null)||(loginTypeVal[2] == "")||(loginTypeVal[2].indexOf("Tab") > -1 )||(loginTypeVal[2] == "certificate")){
				$(".certificateTab").addClass("active");
				$("#certificate").addClass("active");
				setAuthTypeCookie("logintype","certificate",60);
			}else{
				$("."+loginTypeVal[2]+"Tab").addClass("active");
				$("#"+loginTypeVal[2]).addClass("active");
				setAuthTypeCookie("logintype",loginTypeVal[2],60);
				
			}
			
		}else{
			
			$("#rdo2").addClass("active").find('a').attr('title','선택됨');
			$("#rdo2Tab").addClass("active");
			setAuthTypeCookie("logintab",2,60);
			
		}
	
	}else{
		
		$("#menu02").addClass("active").find('a').attr('title','선택됨');
		$("#menu02Tab").addClass("active");
		setAuthTypeCookie("loginmenu",2,60);
	}


}

//한글입력방지
function fnCheckKor() {
	var objEv = event.srcElement;
	var pattern = /[ㄱ-ㅎ|ㅏ-ㅣ|가-힣]/;
	pattern = objEv.value.match(pattern);
	if(pattern != null){
	    objEv.value = "";
	    objEv.focus();
	    return false;
	} else {
	    return true;
	}
}

 

function kkoAuthHpInit(close){
	
	$('#kkoInputSmsAuthCfmtNo').val("");
	$('#kkoInputSmsAuthCfmtNo').prop("disabled", true);
	$("#kkoSmsAuthCfmtNoBtn").text("전체동의 및 인증번호 발송");
	$("#kkoSmsAuthCfmtNoBtn, #kkoHpLoginChk").addClass("gray");
	if(close){
		
		$('#kko_frm_priCif').each(function(){
			this.reset();
		});
	}
}

/**
 * 제휴 SMS 인증번호 받기
 */
 /* 제휴업체 sms 통신사 선택(s) */
 function fnKkoPhonesmsCom(num) {
 	kkoAuthHpInit();
 	kkoValidationChk();
 	$("#kkoSmsCom").val(num);

 } 
 
function kkoFnGetSmsAuthCfmtNo() {
	$("input[name='kkoChkAgree']").prop("checked",true);
	
	if (!kkoHpAuthValidationChk()){		
		return false;
	}

    $("#kkoMvComuDcd").val($("#kkoSmsCom").val()); // 통신사 구분코드 셋팅
    
    // 인증번호 재요청시
    $("#kkoSmsAuthCfmtNoBtn").text("전체동의 및 인증번호 다시 받기");
    $("#kkoSmsAuthCfmtNoBtn").removeClass("gray");

    $("#kkoOHpNo").val( jQuery("#kkoMpnoNo1").val() + $("#kkoMpnoNo2").val() + $("#kkoMpnoNo3").val() );

    if ( typeof arguments[0] == "undefined") {
        $("#kkoOSmsResendYn").val("");
    } else {
        $("#kkoOSmsResendYn").val("Y");
    }
    
    var readForm = document.kko_frm_priCif;
    var sendForm = document.sendForm;

    //가상키패드 암호화
    transkeyEnc();
    
	$ASTX2.getE2EDataIDs(
			["bRlno4"],
		function onSuccess(data) {
				
		    //일반페이지 로딩바호출 open(s)
		    showLoading();
		    //일반페이지 로딩바호출 open(e)	
			var aJax = new devon.xSync("/cyber/auth/inquiryMphoneAuth.ajax;jsessionid=feA6CUll5CkBZtFyBY5ah4H9lbk49pp5Fqsp034wsHH3g4KNTl6FTxTtf3193p3V.nphpws01_servlet_NHpCm01"); // 인증번호 받기 콜백명 fnSetMphoneAuthResult 
			aJax.addQuery("type", "ajax");
			aJax.addQuery("serializeFormData", escape(encodeURIComponent(jQuery("#kko_frm_priCif").serialize()))); 
			aJax.addQuery("e2e_data1", data.e2e_data1);
			aJax.callback = kkoFnSetMphoneAuthResult ; // 콜백명 중복으로 제휴업체 sms용으로 재정의
			aJax.fire();
			return false;  
		}, 
		function onFailure() {
			alert("조회중 에러가 발생하였습니다.");
	          //ASTX E2E대상 필드 관련 초기화. AJAX거래시 이 초기화 안해주면 기존입력값으로 유지됨
		     $ASTX2.clearE2EText(document.getElementById("bRlno4"));
			$_astxu.log('ASTX.getE2EData() failure: errno='+$ASTX2.getLastError()); 
			
		}
	);
	return false; //반드시 false를 return;
}

/**
 * 제휴업체 SMS 인증번호 받기 callback function
 */
function kkoFnSetMphoneAuthResult() {
	
	hideLoading();
	setTimeout(function() {}, 500);
	
	var xmlDoc = this.request.responseXML.documentElement;
    var result = jQuery(xmlDoc);
    var rtnTyp = result.find("RTN_TYP").text();
    var rtnMsg = result.find("RTN_MSG").text();
    var msgCd = result.find("MSG_CD").text();

    var prcRzt = result.find("PRC_RZT").text();
    var prcRztMsg = result.find("PRC_RZT_MSG").text();

    if ( rtnTyp == "D") {
        if ( prcRzt == "B000" ) {
        
        /* if ( true ) 2014-02-19. KCB와의 연계 문제로 실명인증이 모두 fail. 무조건 패스 */
            alert("인증번호가 발송되었습니다.\n인증번호 수신 후 인증번호 6자리를 입력하시기 바랍니다.");

			$("#kkoInputSmsAuthCfmtNo").prop("disabled",false);
			$("#kkoORqSqno").val( result.find("RQ_SQNO").text() ); // 거래일련번호

        } else {
            alert("인증번호발송요청 도중 다음과 같은 오류가 발생하였습니다.\n[" + prcRzt + "] " + prcRztMsg);
            return false;
        }
    } else if ( rtnTyp == "E") {
        alert("업무 처리도중 장애가 발생하였습니다..");
        return false;

    } else if ( rtnTyp == "SESSION_E") {
        alert("사용자의 세션이 만료되었습니다.");
//         location.href = "/login.nhfire";

    } else if ( rtnTyp == "BIZ_E") {
        alert("인증번호발송 요청 도중 오류가 발생하였습니다.");
        return false;
    }
}


function kkoValidationChk(){
	

	var chkBtnDis = $("#kkoInputSmsAuthCfmtNo").is(":disabled");
	var chk = $("#kkoSmsAuthCfmtNoBtn, #kkoHpLoginChk");
	var chkResult = kkoHpAuthValidationChk("check");
	
	chk = (chkBtnDis) ? $("#kkoSmsAuthCfmtNoBtn") : $("#kkoSmsAuthCfmtNoBtn, #kkoHpLoginChk");
	
	chkResult ? chk.removeClass("gray") : chk.addClass("gray");

	return chkResult;
}

function kkoHpAuthValidationChk(check) {
	
    if($("#bRlno4").val()=="" || $("#bRlno4").val().length < 7 ){
		if(!check){
			alert("주민번호 뒷자리를 입력하세요.");
			$("#bRlno4").focus();
		}
		kkoAuthHpInit();
        return false;
    }
	
	if ( $("#kkoSmsCom").val()== "" ) {
		if(!check){
	        alert("통신사를 선택하세요");
	        $("#kkoSmsCom").focus();
		}
        return false;
   	}
	
    if ( !$("#kkoChkAgree1").is(":checked") ) {
		if(!check){
			alert("개인정보이용 및 제공동의에 동의 하셔야 합니다.");
			$("#kkoChkAgree1").focus();
		}
        return false;
    }
    
    if ( !$("#kkoChkAgree2").is(":checked") ) {
		if(!check){
			alert("통신사별 이용약관 동의에 동의 하셔야 합니다.");
			$("#kkoChkAgree2").focus();
		}
        return false;
    }

    if ( !$("#kkoChkAgree3").is(":checked") ) {
		if(!check){
			alert("본인확인 서비스 대행사별 이용약관 동의에 동의 하셔야 합니다.");
			$("#kkoChkAgree3").focus();
		}
        return false;
    }
    
    if ( !$("#kkoChkAgree4").is(":checked") ) {
		if(!check){
			alert("고유식별정보처리 동의에 동의 하셔야 합니다.");
			$("#kkoChkAgree4").focus();
		}
        return false;
    }
    
    if ( !$("#kkoChkAgree5").is(":checked") ) {
		if(!check){
			alert("홈페이지 이용약관 동의에 동의 하셔야 합니다.");
			$("#kkoChkAgree5").focus();
		}
        return false;
    }
    
    if ( !$("#kkoChkAgree6").is(":checked") ) {
		if(!check){
			alert("전자금융거래 이용약관 동의에 동의 하셔야 합니다.");
			$("#kkoChkAgree6").focus();
		}
        return false;
    }
    
    return true;
}

function kkoFnConfirmSmsAutNo() {
	
	if (!kkoHpAuthValidationChk()){
		return false; 
	}
	
	position = "1";    //휴대폰인증
	
	if($("#kkoInputSmsAuthCfmtNo").val() == ""){
		alert("인증번호를 입력하세요.");
		jQuery("#kkoInputSmsAuthCfmtNo").focus();
		return false;
	}

    $("#kkoOSmsAuthCfmtNo").val( $("#kkoInputSmsAuthCfmtNo").val() );
    
    var readForm = document.kko_frm_priCif;
    var sendForm = document.sendForm;

    $ASTX2.getE2EDataIDs(
    		["bRlno4"],
    	function onSuccess(data) {
    			
    		//일반페이지 로딩바호출 open(s) 
    	    showLoading();
    	    //일반페이지 로딩바호출 open(e)	
    		var aJax = new devon.xSync("/login/check/authLogin.ajax;jsessionid=feA6CUll5CkBZtFyBY5ah4H9lbk49pp5Fqsp034wsHH3g4KNTl6FTxTtf3193p3V.nphpws01_servlet_NHpCm01");
    		aJax.addQuery("type", "ajax");
    		aJax.addQuery("loginType", "SMS");
    		aJax.addQuery("serializeFormData", escape(encodeURIComponent($("#kko_frm_priCif").serialize()))); 
    		aJax.addQuery("e2e_data1", data.e2e_data1);
    		aJax.fire();
    		return false;  
    	}, 
    	function onFailure() {
    		alert("조회중 에러가 발생하였습니다. ");
              //ASTX E2E대상 필드 관련 초기화. AJAX거래시 이 초기화 안해주면 기존입력값으로 유지됨
    	     $ASTX2.clearE2EText(document.getElementById("bRlno4"));
    		$_astxu.log('ASTX.getE2EData() failure: errno='+$ASTX2.getLastError()); 
    		
    	}
    );
    
    return false; //반드시 false를 return;
}



function fnValidationLoginChk(){
	
	if(fnCheckLoginChk("check")){
		$("#loginBtn").removeClass("gray");
		return true;
	}else{
		$("#loginBtn").addClass("gray");
		return false;
		
	}
	
}

//웹회원 로그인  입력체크
function fnCheckLoginChk(check){
	
	if($("#cusNm1").val() == "" ){
		if(!check){
			alert("아이디를 입력하세요");
			$("#cusNm1").focus();
		}
		return false;
	}
	if($("#pwd3").val() == "" ){
		if(!check){
			alert("패스워드를 입력하세요");
			$("#pwd3").focus();
		}
		return false;
	}
	
	return true;

}
//웹회원 로그인
function fnCheckLogin() {
    var webLoingForm = document.webLoingForm;
    var sendForm = document.sendForm;
    
    var id = $("#cusNm1").val();
    var pw = $("#pwd3").val();
    
    if(!fnCheckLoginChk()){
    	return false;
    }

    CheckEncForm(webLoingForm, sendForm);
}

// 홈페이지 로그인체크
function CheckEncForm(readForm, sendForm)
{

    $ASTX2.getE2EDataIDs(
			["pwd3"],
		function onSuccess(data) {
				
			var aJax = new devon.xSync("/login/check/homepageLoginCheck.ajax;jsessionid=feA6CUll5CkBZtFyBY5ah4H9lbk49pp5Fqsp034wsHH3g4KNTl6FTxTtf3193p3V.nphpws01_servlet_NHpCm01");
			aJax.addQuery("type", "ajax");
			aJax.addQuery("serializeFormData", escape(encodeURIComponent(jQuery("#webLoingForm").serialize()))); 
			aJax.addQuery("e2e_data1", data.e2e_data1);
			aJax.fire();
			return false;  
		}, 
		function onFailure() {
			alert("조회중 에러가 발생하였습니다.");
	          //ASTX E2E대상 필드 관련 초기화. AJAX거래시 이 초기화 안해주면 기존입력값으로 유지됨
		     $ASTX2.clearE2EText(document.getElementById("pwd3"));
		    
			$_astxu.log('ASTX.getE2EData() failure: errno='+$ASTX2.getLastError()); 
			
		}
	);
    
  return false; //반드시 false를 return;
 
}


//일반회원 로그인 CHECK 결과
function fnSetCheckResult(json, instant, node, xmlDoc){

    var result = jQuery(xmlDoc);
    var checkResult = result.find("Result").text();
    var LginCount = result.find("LginCount").text();
    loginCheck ="Y";
    if(checkResult == "1" || checkResult == "2" || checkResult == "4") { //아이디 비번 오류
    	$ASTX2.clearE2EText(document.getElementById("pwd3"));
		alert("아이디 또는 비밀번호가 잘못되었습니다.");
        $("#pwd3").val("");
//         $("#btnClose").focus();
        return false;
    }
    /* else if(checkResult == "2") { //비번오류
        $('#divPopupArea, .alertMsg').show();
        $("#msg").text("로그인 "+LginCount+"회 실패하였습니다.\n 5회 초과 실패 시 로그인이 차단됩니다.");
        $("#cusNm").val("");
        $("#pwd3").val("");
        $("#btnClose").focus();
        return false;
    } */
    else if(checkResult == "3"){ //정상접속
        
    	
    	var sexType = result.find("sexType").text();
    	var ageGroupCd = result.find("ageGroupCd").text();
    	//_trk_flashEnvView("'_TRK_SX="+sexType+"','_TRK_AG="+ageGroupCd+"','_TRK_ISLOGIN=Y','_TRK_MBR=','_TRK_PI=LIR'");
    	_trk_flashEnvView("_TRK_SX="+sexType,"_TRK_AG="+ageGroupCd,"_TRK_ISLOGIN=Y","_TRK_MBR=","_TRK_PI=LIR");/*_TRK_MBR:회원여부 웹회원은 넣지 않음.*/
    	
    	var returnUrl = ($("#returnUrl").val()=="") ? "/index.nhfire" : $("#returnUrl").val();
        jQuery("#f").attr("action", returnUrl).submit();
    }
    /* else if(checkResult == "4"){ // 로그인 5회 실패
        $('#divPopupArea, .alertMsg').show();
        $("#msg").text("로그인 5회 초과 실패하였습니다.\n 비밀번호 찾기 화면으로 이동 합니다.");
        gCheckResult = "4";
        $("#btnClose").focus();
    } */
    else if(checkResult == "5"){ // 비번 변경주기 체크
        
		if(confirm("회원가입 또는 새로운 비밀번호로 변경하신 지 6개월이 경과되었습니다. 개인정보 유출로 인한 피해를 방지하기 위해 비밀번호를  변경해 주세요.")){
			location.href = "/findPassword.nhfire";
		}
    	return false;
    }else if(checkResult == "6"){ // 비번 변경 페이지 이동
		if(confirm("비밀번호 변경화면으로 이동 합니다.")){
			location.href = "/mypage/membership/changePasswordForm.nhfire"; 
		}
        gCheckResult = "5";

    }else if(checkResult == "7"){ // 제휴업체 관리자 로그인
    	var mpno = result.find("userMpno").text();
    	var userNm = result.find("userNm").text();
    	var phonNum = mpno.split('-');
    	var cusBrdt = result.find("cusBrdt").text();
    	
    	$("#kkoUserId").val(result.find("userId").text());
    	$("#kkoMpnoNo1").val(phonNum[0]);
    	$("#kkoMpnoNo2").val(phonNum[1]);
    	$("#kkoMpnoNo3").val(phonNum[2]);
    	
    	$("#kkoCusNm").val(userNm);
    	$("#kkoCusNmReq").val(userNm);
    	
    	$("#cusBrdt").text(cusBrdt);
    	$("#fRlno4").val(cusBrdt);
    	
    	$.fn.modalUi("open", "divKkoPopupArea", $(this));
        
    	return false; 
    }else{
        return false;
    }
    
}


 
   
//웹회원
function handleKeydown1(n){
    if (event.keyCode==13) {
        fnCheckLogin();
    }
}
//통합회원
function handleKeydown2(n){
    if (event.keyCode==13) {
        if($("input[name=radio]:checked").val() == "1"){
        OcspLogin();
        }else{
        OcspLogin2();
            
        }
    }
}

//회원가입 페이지로 이동
function  register(val){
    if(val == "WEB"){ // 웹회원 WEB
        $("#memberGubun").val(val);
        jQuery("#f").attr("action", "/mypage/membership/hpMembershipStep1.nhfire;jsessionid=feA6CUll5CkBZtFyBY5ah4H9lbk49pp5Fqsp034wsHH3g4KNTl6FTxTtf3193p3V.nphpws01_servlet_NHpCm01").submit();
    }else{//통합회원 INTG
        $("#memberGubun").val(val);
        jQuery("#f").attr("action", "/mypage/membership/membershipStep1.nhfire;jsessionid=feA6CUll5CkBZtFyBY5ah4H9lbk49pp5Fqsp034wsHH3g4KNTl6FTxTtf3193p3V.nphpws01_servlet_NHpCm01").submit();
    }
}
//보안키보드 관련 스크립트
function popup(){
    var p = document.getElementById("layerPopup");
    var inp = '<input type="password" name="layerpwd" id="layerpwd" data-tk-kbdType="qwerty" onclick="mtk.onKeyboard(this);" /><span id="layerpwd_tk_btn">마우스입력</span>';
    p.innerHTML=inp;
    
}
function popupOn(){
    initTranskey();
    var p = document.getElementById("layerPopup");
    p.style.display="block";
}
function popupOff(){
    var p = document.getElementById("layerPopup");
    p.style.display="none";
}




</script>

