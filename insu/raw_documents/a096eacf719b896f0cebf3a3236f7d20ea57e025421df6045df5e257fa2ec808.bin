//토스 값체크
function tossLoginValChk(){
    tossLoginValidation("check") ? $("#tossLoginChk").removeClass("gray") : $("#tossLoginChk").addClass("gray"); 
}

 //토스 값체크
function tossLoginValidation(check){
    
      /* 이름, 생년월일, 휴대폰, 약관  */
    var tossMpnoNo2 = $("#numLoginTossHp2").val();
    var tossMpnoNo3 = $("#numLoginTossHp3").val();
    var tossChk = $("#tossSignChk").is(":checked");
    var telCode = $("#tossCom");
    var cusNm = jQuery("#tossCusNm");
    var birth = $("#tossBirth");
    var pre =  $("#tossRRNO_N7");
    
    if(!cusNm.val())                            {if(!check){alert("이름을 입력 해주세요.");          cusNm.focus();  }return false;}
    if(!birth.val() || birth.val().length < 6 ) {if(!check){alert("주민번호 앞자리를 입력해주세요");      birth.focus();  }return false;}
    if(!pre.val())                              {if(!check){alert("주민번호 뒷자리를 입력해주세요");      n7.focus();     }return false;}
    if(!telCode.val())                          {if(!check){alert("통신사를 선택해주세요.");          telCode.focus();}return false;}
    
    
    if ( !tossMpnoNo2 || tossMpnoNo2.length<3 ) {
        if(!check){
            alert("휴대전화 가운데 자리를 입력하세요");
            $("#numLoginTossHp2").focus();
        }
        return false;
    }
    if ( !tossMpnoNo3 || tossMpnoNo3.length<4 ) {
        if(!check){
            alert("휴대전화 끝자리를 입력하세요");
            $("#numLoginTossHp3").focus();
        }
        return false;
    }
    if( !tossChk ){
        if(!check){
            alert("약관 동의 후 인증해주세요.");   
        }
        return false;
    }
    return true;
}




function tossLoginBtn(){
     
        if(!tossLoginValidation()) {
            return false;
        }

        position = "8"; //토스인증

        $.fn.modalUi("open", "popToss", $(this));
