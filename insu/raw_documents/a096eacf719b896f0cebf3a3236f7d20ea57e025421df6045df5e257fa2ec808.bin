 */
function fnGetSmsAuthCfmtNo() {
    if (!hpAuthValidationChk()) 
        return false; 

    $("#mvComuDcd").val($("#smsCom").val()); // 통신사 구분코드 셋팅
    
    // 인증번호 재요청시
    $("#oSmsAuthCfmtNoBtn").text("다시 받기");

    $("#oHpNo").val( jQuery("#mpnoNo1").val() + $("input[name=mpnoNo2]").val() + $("#mpnoNo3").val() );

    if ( typeof arguments[0] == "undefined") {
        $("#oSmsResendYn").val("");
    } else {
        $("#oSmsResendYn").val("Y");
    }
    
    var readForm = document.frm_priCif;
    var sendForm = document.sendForm;

    //가상키패드 암호화
    transkeyEnc();
    
    $ASTX2.getE2EDataIDs(
            ["bRlno"],
        function onSuccess(data) {
                
            //일반페이지 로딩바호출 open(s)
            showLoading();
            //일반페이지 로딩바호출 open(e)   
            var aJax = new devon.xSync("/cyber/auth/inquiryMphoneAuth.ajax;jsessionid=feA6CUll5CkBZtFyBY5ah4H9lbk49pp5Fqsp034wsHH3g4KNTl6FTxTtf3193p3V.nphpws01_servlet_NHpCm01"); // fnSetMphoneAuthResult
            aJax.addQuery("type", "ajax");
            aJax.addQuery("serializeFormData", escape(encodeURIComponent(jQuery("#frm_priCif").serialize()))); 
            aJax.addQuery("e2e_data1", data.e2e_data1);
            aJax.addQuery('loginYn', 'Y');
            aJax.fire();
            return false;  
        }, 
        function onFailure() {
            alert("조회중 에러가 발생하였습니다.");
              //ASTX E2E대상 필드 관련 초기화. AJAX거래시 이 초기화 안해주면 기존입력값으로 유지됨
             $ASTX2.clearE2EText(document.getElementById("bRlno"));
            $_astxu.log('ASTX.getE2EData() failure: errno='+$ASTX2.getLastError()); 
            
        }
    );
    return false; //반드시 false를 return;
}


/**
 * SMS 인증번호 받기 callback function
 */
function fnSetMphoneAuthResult(json, instance, node, xmlDoc) {
    
    hideLoading();
    setTimeout(function() {}, 500);
    
    var result = jQuery(xmlDoc);
    var rtnTyp = result.find("RTN_TYP").text();
    var rtnMsg = result.find("RTN_MSG").text();
    var msgCd = result.find("MSG_CD").text();

    var prcRzt = result.find("PRC_RZT").text();
    var prcRztMsg = result.find("PRC_RZT_MSG").text();

    if ( rtnTyp == "D") {
        if ( prcRzt == "B000" ) {
        
        /* if ( true ) 2014-02-19. KCB와의 연계 문제로 실명인증이 모두 fail. 무조건 패스 */
            alert("인증번호가 발송되었습니다.\n인증번호 수신 후 인증번호 6자리를 입력하시기 바랍니다.");

            $("#oInputSmsAuthCfmtNo").prop("disabled",false);
            $("#oRqSqno").val( result.find("RQ_SQNO").text() ); // 거래일련번호
            
            
        } else {
            alert("인증번호발송요청 도중 다음과 같은 오류가 발생하였습니다.\n[" + prcRzt + "] " + prcRztMsg);
            return false;
        }
    } else if ( rtnTyp == "E") {
        alert("업무 처리도중 장애가 발생하였습니다..");
        return false;

    } else if ( rtnTyp == "SESSION_E") {
        alert("사용자의 세션이 만료되었습니다.");
//         location.href = "/login.nhfire";

    } else if ( rtnTyp == "BIZ_E") {
        alert("인증번호발송 요청 도중 오류가 발생하였습니다.");
        return false;
    }
}
      
    
