function menuClickEvent(evt) {
	var evtClass = ampNacf.NVL(evt.target.parentNode.className, "");
	var evtHref = ampNacf.NVL(evt.target.href, "");
	console.log("menuClickEvent(홈페이지 메인 메뉴 클릭) className:" + evtClass + ",   target.href:" + evtHref);
	if (evtClass == 'gnb_img02') {
		evtHref = "right_claimdoc";
	}
	if (ampNacf.isNull(evtHref))			return;

	var ampEventInfo = {};
	ampNacf.setEvtNm('');

	position = "";
	//subFrontHeader01.jsp(주메뉴)
	/* 메뉴 오른쪽에 청구안내인 경우*/
	if (evtHref == "right_claimdoc") {
		position = "right";
		ampNacf.setEvtNm('home_menu_right_claimdoc');
		ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메뉴", "보상서비스", "청구서류안내");
		ampNacf.setBizNmCd("청구서류안내", "");
	} else
	//top 영역(다이렉트, 보장분석, 보험상담, 로그인, 회원가입, 공시정보, 회사소개, 사회공헌, FOREIGN, 농협FC, 금융소비자보호)
	if (evtHref.indexOf("direct/index.nhfire") >= 0) {
	} else if (evtHref.indexOf("direct/insurAnalysis/getInsurAnalysisRealName.nhfire") >= 0) {
		ampNacf.setEvtNm('home_top_insuranalysis');
		ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메인", "상단메뉴", "보장분석");
		ampNacf.setBizNmCd("보장분석조회", "");
		position = "top";
	} else if (evtHref.indexOf("login.nhfire") >= 0) {
		ampNacf.setEvtNm('home_top_login');
		ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메인", "상단로그인", "상단로그인");
		ampNacf.setBizNmCd("로그인화면이동", "");
		position = "top";
	//온라인창구 메뉴
	//보험상품  메뉴
	} else if (evtHref.indexOf("product/retrieveProduct.nhfire") >= 0) {
		var aryPdtCd = evtHref.split('pdtCd=');
		var pdtCd = aryPdtCd[1].substring(0,7);
		ampNacf_menuProdClick(pdtCd, ampNacf.getEventPath(evt));
		return false;
	} else if (evtHref.indexOf("product/cropDisasterInsuranceInfo.nhfire") >= 0) {
	} else if (evtHref.indexOf("direct/insurAnalysis/getInsurAnalysisRealName.nhfire") >= 0) {
	} else if (evtHref.indexOf("product/insuranceDictionary.nhfire") >= 0) {
	//보상서비스 메뉴
	} else if (evtHref.indexOf("customer/guide/insuranceClaimGuide.nhfire") >= 0) {
		ampNacf.setEvtNm('home_menu_claimguide');
		ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메뉴", "보상서비스", "보험금청구안내");
		ampNacf.setBizNmCd("보험금청구안내", "");
	} else if (evtHref.indexOf("customer/bilgdcm/retrieveBilgDcmList.nhfire") >= 0) {
		ampNacf.setEvtNm('home_menu_claimdoc');
		ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메뉴", "보상서비스", "청구서류안내");
		ampNacf.setBizNmCd("청구서류안내", "");
	} else if (evtHref.indexOf("cyber/acd/AcdSimUserStep1.nhfire") >= 0) {
		ampNacf.setEvtNm('home_menu_claim');
		ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메뉴", "보상서비스", "보험금청구하기");
		ampNacf.setBizNmCd("보험금청구하기", "");
	} else if (evtHref.indexOf("cyber/acd/AcdUserStep2.nhfire") >= 0) {
		ampNacf.setEvtNm('home_menu_claimlist');
		ampNacf.setDevicePath("pc_web(homepage)", "홈페이지_메뉴", "보상서비스", "보상처리현황조회");
		ampNacf.setBizNmCd("보상처리현황조회", "");
	} else if (evtHref.indexOf("customer/guide/accidentInvetigationStandards.nhfire") >= 0) {
		ampNacf.setEvtNm('home_menu_claimcriteria');
