<!-- 농협손해보험계약자의 농협생명수련원 이용 중단 안내  팝업 -->
<div id="balanceCouponPop2" class="infoMsg mt100 hpx570 wpx730" style="display:none";>
    <ul class="mb30">
    	<li class="fr"><a id="cooperationPopCloseBtn2" class="btnClose2"><img src="/images/btn/btn_close.png" alt="닫기" /></a></li>
